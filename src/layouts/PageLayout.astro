---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import type { SeoProps } from '../utils/seo/meta';

type Props = SeoProps & {
  eyebrow?: string;
  heading: string;
  lead?: string;
  headingFont?: 'display' | 'sans';
};
const { eyebrow, heading, lead, headingFont = 'display', ...seo } = Astro.props;
const headingClass = headingFont === 'display'
  ? 'font-display text-[length:var(--text-h1)] font-normal leading-[1.1] tracking-[-0.02em]'
  : 'text-[length:var(--text-h1)] font-semibold leading-[1.12] tracking-[-0.02em]';
---
<BaseLayout {...seo}>
  <section class="border-b border-rule bg-ivory pb-[clamp(40px,5vw,64px)] pt-[clamp(28px,3.5vw,44px)]">
    <Container>
      {seo.breadcrumbs && seo.breadcrumbs.length > 1 && <Breadcrumbs items={seo.breadcrumbs} />}
      {eyebrow && <p class="m-0 mb-5 text-xs font-medium uppercase tracking-[0.2em] text-gold-600">{eyebrow}</p>}
      <h1 class={`m-0 max-w-[24ch] text-navy-800 ${headingClass}`}>{heading}</h1>
      {lead && <p class="m-0 mt-6 max-w-[62ch] text-[length:var(--text-lead)] leading-[1.55] text-ink-mute">{lead}</p>}
      <slot name="hero-extra" />
    </Container>
  </section>
  <slot />
</BaseLayout>
