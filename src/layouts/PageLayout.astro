---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import ModeIcon from '../components/academic/ModeIcon.astro';
import { MODE } from '../components/academic/ResourceMode';
import type { SeoProps } from '../utils/seo/meta';

type Props = SeoProps & {
  eyebrow?: string;
  /** D-397: show the eyebrow as a study-mode chip (resource pages). */
  eyebrowMode?: 'learn' | 'review' | 'practice';
  heading: string;
  lead?: string;
  headingFont?: 'display' | 'sans';
};
const { eyebrow, eyebrowMode, heading, lead, headingFont = 'display', ...seo } = Astro.props;
const headingClass = headingFont === 'display'
  ? 'font-display text-[length:var(--text-h1)] font-bold leading-[1.04] tracking-[-0.03em]'
  : 'font-display text-[clamp(2rem,1.5rem+2.2vw,3.125rem)] font-bold leading-[1.08] tracking-[-0.025em]';
// D-397: one heading face (Bricolage Grotesque) for both settings; 'sans'
// is now the slightly smaller size used for long resource titles.
---
<BaseLayout {...seo}>
  <section class="border-b border-rule bg-ivory pb-[clamp(40px,5vw,64px)] pt-[clamp(28px,3.5vw,44px)]">
    <Container>
      {seo.breadcrumbs && seo.breadcrumbs.length > 1 && <Breadcrumbs items={seo.breadcrumbs} />}
      {eyebrow && (eyebrowMode
        ? <p class={`m-0 mb-4 inline-flex items-center gap-2 rounded-full border px-3 py-1 mb-eyebrow ${MODE[eyebrowMode].tint} ${MODE[eyebrowMode].border} ${MODE[eyebrowMode].text}`}><ModeIcon kind={eyebrowMode} size={18} />{eyebrow}</p>
        : <p class="m-0 mb-4 mb-eyebrow text-teal-700">{eyebrow}</p>)}
      <h1 data-pagefind-weight="10" class={`m-0 max-w-[24ch] text-navy-800 ${headingClass}`}>{heading}</h1>
      {lead && <p class="m-0 mt-6 max-w-[62ch] text-[length:var(--text-lead)] leading-[1.55] text-ink-mute">{lead}</p>}
      <slot name="hero-extra" />
    </Container>
  </section>
  <slot />
</BaseLayout>
