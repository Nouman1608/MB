---
import '../styles/global.css';
import Meta from '../components/seo/Meta.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/layout/Footer.astro';
import type { SeoProps } from '../utils/seo/meta';
import ConsentAnalytics from '../components/analytics/ConsentAnalytics.astro';
import WhatsAppButton from '../components/ui/WhatsAppButton.astro';

type Props = SeoProps & { isHome?: boolean };
const props = Astro.props;
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/images/brand/marlbridge-emblem-disc.svg" />
    <link rel="icon" href="/images/brand/marlbridge-favicon-512.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/images/brand/marlbridge-appicon-1024.png" />
    <!-- Interim webfont loading. When self-hosting, replace these three tags with:
         <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
         <link rel="preload" href="/fonts/public-sans-latin.woff2" as="font" type="font/woff2" crossorigin /> -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Public+Sans:wght@400;500;600&display=swap"
    />
    <Meta {...props} />
  </head>
  <body>
    <a
      href="#main"
      class="absolute left-4 top-[-60px] z-[100] rounded-sm bg-navy-800 px-5 py-3 text-sm font-medium text-ivory focus:top-4"
    >Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <ConsentAnalytics />
    <WhatsAppButton />
  </body>
</html>
