---
import '../styles/global.css';
import '../styles/fonts.css';
import Meta from '../components/seo/Meta.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/layout/Footer.astro';
import type { SeoProps } from '../utils/seo/meta';
import ConsentAnalytics from '../components/analytics/ConsentAnalytics.astro';
import WhatsAppButton from '../components/ui/WhatsAppButton.astro';

type Props = SeoProps & { isHome?: boolean };
const props = Astro.props;
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/images/brand/marlbridge-emblem-disc.svg" />
    <link rel="icon" href="/images/brand/marlbridge-favicon-512.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/images/brand/marlbridge-appicon-1024.png" />
    <!-- v1.x CLOSURE WS6 -- self-hosted. Files under public/fonts/, rules in
         src/styles/fonts.css (imported above). Only the latin + latin-ext
         subsets were kept (the site has no cyrillic/greek/vietnamese
         content), so this is 14 files instead of Google's full 25-subset
         set. Preloading the two heaviest, most-used weights removes the
         render-blocking third-party request entirely. -->
    <link rel="preload" href="/fonts/public-sans-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <Meta {...props} />
  </head>
  <body>
    <a
      href="#main"
      class="absolute left-4 top-[-60px] z-[100] rounded-sm bg-navy-800 px-5 py-3 text-sm font-medium text-ivory focus:top-4"
    >Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <ConsentAnalytics />
    <WhatsAppButton />
  </body>
</html>
