---
import { teachingMonthLabel } from '../../utils/academic/teaching-month';
/**
 * Syllabus/specification change tracker -- /syllabus-updates/
 *
 * v2.0 AUTHORITY/PRACTICE/TOOLS/GROWTH MEGA PROGRAMME WS11.
 *
 * Aggregates every specification transition already recorded in
 * src/data/academic/assessments.ts (specStatus 'future', 'legacy-teach-out'
 * or 'withdrawn') into one browsable page, so a student or parent can see
 * every currently-known syllabus change across all boards without visiting
 * each subject hub page individually. This page adds no new claims of its
 * own -- every record here already exists on its subject's hub page (see
 * [board]/[qualification]/[subject].astro's specStatus-conditional
 * callouts); this is purely an aggregation view over the same source data.
 *
 * Honesty note (see the page's own "How this list is kept accurate"
 * section): this reflects specification changes that have been officially
 * confirmed by boards and verified against their own syllabus documents
 * (see each combination's verifiedOn date on its hub page) -- it is not a
 * live monitoring feed and does not claim to catch every announcement the
 * moment it is published. Records marked 'current' that point at a
 * successor or predecessor (relatedCode) are listed in their own
 * "partway through a changeover" group, so the page's lead never promises
 * more than it shows (audit round 42, E938 (7)). Every other record is
 * shown nowhere on this page because there is nothing to report for it --
 * matching the codebase's no-filler, no-invented-content convention
 * (docs/decision-log.md D-050 and others).
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import { ASSESSMENTS, type Assessment, type SpecStatus } from '../../data/academic/assessments.ts';
import { flagshipSpecs } from '../../utils/academic/index.ts';
import { MATRIX, academicHubPath, isPublishable } from '../../utils/academic/index.ts';
import { routes } from '../../utils/urls/routes';
import CTA from '../../components/ui/CTA.astro';

const path = '/syllabus-updates/';

function comboFor(a: Assessment) {
  return MATRIX.find(
    (c) => c.boardSlug === a.boardSlug && c.qualificationSlug === a.qualificationSlug && c.subjectSlug === a.subjectSlug,
  );
}

type Row = {
  assessment: Assessment;
  boardLabel: string;
  qualificationLabel: string;
  subjectLabel: string;
  hubHref: string | null;
};

function rowFor(a: Assessment): Row {
  const c = comboFor(a);
  return {
    assessment: a,
    boardLabel: c?.board ?? a.boardSlug,
    qualificationLabel: c?.qualification ?? a.qualificationSlug,
    subjectLabel: c?.subject ?? a.subjectSlug,
    hubHref: c && isPublishable(c) ? academicHubPath(c) : null,
  };
}

const byStatus = (status: SpecStatus) =>
  ASSESSMENTS.filter((a) => a.specStatus === status).map(rowFor).sort((r1, r2) => r1.assessment.firstAssessment.localeCompare(r2.assessment.firstAssessment));

const future = byStatus('future');
const legacy = byStatus('legacy-teach-out');
const withdrawn = byStatus('withdrawn');
const totalTracked = ASSESSMENTS.length;
const totalTransitioning = future.length + legacy.length + withdrawn.length;
/**
 * Round 42 (E938 (7)): records still marked 'current' that are paired with
 * another specification (relatedCode) -- a successor already announced or
 * being taught, or a predecessor still being examined. They are listed so
 * the lead can honestly count them, without reclassifying any record here.
 */
const changeover = ASSESSMENTS.filter((a) => a.specStatus === 'current' && a.relatedCode)
  .map(rowFor)
  .sort((r1, r2) => r1.assessment.firstAssessment.localeCompare(r2.assessment.firstAssessment));

/**
 * Flagship Dominance Programme WS-C (2026-08-31) -- old-vs-new assessment-
 * structure comparison, built ONLY from confirmed pairs already in
 * assessments.ts (both sides' relatedCode point at each other), never
 * from an assumed or invented transition. This deliberately stays to
 * COMPUTED structural facts (component count, total marks, total exam
 * duration) rather than an interpretive "what changed" narrative --
 * per the brief's own instruction, a raw diff is not a substitute for a
 * human-checked academic interpretation, so this doesn't attempt one.
 */
function transitionPairs() {
  const used = new Set<string>();
  const pairs: { older: Assessment; newer: Assessment }[] = [];
  for (const a of ASSESSMENTS) {
    if (!a.relatedCode || used.has(a.code)) continue;
    const b = ASSESSMENTS.find(
      (o) => o.code === a.relatedCode && o.boardSlug === a.boardSlug
        && o.qualificationSlug === a.qualificationSlug && o.subjectSlug === a.subjectSlug,
    );
    if (!b || used.has(b.code)) continue;
    used.add(a.code); used.add(b.code);
    const [older, newer] = (a.firstTeaching ?? '') <= (b.firstTeaching ?? '') ? [a, b] : [b, a];
    pairs.push({ older, newer });
  }
  return pairs.sort((p1, p2) => (p1.newer.firstTeaching ?? '').localeCompare(p2.newer.firstTeaching ?? ''));
}
const totalMarks = (comps: Assessment['components']) => comps.reduce((sum, c) => sum + c.marks, 0);
const totalMinutes = (comps: Assessment['components']) => comps.reduce((sum, c) => sum + (c.durationMinutes ?? 0), 0);
/**
 * Round 42 (E938 (3)): an IB DP record stores its SL and HL components as
 * separate per-tier rows, so adding every row together double-counts the
 * shared papers and describes no candidate's actual assessment. Split such
 * records by tier and label each component with its tier.
 */
const TIER_SHORT: Record<string, string> = { sl: 'SL', hl: 'HL' };
const TIER_LONG: Record<string, string> = { sl: 'Standard Level (SL)', hl: 'Higher Level (HL)' };
function tierBlocks(a: Assessment) {
  const ibTiered = a.tiers.length > 0 && a.tiers.every((t) => t === 'sl' || t === 'hl');
  if (!ibTiered) return [{ heading: '', prefix: '', comps: a.components }];
  return a.tiers.map((t) => ({
    heading: TIER_LONG[t],
    prefix: `${TIER_SHORT[t]} `,
    comps: a.components.filter((c) => c.tier === t),
  }));
}
/**
 * Round 42 (E938 (3)): records whose mark totals were NOT read from the
 * board's own published document. The comparison says so next to the
 * figures instead of claiming board sourcing for them. Taken from each
 * record's own notes in assessments.ts.
 */
const marksNote = (a: Assessment): string | undefined =>
  a.marksSourceNote
  ?? (a.mirrorSourceUrl ? "Some figures in this record were read from a copy of the board's document hosted on a third-party website, not from the board's own site." : undefined);
const comparisonPairs = transitionPairs().map((p) => {
  const c = comboFor(p.newer) ?? comboFor(p.older);
  return {
    ...p,
    boardLabel: c?.board ?? p.newer.boardSlug,
    qualificationLabel: c?.qualification ?? p.newer.qualificationSlug,
    subjectLabel: c?.subject ?? p.newer.subjectSlug,
    hubHref: c && isPublishable(c) ? academicHubPath(c) : null,
  };
});

/**
 * Honest flagship disclosure: as of this build, none of the five flagship
 * specifications have an announced successor on record -- all are stable,
 * current syllabuses. Computed from the real flagship code list rather
 * than hardcoded, so this sentence corrects itself the day that changes.
 */
const flagshipCodes = new Set(flagshipSpecs().map((f) => f.code));
/** Records in the comparison whose marks carry a sourcing note (see marksNote). */
const marksExceptions = comparisonPairs.flatMap((p) => [p.older, p.newer]).filter((a) => marksNote(a)).map((a) => a.code);
const flagshipInTransition = [...future, ...legacy].some((r) => flagshipCodes.has(r.assessment.code));
---
<PageLayout
  title="Syllabus & Specification Changes Tracker"
  description="Specifications Marlbridge records as upcoming, being withdrawn or withdrawn, and current specifications partway through a changeover, with first-teaching, first-assessment and final-assessment dates from each board's own documents."
  path={path}
  eyebrow="Free tool"
  heading="Syllabus &amp; specification changes"
  lead={`Of the ${totalTracked} specifications Marlbridge tracks, ${totalTransitioning} are recorded as upcoming, being withdrawn or withdrawn, and ${changeover.length} more are recorded as current but paired with a specification that replaces them or that they replace. All are listed below. A specification missing from this page may still be changing: check the board's own website.`}
  breadcrumbs={[
    { label: 'Home', href: routes.home },
    { label: 'Syllabus changes', href: path },
  ]}
>
  <Section surface="white">
    <Container>
      {future.length > 0 && (
        <div class="mb-12">
          <h2 class="m-0 mb-1 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Upcoming specifications</h2>
          <p class="m-0 mb-6 max-w-[70ch] text-[14.5px] leading-[1.6] text-ink-mute">Announced, but teaching has not begun yet (a specification is recorded as current once its first teaching has begun, even before its first exams). Learners who start the course on or after the first-teaching date shown follow the new specification. Learners already partway through a specification it replaces finish that one (its final exam series, where Marlbridge records one, is on its card on this page). Where no first-teaching date is shown, check the board's own page for when teaching begins.</p>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {future.map((r) => (
              <div class="flex h-full flex-col gap-2 rounded-sm border border-rule bg-white p-[clamp(20px,2vw,26px)]">
                <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-gold-600">{r.boardLabel} {r.qualificationLabel}</span>
                <span class="text-[17px] font-semibold tracking-[-0.01em] text-navy-800">{r.subjectLabel}</span>
                <span class="text-[13.5px] text-ink-mute">Specification {r.assessment.code}{r.assessment.relatedCode && <> (replaces {r.assessment.relatedCode})</>}</span>
                <dl class="m-0 mt-1 grid grid-cols-[auto_1fr] gap-x-2 gap-y-0.5 text-[13px] text-ink-mute">
                  {r.assessment.firstTeaching && (<><dt class="font-medium text-navy-800">First teaching</dt><dd class="m-0">{teachingMonthLabel(r.assessment.firstTeaching)}</dd></>)}
                  <dt class="font-medium text-navy-800">First assessment</dt><dd class="m-0">{r.assessment.firstAssessment}</dd>
                </dl>
                {r.hubHref
                  ? <a href={r.hubHref} class="mt-auto pt-2 text-[13.5px] font-medium text-gold-600 hover:underline">Full detail on the {r.subjectLabel} hub →</a>
                  : <span class="mt-auto pt-2 text-[13px] text-ink-mute">Not yet published on Marlbridge</span>}
              </div>
            ))}
          </div>
        </div>
      )}

      {legacy.length > 0 && (
        <div class="mb-12">
          <h2 class="m-0 mb-1 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Being withdrawn</h2>
          <p class="m-0 mb-6 text-[14.5px] text-ink-mute">Still assessable for learners already partway through them, but replaced for new learners by a newer specification. The last exam series is shown on the card where the board has announced one.</p>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {legacy.map((r) => (
              <div class="flex h-full flex-col gap-2 rounded-sm border border-rule bg-white p-[clamp(20px,2vw,26px)]">
                <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-gold-600">{r.boardLabel} {r.qualificationLabel}</span>
                <span class="text-[17px] font-semibold tracking-[-0.01em] text-navy-800">{r.subjectLabel}</span>
                <span class="text-[13.5px] text-ink-mute">Specification {r.assessment.code}{r.assessment.relatedCode && <> (being replaced by {r.assessment.relatedCode}{!ASSESSMENTS.some((o) => o.code === r.assessment.relatedCode && o.boardSlug === r.assessment.boardSlug) && <>, which has no Marlbridge assessment record yet</>})</>}</span>
                {r.assessment.finalAssessment && (
                  <p class="m-0 mt-1 text-[13px] text-ink-mute"><span class="font-medium text-navy-800">Final assessment:</span> {r.assessment.finalAssessment}</p>
                )}
                {r.hubHref
                  ? <a href={r.hubHref} class="mt-auto pt-2 text-[13.5px] font-medium text-gold-600 hover:underline">Full detail on the {r.subjectLabel} hub →</a>
                  : <span class="mt-auto pt-2 text-[13px] text-ink-mute">Not yet published on Marlbridge</span>}
              </div>
            ))}
          </div>
        </div>
      )}

      {changeover.length > 0 && (
        <div class="mb-12">
          <h2 class="m-0 mb-1 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Current, but partway through a changeover</h2>
          <p class="m-0 mb-6 max-w-[70ch] text-[14.5px] leading-[1.6] text-ink-mute">Recorded as current, and paired with another specification for the same subject: either a successor that is announced or already being taught, or an older specification it replaces, which may still be examined for learners already partway through it. Check the dates on each card, and the subject hub, for which one applies to you.</p>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {changeover.map((r) => (
              <div class="flex h-full flex-col gap-2 rounded-sm border border-rule bg-white p-[clamp(20px,2vw,26px)]">
                <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-gold-600">{r.boardLabel} {r.qualificationLabel}</span>
                <span class="text-[17px] font-semibold tracking-[-0.01em] text-navy-800">{r.subjectLabel}</span>
                <span class="text-[13.5px] text-ink-mute">Specification {r.assessment.code} {ASSESSMENTS.some((o) => o.code === r.assessment.relatedCode && o.boardSlug === r.assessment.boardSlug)
                  ? <>(paired with {r.assessment.relatedCode})</>
                  : <>(its successor, {r.assessment.relatedCode}, has no Marlbridge assessment record yet)</>}</span>
                <dl class="m-0 mt-1 grid grid-cols-[auto_1fr] gap-x-2 gap-y-0.5 text-[13px] text-ink-mute">
                  {r.assessment.firstTeaching && (<><dt class="font-medium text-navy-800">First teaching</dt><dd class="m-0">{teachingMonthLabel(r.assessment.firstTeaching)}</dd></>)}
                  <dt class="font-medium text-navy-800">First assessment</dt><dd class="m-0">{r.assessment.firstAssessment}</dd>
                  {r.assessment.finalAssessment && (<><dt class="font-medium text-navy-800">Final assessment</dt><dd class="m-0">{r.assessment.finalAssessment}</dd></>)}
                </dl>
                {r.hubHref
                  ? <a href={r.hubHref} class="mt-auto pt-2 text-[13.5px] font-medium text-gold-600 hover:underline">Full detail on the {r.subjectLabel} hub →</a>
                  : <span class="mt-auto pt-2 text-[13px] text-ink-mute">Not yet published on Marlbridge</span>}
              </div>
            ))}
          </div>
        </div>
      )}

      {withdrawn.length > 0 && (
        <div class="mb-12">
          <h2 class="m-0 mb-1 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Already withdrawn</h2>
          <p class="m-0 mb-6 text-[14.5px] text-ink-mute">No longer assessable. Shown for historical reference only.</p>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {withdrawn.map((r) => (
              <div class="flex h-full flex-col gap-2 rounded-sm border border-dashed border-rule bg-ivory p-[clamp(20px,2vw,26px)]">
                <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-gold-600">{r.boardLabel} {r.qualificationLabel}</span>
                <span class="text-[17px] font-semibold tracking-[-0.01em] text-navy-800">{r.subjectLabel}</span>
                <span class="text-[13.5px] text-ink-mute">Specification {r.assessment.code}{r.assessment.relatedCode && <>; see {r.assessment.relatedCode}</>}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      {totalTransitioning === 0 && changeover.length === 0 && (
        <p class="m-0 rounded-sm border border-dashed border-rule bg-ivory p-6 text-[15px] text-ink-mute">
          No specification transitions are currently tracked. Every specification Marlbridge covers is shown as its board's current, ongoing syllabus.
        </p>
      )}
    </Container>
  </Section>

  <Section surface="white" border>
    <Container>
      <h2 class="m-0 mb-1 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Old vs new: assessment structure</h2>
      <p class="m-0 mb-2 max-w-[70ch] text-[14.5px] leading-[1.6] text-ink-mute">
        For every specification pair above where Marlbridge has an assessment record for
        <em>both</em> the outgoing and incoming specification, here is how the paper structure
        compares. The totals are added up from the component figures in those records, the same ones
        shown on each subject hub, not summarised or interpreted. Where a subject is taken at two
        levels (IB Standard and Higher Level), each level is totalled separately. Where a record's
        marks did not come from the board's own document, a note under that record says so.
      </p>
      {!flagshipInTransition && (
        <p class="m-0 mb-8 rounded-sm border border-dashed border-rule bg-ivory p-4 text-[13.5px] leading-[1.6] text-ink-mute">
          None of Marlbridge's five flagship specifications (Cambridge IGCSE Chemistry 0620, Physics 0625,
          Mathematics 0580, and Cambridge International AS &amp; A Level Chemistry 9701, Physics 9702) currently
          has an announced successor on record -- all five are stable, current syllabuses with no confirmed
          transition. The comparisons below cover the other specifications Marlbridge tracks that are.
        </p>
      )}
      {comparisonPairs.length === 0 && (
        <p class="m-0 rounded-sm border border-dashed border-rule bg-ivory p-6 text-[15px] text-ink-mute">
          No transition currently has a real, sourced assessment record on both sides -- so there is nothing
          to compare here yet, even though some specifications above are known to be mid-transition.
        </p>
      )}
      <div class="grid gap-8">
        {comparisonPairs.map((p) => (
          <div class="rounded-sm border border-rule bg-white p-[clamp(20px,2.2vw,30px)]">
            <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
              <div>
                <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-gold-600">{p.boardLabel} {p.qualificationLabel}</span>
                <h3 class="m-0 text-[18px] font-semibold tracking-[-0.01em] text-navy-800">{p.subjectLabel}: {p.older.code} → {p.newer.code}</h3>
              </div>
              {p.hubHref && <a href={p.hubHref} class="shrink-0 text-[13.5px] font-medium text-gold-600 hover:underline">Full detail on the {p.subjectLabel} hub →</a>}
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              {[{ label: `Outgoing — ${p.older.code}`, a: p.older }, { label: `Incoming — ${p.newer.code}`, a: p.newer }].map(({ label, a }) => (
                <div>
                  <p class="m-0 mb-2 text-[12px] font-medium uppercase tracking-[0.1em] text-ink-mute">{label}</p>
                  <dl class="m-0 mb-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5 text-[13px] text-ink-mute">
                    <dt class="font-medium text-navy-800">First teaching</dt><dd class="m-0">{a.firstTeaching ? teachingMonthLabel(a.firstTeaching) : 'Not recorded'}</dd>
                    <dt class="font-medium text-navy-800">First assessment</dt><dd class="m-0">{a.firstAssessment}</dd>
                  </dl>
                  {tierBlocks(a).map((b) => (
                    <div class="mb-3 last:mb-0">
                      {b.heading && <p class="m-0 mb-1 text-[13px] font-semibold text-navy-800">{b.heading}</p>}
                      <dl class="m-0 mb-2 grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5 text-[13px] text-ink-mute">
                        <dt class="font-medium text-navy-800">Components</dt><dd class="m-0">{b.comps.length}</dd>
                        <dt class="font-medium text-navy-800">Total marks</dt><dd class="m-0">{totalMarks(b.comps)}</dd>
                        <dt class="font-medium text-navy-800">Total exam time</dt><dd class="m-0">{Math.round(totalMinutes(b.comps) / 6) / 10}h</dd>
                      </dl>
                      <ul class="m-0 list-none p-0 text-[13px] leading-[1.7] text-ink">
                        {b.comps.map((c) => (
                          <li>{b.prefix}{c.paperCode} — {c.title} ({c.marks} marks, {c.asWeightingPercent != null && c.asWeightingPercent !== c.weightingPercent
                            ? (c.weightingPercent === 0 ? `${c.asWeightingPercent}% AS only` : `${c.asWeightingPercent}% AS / ${c.weightingPercent}% A Level`)
                            : `${c.weightingPercent}%`})</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                  {marksNote(a) && <p class="m-0 mt-2 text-[12.5px] leading-[1.55] text-ink-mute"><span class="font-medium text-navy-800">Marks:</span> {marksNote(a)}</p>}
                </div>
              ))}
            </div>
            <p class="m-0 mt-4 text-[12.5px] text-ink-mute">
              {marksNote(p.older) || marksNote(p.newer)
                ? <>Dates, durations and weightings from each specification's own official documents; for the marks, see the note above. Verified {p.newer.verifiedOn}.</>
                : <>Sourced from {p.older.officialSourceUrl === p.newer.officialSourceUrl ? 'the board\'s own specification documents' : 'each specification\'s own official documents'}, verified {p.newer.verifiedOn}.</>}
            </p>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section surface="ivory" border>
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">What these statuses mean</h2>
      <div class="grid gap-6 sm:grid-cols-3">
        <div>
          <p class="m-0 font-semibold text-navy-800">Upcoming</p>
          <p class="m-0 mt-1.5 text-[14.5px] leading-[1.6] text-ink-mute">A new specification whose first teaching has not begun yet. Once teaching begins it is recorded as current, even before its first exams are sat.</p>
        </div>
        <div>
          <p class="m-0 font-semibold text-navy-800">Being withdrawn</p>
          <p class="m-0 mt-1.5 text-[14.5px] leading-[1.6] text-ink-mute">Still assessable today for learners already partway through it, but replaced for new learners by a newer specification. Its final exam series is shown where the board has announced one.</p>
        </div>
        <div>
          <p class="m-0 font-semibold text-navy-800">Withdrawn</p>
          <p class="m-0 mt-1.5 text-[14.5px] leading-[1.6] text-ink-mute">No longer assessable by any board. Kept here only for historical reference, never as a live study option.</p>
        </div>
      </div>

      <h3 class="m-0 mb-2 mt-10 text-[17px] font-semibold text-navy-800">How this list is kept accurate</h3>
      <p class="m-0 max-w-[70ch] text-[14.5px] leading-[1.65] text-ink-mute">
        The statuses and dates above come from the assessment records behind each subject hub, and each record cites
        the board's own syllabus, specification or subject page.
        {marksExceptions.length > 0 && <> Not every mark total in the comparison comes from a board document: the exceptions ({marksExceptions.join(', ')}) carry a note saying where their marks came from.</>}
        {' '}This page is not a live monitoring feed -- it reflects Marlbridge's most recent verification of each
        specification, dated on that subject's own hub page. If a subject you're following isn't listed here, it
        means Marlbridge has found no officially confirmed transition for it -- not that none exists; always check
        the board's own website for the most current word on your specific specification and examination series.
      </p>
    </Container>
  </Section>

  <CTA
    surface="ivory"
    heading="A specification change can shift what's actually examined. A teacher keeps your revision aligned to the current syllabus."
    buttonLabel="Find Learning Support"
    buttonHref={routes.tutoring}
  />

</PageLayout>
