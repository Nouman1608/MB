---
import { render, type CollectionEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import ResourceCard from '../../components/cards/ResourceCard.astro';
import RelatedGrid from '../../components/layout/RelatedGrid.astro';
import Button from '../../components/ui/Button.astro';
import { PRICING_TERMS, REGION_PRICING, ONE_TO_ONE_PRICING, ONE_TO_ONE_TERMS, ONE_TO_ONE_ONLY_PRICING, ONE_TO_ONE_ONLY_NOTE, isOneToOneOnlyCourse, formatFee } from '../../data/pricing';
import { getAuthors } from '../../utils/content/collections';
import { articlesByAuthor, resourcesByAuthor } from '../../utils/content/related';
import { personNode, organizationEntityNode } from '../../utils/schema/person';
import { routes } from '../../utils/urls/routes';
import VideoSection from '../../components/media/VideoSection.astro';
import { videosForTeacher } from '../../utils/content/media';
import { videoNodes } from '../../utils/schema/video';
import { boardBySlug } from '../../data/academic/boards';

export async function getStaticPaths() {
  const authors = await getAuthors();
  return authors.map((author) => ({ params: { slug: author.id }, props: { author } }));
}

interface Props { author: CollectionEntry<'authors'> }
const { author } = Astro.props;
const d = author.data;
const { Content } = await render(author);
const path = routes.author(author.id);

const articles = await articlesByAuthor(author.id);
const resources = await resourcesByAuthor(author.id);
// D-349 (audit R-07) -- the Academic Team byline had over a thousand resource
// cards on one page (1.16 MB). Past AUTHOR_RESOURCE_PREVIEW, the profile
// shows the first few and links to the paginated full list.
const AUTHOR_RESOURCE_PREVIEW = 24;
const resourcePreview = resources.length > AUTHOR_RESOURCE_PREVIEW ? resources.slice(0, 12) : resources;
/* D-286 -- this teacher's published lessons; renders nothing while there are none. */
const videos = await videosForTeacher(author.id);

/**
 * Conversion & Trust round (2026-09-06, D-149).
 *
 * These pages already held real, sourced teaching facts -- subjectsTaught,
 * yearsExperience, previousSchools, sourceUrl, verifiedOn -- in the authors
 * collection schema, and the template rendered NONE of them. A parent
 * choosing a teacher saw a bio, a credentials line, and then two long
 * archives of published resources: the page functioned as a byline index
 * rather than as a reason to book this person.
 *
 * Everything below is read from the profile's own frontmatter. Nothing is
 * inferred, rounded or filled in: a teacher with no recorded years of
 * experience simply has no such row, and the whole teaching panel is
 * omitted for an institutional byline or a profile with no teaching facts
 * recorded yet, rather than rendering an empty shell.
 *
 * previousSchools is rendered under an explicit "Previously taught at"
 * label. That wording is deliberate and must not be softened into anything
 * suggesting those schools endorse, partner with or recommend Marlbridge --
 * they are a record of where a person worked, nothing more.
 */
const isPerson = d.entityType === 'person';
// D-408 -- a reviewer-only profile (no subject taught at Marlbridge) is not presented as a teacher:
// no "Meet the teacher", no levels claim and no trial booking with them.
const isTeacher = isPerson && d.subjectsTaught.length > 0;
// D-333 (owner answers, 25 Sep 2026): boards per teacher, and which teachers take IB
// students. boardsTaught holds board slugs from src/data/academic/boards.ts; an unknown
// slug fails the build rather than printing a wrong board.
const boardNames = d.boardsTaught.map((slug) => {
  const b = boardBySlug(slug);
  if (!b) throw new Error(`authors/${author.id}: unknown board slug "${slug}" in boardsTaught`);
  return slug === 'ib' ? 'IB' : b.name;
});
const teachesIB = d.boardsTaught.includes('ib');
// D-331: every teacher teaches all levels; D-333: IB (MYP and Diploma) only where recorded.
const ALL_LEVELS_LABEL = teachesIB
  ? 'IGCSE / GCSE / O Level, AS & A Level, and IB (MYP and Diploma)'
  : 'IGCSE / GCSE / O Level, AS & A Level';
// D-330: the owner-set Pakistan base rates (other regions are on /pricing/).
const pkGroup = REGION_PRICING.find((r) => r.region === 'Pakistan')!;
const pkOne = ONE_TO_ONE_PRICING.find((r) => r.region === 'Pakistan')!;
// D-349 (audit R-05): a teacher whose boards include a one-to-one-only course
// (D-335: every OCR course; OxfordAQA Islamiyat and Pakistan Studies) says so,
// with its rate, next to the group and one-to-one fees.
const subjectSlugs = d.subjectsTaught.flatMap((name) =>
  name.split('/').map((part) => part.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')),
);
const teachesOneToOneOnly = d.boardsTaught.some((board) =>
  isOneToOneOnlyCourse(board, '') || subjectSlugs.some((subject) => isOneToOneOnlyCourse(board, subject)),
);
const teachingFacts = [
  d.subjectsTaught.length > 0 && { label: 'Teaches', value: d.subjectsTaught.join(' · ') },
  // D-408 -- subjects reviewed but not taught at Marlbridge.
  d.subjectsReviewed.length > 0 && { label: 'Reviews study resources in', value: d.subjectsReviewed.join(' · ') },
  // D-331 (owner decision, 25 Sep 2026): every Marlbridge teacher teaches all levels.
  // A per-teacher list, if one is ever recorded, still wins.
  isTeacher && { label: 'Levels', value: d.qualificationsTaught.length > 0 ? d.qualificationsTaught.join(' · ') : ALL_LEVELS_LABEL },
  boardNames.length > 0 && { label: 'Exam boards', value: boardNames.join(' · ') },
  d.yearsExperience !== undefined && { label: 'Teaching experience', value: `${d.yearsExperience} years` },
  d.previousSchools.length > 0 && { label: 'Previously taught at', value: d.previousSchools.join(', ') },
].filter(Boolean) as { label: string; value: string }[];
const showTeachingPanel = isPerson && teachingFacts.length > 0;

// v1.2 WS7 — a team byline must never be emitted as Schema.org Person.
const jsonLd = [
  d.entityType === 'organization'
    ? organizationEntityNode({ path, name: d.name, jobTitle: d.role, bio: d.bio })
    : personNode({ path, name: d.name, jobTitle: d.role, bio: d.bio, image: d.image }),
  ...videoNodes(videos),
];
---
<PageLayout
  title={isPerson && d.role ? `${d.name}, ${d.role}` : d.name}
  description={`${d.name} — ${d.role} at Marlbridge. ${d.bio}`.slice(0, 160)}
  path={path}
  eyebrow={isTeacher ? 'Meet the teacher' : isPerson ? 'Reviewer' : 'Author'}
  heading={d.name}
  lead={d.role}
  headingFont="sans"
  breadcrumbs={isTeacher
    ? [
        { label: 'Home', href: routes.home },
        { label: 'Tutoring', href: routes.tutoring },
        { label: d.name, href: path },
      ]
    : [
        { label: 'Home', href: routes.home },
        { label: 'Learning Journal', href: routes.articles },
        { label: d.name, href: path },
      ]}
  jsonLd={jsonLd}
>
  <Fragment slot="hero-extra">
    {d.image ? (
      <img
        src={d.image}
        alt={`Photograph of ${d.name}`}
        width="112"
        height="112"
        loading="eager"
        decoding="async"
        class="mt-6 h-28 w-28 rounded-full border border-rule object-cover"
      />
    ) : d.entityType === 'person' ? (
      <div
        role="img"
        aria-label={`Photograph not yet available for ${d.name}`}
        class="mt-6 flex h-28 w-28 items-center justify-center rounded-full border border-rule bg-white mb-label text-[#6F6552]"
      >
        Photo
      </div>
    ) : null}
  </Fragment>
  <Section surface="white">
    <Container width="prose">
      <div class="text-[17.5px] leading-[1.75] [&>p]:mt-5">
        <p class="m-0">{d.bio}</p>
        <Content />
      </div>
      {d.credentials.length > 0 && (
        <p class="mt-6 mb-label text-ink-mute">{d.credentials.join(' · ')}</p>
      )}
      {(d.links.linkedin || d.links.website) && (
        <p class="mt-4 text-[15px]">
          {d.links.website && <a href={d.links.website} class="underline decoration-teal-500 underline-offset-2">Website</a>}
          {d.links.website && d.links.linkedin && ' · '}
          {d.links.linkedin && <a href={d.links.linkedin} class="underline decoration-teal-500 underline-offset-2">LinkedIn</a>}
        </p>
      )}

      {showTeachingPanel && (
        <section aria-labelledby="teaching-facts" class="mt-10 rounded-sm border border-rule bg-ivory p-[clamp(22px,2.4vw,32px)]">
          <h2 id="teaching-facts" class="m-0 text-[19px] font-semibold tracking-[-0.015em] text-navy-800">Teaching</h2>
          <dl class="m-0 mt-5 grid gap-3.5 text-[15.5px] leading-[1.6]">
            {teachingFacts.map((f) => (
              <div class="grid gap-1 sm:grid-cols-[minmax(150px,auto)_1fr] sm:gap-4">
                <dt class="m-0 mb-label text-teal-700 sm:pt-1">{f.label}</dt>
                <dd class="m-0 text-ink">{f.value}</dd>
              </div>
            ))}
          </dl>
          {d.sourceUrl && (
            <p class="m-0 mt-5 border-t border-rule pt-4 text-[13px] leading-relaxed text-ink-mute">
              These details were taken from <a href={d.sourceUrl} rel="noopener" target="_blank" class="underline decoration-teal-500 underline-offset-2">the published faculty listing</a>{d.verifiedOn && <> and last checked on {d.verifiedOn.toISOString().slice(0, 10)}</>}. Where a school is listed above, it records where this teacher has previously worked — it is not an endorsement of Marlbridge by that school.
            </p>
          )}
          {!d.sourceUrl && d.sourceNote && (
            <p class="m-0 mt-5 border-t border-rule pt-4 text-[13px] leading-relaxed text-ink-mute">
              Source for these details: {d.sourceNote}
            </p>
          )}
        </section>
      )}

      {isTeacher && (
        <section aria-labelledby="teacher-trial" class="mt-8 border-t border-rule pt-8">
          <h2 id="teacher-trial" class="m-0 text-[19px] font-semibold tracking-[-0.015em] text-navy-800">Study with {d.name.split(' ')[0]}</h2>
          <p class="m-0 mt-3 max-w-[62ch] text-[16.5px] leading-[1.65] text-ink-mute">
            {PRICING_TERMS.freeTrial} Your request will say you asked for {d.name.split(' ')[0]}. We will tell you honestly whether {d.name.split(' ')[0]} has room at your level and time — we cannot guarantee a specific teacher in advance, but we will tell you who it is before the class is scheduled. {PRICING_TERMS.enquiryResponse.summary}
          </p>
          {/* D-330: what the next step involves and costs, from the canonical pricing data.
              Pakistan rows are the owner-set base rates; other regions are on /pricing/. */}
          <dl class="m-0 mt-6 grid gap-3 text-[15.5px] leading-[1.6] sm:grid-cols-2">
            <div class="rounded-sm border border-rule bg-white p-4">
              <dt class="m-0 mb-label text-teal-700">Group classes</dt>
              <dd class="m-0 mt-1.5">Up to {PRICING_TERMS.maxGroupSize} students. {PRICING_TERMS.classFormat.group} In Pakistan from {formatFee(pkGroup.igcse, pkGroup.currency)} {pkGroup.currency} per subject per month (IGCSE, GCSE, O Level).</dd>
            </div>
            <div class="rounded-sm border border-rule bg-white p-4">
              <dt class="m-0 mb-label text-teal-700">One-to-one</dt>
              <dd class="m-0 mt-1.5">{PRICING_TERMS.classFormat.oneToOne} In Pakistan from {formatFee(pkOne.igcse, pkOne.currency)} {pkOne.currency} {ONE_TO_ONE_TERMS.unit}.</dd>
            </div>
          </dl>
          {teachesOneToOneOnly && (
            <p class="m-0 mt-3 text-[14px] text-ink-mute">{ONE_TO_ONE_ONLY_NOTE} In Pakistan {formatFee(ONE_TO_ONE_ONLY_PRICING.perClass, ONE_TO_ONE_ONLY_PRICING.currency)} {ONE_TO_ONE_ONLY_PRICING.currency} {ONE_TO_ONE_ONLY_PRICING.unit}.</p>
          )}
          <p class="m-0 mt-3 text-[14px] text-ink-mute">A Level, IB and other regions are priced differently: <a href={routes.pricing} class="underline decoration-teal-500 underline-offset-2">Fees in your currency</a>. {PRICING_TERMS.teacherAvailability}</p>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <Button href={`${routes.trial}?teacher=${author.id}&source=teacher`} variant="primary" data-cta="teacher-trial">Request a free trial with {d.name.split(' ')[0]}</Button>
            <Button href={routes.tutoring} variant="quiet">See all teachers</Button>
          </div>
        </section>
      )}
    </Container>

    <Container>
      <VideoSection videos={videos} heading={`Lessons by ${d.name}`} id="teacher-videos" />
      {isPerson && (articles.length > 0 || resources.length > 0) && (
        <p class="mt-[clamp(48px,6vw,72px)] border-t border-rule pt-8 text-[15px] text-ink-mute">
          Published for Marlbridge by {d.name} — free to read whether or not you study with us.
        </p>
      )}
      {articles.length > 0 && (
        <RelatedGrid id="author-articles" title="Articles">
          {articles.map((a) => <li class="m-0"><ArticleCard entry={a} /></li>)}
        </RelatedGrid>
      )}
      {resources.length > 0 && (
        <RelatedGrid id="author-resources" title="Resources">
          {resourcePreview.map((r) => <li class="m-0"><ResourceCard entry={r} /></li>)}
        </RelatedGrid>
      )}
      {resourcePreview.length < resources.length && (
        <p class="m-0 mt-6 text-[15.5px]"><a href={routes.authorResources(author.id)} class="underline decoration-teal-500 underline-offset-2">All {resources.length} resources by {d.name}</a></p>
      )}
    </Container>
  </Section>
</PageLayout>
