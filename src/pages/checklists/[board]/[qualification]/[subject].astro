---
/**
 * v1.x CLOSURE -- Printable syllabus checklist detail page.
 *
 * Renders ONLY the topics/subtopics present in SYLLABUS_VERSIONS for this
 * exact board+qualification+subject -- the same verified taxonomy used on
 * the academic hub pages (src/pages/boards/[board]/[qualification]/[subject].astro).
 * No topic, subtopic or numbering is invented here; anything not itemised
 * in the source data is shown as an honest "not itemised in the published
 * syllabus" note rather than papered over.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Section from '../../../../components/layout/Section.astro';
import Container from '../../../../components/layout/Container.astro';
import { SYLLABUS_VERSIONS, topicsFor } from '../../../../data/academic/syllabus-topics';
import { boardBySlug } from '../../../../data/academic/boards';
import { qualificationBySlug } from '../../../../data/academic/qualifications';
import { subjectBySlug } from '../../../../data/academic/subjects';
import { courseSubjectNameOverride } from '../../../../data/academic/matrix';
import { activeOnly, academicHubPath } from '../../../../utils/academic';
import { recordRtlLang, nameRtlLang } from '../../../../utils/academic/rtl-names';
import { taughtOnly } from '../../../../utils/academic';
import { PRICING_TERMS, isOneToOneOnlyCourse } from '../../../../data/pricing';
import ResourceTutoringPrompt from '../../../../components/tools/ResourceTutoringPrompt.astro';

export async function getStaticPaths() {
  const activeKeys = new Set(activeOnly().map((c) => `${c.boardSlug}/${c.qualificationSlug}/${c.subjectSlug}`));
  return SYLLABUS_VERSIONS
    .filter((v) => v.status === 'current')
    .filter((v) => activeKeys.has(`${v.boardSlug}/${v.qualificationSlug}/${v.subjectSlug}`))
    .map((v) => ({
      params: { board: v.boardSlug, qualification: v.qualificationSlug, subject: v.subjectSlug },
    }));
}

const { board, qualification, subject } = Astro.params as { board: string; qualification: string; subject: string };
const version = topicsFor(board, qualification, subject);
if (!version) throw new Error(`No syllabus version for ${board}/${qualification}/${subject}`);

const boardName = boardBySlug(board)?.name ?? board;
const qualificationName = qualificationBySlug(qualification)?.name ?? qualification;
// B15 -- name the course as its hub does (9626 is "Information Technology").
const subjectName = courseSubjectNameOverride(board, qualification, subject) ?? subjectBySlug(subject)?.name ?? subject;
const rtlLang = recordRtlLang(version.topics);
const hubHref = academicHubPath({ boardSlug: board, qualificationSlug: qualification, subjectSlug: subject } as any);

/**
 * 8 Oct 2026 -- the lesson-end tuition prompt (D-403) on checklists too.
 * Search Console (15 Sep-5 Oct): checklists get ~8.5% CTR and GA4 shows
 * ~320 organic sessions a month landing on them, with no tuition offer on
 * the page. Shown only for a course Marlbridge teaches (taughtOnly()), never
 * printed, with the course pre-filled in the trial link (D-330).
 */
const taught = taughtOnly().some((c) => c.boardSlug === board && c.qualificationSlug === qualification && c.subjectSlug === subject);
const courseKey = `${board}/${qualification}/${subject}`;
const oneToOneOnly = board === 'ib' || isOneToOneOnlyCourse(board, subject);
const promptFormat = oneToOneOnly ? 'one-to-one' : `one-to-one and in small groups of up to ${PRICING_TERMS.maxGroupSize}`;
const promptTrialHref = `/trial/?course=${encodeURIComponent(courseKey)}${oneToOneOnly ? '&format=one-to-one' : ''}&source=resource`;
---
<BaseLayout
  title={`${boardName} ${qualificationName} ${subjectName} — printable checklist`}
  description={`Printable checklist of all ${version.topics.length} topics for ${boardName} ${qualificationName} ${subjectName}, syllabus ${version.syllabusCode} (${version.syllabusSeries}).`}
  path={`/checklists/${board}/${qualification}/${subject}/`}
>
  <Section>
    <Container>
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4 print:hidden">
        <a href={hubHref} class="text-[14px] text-ink-mute hover:text-navy-900">&larr; Back to {subjectName} hub</a>
        <button type="button" onclick="window.print()" class="inline-flex min-h-11 items-center justify-center rounded-sm bg-navy-800 px-6 py-3 text-[14.5px] font-medium text-ivory hover:bg-navy-700">Print this checklist</button>
      </div>

      <h1 class="m-0 mb-1 text-[28px] font-semibold text-navy-900">{boardName} {qualificationName} {subjectName}</h1>
      {/* D-301 -- Pagefind filters (same values as hubs and resources). */}
      <div hidden aria-hidden="true">
        <span data-pagefind-filter="Resource type:Topic checklist"></span>
        <span data-pagefind-filter={`Board:${boardName}`}></span>
        <span data-pagefind-filter={`Qualification:${qualificationName}`}></span>
      </div>
      <p class="m-0 mb-8 text-[14px] text-ink-mute">
        Syllabus {version.syllabusCode} &middot; {version.syllabusSeries} &middot; sourced from
        {' '}<a href={version.sourceUrl} class="underline decoration-teal-500 underline-offset-2">{version.source}</a>,
        verified {version.verifiedDate}.
      </p>
      {version.subtopicsCaveat && (
        <p class="m-0 -mt-4 mb-8 max-w-[70ch] text-[14px] text-ink-mute" data-subtopics-caveat>{version.subtopicsCaveat}</p>
      )}

      <ol class="m-0 list-none space-y-8 p-0">
        {version.topics.map((topic) => (
          <li>
            <h2 class="m-0 mb-3 text-[18px] font-semibold text-navy-900">{typeof topic.number === 'number' ? `${topic.number}. ` : `${topic.number} `}{nameRtlLang(topic.name, rtlLang) ? <bdi dir="rtl" lang={nameRtlLang(topic.name, rtlLang)}>{topic.name}</bdi> : topic.name}{topic.stage ? ` (${topic.stage})` : ''}</h2>
            {topic.subtopics.length > 0 ? (
              <ul class="m-0 grid gap-2 p-0 sm:grid-cols-2">
                {topic.subtopics.map((s) => (
                  <li class="flex items-start gap-2 text-[14.5px] text-ink-mute">
                    <span class="mt-0.5 h-4 w-4 shrink-0 rounded-sm border border-navy-rule print:border-black" aria-hidden="true"></span>
                    <span>{s.number} {nameRtlLang(s.name, rtlLang) ? <bdi dir="rtl" lang={nameRtlLang(s.name, rtlLang)}>{s.name}</bdi> : s.name}{s.tier ? ` — ${s.tier}` : ''}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="m-0 text-[14px] italic text-ink-mute">{version.subtopicsComplete ? 'The syllabus lists no sub-headings for this topic.' : 'Subtopics for this topic are not listed here yet; check the official document for the full content.'}</p>
            )}
          </li>
        ))}
      </ol>

      {taught && (
        <div class="print:hidden">
          <ResourceTutoringPrompt
            label={`${boardName} ${qualificationName} ${subjectName} (${version.syllabusCode})`}
            trialHref={promptTrialHref}
            formatPhrase={promptFormat}
          />
        </div>
      )}
    </Container>
  </Section>
</BaseLayout>

<style>
  @media print {
    :global(header), :global(footer), :global([data-consent-banner]) { display: none !important; }
  }
</style>
