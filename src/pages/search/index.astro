---
/**
 * v1.x CLOSURE -- site search.
 *
 * Uses Pagefind (https://pagefind.app), a static-search index built from
 * the production HTML after `astro build` via the `postbuild` npm script
 * (`pagefind --site dist --output-subdir pagefind`). Pagefind's own UI
 * bundle is emitted to /pagefind/pagefind-ui.js and /pagefind/pagefind-ui.css
 * at build time -- it does not exist in `astro dev`, only after a real
 * build/preview, which matches how every other static-search integration
 * for Astro works. No third-party search service or API key is involved;
 * everything runs client-side against the generated index.
 *
 * WS1 (AUTHORITY/PRACTICE/TOOLS/GROWTH MEGA PROGRAMME) adds a syllabus/
 * specification-code jump box above the Pagefind widget. It embeds a
 * small (~140-entry) code -> hub-path index built server-side from
 * src/utils/academic/codeIndex.ts (the same deterministic, board-scoped
 * index that generates the /syllabus/<CODE>/ redirect family in
 * public/_redirects) -- NOT the full site content index, so this stays a
 * tiny JSON payload rather than the "giant client-side index" the brief
 * warns against. An exact code match navigates instantly; this is a
 * progressive enhancement on TOP of the real no-JS discovery mechanism,
 * which is typing /syllabus/<CODE>/ directly (a static Cloudflare Pages
 * redirect, no JS or server logic required) -- linked explicitly in the
 * <noscript> fallback below so it's discoverable even without this box.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import { clientCodeIndex } from '../../utils/academic/codeIndex.ts';
import { activeOnly, academicHubPath } from '../../utils/academic';

const codeIndex = clientCodeIndex();
/** D-301 -- every hub by name too (IB hubs have no numeric code), so
 *  "o level physics" or "ib economics" finds the right hub even when
 *  full-text ranking favours pages that repeat the words more often. */
const withCode = new Set(codeIndex.map((e) => e.hubPath));
const hubIndex = [
  ...codeIndex,
  ...activeOnly()
    .map((c) => ({ code: '', hubPath: academicHubPath(c), label: `${c.board} ${c.qualification} ${c.subject}` }))
    .filter((e) => !withCode.has(e.hubPath)),
];
---
{/**
 * QIGT programme -- noindex this page. It has no fixed unique content of
 * its own (Pagefind renders results entirely client-side into an empty
 * div a crawler never populates), so indexing it would only ever surface
 * an empty results shell -- exactly the "search/utility page indexability"
 * problem Section 4 of the brief calls out. The page itself stays fully
 * usable for real visitors; it is simply excluded from search results.
 */}
<BaseLayout title="Search" description="Search Marlbridge for boards, qualifications, subjects, resources and articles." path="/search/" noindex={true}>
  <Section>
    <Container>
      <h1 class="m-0 mb-6 text-[28px] font-semibold text-navy-900">Search Marlbridge</h1>

      <div class="mb-8">
        <label for="syllabus-code-jump" class="mb-2 block text-sm font-medium text-navy-900">
          Looking for a syllabus? Type its code (e.g. 0620) or its name (e.g. O Level Physics).
        </label>
        <div class="relative max-w-sm">
          <input
            id="syllabus-code-jump"
            type="text"
            inputmode="text"
            autocomplete="off"
            placeholder="e.g. 0620, 9701, O Level Physics"
            class="w-full rounded-lg border border-navy-200 px-4 py-2.5 text-navy-900 placeholder:text-navy-400 focus:border-navy-400 focus:outline-none focus:ring-2 focus:ring-navy-100"
            aria-describedby="syllabus-code-jump-hint"
            aria-expanded="false"
            aria-controls="syllabus-code-jump-results"
            role="combobox"
          />
          <ul
            id="syllabus-code-jump-results"
            role="listbox"
            class="absolute z-10 mt-1 hidden w-full overflow-hidden rounded-lg border border-navy-200 bg-white shadow-lg"
          ></ul>
        </div>
        <p id="syllabus-code-jump-hint" class="mt-2 text-sm text-navy-600">
          Every syllabus code also has a direct address you can type or bookmark, e.g.
          <code class="rounded bg-navy-50 px-1.5 py-0.5">marlbridge.com/syllabus/0620/</code> --
          works without JavaScript.
        </p>
      </div>

      <h2 class="m-0 mb-4 text-lg font-semibold text-navy-900">Or search everything</h2>
      <div id="pagefind-search"></div>
      <noscript>
        <p>
          Full-text search requires JavaScript. To find a board, qualification or subject page
          directly, use a syllabus code address like
          <code>marlbridge.com/syllabus/0620/</code>, or use the site navigation.
        </p>
      </noscript>
    </Container>
  </Section>
</BaseLayout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', function () {
    if (typeof PagefindUI === 'undefined') return;
    var ui = new PagefindUI({ element: '#pagefind-search', showSubResults: true, showImages: false });
    // D-335 -- shareable searches: /search/?q=electrolysis runs that search on
    // load, and typing keeps ?q= in the address bar (replaceState, so the
    // back button is not flooded) so the current search can be copied or
    // bookmarked. Pagefind's own UI ignores the query string.
    var initial = '';
    try { initial = (new URLSearchParams(window.location.search).get('q') || '').trim(); } catch (e) { initial = ''; }
    if (initial) ui.triggerSearch(initial.slice(0, 200));
    var syncTimer;
    document.addEventListener('input', function (e) {
      var t = e.target;
      if (!t || !t.classList || !t.classList.contains('pagefind-ui__search-input')) return;
      clearTimeout(syncTimer);
      syncTimer = setTimeout(function () {
        try {
          var url = new URL(window.location.href);
          var v = t.value.trim();
          if (v) url.searchParams.set('q', v); else url.searchParams.delete('q');
          window.history.replaceState(null, '', url.pathname + url.search + url.hash);
        } catch (err) { /* older browsers: leave the URL alone */ }
      }, 400);
    });
    // D-301 -- accessibility: Pagefind's input has only a placeholder, and
    // its result count is not announced. Name the input and make the
    // message a polite live region once Pagefind has rendered them.
    var host = document.getElementById('pagefind-search');
    if (!host) return;
    var apply = function () {
      var field = host.querySelector('.pagefind-ui__search-input');
      if (field && !field.getAttribute('aria-label')) field.setAttribute('aria-label', 'Search Marlbridge resources, subjects and syllabuses');
      var msg = host.querySelector('.pagefind-ui__message');
      if (msg && !msg.getAttribute('aria-live')) {
        msg.setAttribute('role', 'status');
        msg.setAttribute('aria-live', 'polite');
      }
    };
    apply();
    new MutationObserver(apply).observe(host, { childList: true, subtree: true });
  });
</script>

<script type="application/json" id="syllabus-code-index" set:html={JSON.stringify(hubIndex)} />
<script is:inline>
  // D-301 -- keyboard-accessible combobox (WAI-ARIA pattern). Typing no
  // longer navigates away by itself (WCAG 3.2.2): Enter opens the exact
  // match or the highlighted option; Arrow keys move through options;
  // Escape closes the list.
  window.addEventListener('DOMContentLoaded', function () {
    var dataEl = document.getElementById('syllabus-code-index');
    if (!dataEl) return;
    var index;
    try {
      index = JSON.parse(dataEl.textContent);
    } catch (e) {
      return;
    }
    var input = document.getElementById('syllabus-code-jump');
    var results = document.getElementById('syllabus-code-jump-results');
    if (!input || !results) return;
    var matches = [];
    var active = -1;

    function normalize(s) {
      return s.trim().toUpperCase();
    }

    function setActive(i) {
      var items = results.querySelectorAll('[role=option]');
      items.forEach(function (el, n) {
        el.setAttribute('aria-selected', n === i ? 'true' : 'false');
        el.classList.toggle('bg-navy-50', n === i);
      });
      active = i;
      if (i >= 0 && items[i]) input.setAttribute('aria-activedescendant', items[i].id);
      else input.removeAttribute('aria-activedescendant');
    }

    function render(list) {
      matches = list.slice(0, 8);
      results.innerHTML = '';
      active = -1;
      input.removeAttribute('aria-activedescendant');
      if (!matches.length) {
        results.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
        return;
      }
      matches.forEach(function (entry, n) {
        var li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.id = 'syllabus-code-option-' + n;
        li.setAttribute('aria-selected', 'false');
        var a = document.createElement('a');
        a.href = entry.hubPath;
        a.tabIndex = -1;
        a.className = 'block px-4 py-2 text-sm text-navy-900 hover:bg-navy-50 focus:bg-navy-50 focus:outline-none';
        a.textContent = entry.code ? entry.code + ' — ' + entry.label : entry.label;
        li.appendChild(a);
        results.appendChild(li);
      });
      results.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
    }

    input.addEventListener('input', function () {
      var q = normalize(input.value);
      if (!q) {
        render([]);
        return;
      }
      var exact = index.filter(function (e) { return e.code && e.code === q; });
      var rest = index.filter(function (e) { return e.code && e.code !== q && e.code.indexOf(q) === 0; });
      if (!exact.length && !rest.length) {
        // Name search: every word must appear in "<board> <qualification>
        // <subject> <code>"; "o level" / "a level" are matched as phrases.
        var norm = function (t) { return t.toLowerCase().replace(/\b([oa])[\s-]+level/g, '$1-level').replace(/as\s*&\s*a/g, 'a'); };
        var words = norm(q).split(/\s+/).filter(Boolean);
        rest = index.filter(function (e) {
          var hay = norm(e.label + ' ' + e.code);
          return words.every(function (w) { return hay.indexOf(w) !== -1; });
        });
      }
      render(exact.concat(rest));
    });

    input.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (matches.length) setActive(active < matches.length - 1 ? active + 1 : 0);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (matches.length) setActive(active > 0 ? active - 1 : matches.length - 1);
      } else if (e.key === 'Escape') {
        render([]);
      } else if (e.key === 'Enter') {
        var q = normalize(input.value);
        var target = active >= 0 ? matches[active] : index.find(function (x) { return x.code === q; });
        if (target) {
          e.preventDefault();
          window.location.href = target.hubPath;
        }
      }
    });

    document.addEventListener('click', function (e) {
      if (e.target !== input && !results.contains(e.target)) {
        render([]);
      }
    });
  });
</script>
