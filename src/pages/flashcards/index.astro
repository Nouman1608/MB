---
/**
 * D-438 -- /flashcards/: every published flashcard deck. Grows as decks are
 * added to src/data/flashcards/index.ts.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import { FLASHCARD_DECKS, flashcardsPath, topicCardCounts } from '../../data/flashcards';
import { activeOnly } from '../../utils/academic';
import { routes } from '../../utils/urls/routes';

const path = '/flashcards/';
const decks = FLASHCARD_DECKS.flatMap((deck) => {
  const c = activeOnly().find((x) => x.boardSlug === deck.boardSlug && x.qualificationSlug === deck.qualificationSlug && x.subjectSlug === deck.subjectSlug);
  return c ? [{ deck, c, topics: Object.keys(topicCardCounts(deck)).length }] : [];
});
const total = decks.reduce((n, d) => n + d.deck.cards.length, 0);
---
<PageLayout
  title="Free Revision Flashcards by Syllabus"
  description={`Free flashcards written to the official syllabus, one set per topic and subtopic: ${total} cards so far. Study online, track what you know, or print.`}
  path={path}
  eyebrow="Free revision tools"
  heading="Flashcards"
  lead="Short question-and-answer cards for each topic and subtopic of the syllabus. Turn a card, say whether you knew it, and the ones you missed come back until you have them."
  breadcrumbs={[
    { label: 'Home', href: routes.home },
    { label: 'Flashcards', href: path },
  ]}
>
  <Section surface="white" spacing="md">
    <Container>
      <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {decks.map(({ deck, c, topics }) => (
          <li class="m-0">
            <a href={flashcardsPath(deck)} class="block h-full rounded-sm border border-rule bg-white p-5 no-underline hover:border-teal-500">
              <span class="mb-label text-teal-700">{c.board} {c.qualification} · {deck.syllabusCode}</span>
              <span class="mt-1 block text-[18px] font-semibold text-navy-800">{c.subject}</span>
              <span class="mt-1 block text-[14.5px] text-ink-mute">{deck.cards.length} cards across {topics} topics · {deck.syllabusSeries}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="m-0 mt-8 max-w-[70ch] text-[14.5px] leading-[1.6] text-ink-mute">More courses are being added. For any course without flashcards yet, the <a href="/checklists/" class="underline decoration-teal-500 underline-offset-2">printable topic checklists</a> and <a href="/practice/" class="underline decoration-teal-500 underline-offset-2">self-check practice questions</a> cover the same syllabus.</p>
    </Container>
  </Section>
</PageLayout>
