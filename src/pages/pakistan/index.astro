---
/**
 * Pakistan regional guidance -- /pakistan/
 *
 * v2.0 AUTHORITY/PRACTICE/TOOLS/GROWTH MEGA PROGRAMME WS17.
 *
 * Pakistan is Marlbridge's home market: the only region with live,
 * in-person teaching (via Learners Academy) as well as online tuition,
 * the only region with a confirmed IB rate, and every board Marlbridge
 * teaches is available here. This page is deliberately NOT a re-listing
 * of the full multi-region pricing table already on /pricing/ -- it
 * pulls only the Pakistan-specific rows from the same typed data (no new
 * numbers invented here) and focuses on what a Pakistan-based visitor
 * actually needs to decide: which boards are available, what delivery
 * modes exist, and how to start a free trial. Board descriptions are
 * deliberately kept to one line each with a link through to /boards/
 * rather than repeated in full, to avoid duplicating that page's content.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import CTA from '../../components/ui/CTA.astro';
import FAQ from '../../components/ui/FAQ.astro';
import { faqNode } from '../../utils/schema/faq';
import { activeOnly, taughtOnly } from '../../utils/academic';
import { site } from '../../data/site';
import { routes } from '../../utils/urls/routes';
import { BOARDS } from '../../data/academic/boards';
import {
  REGION_PRICING, ONE_TO_ONE_PRICING, ONE_TO_ONE_TERMS, IB_PRICING,
  PRICING_TERMS, PRICING_VERIFIED_DATE, formatFee,
} from '../../data/pricing';
import { hubIsTaught, RESOURCES_ONLY_SUFFIX } from '../../data/markets';

/**
 * D-303: the Cambridge-board hub pages searchers located in Pakistan found
 * most often (Google Search Console, Performance, last 3 months, exported
 * 2026-09-23). Evidence of demand, not a ranking claim.
 */
const PK_SEARCHED_HUBS = [
  { path: '/boards/cambridge/o-level/pakistan-studies/', label: 'Cambridge O Level Pakistan Studies' },
  { path: '/boards/cambridge/igcse/global-perspectives/', label: 'Cambridge IGCSE Global Perspectives' },
  { path: '/boards/cambridge/o-level/english-language/', label: 'Cambridge O Level English Language' },
  { path: '/boards/cambridge/a-level/english-language/', label: 'Cambridge A Level English Language' },
  { path: '/boards/cambridge/o-level/urdu-language/', label: 'Cambridge O Level Urdu Language' },
];

const path = '/pakistan/';
const pkGroup = REGION_PRICING.find((r) => r.region === 'Pakistan')!;
const pkOneToOne = ONE_TO_ONE_PRICING.find((r) => r.region === 'Pakistan')!;
const offeredBoards = BOARDS.filter((b) => b.status === 'offered');

/**
 * D-286 -- how to study with Marlbridge in Pakistan and the questions
 * Pakistani families ask, from facts already held here: the academy's
 * address (site.about, owner-confirmed 2026-09-21), pricing.ts, the matrix.
 */
const published = activeOnly().length;
const taught = taughtOnly().length;
const faqs = [
  {
    question: 'Where is the academy?',
    answer: `In-person classes are at the academy: ${site.about.address}. Students elsewhere in Pakistan are taught live online.`,
  },
  {
    question: 'Can I study online from another city in Pakistan?',
    answer: 'Yes. Online classes are live and priced the same as in person. Class times are agreed with you before the first class.',
  },
  {
    question: 'How do I pay, and when?',
    answer: `Payment is by ${PRICING_TERMS.paymentMethods.join(' or ')}. ${PRICING_TERMS.billing} ${PRICING_TERMS.enrolmentFee}`,
  },
  {
    question: 'Are there discounts for more than one subject or for siblings?',
    answer: `Yes, for group classes: ${PRICING_TERMS.multiSubjectDiscount.percentOff}% off for ${PRICING_TERMS.multiSubjectDiscount.minSubjects} or more subjects, and ${PRICING_TERMS.siblingDiscount.percentOff}% off for up to ${PRICING_TERMS.siblingDiscount.maxSiblings} siblings enrolled at the same time. They can combine; the full terms are on the pricing page.`,
  },
  {
    question: 'Do you offer classes in every subject listed on this site?',
    answer: `Classes are offered in ${taught} of the ${published} published combinations; the others have free study resources only, and each syllabus page says which.`,
  },
];
const jsonLd = [faqNode(faqs)].filter(Boolean) as Record<string, unknown>[];
---
<PageLayout
  title="Marlbridge in Pakistan — Boards, Pricing & Free Trial"
  description="O Level, IGCSE, A Level and IB tuition in Pakistan: in person at our Lahore academy or live online, with group and one-to-one fees in PKR, the boards taught and how to book a free trial class."
  path={path}
  eyebrow="Pakistan"
  heading="Marlbridge in Pakistan"
  lead="Marlbridge is the international branch of Learners Academy in Lahore. Students in Pakistan can be taught in person at the academy or live online, in group or one-to-one classes. IB is taught one-to-one only, OCR is not offered by Learners Academy directly, and SAT preparation is not yet offered."
  breadcrumbs={[{ label: 'Home', href: routes.home }, { label: 'International tutoring', href: '/international-tutoring/' }, { label: 'Pakistan', href: path }]}
  jsonLd={jsonLd}
>
  <Section surface="ivory">
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Where classes are taught</h2>
      <p class="m-0 max-w-[70ch] text-[14.5px] leading-[1.65] text-ink">
        {site.about.address
          ? <>In-person classes are taught at the Learners Academy campus, {site.about.address}.</>
          : <>In-person classes are taught at the Learners Academy campus in Lahore.</>}
        {' '}Students elsewhere in Pakistan join the same teachers live online, and class times are agreed with you before the first class. Most Cambridge syllabuses are examined in
        the June and November series, and some in June only; each syllabus page states its series.
        {' '}Students outside Pakistan: see <a href="/international-tutoring/" class="underline decoration-gold-500 underline-offset-2 hover:text-gold-600">international online tutoring</a>.
      </p>
    </Container>
  </Section>

  <Section surface="white">
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Boards and qualifications taught</h2>
      <p class="m-0 mb-6 max-w-[70ch] text-[14.5px] leading-[1.65] text-ink-mute">
        Every board Marlbridge teaches is available to students in Pakistan. Not every subject with free resources has
        classes at the moment: each board's page shows which qualifications and subjects are taught, and the syllabus codes.
      </p>
      <ul class="m-0 grid gap-3 p-0 sm:grid-cols-2" style="list-style: none;">
        {offeredBoards.map((b) => (
          <li class="rounded-sm border border-rule bg-ivory p-4">
            <a href={`/boards/${b.slug}/`} class="text-[15.5px] font-semibold text-navy-800 underline decoration-gold-500 underline-offset-2 hover:text-gold-600">{b.name}</a>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section surface="ivory" border>
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Pricing for Pakistan</h2>
      <p class="m-0 mb-6 max-w-[70ch] text-[14.5px] leading-[1.65] text-ink-mute">
        Three delivery formats are available in Pakistan -- group classes (per subject, per month), one-to-one classes (per
        class), and IB tuition, which is priced differently again and confirmed for Pakistan only. Full terms, discounts and
        every other region's rate are on the {' '}<a href={routes.pricing} class="underline decoration-gold-500 underline-offset-2 hover:text-gold-600">pricing page</a>.
      </p>

      <div class="grid gap-5 sm:grid-cols-3">
        <div class="rounded-sm border border-rule bg-white p-[clamp(20px,2vw,26px)]">
          <p class="m-0 mb-1 text-[13px] font-medium uppercase tracking-[0.08em] text-gold-600">Group classes</p>
          <p class="m-0 mt-2 text-[15px] text-navy-800">
            {formatFee(pkGroup.igcse, pkGroup.currency)} {pkGroup.currency} <span class="text-[13px] text-ink-mute">/subject/month — GCSE / IGCSE / O Level</span>
          </p>
          <p class="m-0 mt-2 text-[15px] text-navy-800">
            {formatFee(pkGroup.aLevel, pkGroup.currency)} {pkGroup.currency} <span class="text-[13px] text-ink-mute">/subject/month — AS / A Level</span>
          </p>
          <p class="m-0 mt-3 text-[13px] text-ink-mute">{PRICING_TERMS.classFormat.group}</p>
        </div>
        <div class="rounded-sm border border-rule bg-white p-[clamp(20px,2vw,26px)]">
          <p class="m-0 mb-1 text-[13px] font-medium uppercase tracking-[0.08em] text-gold-600">One-to-one classes</p>
          <p class="m-0 mt-2 text-[15px] text-navy-800">
            {formatFee(pkOneToOne.igcse, pkOneToOne.currency)} {pkOneToOne.currency} <span class="text-[13px] text-ink-mute">/class — GCSE / IGCSE / O Level</span>
          </p>
          <p class="m-0 mt-2 text-[15px] text-navy-800">
            {formatFee(pkOneToOne.aLevel, pkOneToOne.currency)} {pkOneToOne.currency} <span class="text-[13px] text-ink-mute">/class — AS / A Level</span>
          </p>
          <p class="m-0 mt-3 text-[13px] text-ink-mute">{PRICING_TERMS.classFormat.oneToOne}</p>
        </div>
        <div class="rounded-sm border border-rule bg-white p-[clamp(20px,2vw,26px)]">
          <p class="m-0 mb-1 text-[13px] font-medium uppercase tracking-[0.08em] text-gold-600">IB tuition</p>
          <p class="m-0 mt-2 text-[15px] text-navy-800">
            {IB_PRICING.perClass.toLocaleString('en-US')} {IB_PRICING.currency} <span class="text-[13px] text-ink-mute">{IB_PRICING.unit}</span>
          </p>
          <p class="m-0 mt-3 text-[13px] text-ink-mute">{IB_PRICING.deliveryMode} Confirmed for Pakistan only.</p>
        </div>
      </div>

      <p class="m-0 mt-6 text-[13px] text-ink-mute">
        {PRICING_TERMS.freeTrial} {PRICING_TERMS.notPermanentNote} Last confirmed {PRICING_VERIFIED_DATE} (one-to-one rates {ONE_TO_ONE_TERMS.verifiedDate}).
      </p>
    </Container>
  </Section>

  <Section surface="white" border>
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Syllabus pages students in Pakistan look up most</h2>
      <p class="m-0 mb-4 max-w-[70ch] text-[14.5px] leading-[1.65] text-ink-mute">
        Taken from Marlbridge's own Google Search Console data for searches made in Pakistan over the last three months.
        Each page names the syllabus code, the current and upcoming exam years, and links to a free checklist.
      </p>
      <ul class="m-0 grid gap-2 p-0 sm:grid-cols-2" style="list-style: none;">
        {PK_SEARCHED_HUBS.map((h) => (
          <li><a href={h.path} class="text-[15px] text-navy-800 underline decoration-gold-500 underline-offset-2 hover:text-gold-600">{h.label}</a>{hubIsTaught(h.path) ? '' : <span class="text-[13px] text-ink-mute">{RESOURCES_ONLY_SUFFIX}</span>}</li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section surface="ivory" border>
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">What Marlbridge does not cover</h2>
      <p class="m-0 max-w-[70ch] text-[14.5px] leading-[1.65] text-ink-mute">
        Marlbridge teaches the six international boards listed above -- it does not currently offer tuition for Pakistan's
        own Matriculation, Federal Board (FBISE) or provincial-board examinations. If your child is studying toward one of
        those, this site and its pricing do not apply to that route. If you're unsure which category your school's exams
        fall into, {' '}<a href={routes.contact} class="underline decoration-gold-500 underline-offset-2 hover:text-gold-600">get in touch</a> and we'll clarify honestly rather than guess.
      </p>
    </Container>
  </Section>

  <Section surface="ivory" border>
    <Container>
      <h2 class="m-0 mb-5 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Questions from families in Pakistan</h2>
      <FAQ items={faqs} id="pakistan-faqs" />
    </Container>
  </Section>

  <CTA
    surface="ivory"
    heading="Ready to see how a class works? Request a free trial and we'll confirm a teacher and a time by email."
    buttonLabel="Request a Free Trial"
    buttonHref={`${routes.trial}?source=region`}
  />
</PageLayout>
