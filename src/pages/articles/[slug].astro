---
import { getEntry, render, type CollectionEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import ArticleMeta from '../../components/articles/ArticleMeta.astro';
import TableOfContents from '../../components/articles/TableOfContents.astro';
import ShareLinks from '../../components/articles/ShareLinks.astro';
import ResourceCard from '../../components/cards/ResourceCard.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import RelatedGrid from '../../components/layout/RelatedGrid.astro';
import { getArticles, readingTime, formatDate } from '../../utils/content/collections';
import { relatedArticles, relatedResources } from '../../utils/content/related';
import { articleNode } from '../../utils/schema/article';
import { routes } from '../../utils/urls/routes';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
const d = article.data;
const { Content, headings } = await render(article);
const path = routes.article(article.id);

const author = await getEntry(d.author);
const subjects = (await Promise.all(d.subjects.map((ref) => getEntry(ref)))).filter(Boolean);
const primarySubjectId = d.subjects[0]?.id;
const minutes = readingTime(article.body ?? '');

/** QIGT programme -- see the matching block in resources/[slug].astro for full rationale. */
const reviewerEntry = d.reviewer ? await getEntry(d.reviewer) : undefined;
const genuinelyReviewed = d.reviewStatus === 'reviewed' && !!reviewerEntry && reviewerEntry.data.isReviewer === true;
const pageNoindex = d.noindex || d.reviewStatus === 'archived';
const alsoArticles = await relatedArticles({ subject: primarySubjectId, category: d.category, picked: d.relatedArticles, excludeId: article.id, limit: 3 });
const alsoResources = await relatedResources({ subject: primarySubjectId, picked: d.relatedResources, limit: 3 });

const jsonLd = [articleNode({
  path,
  headline: d.title,
  description: d.excerpt,
  published: d.publishedDate,
  updated: d.updatedDate,
  authorName: author?.data.name ?? 'Marlbridge Academic Team',
  authorEntityType: author?.data.entityType ?? 'organization',
  ...(genuinelyReviewed
    ? { editorName: reviewerEntry!.data.name, editorEntityType: reviewerEntry!.data.entityType }
    : {}),
})];
---
<PageLayout
  title={d.seoTitle ?? d.title}
  description={d.seoDescription ?? d.excerpt}
  path={path}
  eyebrow={d.category.replace(/-/g, ' ')}
  heading={d.title}
  lead={d.excerpt}
  headingFont="display"
  type="article"
  publishedDate={d.publishedDate}
  updatedDate={d.updatedDate}
  author={author?.data.name}
  breadcrumbs={[
    { label: 'Home', href: routes.home },
    { label: 'Learning Journal', href: routes.articles },
    { label: d.title, href: path },
  ]}
  jsonLd={jsonLd}
  noindex={pageNoindex}
>
  {/* QIGT search workstream (Aug 2026) -- Pagefind filter tag, matching the
      pattern on the resources template. "Article" distinguishes this
      content type from resources in filtered search results; hidden since
      it adds no new visible claim beyond what "Learning Journal" in the
      breadcrumb already conveys. */}
  <div hidden aria-hidden="true">
    <span data-pagefind-filter="Resource type:Article"></span>
  </div>

  <Section surface="white">
    <Container width="prose">
      <ArticleMeta authorName={author?.data.name ?? 'Marlbridge Academic Team'} published={d.publishedDate} updated={d.updatedDate} minutes={minutes} />
      <div class="mt-8"><TableOfContents headings={headings} /></div>
      <div class="text-[17.5px] leading-[1.75] [&>h2]:mt-10 [&>h2]:text-[26px] [&>h2]:font-semibold [&>h2]:text-navy-800 [&>h3]:mt-8 [&>h3]:text-[20px] [&>h3]:font-semibold [&>p]:mt-5 [&>ul]:mt-5 [&>ul]:ps-5 [&>ol]:mt-5 [&>ol]:ps-5 [&>ol>li]:mt-2 [&>ul>li]:mt-2">
        <Content />
      </div>
      <ShareLinks path={path} title={d.title} />

      {author && (
        <aside aria-label="About the author" class="mt-10 rounded-sm border border-rule bg-ivory p-6">
          <p class="m-0 font-mono text-[11px] uppercase tracking-[0.14em] text-gold-600">Written by</p>
          <a href={routes.author(author.id)} class="mt-2 block text-[18px] font-semibold text-navy-800 underline decoration-gold-500 underline-offset-2">{author.data.name}</a>
          <p class="m-0 mt-1 text-[14px] text-ink-mute">{author.data.role}</p>
          <p class="m-0 mt-3 text-[16px] leading-[1.65] text-ink-mute">{author.data.bio}</p>
          {genuinelyReviewed && (
            <p class="m-0 mt-4 border-t border-rule pt-4 text-[14px] text-ink-mute">
              Reviewed by <a href={routes.author(reviewerEntry!.id)} class="font-medium text-navy-800 underline decoration-gold-500 underline-offset-2">{reviewerEntry!.data.name}</a>
              {d.reviewedDate && <> on <time datetime={d.reviewedDate.toISOString()}>{formatDate(d.reviewedDate)}</time></>}
            </p>
          )}
        </aside>
      )}

      {subjects.length > 0 && (
        <p class="mt-8 text-[15.5px] text-ink-mute">
          More on {subjects.length === 1 ? 'this subject' : 'these subjects'}:{' '}
          {subjects.map((subject, i) => (
            <>
              <a href={routes.subject(subject!.id)} data-pagefind-filter="Subject" class="underline decoration-gold-500 underline-offset-2">{subject!.data.title}</a>
              {i < subjects.length - 1 ? ', ' : ''}
            </>
          ))}
        </p>
      )}
    </Container>

    <Container>
      {alsoArticles.length > 0 && (
        <RelatedGrid id="also-articles" title="Related articles">
          {alsoArticles.map((a) => <li class="m-0"><ArticleCard entry={a} /></li>)}
        </RelatedGrid>
      )}
      {alsoResources.length > 0 && (
        <RelatedGrid id="also-resources" title="Related resources">
          {alsoResources.map((r) => <li class="m-0"><ResourceCard entry={r} /></li>)}
        </RelatedGrid>
      )}
    </Container>
  </Section>
</PageLayout>
