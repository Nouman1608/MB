---
import LocaleLayout from '../../layouts/LocaleLayout.astro';
import { LOCALE_COPY, pricingRows } from '../../i18n/copy';

const copy = LOCALE_COPY['ar'];
---
<LocaleLayout copy={copy} path="/ar/">
  <section class="px-[var(--spacing-gutter)] py-16">
    <div class="mx-auto max-w-[var(--container-site)] text-center">
      <p class="m-0 mb-3 text-[13px] font-semibold uppercase tracking-[0.16em] text-gold-600">{copy.eyebrow}</p>
      <h1 class="m-0 mb-5 text-[clamp(28px,4vw,44px)] font-semibold leading-[1.15] text-navy-900">{copy.h1}</h1>
      <p class="mx-auto m-0 mb-8 max-w-[62ch] text-[17px] leading-relaxed text-ink-mute">{copy.subhead}</p>
      <a href="/contact/" class="inline-flex min-h-11 items-center justify-center rounded-sm bg-navy-800 px-7 py-3.5 text-[15px] font-medium text-ivory hover:bg-navy-700">{copy.ctaContact}</a>
    </div>
  </section>

  <section class="border-t border-navy-rule px-[var(--spacing-gutter)] py-14">
    <div class="mx-auto grid max-w-[var(--container-site)] gap-8 sm:grid-cols-3">
      {copy.pillars.map((p) => (
        <div>
          <h2 class="m-0 mb-2 text-[18px] font-semibold text-navy-900">{p.title}</h2>
          <p class="m-0 text-[15px] leading-relaxed text-ink-mute">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-navy-rule bg-[#F7F4EE] px-[var(--spacing-gutter)] py-14">
    <div class="mx-auto max-w-[var(--container-site)]">
      <h2 class="m-0 mb-2 text-[26px] font-semibold text-navy-900">{copy.pricingHeading}</h2>
      <p class="m-0 mb-6 text-[15px] text-ink-mute">{copy.pricingNote}</p>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-[14.5px]">
          <thead>
            <tr class="border-b border-navy-rule text-start">
              <th class="px-3 py-2 text-start font-semibold text-navy-900">{copy.tableHeaders.region}</th>
              <th class="px-3 py-2 text-start font-semibold text-navy-900">{copy.tableHeaders.currency}</th>
              <th class="px-3 py-2 text-start font-semibold text-navy-900">{copy.tableHeaders.igcse}</th>
              <th class="px-3 py-2 text-start font-semibold text-navy-900">{copy.tableHeaders.aLevel}</th>
            </tr>
          </thead>
          <tbody>
            {pricingRows.map((r) => (
              <tr class="border-b border-[#E7E1D4]">
                <td class="px-3 py-2 text-ink-mute">{r.region}</td>
                <td class="px-3 py-2 text-ink-mute">{r.currency}</td>
                <td class="px-3 py-2 text-ink-mute">{r.igcse}</td>
                <td class="px-3 py-2 text-ink-mute">{r.aLevel}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="m-0 mt-6 text-[13.5px] text-ink-mute">{copy.termsNote}</p>
    </div>
  </section>

  <section class="border-t border-navy-rule px-[var(--spacing-gutter)] py-16 text-center">
    <div class="mx-auto max-w-[60ch]">
      <h2 class="m-0 mb-3 text-[24px] font-semibold text-navy-900">{copy.contactHeading}</h2>
      <p class="m-0 mb-6 text-[15px] leading-relaxed text-ink-mute">{copy.contactBody}</p>
      <a href="/contact/" class="inline-flex min-h-11 items-center justify-center rounded-sm bg-gold-500 px-7 py-3.5 text-[15px] font-medium text-navy-900 hover:opacity-90">{copy.contactButton}</a>
    </div>
  </section>
</LocaleLayout>
