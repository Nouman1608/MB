---
/**
 * Gulf regional guidance -- /gulf/
 *
 * v2.0 AUTHORITY/PRACTICE/TOOLS/GROWTH MEGA PROGRAMME WS18.
 *
 * All Marlbridge teaching is delivered live from Pakistan; for the six
 * Gulf countries with a confirmed rate (Saudi Arabia, UAE, Qatar, Kuwait,
 * Bahrain, Oman) that means fully online tuition. This page pulls only
 * those six rows from the same typed pricing data already on /pricing/
 * (no new numbers invented here) and adds the one piece of regional
 * context that page doesn't cover: how Pakistan Standard Time lines up
 * against Gulf time zones, which is what actually determines whether live
 * online classes are practical for a family in the Gulf.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import CTA from '../../components/ui/CTA.astro';
import FAQ from '../../components/ui/FAQ.astro';
import { faqNode } from '../../utils/schema/faq';
import { activeOnly, taughtOnly } from '../../utils/academic';
import { site } from '../../data/site';
import { routes } from '../../utils/urls/routes';
import { BOARDS } from '../../data/academic/boards';
import {
  REGION_PRICING, ONE_TO_ONE_PRICING, ONE_TO_ONE_TERMS,
  PRICING_TERMS, PRICING_VERIFIED_DATE, formatFee, INDICATIVE_NOTE, ibConversionFor,
} from '../../data/pricing';

const path = '/gulf/';
// D-303: the UAE and Qatar have their own country pages (owner choice,
// 23 Sep 2026); the other four Gulf countries stay on this regional page.
const COUNTRY_PAGES: Record<string, string> = { 'United Arab Emirates': '/uae/', 'Qatar': '/qatar/' };
const GULF_REGIONS = ['Saudi Arabia', 'United Arab Emirates', 'Qatar', 'Kuwait', 'Bahrain', 'Oman'];
const gulfGroup = REGION_PRICING.filter((r) => GULF_REGIONS.includes(r.region));
const gulfOneToOne = ONE_TO_ONE_PRICING.filter((r) => GULF_REGIONS.includes(r.region));
const offeredBoards = BOARDS.filter((b) => b.status === 'offered');

/**
 * D-286 -- Gulf-specific parent questions, answered only from facts already
 * held in this repository (pricing.ts, site.ts, the matrix). Marlbridge has
 * no office or teaching centre in the Gulf; the only in-person teaching is
 * at the academy in Lahore (site.about.address, owner-confirmed 2026-09-21).
 */
const published = activeOnly().length;
const taught = taughtOnly().length;
const uae = gulfGroup.find((g) => g.region === 'United Arab Emirates')!;
const faqs = [
  {
    question: 'Do you have a centre or office in the Gulf?',
    answer: `No. Marlbridge has no office or teaching centre in the Gulf. Students in the Gulf are taught live online. The only in-person teaching is at the academy in ${site.about.city}, ${site.about.country}.`,
  },
  {
    question: 'What time would classes be in the Gulf?',
    answer: 'Class times are agreed with you before the first class, in your own time zone. For orientation: Pakistan is one hour ahead of the UAE and Oman, and two hours ahead of Saudi Arabia, Qatar, Kuwait and Bahrain, so a 6:00 pm class in Dubai is 7:00 pm in Pakistan, and a 6:00 pm class in Riyadh is 8:00 pm in Pakistan.',
  },
  {
    question: 'Which currency are fees in, and how do I pay?',
    answer: `Group fees are set in each country's own currency, as in the table on this page (for example ${formatFee(uae.igcse, uae.currency)} ${uae.currency} per subject per month for IGCSE in the UAE). One-to-one rates are currency conversions of the Pakistan rate. Payment is by ${PRICING_TERMS.paymentMethods.join(' or ')}. ${PRICING_TERMS.billing}`,
  },
  {
    question: 'Do you teach the curriculum my school follows?',
    answer: `Marlbridge publishes ${published} board, qualification and subject combinations (Cambridge, Pearson Edexcel, AQA, OxfordAQA, OCR and IB) and offers classes in ${taught} of them; the others have free study resources only, and each syllabus page says which. Choose your board on the trial form, or "Not sure" and we will check with you.`,
  },
  {
    question: 'How quickly will you reply?',
    answer: `${PRICING_TERMS.enquiryResponse.summary} ${PRICING_TERMS.freeTrial}`,
  },
];
const jsonLd = [faqNode(faqs)].filter(Boolean) as Record<string, unknown>[];

/**
 * Standard UTC offsets (no daylight-saving observed in any of these seven
 * countries), stated for orientation only -- not a claim about exact class
 * scheduling, which is confirmed directly with a teacher after enrolling.
 */
const TIME_ZONES: Record<string, string> = {
  'Pakistan': 'UTC+5 (Pakistan Standard Time)',
  'Saudi Arabia': 'UTC+3 (Arabia Standard Time)',
  'Qatar': 'UTC+3 (Arabia Standard Time)',
  'Kuwait': 'UTC+3 (Arabia Standard Time)',
  'Bahrain': 'UTC+3 (Arabia Standard Time)',
  'United Arab Emirates': 'UTC+4 (Gulf Standard Time)',
  'Oman': 'UTC+4 (Gulf Standard Time)',
};
---
<PageLayout
  title="Marlbridge in the Gulf — Online Tuition, Pricing & Time Zones"
  description="Live online Cambridge, Pearson Edexcel, AQA, OxfordAQA, OCR and IB tuition from Lahore for students in Saudi Arabia, the UAE, Qatar, Kuwait, Bahrain and Oman: set group fees, indicative one-to-one fees and time zones."
  path={path}
  eyebrow="Gulf"
  heading="Marlbridge in the Gulf"
  lead="Every Marlbridge class is taught live online from our academy in Lahore, Pakistan. There is no Marlbridge office or teacher in the Gulf. Group fees are set for six Gulf countries, and the time difference is only one to two hours."
  breadcrumbs={[{ label: 'Home', href: routes.home }, { label: 'International tutoring', href: '/international-tutoring/' }, { label: 'Gulf', href: path }]}
  jsonLd={jsonLd}
>
  <Section surface="ivory">
    <Container>
      <p class="m-0 max-w-[70ch] text-[14.5px] leading-[1.65] text-ink">
        Families in the United Arab Emirates and Qatar have their own pages, with local class times, the syllabus pages
        searched most from each country, and what Marlbridge does not teach:
        {' '}<a href="/uae/" class="font-semibold text-navy-800 underline decoration-gold-500 underline-offset-2 hover:text-gold-600">online tutoring for the UAE</a>
        {' '}and{' '}
        <a href="/qatar/" class="font-semibold text-navy-800 underline decoration-gold-500 underline-offset-2 hover:text-gold-600">online tutoring for Qatar</a>.
        Other countries are covered on the
        {' '}<a href="/international-tutoring/" class="underline decoration-gold-500 underline-offset-2 hover:text-gold-600">international tutoring page</a>.
      </p>
    </Container>
  </Section>

  <Section surface="white">
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Boards and qualifications taught</h2>
      <p class="m-0 mb-6 max-w-[70ch] text-[14.5px] leading-[1.65] text-ink-mute">
        Students in the Gulf get the same catalogue as anywhere else, taught live online: classes are offered in {taught} of the {published}
        published board, qualification and subject combinations, and the rest have free study resources only. Each board's page lists its
        qualifications, subjects and syllabus codes, and each syllabus page says whether classes are offered.
      </p>
      <ul class="m-0 grid gap-3 p-0 sm:grid-cols-2" style="list-style: none;">
        {offeredBoards.map((b) => (
          <li class="rounded-sm border border-rule bg-ivory p-4">
            <a href={`/boards/${b.slug}/`} class="text-[15.5px] font-semibold text-navy-800 underline decoration-gold-500 underline-offset-2 hover:text-gold-600">{b.name}</a>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section surface="ivory" border>
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Time zones — why live online classes work from Pakistan</h2>
      <p class="m-0 mb-6 max-w-[70ch] text-[14.5px] leading-[1.65] text-ink-mute">
        Pakistan sits only one hour ahead of the UAE and Oman, and two hours ahead of Saudi Arabia, Qatar, Kuwait and Bahrain --
        close enough that a class held in the evening, Pakistan time, still lands at a reasonable after-school hour for a
        student in the Gulf. This is orientation only. {PRICING_TERMS.groupClassTimes} One-to-one classes can be arranged at any time.
      </p>
      <div class="overflow-x-auto" tabindex="0" role="group" aria-label="Table, scrolls sideways on small screens">
        <table class="w-full min-w-[420px] border-collapse text-[14px]">
          <thead>
            <tr class="border-b border-rule text-left">
              <th scope="col" class="py-2 pr-4 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Country</th>
              <th scope="col" class="py-2 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Standard time zone</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-rule bg-white/60">
              <td class="py-2 pr-4 font-medium text-navy-800">Pakistan (where classes are taught from)</td>
              <td class="py-2 text-ink-mute">{TIME_ZONES['Pakistan']}</td>
            </tr>
            {GULF_REGIONS.map((r) => (
              <tr class="border-b border-rule">
                <td class="py-2 pr-4 text-ink">{r}</td>
                <td class="py-2 text-ink-mute">{TIME_ZONES[r]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Container>
  </Section>

  <Section surface="white" border>
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Pricing for the Gulf</h2>
      <p class="m-0 mb-6 max-w-[70ch] text-[14.5px] leading-[1.65] text-ink-mute">
        Group classes are priced per subject, per month; one-to-one classes are priced per class. The group rates below
        are set for each of these six countries. The one-to-one rates are different: they are currency conversions of the
        Pakistan one-to-one rate (see the note below), not separately set regional rates. Full terms, discounts and every other region are on the
        {' '}<a href={routes.pricing} class="underline decoration-gold-500 underline-offset-2 hover:text-gold-600">pricing page</a>.
      </p>

      <div class="overflow-x-auto" tabindex="0" role="group" aria-label="Table, scrolls sideways on small screens">
        <table class="w-full min-w-[680px] border-collapse text-[15px]">
          <thead>
            <tr class="border-b border-rule text-left">
              <th scope="col" class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Country</th>
              <th scope="col" class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Group — GCSE/IGCSE/O Level</th>
              <th scope="col" class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Group — AS/A Level</th>
              <th scope="col" class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">One-to-one (per class)</th>
              <th scope="col" class="py-3 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">IB (per 1-hour class)</th>
            </tr>
          </thead>
          <tbody>
            {gulfGroup.map((g) => {
              const o = gulfOneToOne.find((x) => x.region === g.region)!;
              return (
                <tr class="border-b border-rule">
                  <td class="py-3 pr-4 text-ink">{COUNTRY_PAGES[g.region] ? <a href={COUNTRY_PAGES[g.region]} class="underline decoration-gold-500 underline-offset-2 hover:text-gold-600">{g.region}</a> : g.region}</td>
                  <td class="py-3 pr-4 text-ink-mute">{formatFee(g.igcse, g.currency)} {g.currency} <span class="text-[13px]">/mo</span></td>
                  <td class="py-3 pr-4 text-ink-mute">{formatFee(g.aLevel, g.currency)} {g.currency} <span class="text-[13px]">/mo</span></td>
                  <td class="py-3 pr-4 text-ink-mute">{formatFee(o.igcse, o.currency)}–{formatFee(o.aLevel, o.currency)} {o.currency} <span class="text-[12px]">(indicative)</span></td>
                  <td class="py-3 text-ink-mute">{(() => { const ib = ibConversionFor(g.region); return ib ? <>{formatFee(ib.perClass, ib.currency)} {ib.currency} <span class="text-[12px]">(indicative)</span></> : 'On enquiry'; })()}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <p class="m-0 mt-6 text-[13px] text-ink-mute">
        One-to-one rates: {INDICATIVE_NOTE} {ONE_TO_ONE_TERMS.conversionNote} {PRICING_TERMS.freeTrial} {PRICING_TERMS.notPermanentNote} Last confirmed
        {' '}{PRICING_VERIFIED_DATE} (one-to-one rates {ONE_TO_ONE_TERMS.verifiedDate}).
      </p>
    </Container>
  </Section>

  <Section surface="ivory" border>
    <Container>
      <h2 class="m-0 mb-6 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Questions from Gulf families</h2>
      <FAQ items={faqs} id="gulf-faqs" />
    </Container>
  </Section>

  <CTA
    surface="ivory"
    heading="Ready to try a live online class from wherever you are in the Gulf? Request a free trial and we'll confirm a teacher and a time by email."
    buttonLabel="Request a Free Trial"
    buttonHref={`${routes.trial}?source=region`}
  />
</PageLayout>
