---
import { getEntry, render, type CollectionEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import CTA from '../../components/ui/CTA.astro';
import ResourceCard from '../../components/cards/ResourceCard.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import RelatedGrid from '../../components/layout/RelatedGrid.astro';
import { getResources, resourceCategoryMeta, formatDate, resourceLevelLabel } from '../../utils/content/collections';
import { boardBySlug } from '../../data/academic/boards';
import { qualificationBySlug } from '../../data/academic/qualifications';
import { relatedResources, relatedArticles, topicSiblings } from '../../utils/content/related';
import { articleNode } from '../../utils/schema/article';
import { routes, resourceUrl } from '../../utils/urls/routes';
import { syllabusFor } from '../../data/academic/syllabuses';

export async function getStaticPaths() {
  const resources = await getResources();
  return resources.map((resource) => ({ params: { slug: resource.id }, props: { resource } }));
}

interface Props { resource: CollectionEntry<'resources'> }
const { resource } = Astro.props;
const d = resource.data;
const { Content } = await render(resource);
const path = resourceUrl(resource);

const subject = await getEntry(d.subject);
const author = d.author ? await getEntry(d.author) : undefined;
const meta = resourceCategoryMeta[d.resourceType];
const levels = resourceLevelLabel(d.level, d.stage);

/**
 * QIGT search workstream (Aug 2026) -- Pagefind filter values. Board and
 * qualification are not otherwise displayed as their own labelled fields
 * on this page (only "Level", a combined display string, is), so these
 * are captured via a visually hidden block rather than invented as new
 * visible UI on every one of 731 resource pages. Values are the same
 * board/qualification names already shown everywhere else on the site
 * (board hub pages, /boards/, /levels/) -- nothing new is claimed, this
 * only makes the existing, real tagging searchable. See
 * src/pages/search/index.astro for the default Pagefind UI, which
 * auto-renders filter checkboxes for any data-pagefind-filter value found.
 */
const boardNames = d.boards.map((slug) => boardBySlug(slug)?.name).filter((n): n is string => Boolean(n));
const qualificationNames = d.qualifications.map((slug) => qualificationBySlug(slug)?.name).filter((n): n is string => Boolean(n));

/**
 * Flagship Dominance/Trust programme -- best-effort official specification
 * link(s), looked up from the SAME verified syllabus records every
 * syllabus hub page reads (never re-typed or guessed here).
 *
 * Audit I07 fix (2026-09-05): a resource declaring more than one board or
 * qualification (e.g. 55 Cambridge resources covering both IGCSE Chemistry
 * 0620 and O Level Chemistry 5070 in one combined guide) previously got
 * no official-specification link at all, because the single-syllabus gate
 * below required exactly one board AND one qualification. Every (board,
 * qualification) pair the resource actually declares is now looked up
 * individually via the resource's own syllabusCodes for disambiguation,
 * de-duplicated by code (a resource that declares the same board twice,
 * or a code shared across a pairing, only lists that syllabus once), and
 * every one that resolves is rendered as its own labelled link -- so a
 * combined IGCSE+O Level resource now shows both "Official specification
 * (IGCSE)" and "Official specification (O Level)" rather than neither.
 * A single-board/qualification resource still renders exactly as before
 * (officialSyllabuses.length is 1, so no per-link qualification label is
 * needed): this is additive, not a behaviour change for the ~1100
 * resources that already had a working link.
 */
const officialSyllabuses = d.boards
  .flatMap((b) => d.qualifications.map((q) => syllabusFor(b, q, d.subject.id, d.syllabusCodes)))
  .filter((s): s is NonNullable<typeof s> => Boolean(s))
  .filter((s, i, arr) => arr.findIndex((x) => x.code === s.code) === i);
/**
 * Flagship Dominance/Trust programme, Section 9 (2026-08-31, D-095):
 * replaces the earlier mailto: link with the structured corrections form
 * (src/pages/report-a-correction/) -- a categorized issue type, a proper
 * description field, and this page's own URL auto-captured via ?page=,
 * rather than relying on a visitor's mail client to fill in a template.
 * The form page still offers a plain-email fallback for anyone who'd
 * rather not use it.
 */
const correctionHref = `${routes.reportCorrection}?page=${encodeURIComponent(`https://marlbridge.com${path}`)}`;
const alignedToParts = [...boardNames, ...qualificationNames, subject?.data.title].filter(Boolean) as string[];
let alignedToText = `Aligned to ${alignedToParts.join(' ')}`;
if (d.syllabusCodes.length > 0) alignedToText += ` (${d.syllabusCodes.join(', ')})`;
if (d.syllabusSeries) alignedToText += `, ${d.syllabusSeries}`;
alignedToText += '.';

/**
 * QIGT programme -- genuine review evidence, computed ONCE and reused for
 * both the visible "Reviewed by" byline below and the schema.org `editor`
 * property, so the two can never disagree. Requires ALL of: reviewStatus
 * is actually 'reviewed' (not just a reviewer being assigned -- assignment
 * alone stays review-pending), the reviewer reference resolves to a real
 * authors-collection entry, and that entry is flagged isReviewer: true.
 * `changes-requested` and `review-pending` never display or claim review,
 * on purpose -- see scripts/validate-review-integrity.mjs for the
 * build-time enforcement of this same rule.
 */
const reviewerEntry = d.reviewer ? await getEntry(d.reviewer) : undefined;
const genuinelyReviewed = d.reviewStatus === 'reviewed' && !!reviewerEntry && reviewerEntry.data.isReviewer === true;
/** `archived` content stays reachable (no dead links) but must not be indexed. */
const pageNoindex = d.noindex || d.reviewStatus === 'archived';

const siblings = await topicSiblings(resource);
const alsoResources = await relatedResources({ subject: d.subject.id, topic: d.topic, boards: d.boards, excludeId: resource.id, picked: d.relatedResources, limit: 3 });
const alsoArticles = await relatedArticles({ subject: d.subject.id, picked: d.relatedArticles, limit: 2 });

const jsonLd = [articleNode({
  path,
  headline: d.title,
  description: d.description,
  published: d.publishedDate,
  updated: d.updatedDate,
  authorName: author?.data.name ?? 'Marlbridge Academic Team',
  authorEntityType: author?.data.entityType ?? 'organization',
  ...(genuinelyReviewed
    ? { editorName: reviewerEntry!.data.name, editorEntityType: reviewerEntry!.data.entityType }
    : {}),
})];
---
<PageLayout
  title={d.seoTitle ?? d.title}
  description={d.seoDescription ?? d.description}
  path={path}
  eyebrow={meta.title}
  heading={d.title}
  lead={d.description}
  headingFont="display"
  type="article"
  publishedDate={d.publishedDate}
  updatedDate={d.updatedDate}
  author={author?.data.name}
  breadcrumbs={[
    { label: 'Home', href: routes.home },
    { label: 'Resources', href: routes.resources },
    { label: meta.title, href: routes.resourceTypeAnchor(d.resourceType) },
    { label: d.title, href: path },
  ]}
  jsonLd={jsonLd}
  noindex={pageNoindex}
>
  <dl slot="hero-extra" class="m-0 mt-7 flex flex-wrap gap-x-8 gap-y-3 text-[14px]">
    <div class="m-0"><dt class="m-0 inline font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Subject </dt><dd class="m-0 inline"><a href={routes.subject(d.subject.id)} data-pagefind-filter="Subject" class="underline decoration-rule underline-offset-2">{subject?.data.title}</a></dd></div>
    <div class="m-0"><dt class="m-0 inline font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Level </dt><dd class="m-0 inline text-ink-mute" data-pagefind-filter="Level">{levels}</dd></div>
    {d.curriculum && <div class="m-0"><dt class="m-0 inline font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Curriculum </dt><dd class="m-0 inline text-ink-mute">{d.curriculum}</dd></div>}
    {d.topic && <div class="m-0"><dt class="m-0 inline font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Topic </dt><dd class="m-0 inline text-ink-mute">{d.topic}</dd></div>}
    {author && <div class="m-0"><dt class="m-0 inline font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Author </dt><dd class="m-0 inline text-ink-mute"><a href={routes.author(author.id)} class="underline decoration-rule underline-offset-2">{author.data.name}</a></dd></div>}
    <div class="m-0"><dt class="m-0 inline font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Updated </dt><dd class="m-0 inline text-ink-mute"><time datetime={(d.updatedDate ?? d.publishedDate).toISOString()}>{formatDate(d.updatedDate ?? d.publishedDate)}</time></dd></div>
    {genuinelyReviewed && (
      <div class="m-0"><dt class="m-0 inline font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Reviewed by </dt><dd class="m-0 inline text-ink-mute"><a href={routes.author(reviewerEntry!.id)} class="underline decoration-rule underline-offset-2">{reviewerEntry!.data.name}</a>{d.reviewedDate && <> on <time datetime={d.reviewedDate.toISOString()}>{formatDate(d.reviewedDate)}</time></>}</dd></div>
    )}
  </dl>

  {/* Flagship Dominance/Trust programme -- universal, non-attributed teacher-review
      trust line plus provenance and a correction path. Deliberately simple: no named
      reviewer, no invented date, no fabricated Person schema -- see reviewedByTeachers
      in src/content.config.ts and docs/decision-log.md D-092. Independent of, and
      additional to, the genuine named-reviewer byline above when that also exists. */}
  {d.reviewedByTeachers && (
    <div slot="hero-extra" data-testid="teacher-review-trust" class="mt-6 max-w-[62ch] rounded-sm border border-rule bg-ivory px-5 py-4 text-[14px] leading-relaxed text-ink-mute">
      <p class="m-0 font-semibold text-navy-800">Reviewed by teachers</p>
      <p class="m-0 mt-1">
        {alignedToText}{officialSyllabuses.map((s) => (
          <>
            {' '}
            <a href={s.officialUrl} rel="noopener" class="underline decoration-gold-500 underline-offset-2">
              Official specification{officialSyllabuses.length > 1 && ` (${qualificationBySlug(s.qualificationSlug)?.name ?? s.qualificationSlug})`}
            </a>
            {officialSyllabuses.indexOf(s) === officialSyllabuses.length - 1 ? '.' : ';'}
          </>
        ))}
      </p>
      <p class="m-0 mt-1"><a href={correctionHref} class="underline decoration-gold-500 underline-offset-2">Found an error? Report a correction.</a></p>
    </div>
  )}

  {/* Hidden filter tags -- see the comment above boardNames/qualificationNames.
      hidden (display:none) rather than removed from the DOM, since Pagefind's
      own docs confirm data-pagefind-filter still applies inside a hidden or
      data-pagefind-ignore element -- this deliberately adds nothing to what a
      sighted or screen-reader visitor perceives. */}
  <div slot="hero-extra" hidden aria-hidden="true">
    <span data-pagefind-filter={`Resource type:${meta.title}`}></span>
    {boardNames.map((name) => <span data-pagefind-filter={`Board:${name}`}></span>)}
    {qualificationNames.map((name) => <span data-pagefind-filter={`Qualification:${name}`}></span>)}
  </div>

  <Section surface="white">
    <Container>
      <div class="max-w-[68ch] text-[17.5px] leading-[1.75] [&>h2]:mt-10 [&>h2]:text-[24px] [&>h2]:font-semibold [&>h2]:text-navy-800 [&>h3]:mt-8 [&>h3]:text-[19px] [&>h3]:font-semibold [&>p]:mt-5 [&>ul]:mt-5 [&>ul]:ps-5 [&>ol]:mt-5 [&>ol]:ps-5 [&_a]:underline [&_a]:decoration-gold-500 [&_a]:underline-offset-2">
        <Content />
      </div>

      {(siblings.prev || siblings.next) && (
        <nav aria-label="Topic sequence" class="mt-12 grid gap-4 border-t border-rule pt-6 sm:grid-cols-2">
          {siblings.prev && (
            <a href={resourceUrl(siblings.prev)} class="rounded-sm border border-rule p-5 hover:border-gold-500">
              <span class="block font-mono text-[11px] uppercase tracking-[0.1em] text-ink-mute">Previous</span>
              <span class="mt-1 block text-[17px] font-semibold text-navy-800">{siblings.prev.data.title}</span>
            </a>
          )}
          {siblings.next && (
            <a href={resourceUrl(siblings.next)} class="rounded-sm border border-rule p-5 text-end hover:border-gold-500 sm:col-start-2">
              <span class="block font-mono text-[11px] uppercase tracking-[0.1em] text-ink-mute">Next</span>
              <span class="mt-1 block text-[17px] font-semibold text-navy-800">{siblings.next.data.title}</span>
            </a>
          )}
        </nav>
      )}

      {alsoResources.length > 0 && (
        <RelatedGrid id="also-resources" title="Related resources">
          {alsoResources.map((r) => <li class="m-0"><ResourceCard entry={r} subjectTitle={subject?.data.title} /></li>)}
        </RelatedGrid>
      )}

      {alsoArticles.length > 0 && (
        <RelatedGrid id="also-articles" title="Related articles" columns={2}>
          {alsoArticles.map((a) => <li class="m-0"><ArticleCard entry={a} /></li>)}
        </RelatedGrid>
      )}
    </Container>
  </Section>

  <CTA
    surface="ivory"
    heading={`Working through ${subject?.data.title}? Tutoring covers the same material with a teacher.`}
    buttonLabel="Find Learning Support"
    buttonHref={routes.tutoring}
  />
</PageLayout>
