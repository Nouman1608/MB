---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import TrialRequestForm from '../../components/forms/TrialRequestForm.astro';
import HowTuitionWorks from '../../components/sections/HowTuitionWorks.astro';
import FAQ from '../../components/ui/FAQ.astro';
import { faqNode } from '../../utils/schema/faq';
import { routes } from '../../utils/urls/routes';
import { PRICING_TERMS } from '../../data/pricing';

/**
 * D-291 (2026-09-23) -- shortened at the owner's request: no qualification
 * dropdown, no time zone, subject typed by the student.
 *
 * D-286 (2026-09-23) -- the form is structured again (TrialRequestForm):
 * qualification, board, subject, format, country, time zone, optional
 * times and message. The lead is shortened so the form starts sooner on a
 * phone (the review finding that the mobile page put a long intro first),
 * and the "What should I write?" answer now reflects the new form.
 *
 * Earlier history, kept for context:
 * v1.x CLOSURE Release WS1 (2026-08-26) -- this page's copy previously
 * described the trial form's now-removed structured qualification/board/
 * subject/availability dropdowns (QIGT trust workstream, Aug 2026).
 * Reverted to match the current 5-field form (Name/Email/Phone/Country/
 * Message): the FAQ and lead copy now point visitors at the message field
 * for those details instead of describing dropdown options that no longer
 * exist. Reuses only facts already published elsewhere (pricing, teaching
 * locations) -- nothing here is a new claim.
 */
const faqs = [
  {
    question: 'Is the trial class really free?',
    answer: `${PRICING_TERMS.freeTrial} There is no charge and no obligation to continue.`,
  },
  {
    question: 'Is the trial one-to-one or in a group?',
    answer: `${PRICING_TERMS.trialFormat.summary} ${PRICING_TERMS.trialFormat.group} ${PRICING_TERMS.trialFormat.oneToOne}`,
  },
  {
    question: 'How long is the trial class?',
    answer: `It is a real class, so it runs for the normal length of the format you are trying. Group classes: ${PRICING_TERMS.classFormat.group} One-to-one classes: ${PRICING_TERMS.classFormat.oneToOne}`,
  },
  {
    question: 'How quickly will I hear back?',
    answer: `${PRICING_TERMS.enquiryResponse.summary} If you would rather not wait for email, message us on WhatsApp using the button on this page.`,
  },
  {
    question: 'Does submitting this form book the class?',
    answer: 'No -- this sends a request. Marlbridge replies to confirm a teacher and a time before anything is scheduled, in your own time zone.',
  },
  {
    question: 'Can I ask for a particular teacher?',
    answer: 'You can ask, and we will tell you honestly whether that teacher has room at the level and time you need. We will always tell you who is teaching before the class is scheduled, but we cannot guarantee a specific teacher in advance.',
  },
  {
    question: 'What if I am not sure of the exam board or the right format?',
    answer: 'Choose "Not sure" or "Help me decide". The teacher will check the syllabus with you, and explain the difference between group classes (a monthly fee per subject) and one-to-one classes (a fee per class) before anything is arranged.',
  },
  {
    question: 'What happens if I want to continue after the trial?',
    answer: `${PRICING_TERMS.billing} ${PRICING_TERMS.enrolmentFee} ${PRICING_TERMS.cancellationPolicy}`,
  },
  {
    question: 'Where does Marlbridge teach?',
    answer: 'Marlbridge teaches in person at its academy in Lahore, Pakistan, and live online to learners anywhere else, with lesson times agreed in their own time zone.',
  },
];
const faq = faqNode(faqs);
---
<PageLayout
  translationKey="trial"
  title="Free Trial Class"
  description="Request a free trial class with a Marlbridge subject teacher: choose the course, group or one-to-one, and your times. Email replies within two working days, WhatsApp within one."
  path={routes.trial}
  eyebrow="Free trial"
  heading="Request a free trial class."
  lead={`Tell us the course and when you're free. ${PRICING_TERMS.enquiryResponse.short} This is a request, not a booking.`}
  breadcrumbs={[{ label: 'Home', href: routes.home }, { label: 'Free Trial Class', href: routes.trial }]}
  jsonLd={faq ? [faq] : []}
>
  <Section surface="white">
    <Container>
      {/* D-330: the four things a family needs to know before asking, from the approved PRICING_TERMS wording. */}
      <ul class="m-0 mb-8 grid max-w-[72ch] list-none gap-3 p-0 text-[15px] leading-relaxed sm:grid-cols-2" aria-label="About the free trial class">
        <li class="m-0 rounded-sm border border-rule bg-ivory p-4"><strong class="text-navy-800">Free, no obligation.</strong> {PRICING_TERMS.freeTrial} You decide afterwards whether to continue.</li>
        <li class="m-0 rounded-sm border border-rule bg-ivory p-4"><strong class="text-navy-800">A real class.</strong> Group: {PRICING_TERMS.classFormat.group.split(',')[0]}. One-to-one: {PRICING_TERMS.classFormat.oneToOne.split('.')[0]}.</li>
        <li class="m-0 rounded-sm border border-rule bg-ivory p-4"><strong class="text-navy-800">A request, not a booking.</strong> We propose a teacher and a time in your time zone; nothing is scheduled until you agree.</li>
        <li class="m-0 rounded-sm border border-rule bg-ivory p-4"><strong class="text-navy-800">Quick reply.</strong> {PRICING_TERMS.enquiryResponse.short}</li>
      </ul>
      <TrialRequestForm />
    </Container>
  </Section>

  <HowTuitionWorks surface="white" showCta={false} heading="What happens after you send this." />

  <Section surface="ivory" border>
    <Container>
      <h2 class="m-0 mb-6 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Questions</h2>
      <FAQ items={faqs} id="trial-faqs" />
      <p class="m-0 mt-8 text-[15.5px]">
        Have a different question first? <a href={routes.contact} class="underline decoration-gold-500 underline-offset-2">Send a general enquiry</a> instead.
      </p>
    </Container>
  </Section>
</PageLayout>
