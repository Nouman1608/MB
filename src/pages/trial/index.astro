---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import FAQ from '../../components/ui/FAQ.astro';
import { faqNode } from '../../utils/schema/faq';
import { routes } from '../../utils/urls/routes';
import { PRICING_TERMS } from '../../data/pricing';

/**
 * v1.x CLOSURE Release WS1 (2026-08-26) -- this page's copy previously
 * described the trial form's now-removed structured qualification/board/
 * subject/availability dropdowns (QIGT trust workstream, Aug 2026).
 * Reverted to match the current 5-field form (Name/Email/Phone/Country/
 * Message): the FAQ and lead copy now point visitors at the message field
 * for those details instead of describing dropdown options that no longer
 * exist. Reuses only facts already published elsewhere (pricing, teaching
 * locations) -- nothing here is a new claim.
 */
const faqs = [
  {
    question: 'Is the trial class really free?',
    answer: `${PRICING_TERMS.freeTrial} There is no charge and no obligation to continue.`,
  },
  {
    question: 'Does submitting this form book the class?',
    answer: 'No -- this sends a request. Marlbridge replies by email to confirm a teacher and a time before anything is scheduled.',
  },
  {
    question: "What should I write in the message?",
    answer: 'The programme or qualification (e.g. IGCSE, A Level), the exam board if known, the subject, the level, your preferred days/times and timezone, and what support you need. If anything is not yet decided, say so -- Marlbridge will confirm the right fit by email.',
  },
  {
    question: 'Where does Marlbridge teach?',
    answer: 'Marlbridge teaches in Pakistan today. Learners outside our teaching locations are taught online.',
  },
];
const faq = faqNode(faqs);
---
<PageLayout
  title="Free Trial Class"
  description="Request a free trial class from Marlbridge. Tell us the programme, board and subject in your message, and we will reply by email to confirm a teacher and a time."
  path={routes.trial}
  eyebrow="Free trial"
  heading="Request a free trial class."
  lead="Tell us in your message which programme, board and subject the learner needs help with. We will reply by email to confirm a teacher and a time -- this is a request, not a booking."
  breadcrumbs={[{ label: 'Home', href: routes.home }, { label: 'Free Trial Class', href: routes.trial }]}
  jsonLd={faq ? [faq] : []}
>
  <Section surface="white">
    <Container><EnquiryForm kind="trial" /></Container>
  </Section>

  <Section surface="ivory" border>
    <Container>
      <h2 class="m-0 mb-6 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Questions</h2>
      <FAQ items={faqs} id="trial-faqs" />
      <p class="m-0 mt-8 text-[15.5px]">
        Have a different question first? <a href={routes.contact} class="underline decoration-gold-500 underline-offset-2">Send a general enquiry</a> instead.
      </p>
    </Container>
  </Section>
</PageLayout>
