---
/**
 * Practice session -- /practice/{code}/
 *
 * v2.0 AUTHORITY/PRACTICE/TOOLS/GROWTH MEGA PROGRAMME WS6 (self-check
 * engine), WS7 (saved progress + error notebook) and WS8 (timed mode +
 * weak-topic recommendations) -- built together since all three share one
 * localStorage schema and one page. See src/utils/practice/bank.ts for why
 * this is self-marked, not auto-graded: the underlying content is prose
 * worked answers, not single machine-checkable correct answers.
 *
 * Only generates a page for a flagship code that actually has parsed
 * practice questions -- getStaticPaths filters this explicitly, so there
 * is no route for 0625/0580 today (see /practice/ index for how that gap
 * is disclosed rather than hidden).
 *
 * Everything below "How this works" is inert without JavaScript -- the
 * noscript fallback says so plainly and points to the underlying
 * practice-questions resources directly, so a JS-disabled visitor still
 * gets the real content, just not the interactive self-check flow.
 */
import PageLayout from '../../../layouts/PageLayout.astro';
import Section from '../../../components/layout/Section.astro';
import Container from '../../../components/layout/Container.astro';
import { flagshipSpecs, academicHubPath } from '../../../utils/academic/index.ts';
import { practiceQuestionsForCode } from '../../../utils/practice/bank.ts';
import { syllabusFor } from '../../../data/academic/syllabuses.ts';
import { routes } from '../../../utils/urls/routes';
import { buildClientQuestions, dataHashFor } from '../../../utils/practice/client-questions.ts';

export async function getStaticPaths() {
  return flagshipSpecs()
    .filter((f) => practiceQuestionsForCode(f.code).length > 0)
    .map((f) => ({ params: { code: f.code }, props: { spec: f } }));
}

const { spec } = Astro.props as { spec: ReturnType<typeof flagshipSpecs>[number] };
const path = `/practice/${spec.code}/`;
const syllabus = syllabusFor(spec.boardSlug, spec.qualificationSlug, spec.subjectSlug);
const hubPath = academicHubPath(spec.combination);
const subjectTitle = syllabus?.officialTitle ?? `${spec.combination.board} ${spec.combination.qualification} ${spec.combination.subject}`;

// D-104 follow-up: the question bank itself (qHtml/aHtml markdown-to-HTML,
// topic-label resolution) now lives in a shared util, ../../../utils/
// practice/client-questions.ts, reused by both this page (which still
// needs `clientQuestions.length` server-side, below) and the JSON endpoint
// at /practice-data/{code}.json that actually serves the array to the
// client. See docs/decision-log.md D-104 for why: on the two largest
// flagship codes, inlining the full array directly into this page's HTML
// (the old approach) added 180-280KB raw with no independent cache
// lifetime -- every repeat visit re-downloaded the full bank. Now the
// page only computes the array server-side for the few places that need
// a plain count or list (below), and the client fetches it separately, as
// its own long-cached resource.
const clientQuestions = buildClientQuestions(spec);
const dataUrl = `/practice-data/${spec.code}.json?v=${dataHashFor(clientQuestions)}`;

const storageKey = `mb-practice-${spec.code}`;
const analyticsContext = {
  specCode: spec.code,
  board: spec.combination.board,
  qualification: spec.combination.qualification,
  subject: spec.combination.subject,
};
---
<PageLayout
  title={`${subjectTitle} — Free Practice Questions`}
  description={`Self-check practice for ${subjectTitle} (${spec.code}): ${clientQuestions.length} original exam-style questions with full worked answers. Attempt, reveal, mark yourself, track weak topics. No account needed.`}
  path={path}
  eyebrow={`${spec.combination.board} ${spec.combination.qualification} · ${spec.code}`}
  heading={`Practice: ${spec.combination.subject}`}
  lead={`${clientQuestions.length} original exam-style questions for ${subjectTitle}, drawn from Marlbridge's own practice-questions resources. Attempt each one, reveal the worked answer, and mark yourself.`}
  breadcrumbs={[
    { label: 'Home', href: routes.home },
    { label: 'Practice', href: '/practice/' },
    { label: spec.combination.subject, href: path },
  ]}
>
  <Section surface="white">
    <Container>
      <noscript>
        <div class="rounded-sm border border-rule bg-ivory p-6">
          <p class="m-0 text-[15px] text-ink">
            This interactive practice session needs JavaScript. Without it, you can still work
            through the same questions directly in the source resources:
          </p>
          <ul class="m-0 mt-3 list-disc pl-5 text-[14.5px] text-ink-mute">
            {[...new Set(clientQuestions.map((q) => q.resourceSlug))].map((slug) => (
              <li><a href={`/resources/${slug}/`} class="underline decoration-gold-500 underline-offset-2">{clientQuestions.find((q) => q.resourceSlug === slug)?.resourceTitle}</a></li>
            ))}
          </ul>
        </div>
      </noscript>

      <div id="mb-practice-app" data-storage-key={storageKey} data-hub-path={hubPath} class="hidden">
        <div id="mb-practice-toolbar" class="mb-6 flex flex-wrap items-center gap-x-6 gap-y-3 rounded-sm border border-rule bg-ivory p-4 text-[13.5px]">
          <span id="mb-practice-progress" class="font-medium text-navy-800">0 / {clientQuestions.length} attempted</span>
          <span id="mb-practice-score" class="text-ink-mute"></span>
          <label class="ml-auto flex items-center gap-2 text-ink-mute">
            <span>Show:</span>
            <select id="mb-practice-filter" class="rounded-sm border border-rule bg-white px-2 py-1 text-[13.5px]">
              <option value="all">All questions</option>
              <option value="unattempted">Unattempted only</option>
              <option value="wrong">Previously wrong only</option>
            </select>
          </label>
          <label class="flex items-center gap-2 text-ink-mute">
            <span>Mode:</span>
            <select id="mb-practice-mode" class="rounded-sm border border-rule bg-white px-2 py-1 text-[13.5px]">
              <option value="standard">Standard practice</option>
              <option value="mixed">Mixed revision (20, balanced by topic)</option>
              <option value="diagnostic">Diagnostic check (one-time, broad coverage)</option>
            </select>
          </label>
          <label class="flex items-center gap-2 text-ink-mute">
            <input type="checkbox" id="mb-practice-timed" class="h-4 w-4" />
            <span>Timed mode</span>
          </label>
          <span id="mb-practice-timer" class="font-mono text-navy-800" hidden>00:00</span>
        </div>

        <div id="mb-practice-card" class="rounded-sm border border-rule bg-white p-[clamp(22px,3vw,36px)]">
          <div class="mb-4 flex items-center justify-between text-[12px] font-medium uppercase tracking-[0.1em] text-gold-600">
            <span id="mb-practice-qnum">Question 1 of {clientQuestions.length}</span>
            <span id="mb-practice-marks"></span>
          </div>
          <div id="mb-practice-question" class="prose-question text-[16.5px] leading-[1.65] text-ink"></div>
          <div id="mb-practice-answer-wrap" hidden>
            <hr class="my-5 border-rule" />
            <p class="m-0 mb-2 text-[12px] font-medium uppercase tracking-[0.1em] text-gold-600">Worked answer</p>
            <div id="mb-practice-answer" class="prose-question text-[16px] leading-[1.65] text-ink"></div>
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <button id="mb-practice-reveal" type="button" class="rounded-sm bg-navy-800 px-5 py-2.5 text-[14px] font-medium text-white transition-colors hover:bg-navy-700">Reveal answer</button>
            <button id="mb-practice-right" type="button" hidden class="rounded-sm border border-rule bg-white px-5 py-2.5 text-[14px] font-medium text-ink transition-colors hover:border-gold-500">I got this right</button>
            <button id="mb-practice-wrong" type="button" hidden class="rounded-sm border border-rule bg-white px-5 py-2.5 text-[14px] font-medium text-ink transition-colors hover:border-gold-500">I got this wrong</button>
            <button id="mb-practice-next" type="button" hidden class="ml-auto rounded-sm px-5 py-2.5 text-[14px] font-medium text-gold-600 transition-colors hover:text-gold-700">Next question →</button>
          </div>
        </div>
        <p id="mb-practice-empty" class="m-0 mt-6 rounded-sm border border-dashed border-rule bg-ivory p-6 text-[14.5px] text-ink-mute" hidden></p>

        <div id="mb-practice-diagnostic-results" class="mt-6 rounded-sm border border-rule bg-white p-[clamp(22px,3vw,36px)]" hidden>
          <h2 class="m-0 mb-1 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Diagnostic results</h2>
          <p id="mb-practice-diag-score" class="m-0 mb-6 text-[14.5px] text-ink-mute"></p>
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <h3 class="m-0 mb-2 text-[12px] font-semibold uppercase tracking-[0.1em] text-gold-600">Strengths</h3>
              <ul id="mb-practice-diag-strengths" class="m-0 list-none p-0 text-[14px] leading-[1.7] text-ink"></ul>
            </div>
            <div>
              <h3 class="m-0 mb-2 text-[12px] font-semibold uppercase tracking-[0.1em] text-gold-600">Weak areas</h3>
              <ul id="mb-practice-diag-weak" class="m-0 list-none p-0 text-[14px] leading-[1.7] text-ink"></ul>
            </div>
          </div>
          <p class="m-0 mt-6 text-[13px] text-ink-mute">A simple, deterministic check based on the questions you were just given, spread across the syllabus topics this bank covers — not a validated diagnostic assessment, and not a prediction of exam performance.</p>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <a href={hubPath} class="rounded-sm border border-rule bg-white px-5 py-2.5 text-[14px] font-medium text-ink transition-colors hover:border-gold-500">Review the syllabus hub</a>
            <a href="/tutoring/" id="mb-practice-teacher-support" class="rounded-sm bg-navy-800 px-5 py-2.5 text-[14px] font-medium text-white transition-colors hover:bg-navy-700">Get teacher support</a>
            <button type="button" id="mb-practice-diag-restart" class="ml-auto rounded-sm px-5 py-2.5 text-[14px] font-medium text-gold-600 transition-colors hover:text-gold-700">Back to standard practice</button>
          </div>
        </div>

        <div id="mb-practice-weak" class="mt-10" hidden>
          <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Your weak topics</h2>
          <p class="m-0 mb-4 text-[14.5px] text-ink-mute">Based on questions you've marked wrong, ranked by how often they come up.</p>
          <ul id="mb-practice-weak-list" class="m-0 grid list-none gap-3 p-0 sm:grid-cols-2"></ul>
        </div>

        <div id="mb-practice-notebook" class="mt-10" hidden>
          <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Error notebook</h2>
          <p class="m-0 mb-4 text-[14.5px] text-ink-mute">Every question you've marked wrong, in one place — jump straight back to it.</p>
          <ul id="mb-practice-notebook-list" class="m-0 grid list-none gap-2 p-0"></ul>
        </div>

        <div id="mb-practice-mastery" class="mt-10" hidden>
          <h2 class="m-0 mb-1 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Your topic mastery</h2>
          <p class="m-0 mb-3 text-[14.5px] text-ink-mute">
            A simple, deterministic signal from your attempts on this page — not a validated diagnostic.
            {' '}<button type="button" id="mb-practice-mastery-info" class="underline decoration-gold-500 underline-offset-2 hover:text-gold-600">How this is worked out</button>
          </p>
          <div id="mb-practice-mastery-explain" class="m-0 mb-4 rounded-sm border border-dashed border-rule bg-ivory p-4 text-[13px] leading-[1.6] text-ink-mute" hidden>
            <strong class="text-ink">Not started</strong> — no attempts yet on any question in this topic.{' '}
            <strong class="text-ink">Needs review</strong> — your most recent attempt in this topic was marked wrong, or fewer than half your attempts were correct.{' '}
            <strong class="text-ink">Developing</strong> — at least half your attempts were correct, but not yet two in a row.{' '}
            <strong class="text-ink">Secure</strong> — at least two questions attempted in this topic, all marked correct, and your most recent attempt was correct. One correct answer is never enough on its own to call a topic secure.
          </div>
          <ul id="mb-practice-mastery-list" class="m-0 grid list-none gap-2 p-0 sm:grid-cols-2"></ul>
        </div>

        <div id="mb-practice-spaced" class="mt-10" hidden>
          <h2 class="m-0 mb-1 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Ready to retry</h2>
          <p class="m-0 mb-4 text-[14.5px] text-ink-mute">Questions you got wrong a while ago — worth another attempt now they're not fresh in memory.</p>
          <ul id="mb-practice-spaced-list" class="m-0 grid list-none gap-2 p-0"></ul>
        </div>

        <p class="m-0 mt-8 text-[12.5px] text-ink-mute">
          Your progress is saved only in this browser (localStorage), on this device. Clearing your
          browser data will reset it. Nothing is sent to Marlbridge or anyone else.
          <button id="mb-practice-reset" type="button" class="ml-1 underline decoration-gold-500 underline-offset-2 hover:text-gold-600">Reset my progress</button>
        </p>
      </div>
    </Container>
  </Section>

  <script is:inline define:vars={{ storageKey, hubPath: hubPath, dataUrl, analyticsContext }}>
    (function () {
      const app = document.getElementById('mb-practice-app');
      if (!app) return;

      const els = {
        progress: document.getElementById('mb-practice-progress'),
        score: document.getElementById('mb-practice-score'),
        filter: document.getElementById('mb-practice-filter'),
        timedToggle: document.getElementById('mb-practice-timed'),
        timer: document.getElementById('mb-practice-timer'),
        qnum: document.getElementById('mb-practice-qnum'),
        marks: document.getElementById('mb-practice-marks'),
        question: document.getElementById('mb-practice-question'),
        answerWrap: document.getElementById('mb-practice-answer-wrap'),
        answer: document.getElementById('mb-practice-answer'),
        reveal: document.getElementById('mb-practice-reveal'),
        right: document.getElementById('mb-practice-right'),
        wrong: document.getElementById('mb-practice-wrong'),
        next: document.getElementById('mb-practice-next'),
        card: document.getElementById('mb-practice-card'),
        empty: document.getElementById('mb-practice-empty'),
        weakWrap: document.getElementById('mb-practice-weak'),
        weakList: document.getElementById('mb-practice-weak-list'),
        notebookWrap: document.getElementById('mb-practice-notebook'),
        notebookList: document.getElementById('mb-practice-notebook-list'),
        reset: document.getElementById('mb-practice-reset'),
        mode: document.getElementById('mb-practice-mode'),
        masteryWrap: document.getElementById('mb-practice-mastery'),
        masteryList: document.getElementById('mb-practice-mastery-list'),
        masteryInfo: document.getElementById('mb-practice-mastery-info'),
        masteryExplain: document.getElementById('mb-practice-mastery-explain'),
        spacedWrap: document.getElementById('mb-practice-spaced'),
        spacedList: document.getElementById('mb-practice-spaced-list'),
        diagWrap: document.getElementById('mb-practice-diagnostic-results'),
        diagScore: document.getElementById('mb-practice-diag-score'),
        diagStrengths: document.getElementById('mb-practice-diag-strengths'),
        diagWeak: document.getElementById('mb-practice-diag-weak'),
        diagRestart: document.getElementById('mb-practice-diag-restart'),
        teacherSupport: document.getElementById('mb-practice-teacher-support'),
      };

      /**
       * Search Intelligence Execution Round -- thin, safe wrapper around the
       * shared window.mbTrack helper (defined in ConsentAnalytics.astro).
       * Never throws if mbTrack/gtag aren't ready (consent not yet granted,
       * or the analytics script hasn't loaded for any reason) -- practice
       * functionality itself must never depend on or be blocked by
       * analytics succeeding.
       */
      function track(name, params) {
        try {
          if (typeof window.mbTrack === 'function') {
            window.mbTrack(name, Object.assign({}, analyticsContext, params || {}));
          }
        } catch (e) {}
      }

      function loadState() {
        try {
          const raw = localStorage.getItem(storageKey);
          if (raw) return JSON.parse(raw);
        } catch (e) {}
        return { attempts: {} };
      }
      function saveState(state) {
        try {
          localStorage.setItem(storageKey, JSON.stringify(state));
        } catch (e) {}
      }

      /**
       * D-104 follow-up -- `questions` used to be `JSON.parse`d synchronously
       * from an inline <script type="application/json"> block embedded in
       * this page's own HTML. It's now fetched from its own cacheable
       * resource (dataUrl, a build-time-generated JSON endpoint -- see
       * src/pages/practice-data/[code].json.ts), so everything that reads
       * `questions` has to wait for that fetch. `init()` below does the
       * fetching; the app stays hidden (its initial state, from the
       * frontmatter's `class="hidden"`) until data arrives or fails.
       * @type {Array<{id:string,qHtml:string,aHtml:string,marks:number,resourceSlug:string,resourceTitle:string,topics:Array<{key:string,label:string}>}>}
       */
      let questions = [];

      let state = loadState();
      let filtered = [];
      let index = 0;
      let revealed = false;
      let timerStart = null;
      let timerInterval = null;
      let mode = 'standard';
      let diagnosticActive = false;
      let diagnosticStartTs = null;
      let lastDiagnosticScorePercent = null;
      /** @type {Record<string, boolean>} this diagnostic run's own answers, kept separate from `state` so results reflect exactly this run regardless of earlier history */
      let diagnosticRun = {};

      /**
       * Flagship Dominance Programme WS-B (2026-08-31) -- topic index built
       * once from every question's own topics[] (server-resolved real
       * syllabus names, not slugs -- resolved server-side in
       * client-questions.ts). Preserves first-seen order so the mastery
       * list reads in roughly syllabus order rather than alphabetically.
       * Built by `init()` once `questions` has actually loaded (D-104
       * follow-up -- was a plain module-init loop before `questions` became
       * async).
       */
      let allTopics = new Map();
      function buildTopicsIndex() {
        const m = new Map();
        for (const q of questions) {
          for (const t of q.topics) {
            if (!m.has(t.key)) m.set(t.key, t.label);
          }
        }
        return m;
      }

      /**
       * Deterministic topic-balanced sample: round-robins across every
       * topic group (a question's first tagged topic, or 'general' if it
       * has none) so a mixed/diagnostic set spreads across the syllabus
       * instead of clustering on whichever topic happens to have the most
       * source files. Same input always produces the same output -- no
       * randomness, matching the brief's "use deterministic logic".
       */
      function buildBalancedSet(n) {
        const groups = new Map();
        for (const q of questions) {
          const key = q.topics[0] ? q.topics[0].key : 'general';
          if (!groups.has(key)) groups.set(key, []);
          groups.get(key).push(q);
        }
        const groupArrays = [...groups.values()];
        const picked = [];
        let round = 0;
        while (picked.length < n) {
          let addedThisRound = false;
          for (const arr of groupArrays) {
            if (round < arr.length) {
              picked.push(arr[round]);
              addedThisRound = true;
              if (picked.length >= n) break;
            }
          }
          if (!addedThisRound) break;
          round++;
        }
        return picked;
      }

      /**
       * Topic mastery level -- deterministic, documented, and deliberately
       * conservative: a single correct answer can never reach 'secure' (the
       * brief's own warning against overconfidence from one question), and
       * a fresh wrong answer always demotes a topic regardless of a good
       * historical ratio, since the most recent signal is the most current
       * evidence of whether a topic is actually secure right now.
       */
      function masteryLevel(attempts) {
        if (attempts.length === 0) return 'not-started';
        const correctCount = attempts.filter((a) => a.correct).length;
        const ratio = correctCount / attempts.length;
        const mostRecent = attempts.reduce((a, b) => (a.ts > b.ts ? a : b));
        if (!mostRecent.correct) return 'needs-review';
        if (attempts.length >= 2 && ratio === 1) return 'secure';
        if (ratio >= 0.5) return 'developing';
        return 'needs-review';
      }
      const MASTERY_LABEL = {
        'not-started': 'Not started',
        'needs-review': 'Needs review',
        'developing': 'Developing',
        'secure': 'Secure',
      };
      const MASTERY_CLASS = {
        'not-started': 'bg-ivory text-ink-mute',
        'needs-review': 'bg-[#fbe9e7] text-[#9a3412]',
        'developing': 'bg-[#fff4d6] text-[#8a6100]',
        'secure': 'bg-[#e6f4ea] text-[#1e6b3a]',
      };

      function applyFilter() {
        const mode = els.filter.value;
        if (mode === 'unattempted') {
          filtered = questions.filter((q) => !state.attempts[q.id]);
        } else if (mode === 'wrong') {
          filtered = questions.filter((q) => state.attempts[q.id] && state.attempts[q.id].correct === false);
        } else {
          filtered = questions.slice();
        }
        index = 0;
        render();
      }

      function fmtTime(ms) {
        const s = Math.floor(ms / 1000);
        const mm = String(Math.floor(s / 60)).padStart(2, '0');
        const ss = String(s % 60).padStart(2, '0');
        return mm + ':' + ss;
      }

      function stopTimer() {
        if (timerInterval) clearInterval(timerInterval);
        timerInterval = null;
      }
      function startTimer() {
        stopTimer();
        timerStart = Date.now();
        els.timer.hidden = !els.timedToggle.checked;
        if (!els.timedToggle.checked) return;
        timerInterval = setInterval(() => {
          els.timer.textContent = fmtTime(Date.now() - timerStart);
        }, 1000);
        els.timer.textContent = '00:00';
      }

      function updateSummary() {
        const attemptedIds = Object.keys(state.attempts).filter((id) => questions.some((q) => q.id === id));
        const correctCount = attemptedIds.filter((id) => state.attempts[id].correct).length;
        els.progress.textContent = attemptedIds.length + ' / ' + questions.length + ' attempted';
        els.score.textContent = attemptedIds.length > 0
          ? Math.round((correctCount / attemptedIds.length) * 100) + '% marked correct so far'
          : '';
      }

      function updateWeakTopics() {
        const wrongCounts = new Map();
        for (const q of questions) {
          const a = state.attempts[q.id];
          if (a && a.correct === false) {
            for (const t of q.topics) {
              wrongCounts.set(t.key, {
                label: t.label,
                count: (wrongCounts.get(t.key)?.count || 0) + 1,
              });
            }
          }
        }
        const ranked = [...wrongCounts.entries()].sort((a, b) => b[1].count - a[1].count).slice(0, 6);
        els.weakWrap.hidden = ranked.length === 0;
        els.weakList.innerHTML = '';
        for (const [key, info] of ranked) {
          const li = document.createElement('li');
          li.className = 'flex items-center justify-between gap-3 rounded-sm border border-rule bg-ivory px-4 py-3';
          const label = document.createElement('span');
          label.className = 'text-[14px] text-ink';
          label.textContent = info.label;
          const badge = document.createElement('a');
          badge.href = hubPath + '#topics-heading';
          badge.className = 'shrink-0 rounded-sm bg-white px-2.5 py-1 text-[12px] font-medium text-gold-600 underline decoration-gold-500 underline-offset-2 hover:text-gold-700';
          badge.textContent = info.count + ' wrong · study this topic';
          badge.addEventListener('click', () => {
            track('weak_topic_click', { topic: info.label, wrong_count: info.count });
          });
          li.appendChild(label);
          li.appendChild(badge);
          els.weakList.appendChild(li);
        }
      }

      function updateNotebook() {
        const wrongQuestions = questions.filter((q) => {
          const a = state.attempts[q.id];
          return a && a.correct === false;
        });
        els.notebookWrap.hidden = wrongQuestions.length === 0;
        els.notebookList.innerHTML = '';
        for (const q of wrongQuestions) {
          const li = document.createElement('li');
          li.className = 'rounded-sm border border-rule bg-white px-4 py-3';
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'w-full text-left text-[14px] text-ink hover:text-gold-600';
          const plain = q.qHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
          btn.textContent = plain.length > 140 ? plain.slice(0, 140) + '…' : plain;
          btn.addEventListener('click', () => {
            track('retry', { topic: q.topics[0] ? q.topics[0].label : 'general', source: 'notebook' });
            const i = filtered.findIndex((f) => f.id === q.id);
            if (i >= 0) { index = i; render(); }
            else { filtered = questions.slice(); index = questions.findIndex((f) => f.id === q.id); render(); }
            els.card.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          li.appendChild(btn);
          els.notebookList.appendChild(li);
        }
      }

      function updateMastery() {
        if (Object.keys(state.attempts).length === 0) { els.masteryWrap.hidden = true; return; }
        els.masteryWrap.hidden = false;
        els.masteryList.innerHTML = '';
        for (const [key, label] of allTopics) {
          const topicQuestions = questions.filter((q) => q.topics.some((t) => t.key === key));
          const attempts = topicQuestions
            .map((q) => state.attempts[q.id])
            .filter((a) => a);
          const level = masteryLevel(attempts);
          const li = document.createElement('li');
          li.className = 'flex items-center justify-between gap-3 rounded-sm border border-rule bg-white px-4 py-3';
          const span = document.createElement('span');
          span.className = 'text-[14px] text-ink';
          span.textContent = label;
          const badge = document.createElement('span');
          badge.className = 'shrink-0 rounded-sm px-2.5 py-1 text-[12px] font-medium ' + MASTERY_CLASS[level];
          badge.textContent = MASTERY_LABEL[level] + (attempts.length ? ' · ' + attempts.length + ' attempted' : '');
          li.appendChild(span);
          li.appendChild(badge);
          els.masteryList.appendChild(li);
        }
      }

      function fmtDaysAgo(ts) {
        const days = Math.floor((Date.now() - ts) / 86400000);
        if (days <= 0) return 'today';
        if (days === 1) return '1 day ago';
        return days + ' days ago';
      }

      /**
       * Flagship Dominance Programme WS-B -- spaced-retry queue. Surfaces a
       * previously-wrong question only once it is at least a day old (the
       * point of spacing is that it is no longer fresh in memory), oldest
       * miss first, capped to a manageable list. Purely a read of existing
       * `state.attempts` -- no separate storage, no account needed.
       */
      const SPACED_RETRY_THRESHOLD_MS = 24 * 60 * 60 * 1000;
      function updateSpacedRetry() {
        const ready = questions
          .filter((q) => {
            const a = state.attempts[q.id];
            return a && a.correct === false && (Date.now() - a.ts) >= SPACED_RETRY_THRESHOLD_MS;
          })
          .sort((a, b) => state.attempts[a.id].ts - state.attempts[b.id].ts)
          .slice(0, 8);
        els.spacedWrap.hidden = ready.length === 0;
        els.spacedList.innerHTML = '';
        for (const q of ready) {
          const li = document.createElement('li');
          li.className = 'rounded-sm border border-rule bg-white px-4 py-3';
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'flex w-full items-center justify-between gap-3 text-left text-[14px] text-ink hover:text-gold-600';
          const plain = q.qHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
          const textSpan = document.createElement('span');
          textSpan.textContent = plain.length > 120 ? plain.slice(0, 120) + '…' : plain;
          const whenSpan = document.createElement('span');
          whenSpan.className = 'shrink-0 text-[12px] text-ink-mute';
          whenSpan.textContent = 'missed ' + fmtDaysAgo(state.attempts[q.id].ts);
          btn.appendChild(textSpan);
          btn.appendChild(whenSpan);
          btn.addEventListener('click', () => {
            track('retry', { topic: q.topics[0] ? q.topics[0].label : 'general', source: 'spaced_retry' });
            if (mode !== 'standard') { els.mode.value = 'standard'; applyMode(); }
            const i = filtered.findIndex((f) => f.id === q.id);
            if (i >= 0) { index = i; render(); }
            else { filtered = questions.slice(); index = questions.findIndex((f) => f.id === q.id); render(); }
            els.card.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          li.appendChild(btn);
          els.spacedList.appendChild(li);
        }
      }

      function topicResultsFor(qIds, results) {
        const byTopic = new Map();
        for (const id of qIds) {
          const q = questions.find((x) => x.id === id);
          if (!q) continue;
          for (const t of q.topics) {
            if (!byTopic.has(t.key)) byTopic.set(t.key, { label: t.label, correct: 0, total: 0 });
            const entry = byTopic.get(t.key);
            entry.total++;
            if (results[id]) entry.correct++;
          }
        }
        return byTopic;
      }

      /**
       * Diagnostic results -- a deliberately simple, disclosed-as-simple
       * summary (never framed as a validated psychometric diagnostic).
       * Strengths: every attempted question in that topic was correct.
       * Weak areas: at least one attempted question in that topic was
       * wrong. A topic can appear in neither list if this particular
       * diagnostic run happened not to sample it.
       */
      function showDiagnosticResults() {
        const ids = filtered.map((q) => q.id);
        const correctCount = ids.filter((id) => diagnosticRun[id]).length;
        const scorePercent = Math.round((correctCount / ids.length) * 100);
        els.card.hidden = true;
        els.empty.hidden = true;
        els.diagWrap.hidden = false;
        els.diagScore.textContent = correctCount + ' / ' + ids.length + ' correct (' + scorePercent + '%)';

        // Search Intelligence Execution Round -- quiz_complete. Diagnostic
        // mode is the only mode with a real, defined end (see
        // docs/growth/practice-analytics-events.md); duration_bucket comes
        // from diagnosticStartTs, a quiz-level timer independent of the
        // separate per-question "timed mode" checkbox, so it's populated
        // on every diagnostic run.
        (function () {
          var durationBucket = null;
          if (diagnosticStartTs) {
            var elapsedMs = Date.now() - diagnosticStartTs;
            var elapsedMin = elapsedMs / 60000;
            durationBucket = elapsedMin < 2 ? '<2min' : elapsedMin < 5 ? '2-5min' : elapsedMin < 10 ? '5-10min' : '10min+';
          }
          var completeParams = {
            total_questions: ids.length,
            correct_count: correctCount,
            incorrect_count: ids.length - correctCount,
            score_percent: scorePercent,
          };
          if (durationBucket) completeParams.duration_bucket = durationBucket;
          track('quiz_complete', completeParams);
          lastDiagnosticScorePercent = scorePercent;
        })();

        const byTopic = topicResultsFor(ids, diagnosticRun);
        const strengths = [...byTopic.values()].filter((t) => t.correct === t.total);
        const weak = [...byTopic.values()].filter((t) => t.correct < t.total);
        els.diagStrengths.innerHTML = strengths.length
          ? strengths.map((t) => '<li class="mb-1">' + t.label + '</li>').join('')
          : '<li class="text-ink-mute">None yet -- try again after reviewing the weak areas below.</li>';
        els.diagWeak.innerHTML = weak.length
          ? weak.map((t) => '<li class="mb-1">' + t.label + ' (' + t.correct + '/' + t.total + ')</li>').join('')
          : '<li class="text-ink-mute">None -- every topic sampled was fully correct.</li>';
        if (els.diagWrap.scrollIntoView) els.diagWrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function applyMode() {
        mode = els.mode.value;
        diagnosticActive = false;
        diagnosticRun = {};
        els.diagWrap.hidden = true;
        els.filter.disabled = mode !== 'standard';
        if (mode === 'standard') {
          applyFilter();
          return;
        }
        if (mode === 'mixed') {
          filtered = buildBalancedSet(Math.min(20, questions.length));
          index = 0;
          render();
          return;
        }
        // diagnostic
        const n = Math.min(25, questions.length);
        filtered = buildBalancedSet(n);
        diagnosticActive = true;
        diagnosticStartTs = Date.now();
        index = 0;
        render();
      }

      function render() {
        stopTimer();
        if (filtered.length === 0) {
          els.card.hidden = true;
          els.empty.hidden = false;
          els.empty.textContent = els.filter.value === 'wrong'
            ? "Nothing marked wrong yet — nothing to review here."
            : "No questions match this filter right now.";
          updateSummary();
          updateWeakTopics();
          updateNotebook();
          updateMastery();
          updateSpacedRetry();
          return;
        }
        els.card.hidden = false;
        els.diagWrap.hidden = true;
        els.empty.hidden = true;
        if (index >= filtered.length) index = 0;
        const q = filtered[index];
        revealed = false;
        els.qnum.textContent = 'Question ' + (index + 1) + ' of ' + filtered.length;
        els.marks.textContent = q.marks + (q.marks === 1 ? ' mark' : ' marks');
        els.question.innerHTML = q.qHtml;
        els.answer.innerHTML = q.aHtml;
        els.answerWrap.hidden = true;
        els.reveal.hidden = false;
        els.right.hidden = true;
        els.wrong.hidden = true;
        els.next.hidden = filtered.length <= 1;
        startTimer();
        updateSummary();
        updateWeakTopics();
        updateNotebook();
        updateMastery();
        updateSpacedRetry();
      }

      function markAttempt(correct) {
        const q = filtered[index];
        if (!q) return;
        const priorAttempt = state.attempts[q.id];
        const wasAlreadyWrong = !!(priorAttempt && priorAttempt.correct === false);
        const topicLabel = q.topics[0] ? q.topics[0].label : 'general';
        state.attempts[q.id] = { correct: correct, ts: Date.now(), timedMode: !!els.timedToggle.checked };
        saveState(state);
        if (diagnosticActive) diagnosticRun[q.id] = correct;

        // Search Intelligence Execution Round -- question_answered fires on
        // every self-mark (Section 7's "every answer is an event" model,
        // chosen given current real traffic volume -- see
        // docs/growth/practice-analytics-events.md). question_correct /
        // question_incorrect fire as a second, thin event per Section 5's
        // explicit event-name list.
        track('question_answered', {
          question_id: q.id,
          topic: topicLabel,
          marks: q.marks,
          practice_mode: mode,
          timed_mode: !!els.timedToggle.checked,
          is_correct: !!correct,
        });
        track(correct ? 'question_correct' : 'question_incorrect', { topic: topicLabel });
        // Only a NEW entry into the wrong-set counts as error_notebook_add --
        // re-marking an already-notebooked question wrong again is not a
        // new addition, just noise duplicating question_answered.
        if (!correct && !wasAlreadyWrong) {
          track('error_notebook_add', { topic: topicLabel });
        }

        updateSummary();
        updateWeakTopics();
        updateNotebook();
        updateMastery();
        updateSpacedRetry();
        els.right.hidden = true;
        els.wrong.hidden = true;
        if (diagnosticActive && index >= filtered.length - 1) {
          setTimeout(() => { showDiagnosticResults(); }, 350);
          return;
        }
        if (filtered.length > 1) {
          setTimeout(() => { index = (index + 1) % filtered.length; render(); }, 350);
        }
      }

      els.reveal.addEventListener('click', () => {
        revealed = true;
        els.answerWrap.hidden = false;
        els.reveal.hidden = true;
        els.right.hidden = false;
        els.wrong.hidden = false;
        stopTimer();
      });
      els.right.addEventListener('click', () => markAttempt(true));
      els.wrong.addEventListener('click', () => markAttempt(false));
      els.next.addEventListener('click', () => { index = (index + 1) % filtered.length; render(); });
      els.filter.addEventListener('change', applyFilter);
      els.timedToggle.addEventListener('change', () => { els.timer.hidden = !els.timedToggle.checked; if (!revealed) startTimer(); });
      els.reset.addEventListener('click', () => {
        if (!confirm('Reset all saved progress for this subject? This cannot be undone.')) return;
        state = { attempts: {} };
        saveState(state);
        els.mode.value = 'standard';
        applyMode();
      });
      els.mode.addEventListener('change', applyMode);
      els.masteryInfo.addEventListener('click', () => {
        els.masteryExplain.hidden = !els.masteryExplain.hidden;
      });
      els.diagRestart.addEventListener('click', () => {
        els.mode.value = 'standard';
        applyMode();
      });
      if (els.teacherSupport) {
        els.teacherSupport.addEventListener('click', () => {
          track('teacher_support_click', {
            source: 'practice_diagnostic',
            score_percent: lastDiagnosticScorePercent,
          });
        });
      }

      /**
       * D-104 follow-up -- fetches the question bank from its own cacheable
       * resource instead of reading it synchronously off the page. `dataUrl`
       * carries a content hash in its query string (see the frontmatter,
       * dataHashFor), so the long `immutable` Cache-Control the endpoint
       * sends is safe: a real content change produces a new URL at the next
       * build, not a stale cached response of an old one. On failure, shows
       * the same "nothing to show" empty state the filter/mode UI already
       * uses elsewhere, rather than leaving the page silently blank.
       */
      async function init() {
        try {
          const res = await fetch(dataUrl);
          if (!res.ok) throw new Error('practice data fetch failed: HTTP ' + res.status);
          questions = await res.json();
        } catch (e) {
          app.classList.remove('hidden');
          els.card.hidden = true;
          els.empty.hidden = false;
          els.empty.textContent = "Couldn't load the practice questions just now -- please refresh the page, or try again shortly.";
          return;
        }
        allTopics = buildTopicsIndex();
        app.classList.remove('hidden');
        track('practice_start', {});
        applyMode();
      }
      init();
    })();
  </script>
</PageLayout>

<style>
  #mb-practice-question :global(p),
  #mb-practice-answer :global(p) {
    margin: 0 0 0.9em 0;
  }
  #mb-practice-question :global(p:last-child),
  #mb-practice-answer :global(p:last-child) {
    margin-bottom: 0;
  }
  #mb-practice-question :global(code),
  #mb-practice-answer :global(code) {
    background: var(--color-ivory, #f7f4ee);
    padding: 0.1em 0.35em;
    border-radius: 3px;
    font-size: 0.92em;
  }
</style>
