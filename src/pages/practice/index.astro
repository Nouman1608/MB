---
/**
 * Practice hub -- /practice/
 *
 * v2.0 AUTHORITY/PRACTICE/TOOLS/GROWTH MEGA PROGRAMME WS6/7/8.
 *
 * Lists the flagship specifications that have a real, working self-check
 * practice session (see src/utils/practice/bank.ts for why this is a
 * self-check engine, not an auto-grader). Only 0620, 9701 and 9702 have
 * practice-questions content today -- 0625 and 0580 are shown honestly as
 * "not yet available" rather than silently omitted or linked to an empty
 * page, matching this codebase's established no-filler, no-silent-gap
 * convention (see e.g. docs/decision-log.md D-050).
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import { flagshipSpecs, academicHubPath } from '../../utils/academic/index.ts';
import { practiceQuestionsForCode } from '../../utils/practice/bank.ts';
import { syllabusFor } from '../../data/academic/syllabuses.ts';
import { routes } from '../../utils/urls/routes';
import CTA from '../../components/ui/CTA.astro';

const path = '/practice/';
const specs = flagshipSpecs().map((f) => {
  const questions = practiceQuestionsForCode(f.code);
  const syllabus = syllabusFor(f.boardSlug, f.qualificationSlug, f.subjectSlug);
  return {
    ...f,
    questionCount: questions.length,
    title: syllabus?.officialTitle ?? `${f.combination.board} ${f.combination.qualification} ${f.combination.subject}`,
  };
});
const available = specs.filter((s) => s.questionCount > 0);
const notYetAvailable = specs.filter((s) => s.questionCount === 0);
---
<PageLayout
  title="Free Practice Questions — Self-Check Study Tool"
  description="Self-check practice sessions for Cambridge IGCSE Chemistry, Physics, Mathematics and A Level Chemistry, Physics — attempt real exam-style questions, reveal the worked answer, and track your own weak topics. No account required."
  path={path}
  eyebrow="Free tool"
  heading="Practice"
  lead="Work through real exam-style questions one at a time, reveal the full worked answer when you're ready, and mark your own attempt. Everything is saved in your browser only — no account, no sign-up."
  breadcrumbs={[
    { label: 'Home', href: routes.home },
    { label: 'Practice', href: path },
  ]}
>
  <Section surface="white">
    <Container>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {available.map((s) => (
          <a
            href={`/practice/${s.code}/`}
            class="flex h-full flex-col gap-3 rounded-sm border border-rule bg-white p-[clamp(22px,2.2vw,30px)] transition-colors duration-150 hover:border-gold-500"
          >
            <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-gold-600">{s.combination.board} {s.combination.qualification}</span>
            <span class="text-[19px] font-semibold tracking-[-0.01em] text-navy-800">{s.combination.subject}</span>
            <span class="text-[13.5px] text-ink-mute">Syllabus {s.code}</span>
            <span class="mt-auto pt-2 text-[13.5px] font-medium text-gold-600">{s.questionCount} practice questions →</span>
          </a>
        ))}
      </div>

      {notYetAvailable.length > 0 && (
        <div class="mt-10 rounded-sm border border-dashed border-rule bg-ivory p-[clamp(20px,2vw,28px)]">
          <p class="m-0 text-[13.5px] font-medium uppercase tracking-[0.1em] text-ink-mute">Not yet available</p>
          <p class="m-0 mt-2 text-[15px] text-ink-mute">
            {notYetAvailable.map((s, i) => (
              <>
                {i > 0 && ', '}
                <a href={academicHubPath(s.combination)} class="underline decoration-gold-500 underline-offset-2 hover:text-gold-600">{s.combination.subject} ({s.code})</a>
              </>
            ))}
            {' '}— {notYetAvailable.length === 1 ? 'has' : 'have'} no published practice questions yet, so there's nothing honest to build a practice session from. Once questions are published for {notYetAvailable.length === 1 ? 'it' : 'them'}, a session will appear here.
          </p>
        </div>
      )}
    </Container>
  </Section>

  <Section surface="ivory" border>
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">How this works</h2>
      <div class="grid gap-6 sm:grid-cols-3">
        <div>
          <p class="m-0 font-semibold text-navy-800">1. Attempt, then reveal</p>
          <p class="m-0 mt-1.5 text-[14.5px] leading-[1.6] text-ink-mute">Work the question on paper first, then reveal the full worked answer — these are original marking-point answers, not a single-word "correct" check.</p>
        </div>
        <div>
          <p class="m-0 font-semibold text-navy-800">2. Mark yourself honestly</p>
          <p class="m-0 mt-1.5 text-[14.5px] leading-[1.6] text-ink-mute">Say whether you got it right or wrong against the worked answer. Your marks are saved in your browser only, on your device — nothing is sent anywhere.</p>
        </div>
        <div>
          <p class="m-0 font-semibold text-navy-800">3. See your weak topics</p>
          <p class="m-0 mt-1.5 text-[14.5px] leading-[1.6] text-ink-mute">Everything you mark wrong goes into your error notebook, grouped by topic, so you know exactly what to revise next — with a link straight back to the relevant study material.</p>
        </div>
      </div>
    </Container>
  </Section>

  <CTA
    surface="ivory"
    heading="Marked a topic as weak more than once? A teacher can work through it with you directly."
    buttonLabel="Find Learning Support"
    buttonHref={routes.tutoring}
  />

</PageLayout>
