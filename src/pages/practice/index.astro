---
/**
 * Practice hub -- /practice/
 *
 * v2.0 AUTHORITY/PRACTICE/TOOLS/GROWTH MEGA PROGRAMME WS6/7/8.
 *
 * Lists the flagship specifications that have a real, working self-check
 * practice session (see src/utils/practice/bank.ts for why this is a
 * self-check engine, not an auto-grader). `available` below is computed
 * dynamically from the real question bank on every build, not hardcoded --
 * as of the Flagship Dominance/Trust programme (2026-08-31) all five
 * flagship specs (0580, 0620, 0625, 9701, 9702) have real content (541
 * questions total), but if a future spec genuinely has none, it is shown
 * honestly as "not yet available" rather than silently omitted or linked
 * to an empty page, matching this codebase's established no-filler,
 * no-silent-gap convention (see e.g. docs/decision-log.md D-050).
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import { flagshipSpecs, academicHubPath } from '../../utils/academic/index.ts';
import { practiceQuestionsForCode } from '../../utils/practice/bank.ts';
import { syllabusFor } from '../../data/academic/syllabuses.ts';
import { routes } from '../../utils/urls/routes';
import CTA from '../../components/ui/CTA.astro';
import { DIAGNOSTIC_SETS, diagnosticPath } from '../../data/diagnostics.ts';

const path = '/practice/';
const specs = flagshipSpecs().map((f) => {
  const questions = practiceQuestionsForCode(f.code);
  const syllabus = syllabusFor(f.boardSlug, f.qualificationSlug, f.subjectSlug);
  return {
    ...f,
    questionCount: questions.length,
    title: syllabus?.officialTitle ?? `${f.combination.board} ${f.combination.qualification} ${f.combination.subject}`,
  };
});
const available = specs.filter((s) => s.questionCount > 0);
const notYetAvailable = specs.filter((s) => s.questionCount === 0);
// D-286: the 10-minute diagnostics, listed first -- the quickest way in.
const diagnostics = DIAGNOSTIC_SETS.map((d) => ({ ...d, spec: specs.find((s) => s.code === d.code)! }));
---
<PageLayout
  title="Free Practice Questions & 10-Minute Diagnostics"
  description="Free 10-minute diagnostics and self-check practice questions for Cambridge and Edexcel IGCSE, O Level and A Level subjects: worked answers, weak-topic tracking, no account."
  path={path}
  eyebrow="Free tool"
  heading="Practice"
  lead="Work through real exam-style questions one at a time, reveal the full worked answer when you're ready, and mark your own attempt. Your progress is saved in your browser — no account, no sign-up."
  breadcrumbs={[
    { label: 'Home', href: routes.home },
    { label: 'Practice', href: path },
  ]}
>
  <Section surface="white">
    <Container>
      <h2 class="m-0 mb-2 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Test my knowledge: 10-minute diagnostics</h2>
      <p class="m-0 mb-5 max-w-[68ch] text-[15px] text-ink-mute">Four to six short questions across a syllabus, then worked answers and a list of topics to practise. You mark yourself; it is a study check, not a predicted grade. <a href="/diagnostics/" class="font-medium text-navy-800 underline decoration-gold-500 underline-offset-2 hover:text-gold-600">See all diagnostics by qualification →</a></p>
      <ul class="m-0 mb-12 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {diagnostics.map((d) => (
          <li class="m-0">
            <a href={diagnosticPath(d)} class="flex h-full flex-col gap-2 rounded-sm border border-gold-500 bg-ivory p-[clamp(20px,2vw,26px)] transition-colors hover:bg-white">
              <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-gold-600">{d.spec.combination.board} {d.spec.combination.qualification} · {d.code}</span>
              <span class="text-[18px] font-semibold text-navy-800">{d.spec.combination.subject}</span>
              <span class="text-[14px] text-ink-mute">{d.scopeLabel} · about {d.minutes} min</span>
            </a>
          </li>
        ))}
      </ul>
      <h2 class="m-0 mb-5 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Self-check practice</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {available.map((s) => (
          <a
            href={`/practice/${s.code}/`}
            class="flex h-full flex-col gap-3 rounded-sm border border-rule bg-white p-[clamp(22px,2.2vw,30px)] transition-colors duration-150 hover:border-gold-500"
          >
            <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-gold-600">{s.combination.board} {s.combination.qualification}</span>
            <span class="text-[19px] font-semibold tracking-[-0.01em] text-navy-800">{s.combination.subject}</span>
            <span class="text-[13.5px] text-ink-mute">Syllabus {s.code}</span>
            <span class="mt-auto pt-2 text-[13.5px] font-medium text-gold-600">{s.questionCount} practice questions →</span>
          </a>
        ))}
      </div>

      {notYetAvailable.length > 0 && (
        <div class="mt-10 rounded-sm border border-dashed border-rule bg-ivory p-[clamp(20px,2vw,28px)]">
          <p class="m-0 text-[13.5px] font-medium uppercase tracking-[0.1em] text-ink-mute">Not yet available</p>
          <p class="m-0 mt-2 text-[15px] text-ink-mute">
            {notYetAvailable.map((s, i) => (
              <>
                {i > 0 && ', '}
                <a href={academicHubPath(s.combination)} class="underline decoration-gold-500 underline-offset-2 hover:text-gold-600">{s.combination.subject} ({s.code})</a>
              </>
            ))}
            {' '}— {notYetAvailable.length === 1 ? 'has' : 'have'} no published practice questions yet, so there's nothing honest to build a practice session from. Once questions are published for {notYetAvailable.length === 1 ? 'it' : 'them'}, a session will appear here.
          </p>
        </div>
      )}
    </Container>
  </Section>

  <Section surface="ivory" border>
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">How this works</h2>
      <div class="grid gap-6 sm:grid-cols-3">
        <div>
          <p class="m-0 font-semibold text-navy-800">1. Attempt, then reveal</p>
          <p class="m-0 mt-1.5 text-[14.5px] leading-[1.6] text-ink-mute">Work the question on paper first, then reveal the full worked answer — these are original marking-point answers, not a single-word "correct" check.</p>
        </div>
        <div>
          <p class="m-0 font-semibold text-navy-800">2. Mark yourself honestly</p>
          <p class="m-0 mt-1.5 text-[14.5px] leading-[1.6] text-ink-mute">Say whether you got it right or wrong against the worked answer. Your marks are saved in your browser, on your device, not on a Marlbridge server. Each mark, including whether you marked it correct, is also sent to Google Analytics as a usage measurement, without cookies unless you have accepted analytics cookies (<a href="/legal/cookies/" class="underline decoration-gold-500 underline-offset-2">Cookie Policy</a>).</p>
        </div>
        <div>
          <p class="m-0 font-semibold text-navy-800">3. See your weak topics</p>
          <p class="m-0 mt-1.5 text-[14.5px] leading-[1.6] text-ink-mute">Everything you mark wrong goes into your error notebook, grouped by topic, so you know exactly what to revise next — with a link straight back to the relevant study material.</p>
        </div>
      </div>
    </Container>
  </Section>

  <CTA
    surface="ivory"
    heading="Marked a topic as weak more than once? A teacher can work through it with you directly."
    buttonLabel="Request a free trial class"
    buttonHref="/trial/?source=practice"
  />

</PageLayout>
