---
/**
 * D-286 -- one workshop: topic, qualification and syllabus, teacher, date,
 * duration and time zone, registration, related revision material, and --
 * after the event -- the recording and transcript (a published `videos`
 * entry named in `recording`).
 *
 * Registration posts to /api/workshop-register (functions/api/
 * workshop-register.ts), which re-checks the workshop against
 * /workshops/{slug}/registration.json, blocks duplicates, and reports
 * success only after the confirmation email was accepted for delivery.
 */
import PageLayout from '../../../layouts/PageLayout.astro';
import Section from '../../../components/layout/Section.astro';
import Container from '../../../components/layout/Container.astro';
import TeachingVideo from '../../../components/media/TeachingVideo.astro';
import ResourceCard from '../../../components/cards/ResourceCard.astro';
import { getWorkshops, isDraft } from '../../../utils/content/media';
import { formatInZone, endIso, isUpcoming, TEACHING_TIME_ZONE } from '../../../utils/content/workshop-time';
import { getEntry, render, type CollectionEntry } from 'astro:content';
import { routes } from '../../../utils/urls/routes';
import { site } from '../../../data/site';
import LazyTurnstile from '../../../components/forms/LazyTurnstile.astro';

export async function getStaticPaths() {
  return (await getWorkshops()).map((w) => ({ params: { slug: w.id }, props: { w } }));
}
const { w } = Astro.props as { w: CollectionEntry<'workshops'> };
const d = w.data;
const teacher = await getEntry(d.teacher);
const subject = await getEntry(d.subject);
const related = (await Promise.all(d.relatedResources.map((r) => getEntry(r)))).filter(Boolean) as CollectionEntry<'resources'>[];
const recording = d.recording ? await getEntry(d.recording) : undefined;
const showRecording = recording && (recording.data.publicationState === 'published' || isDraft(w));
const { Content } = await render(w);
const path = `/workshops/${w.id}/`;
const end = endIso(d.startsAt, d.durationMinutes);
const upcomingAtBuild = isUpcoming(d.startsAt, d.durationMinutes);
const canRegister = d.status === 'scheduled' && d.registration.status === 'open' && upcomingAtBuild;
const event = !isDraft(w) && d.status !== 'cancelled' ? [{
  '@type': 'Event',
  name: d.title,
  description: d.summary,
  startDate: d.startsAt,
  endDate: end,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  location: { '@type': 'VirtualLocation', url: `${site.url}${path}` },
  organizer: { '@type': 'EducationalOrganization', name: 'Marlbridge', url: site.url },
  ...(teacher ? { performer: { '@type': 'Person', name: teacher.data.name } } : {}),
  isAccessibleForFree: true,
}] : [];
---
<PageLayout
  noindex={isDraft(w)}
  title={d.title}
  description={d.summary}
  path={path}
  eyebrow={`Workshop · ${d.syllabusCodes.join(', ')}`}
  heading={d.title}
  lead={d.summary}
  breadcrumbs={[{ label: 'Home', href: routes.home }, { label: 'Workshops', href: '/workshops/' }, { label: d.title, href: path }]}
  jsonLd={event}
>
  <Section surface="white" spacing="md">
    <Container>
      {isDraft(w) && <p class="m-0 mb-6 rounded-sm bg-[#fff4d6] p-3 text-[14px] font-medium text-[#6b4b00]">DRAFT — not published. This page is only built for review (MB_PREVIEW_DRAFTS=1) and is not indexed.</p>}
      {d.status === 'cancelled' && <p class="m-0 mb-6 rounded-sm border border-[#E3BDBD] bg-[#FBF2F2] p-3 text-[15px] text-error">This workshop has been cancelled.</p>}
      <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr]">
        <div>
          <dl class="m-0 grid gap-x-8 gap-y-4 rounded-sm border border-rule bg-ivory p-5 text-[15px] sm:grid-cols-2">
            <div><dt class="font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Topic</dt><dd class="m-0 mt-1">{d.topic}</dd></div>
            <div><dt class="font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Course</dt><dd class="m-0 mt-1">{subject?.data.title} · syllabus {d.syllabusCodes.join(', ')}</dd></div>
            <div><dt class="font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Teacher</dt><dd class="m-0 mt-1">{teacher && <a href={routes.author(teacher.id)} class="underline decoration-gold-500 underline-offset-2">{teacher.data.name}</a>}</dd></div>
            <div><dt class="font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Length and format</dt><dd class="m-0 mt-1">{d.durationMinutes} minutes · {d.format}</dd></div>
            <div class="sm:col-span-2"><dt class="font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">When</dt>
              <dd class="m-0 mt-1">
                <time datetime={d.startsAt}>{formatInZone(d.startsAt, 'UTC')} UTC</time><br />
                {formatInZone(d.startsAt, TEACHING_TIME_ZONE)} Pakistan time (UTC+5)<br />
                <strong data-local-time={d.startsAt}></strong>
              </dd>
            </div>
            <div class="sm:col-span-2"><dt class="font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Who it is for</dt><dd class="m-0 mt-1">{d.audience}</dd></div>
          </dl>
          <div class="mt-6 max-w-[68ch] text-[16.5px] leading-[1.7]"><Content /></div>
          {canRegister && (
            <a data-ics data-title={d.title} data-start={d.startsAt} data-end={end} data-url={`${site.url}${path}`} data-uid={w.id} download={`${w.id}.ics`} href="#" class="mt-4 inline-flex min-h-11 items-center text-[14.5px] font-medium text-navy-800 underline decoration-gold-500 underline-offset-2">Add to my calendar (.ics)</a>
          )}
        </div>
        <div>
          {canRegister ? (
            <section aria-labelledby="reg-h" class="rounded-sm border border-rule bg-white p-5" data-register-wrap data-starts={d.startsAt}>
              <h2 id="reg-h" class="m-0 text-[19px] font-semibold text-navy-800">Register — free</h2>
              <p class="m-0 mt-1 text-[14px] text-ink-mute">We'll email a confirmation now and the joining link before the start.{d.registration.capacity ? ` Places are limited to ${d.registration.capacity}.` : ''}</p>
              <form class="mt-4 grid gap-4" novalidate data-register-form>
                <div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden"><label for="reg-web">Website</label><input id="reg-web" name="website" tabindex={-1} autocomplete="off" /></div>
                <input type="hidden" name="workshop" value={w.id} />
                <div class="grid gap-1.5"><label for="reg-name" class="text-[14px] font-medium">Name</label><input id="reg-name" name="name" required autocomplete="name" class="min-h-11 rounded-sm border border-rule px-3" /><p class="m-0 text-[13.5px] text-error" hidden data-err="name"></p></div>
                <div class="grid gap-1.5"><label for="reg-email" class="text-[14px] font-medium">Email</label><input id="reg-email" name="email" type="email" required autocomplete="email" class="min-h-11 rounded-sm border border-rule px-3" /><p class="m-0 text-[13.5px] text-error" hidden data-err="email"></p></div>
                <div class="grid gap-1.5"><label for="reg-country" class="text-[14px] font-medium">Country</label><input id="reg-country" name="country" required autocomplete="country-name" class="min-h-11 rounded-sm border border-rule px-3" /><p class="m-0 text-[13.5px] text-error" hidden data-err="country"></p></div>
                <div class="grid gap-1.5"><label for="reg-role" class="text-[14px] font-medium">I am a</label>
                  <select id="reg-role" name="role" class="min-h-11 rounded-sm border border-rule bg-white px-3"><option value="student">Student</option><option value="parent">Parent</option><option value="teacher">Teacher</option><option value="other">Other</option></select></div>
                {site.turnstile.siteKey && <div class="cf-turnstile" data-sitekey={site.turnstile.siteKey}></div>}
                <p class="m-0 text-[13px] text-ink-mute">We use these details only to run this workshop. See the <a href="/legal/privacy/" class="underline decoration-gold-500 underline-offset-2">Privacy Policy</a>.</p>
                <button type="submit" class="min-h-11 rounded-sm bg-navy-800 px-6 text-[15px] font-medium text-ivory hover:bg-navy-700 disabled:opacity-60">Register</button>
                <p role="status" aria-live="polite" class="m-0 text-[14.5px]" data-register-status></p>
              </form>
            </section>
          ) : (
            <p class="m-0 rounded-sm border border-rule bg-ivory p-5 text-[15px] text-ink-mute">{d.status === 'cancelled' ? 'Registration is closed: this workshop was cancelled.' : upcomingAtBuild ? (d.registration.status === 'full' ? 'This workshop is full.' : 'Registration is not open.') : 'This workshop has taken place.'}</p>
          )}
        </div>
      </div>

      {showRecording && recording && (
        <section aria-labelledby="rec-h" class="mt-12">
          <h2 id="rec-h" class="m-0 mb-4 text-[length:var(--text-h2)] font-semibold text-navy-800">Recording and transcript</h2>
          <div class="max-w-[760px]"><TeachingVideo video={recording} /></div>
        </section>
      )}

      {related.length > 0 && (
        <section aria-labelledby="rel-h" class="mt-12">
          <h2 id="rel-h" class="m-0 mb-4 text-[length:var(--text-h2)] font-semibold text-navy-800">Revise before or after</h2>
          <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => <li class="m-0"><ResourceCard entry={r} /></li>)}
          </ul>
        </section>
      )}
    </Container>
  </Section>
</PageLayout>

{canRegister && site.turnstile.siteKey && <LazyTurnstile />}
<script>
  import { applyLocalTimes, icsHref } from '../../../scripts/workshop-client';
  applyLocalTimes();
  document.querySelectorAll<HTMLAnchorElement>('[data-ics]').forEach((a) => {
    a.href = icsHref({ uid: a.dataset.uid!, title: a.dataset.title!, start: a.dataset.start!, end: a.dataset.end!, url: a.dataset.url!, description: `Marlbridge workshop. Details: ${a.dataset.url}` });
  });
  const wrap = document.querySelector<HTMLElement>('[data-register-wrap]');
  if (wrap && Date.parse(wrap.dataset.starts ?? '') < Date.now()) {
    wrap.replaceChildren(Object.assign(document.createElement('p'), { className: 'm-0 text-[15px] text-ink-mute', textContent: 'Registration has closed: this workshop has started.' }));
  }
  const form = document.querySelector<HTMLFormElement>('[data-register-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-register-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    let done = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (done) return;
      form.querySelectorAll<HTMLElement>('[data-err]').forEach((p) => { p.hidden = true; });
      const fd = new FormData(form);
      const errs: Record<string, string> = {};
      if (!String(fd.get('name') ?? '').trim()) errs.name = 'Please enter your name.';
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(fd.get('email') ?? ''))) errs.email = 'Please enter a valid email address.';
      if (!String(fd.get('country') ?? '').trim()) errs.country = 'Please enter your country.';
      const show = (m: Record<string, string>) => Object.entries(m).forEach(([k, v]) => { const p = form.querySelector<HTMLElement>(`[data-err="${k}"]`); if (p) { p.textContent = v; p.hidden = false; } });
      if (Object.keys(errs).length) { show(errs); (form.querySelector(`[name="${Object.keys(errs)[0]}"]`) as HTMLElement | null)?.focus(); return; }
      button.disabled = true;
      status.className = 'm-0 text-[14.5px] text-ink-mute';
      status.textContent = 'Registering…';
      try {
        const res = await fetch('/api/workshop-register', { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        const body = await res.json().catch(() => ({}));
        if (res.ok && body.ok) {
          done = true;
          status.className = 'm-0 rounded-sm border border-[#B9D3C6] bg-[#F1F7F4] p-3 text-[14.5px] text-success';
          status.textContent = body.message ?? 'You are registered. Check your email for the confirmation.';
          form.querySelectorAll<HTMLInputElement>('input, select').forEach((i) => { i.disabled = true; });
          try { (window as unknown as { mbTrack?: (n: string, p: Record<string, unknown>) => void }).mbTrack?.('workshop_registration_success', { workshop: String(fd.get('workshop')) }); } catch { /* ignore */ }
          return;
        }
        if (body.errors) show(body.errors);
        status.className = 'm-0 rounded-sm border border-[#E3BDBD] bg-[#FBF2F2] p-3 text-[14.5px] text-error';
        status.textContent = body.message ?? 'Registration failed. Please try again.';
      } catch {
        status.className = 'm-0 rounded-sm border border-[#E3BDBD] bg-[#FBF2F2] p-3 text-[14.5px] text-error';
        status.textContent = 'We could not reach the server. Please check your connection and try again.';
      }
      if (!done) button.disabled = false;
    });
  }
</script>
