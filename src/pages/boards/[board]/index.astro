---
/**
 * Board hub — /boards/{board}/
 *
 * Every publishable qualification x subject combination for one board,
 * grouped by qualification. Routes come exclusively from
 * boardsWithCombinations() (itself derived from activeOnly()), so a board
 * with zero publishable combinations — or OCR, which is architecturally
 * excluded by board.status — cannot produce a page here.
 */
import PageLayout from '../../../layouts/PageLayout.astro';
import Section from '../../../components/layout/Section.astro';
import Container from '../../../components/layout/Container.astro';
import FAQ from '../../../components/ui/FAQ.astro';
import CTA from '../../../components/ui/CTA.astro';
import {
  boardPath, boardsPath, combinationsForBoard,
  boardsWithCombinations, academicHubPath,
} from '../../../utils/academic';
import { boardBySlug } from '../../../data/academic/boards';
import { routes } from '../../../utils/urls/routes';
import { faqNode } from '../../../utils/schema/faq';

export async function getStaticPaths() {
  return boardsWithCombinations().map((boardSlug) => ({ params: { board: boardSlug } }));
}

const { board: boardSlug } = Astro.params;
const board = boardBySlug(boardSlug as string)!;
const combos = combinationsForBoard(boardSlug as string);

const byQualification = new Map<string, typeof combos>();
for (const c of combos) {
  if (!byQualification.has(c.qualificationSlug)) byQualification.set(c.qualificationSlug, []);
  byQualification.get(c.qualificationSlug)!.push(c);
}
const groups = [...byQualification.entries()]
  .map(([qualificationSlug, items]) => ({
    qualificationSlug,
    qualification: items[0].qualification,
    items: items.slice().sort((a, b) => a.subject.localeCompare(b.subject)),
  }))
  .sort((a, b) => a.qualification.localeCompare(b.qualification));

const path = boardPath(boardSlug as string);

/**
 * FAQ content is generated strictly from the already-computed combos/groups
 * above — every figure and every board/qualification name is read straight
 * from the ACTIVE matrix data rendered on this page, never invented.
 */
const qualificationNames = groups.map((g) => g.qualification);
const subjectCount = new Set(combos.map((c) => c.subjectSlug)).size;
const faqs = [
  {
    question: `Which qualifications does Marlbridge teach for ${board.name}?`,
    answer: `Marlbridge currently publishes ${board.name} material for ${
      qualificationNames.length === 1
        ? qualificationNames[0]
        : `${qualificationNames.slice(0, -1).join(', ')} and ${qualificationNames[qualificationNames.length - 1]}`
    }.`,
  },
  {
    question: `How many ${board.name} subjects does Marlbridge teach?`,
    answer: `Marlbridge publishes ${combos.length} ${board.name} subject and qualification combinations, covering ${subjectCount} distinct subject${subjectCount === 1 ? '' : 's'}.`,
  },
];
const faq = faqNode(faqs);
---
<PageLayout
  title={board.name}
  description={`${board.name} qualifications taught by Marlbridge — every subject and qualification combination we publish, in one place.`}
  path={path}
  eyebrow="Board"
  heading={board.name}
  lead={`Every ${board.name} qualification and subject combination Marlbridge publishes, grouped by qualification.`}
  breadcrumbs={[
    { label: 'Home', href: routes.home },
    { label: 'Boards', href: boardsPath() },
    { label: board.name, href: path },
  ]}
  jsonLd={faq ? [faq] : []}
>
  <Section surface="white">
    <Container>
      <p class="m-0 mb-[clamp(32px,4vw,56px)] max-w-[68ch] text-[17px] leading-[1.7] text-ink-mute">{board.about}</p>
      {groups.map((g) => (
        <div class="mb-[clamp(32px,4vw,56px)] last:mb-0">
          <h2 class="m-0 mb-4 border-b-2 border-navy-800 pb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">{g.qualification}</h2>
          <ul class="m-0 grid list-none gap-px border border-rule bg-rule p-0 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((c) => (
              <li class="m-0 bg-white">
                <a href={academicHubPath(c)} class="group flex h-full flex-col justify-between gap-2 p-5">
                  <span class="font-display text-xl tracking-[-0.01em] text-navy-800 group-hover:text-gold-600">{c.subject}</span>
                  {c.qualificationCode && <span class="font-mono text-[12px] text-ink-mute">Specification {c.qualificationCode}</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </Container>
  </Section>

  <Section surface="ivory" labelledby="board-faqs" border>
    <Container>
      <h2 id="board-faqs" class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Questions</h2>
      <div class="max-w-[80ch]">
        <FAQ items={faqs} />
      </div>
    </Container>
  </Section>

  <CTA
    heading={`Studying ${/^[aeiou]/i.test(board.name) ? 'an' : 'a'} ${board.name} qualification? Tell us where the difficulty is.`}
    buttonLabel="Find Learning Support"
    buttonHref={routes.tutoring}
  />
</PageLayout>
