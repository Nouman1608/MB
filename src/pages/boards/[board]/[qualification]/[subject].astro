---
/**
 * Academic hub — /boards/{board}/{qualification}/{subject}/
 *
 * REFERENCE IMPLEMENTATION for the whole Marlbridge academic system.
 *
 * Routes come exclusively from activeOnly(), which requires marlbridgeStatus
 * ACTIVE. A combination that is UNKNOWN, FUTURE or NOT_SUPPORTED cannot
 * produce a page here, so OCR, AQA IGCSE and every unapproved combination are
 * structurally excluded rather than merely omitted.
 *
 * Nothing on this page is invented. Syllabus facts come from the awarding
 * body (src/data/academic/syllabuses.ts); resources and articles come from the
 * content collections. Sections with no genuine content render an honest empty
 * state instead of filler.
 */
import { getEntry } from 'astro:content';
import PageLayout from '../../../../layouts/PageLayout.astro';
import Section from '../../../../components/layout/Section.astro';
import Container from '../../../../components/layout/Container.astro';
import ResourceCard from '../../../../components/cards/ResourceCard.astro';
import ArticleCard from '../../../../components/cards/ArticleCard.astro';
import RelatedGrid from '../../../../components/layout/RelatedGrid.astro';
import EmptyState from '../../../../components/ui/EmptyState.astro';
import CTA from '../../../../components/ui/CTA.astro';
import { activeOnly, offeringsForSubject, academicHubPath, boardPath, levelPath, LEVEL_FOR_QUALIFICATION, type Combination } from '../../../../utils/academic';
import { subjectBySlug } from '../../../../data/academic/subjects';
import { syllabusFor } from '../../../../data/academic/syllabuses';
import { assessmentsFor } from '../../../../data/academic/assessments';
import { topicsFor, hasStages } from '../../../../data/academic/syllabus-topics';
import { getResources } from '../../../../utils/content/collections';
import { isIndexableAcademicPage } from '../../../../utils/seo/indexability';
import { relatedArticles } from '../../../../utils/content/related';
import { courseNode } from '../../../../utils/schema/course';
import { faqNode } from '../../../../utils/schema/faq';
import FAQ from '../../../../components/ui/FAQ.astro';
import { enrolmentOpenFor } from '../../../../utils/content/status';
import { routes } from '../../../../utils/urls/routes';

export async function getStaticPaths() {
  return activeOnly().map((c) => ({
    params: { board: c.boardSlug, qualification: c.qualificationSlug, subject: c.subjectSlug },
    props: { combination: c },
  }));
}

const { combination: c } = Astro.props as { combination: Combination };
const path = academicHubPath(c);
const syllabus = syllabusFor(c.boardSlug, c.qualificationSlug, c.subjectSlug);

/**
 * v1.x CLOSURE WS5 -- real, sourced assessment structure (papers,
 * duration, marks, weighting) for this combination, when it has been
 * modeled (src/data/academic/assessments.ts). A bounded first batch of 12
 * combinations is modeled as of this release; every other ACTIVE
 * combination honestly renders "not yet modeled" below rather than either
 * inventing figures or silently omitting the section -- see
 * docs/decision-log.md D-050.
 */
const assessments = assessmentsFor(c.boardSlug, c.qualificationSlug, c.subjectSlug);
const ASSESSMENT_TYPE_LABEL: Record<string, string> = {
  'written-exam': 'Written exam',
  'multiple-choice': 'Multiple choice',
  coursework: 'Coursework',
  'non-exam-assessment': 'Non-exam assessment',
  practical: 'Practical',
  'alternative-to-practical': 'Alternative to practical',
  'practical-endorsement': 'Practical endorsement',
  oral: 'Oral',
  speaking: 'Speaking',
  listening: 'Listening',
  reading: 'Reading',
  writing: 'Writing',
  portfolio: 'Portfolio',
  project: 'Project',
  unit: 'Unit',
  endorsement: 'Endorsement',
};
/** v2.0 MEGA PROGRAMME WS12 -- assessmentModel vocabulary, one-line label
 * shown per assessment record when the field is populated (18 pre-v2.0
 * records deliberately have no assessmentModel; see its doc comment in
 * assessments.ts -- those simply omit this line). */
const ASSESSMENT_MODEL_LABEL: Record<string, string> = {
  linear: 'Linear qualification',
  modular: 'Modular qualification',
  staged: 'Staged qualification',
  'unit-based': 'Unit-based qualification',
  'component-based': 'Component-based qualification',
  mixed: 'Mixed assessment model',
};
const TIER_LABEL: Record<string, string> = {
  'not-tiered': '',
  core: 'Core',
  extended: 'Extended',
  foundation: 'Foundation',
  higher: 'Higher',
  'first-language': 'First Language',
  'second-language': 'Second Language',
  'as-only': 'AS',
  'a2-only': 'A2',
};

// LEVEL_FOR_QUALIFICATION now lives in utils/academic (shared with
// astro.config.mjs's sitemap indexability step -- see that file).
const levelKey = LEVEL_FOR_QUALIFICATION[c.qualificationSlug];

// The matrix's subjectSlug and the subjects content collection's id can
// differ (e.g. matrix 'english-language' -> hub 'english') — always resolve
// through the canonical registry's hubId rather than assuming they match,
// so this never silently 404s or links to a nonexistent hub.
const hubSlug = subjectBySlug(c.subjectSlug)?.hubId ?? c.subjectSlug;
const subjectEntry = await getEntry('subjects', hubSlug);
const allResources = await getResources();
// Resources reference the subjects CONTENT id (hubSlug), not the matrix
// subjectSlug — those diverge for e.g. matrix 'english-language' -> content
// id 'english'. Filtering on c.subjectSlug here silently hid every resource
// for any subject whose hubId differs from its matrix slug (Workstream 9
// finding: AQA GCSE English Language resources were invisible on this page
// for exactly this reason, even though they render correctly on the
// English subject hub, which already used hubSlug).
// A resource must also apply to THIS board: either genuinely board-agnostic
// (boards: [], e.g. general study-skills material) or explicitly tagged
// with c.boardSlug. Without this, a board-specific resource (most of them
// carry a boards[] tag — see content.config.ts) would silently surface on
// every other board's leaf page for the same subject/level, misrepresenting
// e.g. AQA-specific syllabus content as relevant to OxfordAQA or Cambridge
// students. Found via v1.0 WS7 audit: an AQA-only Sociology resource
// (boards: ["aqa"]) was rendering on the OxfordAQA A-level Sociology page.
const resources = allResources.filter(
  (r) =>
    r.data.subject.id === hubSlug &&
    r.data.level.includes(levelKey as never) &&
    (r.data.boards.length === 0 || r.data.boards.includes(c.boardSlug as never)),
);

const study = resources.filter((r) => ['study-guides', 'revision-notes', 'subject-guides'].includes(r.data.resourceType));
const revision = resources.filter((r) => r.data.resourceType === 'revision-notes');
const examPrep = resources.filter((r) => ['past-papers', 'practice-questions', 'exam-preparation'].includes(r.data.resourceType));
const articles = await relatedArticles({ subject: hubSlug, limit: 3 });

/**
 * Official syllabus topics, straight from the awarding body's document.
 * Marlbridge resource coverage is computed per topic so the page can state
 * plainly which topics we have material for — and which we do not.
 */
const syllabusTopics = topicsFor(c.boardSlug, c.qualificationSlug, c.subjectSlug);
const coverage = (syllabusTopics?.topics ?? []).map((t) => ({
  topic: t,
  resources: resources.filter((r) =>
    r.data.syllabusTopics.some((m) => m.qualification === c.qualificationSlug && m.topic === t.slug),
  ),
}));
const covered = coverage.filter((x) => x.resources.length > 0).length;
const staged = syllabusTopics ? hasStages(syllabusTopics) : false;
/** 9701 is presented as two clearly separated stages, never one flat list. */
const groups: { label: string; note: string; items: typeof coverage }[] = staged
  ? [
      { label: 'AS Level', note: 'Topics 1–22. Studied in the first year, and assessed on the AS papers.',
        items: coverage.filter((x) => x.topic.stage === 'AS') },
      { label: 'A Level', note: 'Topics 23–37. Studied in addition to the AS content for the full A Level.',
        items: coverage.filter((x) => x.topic.stage === 'A') },
    ]
  : [{ label: '', note: '', items: coverage }];

/** The other approved qualifications for this subject — the sibling hubs. */
const siblings = offeringsForSubject(c.subjectSlug).filter((o) => o.qualificationSlug !== c.qualificationSlug);

const heading = `${c.board} ${c.qualification} ${c.subject}`;
const title = syllabus ? `${heading} (${syllabus.code})` : heading;

/**
 * Differentiated meta description (Aug 2026 SEO remediation, Phase 4/9).
 *
 * The old description was one fixed template string for all 160 hub
 * pages -- board/qualification/subject/code varied, but the rest was
 * identical boilerplate ("overview, topics and study resources... Free
 * to read") regardless of what was actually on the page. That is exactly
 * the "near-identical descriptions" problem search consoles flag, and it
 * wastes the description's one real job: telling a searcher what makes
 * *this* result different from the next one. Real differentiators are
 * available at this point in the template -- syllabus code and, since
 * D-023/D-024, real resource type/count data -- so use them instead.
 */
const RESOURCE_TYPE_LABEL: Record<string, string> = {
  'study-guides': 'study guides',
  'revision-notes': 'revision notes',
  'past-papers': 'past-paper guidance',
  'practice-questions': 'practice questions',
  'exam-preparation': 'exam preparation guides',
  'subject-guides': 'a subject guide',
};
const presentResourceTypes = [...new Set(resources.map((r) => r.data.resourceType))]
  .map((t) => RESOURCE_TYPE_LABEL[t] ?? t);
// Never claim resource availability this combination doesn't have --
// the explicit false branch here is what the "no resources" case reads
// as, rather than silently reusing generic "study resources" language.
const resourceSummary = presentResourceTypes.length > 0
  ? `${resources.length} original resource${resources.length === 1 ? '' : 's'} (${presentResourceTypes.join(', ')})`
  : 'no original Marlbridge resource yet';
const pageDescription = `${heading}${syllabus ? ` (${syllabus.code})` : ''}: what the qualification covers, and ${resourceSummary} Marlbridge has published for it.`.replace(/\s+/g, ' ');

/**
 * Indexability (Aug 2026 SEO remediation — Phase 1/2).
 *
 * activeOnly() legitimately produces a page for every ACTIVE combination in
 * the academic matrix, but a combination can be approved long before any
 * syllabus topics have been transcribed or any substantial resource
 * written. Those pages render nothing but honest empty states — or, worse,
 * a single thin stub — genuinely useful to a human who lands on one,
 * genuinely worthless as a search result.
 *
 * The decision itself lives in one place, src/utils/seo/indexability.ts
 * (isIndexableAcademicPage), so the exact same rule also governs sitemap
 * inclusion (astro.config.mjs) instead of the two drifting independently.
 * A single 100-word resource used to be enough to mark a page indexable;
 * it no longer is — see that file for the substantial-content threshold
 * and why 400 words was chosen.
 *
 * `noindex, follow` (see components/seo/Meta.astro) still keeps the page
 * served and in the internal link graph, preserving link equity flow to
 * the pages that do have content — this only withholds it from search
 * results until it earns a place there.
 *
 * This is deliberately NOT based on `marlbridgeTeaches` — whether we teach a
 * combination is a separate fact from whether this page has anything on it.
 */
const hasSyllabusTopics = (syllabusTopics?.topics ?? []).length > 0;
const indexability = isIndexableAcademicPage({
  resources: resources.map((r) => ({
    resourceType: r.data.resourceType,
    wordCount: r.body?.trim().split(/\s+/).filter(Boolean).length ?? 0,
  })),
  hasSyllabusTopics,
});
const isThin = !indexability.indexable;

/**
 * v2.0 MEGA PROGRAMME WS15 -- AEO/AIO: FAQ content generated strictly from
 * the already-computed `assessments` array above (the same data the visible
 * Assessment structure table renders), matching the discipline
 * src/pages/levels/[qualification]/index.astro already established for its
 * own FAQ block -- every figure here is read straight from a sourced
 * assessments.ts record, never invented or computed by summing marks across
 * components that may be mutually-exclusive alternatives (alternativeGroup/
 * routeGroup components are listed individually with their own real marks/
 * weighting, not aggregated into a total that could silently double-count a
 * choice). Only emitted when a real assessment record exists -- combinations
 * still NOT_YET_MODELED get no FAQ, matching the honest "not yet modeled"
 * fallback the visible table already uses.
 */
const primaryAssessment = assessments.find((a) => a.specStatus === 'current') ?? assessments[0];
const faqs: { question: string; answer: string }[] = [];
if (primaryAssessment) {
  const componentList = primaryAssessment.components
    .map((comp) => {
      const dur = comp.durationMinutes
        ? `${Math.floor(comp.durationMinutes / 60)}h${comp.durationMinutes % 60 ? ` ${comp.durationMinutes % 60}m` : ''}`.trim()
        : 'no fixed duration';
      return `${comp.paperCode} (${comp.title}) — ${dur}, ${comp.marks} marks, ${comp.weightingPercent}% of the qualification`;
    })
    .join('; ');
  const modelPhrase = primaryAssessment.assessmentModel ? ` It is a ${primaryAssessment.assessmentModel.replace('-', ' ')} qualification.` : '';
  faqs.push({
    question: `How is ${c.board} ${c.subject} (${primaryAssessment.code}) assessed?`,
    answer: `${c.board} ${c.subject} (${primaryAssessment.code}) is assessed through: ${componentList}.${modelPhrase} Source: official ${c.board} specification, verified ${primaryAssessment.verifiedOn}.`,
  });
  if (assessments.length > 1) {
    const future = assessments.find((a) => a.specStatus === 'future');
    const legacy = assessments.find((a) => a.specStatus === 'legacy-teach-out');
    if (future) {
      faqs.push({
        question: `Is there a new ${c.board} ${c.subject} specification coming?`,
        answer: `Yes. ${future.code} is an upcoming specification${future.relatedCode ? `, replacing ${future.relatedCode}` : ''}${future.firstTeaching ? `, for first teaching from ${future.firstTeaching}` : ''}. First assessment: ${future.firstAssessment}. Until then, ${primaryAssessment.code} remains the specification current students follow.`,
      });
    }
    if (legacy) {
      faqs.push({
        question: `Is ${legacy.code} being withdrawn?`,
        answer: `Yes. ${legacy.code} is being withdrawn${legacy.relatedCode ? ` in favour of ${legacy.relatedCode}` : ''}.${legacy.finalAssessment ? ` Final assessment opportunity: ${legacy.finalAssessment}.` : ''}`,
      });
    }
  }
}
const faq = faqNode(faqs);

const jsonLd = [
  courseNode({
    path,
    name: syllabus?.officialTitle ?? heading,
    description: `${heading} teaching and study resources from Marlbridge.`,
  }),
  ...(faq ? [faq] : []),
];
---
<PageLayout
  noindex={isThin}
  title={title}
  description={pageDescription}
  path={path}
  eyebrow={`${c.board} · ${c.qualification}`}
  heading={heading}
  lead={`${c.subject} for ${c.board} ${c.qualification}${syllabus ? ` (syllabus ${syllabus.code})` : ''} — what the qualification covers, and the study material Marlbridge publishes for it.`}
  breadcrumbs={[
    { label: 'Home', href: routes.home },
    { label: 'Subjects', href: routes.subjects },
    { label: c.subject, href: routes.subject(hubSlug) },
    { label: `${c.board} ${c.qualification}`, href: path },
  ]}
  jsonLd={jsonLd}
>
  <dl slot="hero-extra" class="m-0 mt-7 flex flex-wrap gap-x-8 gap-y-3 text-[14px]">
    {syllabus && (
      <div class="m-0"><dt class="m-0 inline font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Syllabus </dt><dd class="m-0 inline text-ink-mute">{syllabus.code}</dd></div>
    )}
    <div class="m-0"><dt class="m-0 inline font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Board </dt><dd class="m-0 inline text-ink-mute"><a href={boardPath(c.boardSlug)} class="underline decoration-gold-500 underline-offset-2 hover:text-gold-600">{c.board}</a></dd></div>
    <div class="m-0"><dt class="m-0 inline font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Qualification </dt><dd class="m-0 inline text-ink-mute"><a href={levelPath(c.qualificationSlug)} class="underline decoration-gold-500 underline-offset-2 hover:text-gold-600">{c.qualification}</a></dd></div>
  </dl>

  {/*
    v1.2 WS10 — a concise, answer-first "at a glance" box near the top of
    every leaf page, covering exactly the questions a reader (or an AI
    system extracting an answer) asks first: what qualification is this,
    what's its spec code, does Marlbridge teach it, are resources
    available, is enrolment open, and where was this verified. Every value
    is read from real data already computed above (syllabus, resources,
    enrolmentOpenFor) -- nothing here is new copy invented for this box.
  */}
  <Section surface="ivory" labelledby="at-a-glance-heading" spacing="md" border>
    <Container>
      <h2 id="at-a-glance-heading" class="sr-only">At a glance</h2>
      <dl class="m-0 grid gap-x-8 gap-y-4 text-[15px] sm:grid-cols-2 lg:grid-cols-3">
        <div class="m-0"><dt class="m-0 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Qualification</dt><dd class="m-0 mt-1 text-ink">{c.board} {c.qualification} {c.subject}</dd></div>
        <div class="m-0"><dt class="m-0 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Spec code</dt><dd class="m-0 mt-1 text-ink">{syllabus?.code ?? 'Being verified'}</dd></div>
        <div class="m-0"><dt class="m-0 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Does Marlbridge teach it?</dt><dd class="m-0 mt-1 text-ink">Yes</dd></div>
        <div class="m-0"><dt class="m-0 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Are resources available?</dt><dd class="m-0 mt-1 text-ink">{resources.length > 0 ? `Yes — ${resources.length} published` : 'Not yet — none published for this exact combination'}</dd></div>
        <div class="m-0"><dt class="m-0 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Is enrolment open?</dt><dd class="m-0 mt-1 text-ink">{enrolmentOpenFor('teaching') === 'enquire' ? 'Enquire to join — no online enrolment yet' : 'Not applicable'}</dd></div>
        <div class="m-0"><dt class="m-0 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Where was this verified?</dt><dd class="m-0 mt-1 text-ink">{syllabus ? <>{syllabus.verifiedOn}, official {c.board} specification</> : 'Not yet verified against an official source'}</dd></div>
      </dl>
    </Container>
  </Section>

  <Section surface="white">
    <Container>
      <div class="grid items-start gap-8 lg:grid-cols-[minmax(280px,0.8fr)_1.6fr] lg:gap-[clamp(32px,5vw,88px)]">
        <h2 class="m-0 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">The qualification</h2>
        <div class="max-w-[68ch] text-[17.5px] leading-[1.7]">
          {syllabus ? (
            <>
              <p class="m-0 text-[16.5px] text-ink-mute">
                <strong class="font-semibold text-navy-800">{syllabus.officialTitle}</strong>
              </p>
              <blockquote class="m-0 mt-4 border-s-2 border-gold-500 ps-4 text-[17px] text-ink-mute">
                {syllabus.boardSummary}
                <cite class="mt-2 block text-[14px] not-italic">
                  — {c.board}, <a href={syllabus.officialUrl} rel="nofollow noopener" class="underline decoration-rule underline-offset-2">official syllabus page</a>
                </cite>
              </blockquote>
              {syllabus.notes && <p class="m-0 mt-4 text-[15.5px] text-ink-mute">{syllabus.notes}</p>}
              <p class="m-0 mt-5 text-[15.5px] text-ink-mute">
                Specifications change between examination series. Always confirm the current syllabus and assessment structure on
                <a href={syllabus.officialUrl} rel="nofollow noopener" class="underline decoration-gold-500 underline-offset-2"> the {c.board} syllabus page</a> for your examination year.
              </p>
            </>
          ) : (
            <p class="m-0 text-ink-mute">Syllabus details for this qualification are being verified against the awarding body and will be published once confirmed.</p>
          )}
        </div>
      </div>

      <div class="mt-[clamp(48px,6vw,80px)] grid items-start gap-8 border-t border-rule pt-[clamp(32px,4vw,56px)] lg:grid-cols-[minmax(280px,0.8fr)_1.6fr] lg:gap-[clamp(32px,5vw,88px)]">
        <h2 class="m-0 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Assessment structure</h2>
        <div class="max-w-[68ch] text-[17.5px] leading-[1.7]">
          {assessments.length > 0 ? (
            assessments.map((a) => (
              <div class="mb-8 last:mb-0">
                {assessments.length > 1 && (
                  <p class="m-0 mb-2 text-[13px] font-semibold uppercase tracking-[0.08em] text-gold-600">
                    {a.code}{a.tiers[0] !== 'not-tiered' ? ` — ${a.tiers.map((t) => TIER_LABEL[t] ?? t).join(' / ')}` : ''}
                    {a.specStatus === 'legacy-teach-out' && ' (being withdrawn)'}
                    {a.specStatus === 'future' && ' (upcoming — not yet current)'}
                    {a.specStatus === 'withdrawn' && ' (withdrawn — no longer assessable)'}
                  </p>
                )}
                {a.specStatus === 'legacy-teach-out' && (
                  <p class="m-0 mb-3 text-[15px] text-ink-mute">
                    {a.code} is being withdrawn{a.relatedCode && <> in favour of {a.relatedCode}</>}.
                    {a.finalAssessment && <> Final assessment opportunity: {a.finalAssessment}.</>}
                  </p>
                )}
                {a.specStatus === 'future' && (
                  <p class="m-0 mb-3 text-[15px] text-ink-mute">
                    {a.code} is an upcoming specification{a.relatedCode && <>, replacing {a.relatedCode}</>}
                    {a.firstTeaching && <>, for first teaching from {a.firstTeaching}</>}. First assessment: {a.firstAssessment}.
                    {' '}It is not yet the specification current students should follow{a.relatedCode && <> — that remains {a.relatedCode} until this one begins</>}.
                  </p>
                )}
                {a.specStatus === 'withdrawn' && (
                  <p class="m-0 mb-3 text-[15px] text-ink-mute">
                    {a.code} has been withdrawn and is no longer assessable{a.relatedCode && <>; see {a.relatedCode}</>}. Shown here for historical reference only.
                  </p>
                )}
                {a.assessmentModel && (
                  <p class="m-0 mb-2 text-[13px] text-ink-mute">{ASSESSMENT_MODEL_LABEL[a.assessmentModel] ?? a.assessmentModel}</p>
                )}
                <table class="w-full border-collapse text-[15px]">
                  <thead>
                    <tr class="border-b border-rule text-left">
                      <th class="py-2 pe-3 font-semibold text-navy-800">Component</th>
                      <th class="py-2 pe-3 font-semibold text-navy-800">Duration</th>
                      <th class="py-2 pe-3 font-semibold text-navy-800">Marks</th>
                      <th class="py-2 pe-3 font-semibold text-navy-800">Weighting</th>
                      <th class="py-2 font-semibold text-navy-800">Type</th>
                    </tr>
                  </thead>
                  <tbody>
                    {a.components.map((comp) => (
                      <tr class="border-b border-rule/60">
                        <td class="py-2 pe-3 text-ink">
                          {comp.paperCode}: {comp.title}
                          {comp.tier && comp.tier !== 'not-tiered' && <span class="text-ink-mute"> ({TIER_LABEL[comp.tier] ?? comp.tier})</span>}
                        </td>
                        <td class="py-2 pe-3 text-ink-mute">{comp.durationMinutes ? `${Math.floor(comp.durationMinutes / 60)}h ${comp.durationMinutes % 60 ? `${comp.durationMinutes % 60}m` : ''}`.trim() : '—'}</td>
                        <td class="py-2 pe-3 text-ink-mute">{comp.marks}</td>
                        <td class="py-2 pe-3 text-ink-mute">{comp.weightingPercent}%{comp.alternativeGroup && <span title="Sat as an alternative to another component"> *</span>}</td>
                        <td class="py-2 text-ink-mute">{ASSESSMENT_TYPE_LABEL[comp.assessmentType] ?? comp.assessmentType}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                {a.components.some((comp) => comp.alternativeGroup) && (
                  <p class="m-0 mt-2 text-[13px] text-ink-mute">* Candidates sit one of the components marked with an asterisk, not all of them.</p>
                )}
                {a.components.some((comp) => comp.routeGroup && comp.routeGroup.length > 0) && (
                  <p class="m-0 mt-2 text-[13px] text-ink-mute">
                    This qualification offers alternative routes built from the components above — candidates complete one full route, not every component listed. See the source notes below for exactly which components make up each route.
                  </p>
                )}
                <p class="m-0 mt-3 text-[13px] text-ink-mute">
                  Source: <a href={a.officialSourceUrl} rel="nofollow noopener" class="underline decoration-rule underline-offset-2">official {c.board} specification</a>, verified {a.verifiedOn}.
                  {a.notes && <> {a.notes}</>}
                </p>
              </div>
            ))
          ) : (
            <p class="m-0 text-ink-mute">
              Marlbridge has not yet modeled the paper-by-paper assessment structure (marks, weighting, timing) for this
              specific qualification. {syllabus ? <>Refer to the <a href={syllabus.officialUrl} rel="nofollow noopener" class="underline decoration-gold-500 underline-offset-2">official {c.board} specification</a> for the current assessment scheme.</> : 'Refer to the official awarding-body specification for the current assessment scheme.'}
            </p>
          )}
        </div>
      </div>

      {faqs.length > 0 && (
        <div class="mt-[clamp(48px,6vw,80px)] border-t border-rule pt-[clamp(32px,4vw,56px)]">
          <h2 class="m-0 mb-2 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Assessment FAQs</h2>
          <FAQ items={faqs} />
        </div>
      )}

      {subjectEntry && (
        <div class="mt-[clamp(48px,6vw,80px)] grid items-start gap-8 border-t border-rule pt-[clamp(32px,4vw,56px)] lg:grid-cols-[minmax(280px,0.8fr)_1.6fr] lg:gap-[clamp(32px,5vw,88px)]">
          <h2 class="m-0 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">The subject</h2>
          <div class="max-w-[68ch] text-[17.5px] leading-[1.7]">
            <p class="m-0">{subjectEntry.data.description}</p>
            <p class="m-0 mt-4 text-[15.5px]">
              <a href={routes.subject(hubSlug)} class="underline decoration-gold-500 underline-offset-2">All {subjectEntry.data.title} at Marlbridge</a>
            </p>
          </div>
        </div>
      )}
    </Container>
  </Section>

  <Section surface="ivory" labelledby="topics-heading" border>
    <Container>
      <h2 id="topics-heading" class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Syllabus topics</h2>
      {syllabusTopics ? (
        <>
          <p class="m-0 mb-2 max-w-[70ch] text-[16.5px] leading-[1.65] text-ink-mute">
            The {syllabusTopics.topics.length} topics below are the official subject content of
            <strong class="font-semibold text-navy-800"> {syllabus?.officialTitle ?? `${c.board} ${c.qualification} ${c.subject}`}</strong>,
            for the {syllabusTopics.syllabusSeries} examination series, reproduced from the
            <a href={syllabusTopics.sourceUrl} rel="nofollow noopener" class="underline decoration-gold-500 underline-offset-2"> {c.board} syllabus document</a>.
          </p>
          <p class="m-0 mb-[clamp(24px,3vw,40px)] max-w-[70ch] text-[15.5px] leading-[1.6] text-ink-mute">
            A topic listed here is part of the syllabus. It does <strong class="font-semibold text-navy-800">not</strong> mean
            Marlbridge has published material for it — topics with resources are marked.
            Marlbridge currently has resources for {covered} of {syllabusTopics.topics.length} topics.
          </p>

          {groups.map((g) => (
            <section class={g.label ? 'mt-[clamp(32px,4vw,48px)] first:mt-0' : ''} aria-label={g.label || undefined}>
              {g.label && (
                <div class="mb-4 border-t-2 border-navy-800 pt-4">
                  <h3 class="m-0 text-[19px] font-semibold tracking-[-0.01em] text-navy-800">{g.label}</h3>
                  <p class="m-0 mt-1 text-[15px] text-ink-mute">{g.note}</p>
                </div>
              )}
              <ol class="m-0 list-none border-t border-rule p-0">
                {g.items.map(({ topic, resources: got }) => (
                  <li class="m-0 border-b border-rule py-4">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
                      <p class="m-0 flex items-baseline gap-3 text-[17px] text-ink">
                        <span class="font-mono text-[12px] text-gold-600">
                          {topic.stage ? `${topic.stage} ` : ''}{topic.number}
                        </span>
                        <span>{topic.name}</span>
                      </p>
                      {got.length > 0 ? (
                        <span class="shrink-0 rounded-sm border border-[#B7D8C6] bg-[#EEF7F1] px-2 py-0.5 font-mono text-[10.5px] uppercase tracking-[0.08em] text-success">
                          {got.length} Marlbridge {got.length === 1 ? 'resource' : 'resources'}
                        </span>
                      ) : (
                        <span class="shrink-0 font-mono text-[10.5px] uppercase tracking-[0.08em] text-ink-mute">
                          Syllabus topic · no resource yet
                        </span>
                      )}
                    </div>
                    {got.length > 0 && (
                      <ul class="m-0 mt-2.5 list-none p-0 ps-[calc(1.5rem+12px)]">
                        {got.map((r) => (
                          <li class="m-0">
                            <a href={`/resources/${r.id}/`} class="text-[15.5px] underline decoration-gold-500 underline-offset-2 hover:text-gold-600">{r.data.title}</a>
                          </li>
                        ))}
                      </ul>
                    )}
                    {topic.subtopics.length > 0 && (
                      <p class="m-0 mt-2 ps-[calc(1.5rem+12px)] text-[14px] leading-relaxed text-ink-mute">
                        {topic.subtopics.map((st: { name: string }) => st.name).join(' · ')}
                      </p>
                    )}
                  </li>
                ))}
              </ol>
            </section>
          ))}

          <p class="m-0 mt-6 text-[14px] text-ink-mute">
            Source: {syllabusTopics.source} — {syllabusTopics.syllabusSeries} series. Verified {syllabusTopics.verifiedDate}.
            {syllabusTopics.tiered ? ' This syllabus is tiered -- see the qualification summary above for the exact tier structure.' : ''}
            Always check the current syllabus for your examination year.
          </p>
        </>
      ) : (
        <EmptyState
          heading="Syllabus topics are being verified"
          body="Topics are published here once confirmed against the awarding body's syllabus document."
          primary={{ label: 'Browse all resources', href: routes.resources }}
        />
      )}
    </Container>
  </Section>

  <Section surface="white">
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Study resources</h2>
      {study.length > 0 ? (
        <ul class="m-0 mt-6 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {study.map((r) => <li class="m-0"><ResourceCard entry={r} subjectTitle={c.subject} /></li>)}
        </ul>
      ) : (
        <div class="mt-6"><EmptyState heading="No study guides yet for this qualification" body="Study guides are published as they are written." primary={{ label: 'All resources', href: routes.resources }} /></div>
      )}

      <h2 class="m-0 mb-3 mt-[clamp(48px,6vw,80px)] text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Revision material</h2>
      {revision.length > 0 ? (
        <ul class="m-0 mt-6 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {revision.map((r) => <li class="m-0"><ResourceCard entry={r} subjectTitle={c.subject} /></li>)}
        </ul>
      ) : (
        <div class="mt-6"><EmptyState heading="No revision notes yet for this qualification" body="Condensed revision notes are added ahead of each examination series." primary={{ label: 'All resources', href: routes.resources }} /></div>
      )}

      <h2 class="m-0 mb-3 mt-[clamp(48px,6vw,80px)] text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Exam preparation</h2>
      {examPrep.length > 0 ? (
        <ul class="m-0 mt-6 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {examPrep.map((r) => <li class="m-0"><ResourceCard entry={r} subjectTitle={c.subject} /></li>)}
        </ul>
      ) : (
        <div class="mt-6">
          <EmptyState
            heading="Past papers and practice questions are not published yet"
            body={`Past papers for ${syllabus?.code ?? 'this syllabus'} are available from ${c.board} directly. Marlbridge practice material for this qualification is being written.`}
            primary={{ label: 'All resources', href: routes.resources }}
          />
        </div>
      )}
    </Container>
  </Section>

  <Section surface="ivory" labelledby="other-quals" border>
    <Container>
      <h2 id="other-quals" class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">
        {c.subject} at other qualifications
      </h2>
      <p class="m-0 mb-[clamp(24px,3vw,40px)] max-w-[68ch] text-[16.5px] leading-[1.65] text-ink-mute">
        These are separate qualifications with different syllabuses and assessments — not different names for the same course. Check which one your school enters you for.
      </p>
      {siblings.length > 0 ? (
        <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {siblings.map((s) => {
            const sib = syllabusFor(s.boardSlug, s.qualificationSlug, s.subjectSlug);
            return (
              <li class="m-0">
                <a href={academicHubPath(s)} class="flex h-full flex-col gap-2 rounded-sm border border-rule bg-white p-[clamp(22px,2.2vw,30px)] transition-colors duration-150 hover:border-gold-500">
                  <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-gold-600">{s.board}</span>
                  <span class="text-[18px] font-semibold tracking-[-0.01em] text-navy-800">{s.qualification} {s.subject}</span>
                  {sib && <span class="mt-auto pt-2 font-mono text-[12px] text-ink-mute">Syllabus {sib.code}</span>}
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="m-0 text-ink-mute">No other qualifications are published for this subject yet.</p>
      )}
    </Container>
  </Section>

  {articles.length > 0 && (
    <Section surface="white">
      <Container>
        <RelatedGrid id="hub-articles" title="Related articles">
          {articles.map((a) => <li class="m-0"><ArticleCard entry={a} /></li>)}
        </RelatedGrid>
      </Container>
    </Section>
  )}

  <CTA
    heading={`Studying ${c.board} ${c.qualification} ${c.subject}? Tell us where the difficulty is.`}
    buttonLabel="Find Learning Support"
    buttonHref={routes.tutoring}
  />
</PageLayout>
