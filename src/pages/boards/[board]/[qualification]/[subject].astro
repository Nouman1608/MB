---
import { teachingMonthLabel } from '../../../../utils/academic/teaching-month';
/**
 * Academic hub — /boards/{board}/{qualification}/{subject}/
 *
 * REFERENCE IMPLEMENTATION for the whole Marlbridge academic system.
 *
 * Routes come exclusively from activeOnly(), which requires marlbridgeStatus
 * ACTIVE. A combination that is UNKNOWN, FUTURE or NOT_SUPPORTED cannot
 * produce a page here, so OCR, AQA IGCSE and every unapproved combination are
 * structurally excluded rather than merely omitted.
 *
 * Nothing on this page is invented. Syllabus facts come from the awarding
 * body (src/data/academic/syllabuses.ts); resources and articles come from the
 * content collections. Sections with no genuine content render an honest empty
 * state instead of filler.
 */
import { getEntry } from 'astro:content';
import PageLayout from '../../../../layouts/PageLayout.astro';
import Section from '../../../../components/layout/Section.astro';
import Container from '../../../../components/layout/Container.astro';
import ArticleCard from '../../../../components/cards/ArticleCard.astro';
import RelatedGrid from '../../../../components/layout/RelatedGrid.astro';
import CTA from '../../../../components/ui/CTA.astro';
import CourseTopicResources from '../../../../components/academic/CourseTopicResources.astro';
import { courseTopics } from '../../../../utils/academic/course-topics';
import { activeOnly, offersClasses, offeringsForSubject, academicHubPath, boardPath, levelPath, isFlagshipCode, type Combination } from '../../../../utils/academic';
import { subjectBySlug } from '../../../../data/academic/subjects';
import { courseSubjectNameOverride } from '../../../../data/academic/matrix';
import { syllabusFor } from '../../../../data/academic/syllabuses';
import { assessmentsFor, type AssessmentComponent } from '../../../../data/academic/assessments';
import { topicsFor, hasStages } from '../../../../data/academic/syllabus-topics';
import { getResources } from '../../../../utils/content/collections';
import { resourcesForCombination } from '../../../../utils/academic/combination-resources';
import { isIndexableAcademicPage } from '../../../../utils/seo/indexability';
import { relatedArticles } from '../../../../utils/content/related';
import { courseNode } from '../../../../utils/schema/course';
import { practiceQuestionsForCode } from '../../../../utils/practice/bank.ts';
import { faqNode } from '../../../../utils/schema/faq';
import FAQ from '../../../../components/ui/FAQ.astro';
import { enrolmentOpenFor } from '../../../../utils/content/status';
import { routes } from '../../../../utils/urls/routes';
import { FALLBACK_EMAIL } from '../../../../utils/forms/submit';
import { site } from '../../../../data/site';
import TuitionPanel from '../../../../components/sections/TuitionPanel.astro';
import { diagnosticsForCode, diagnosticPath } from '../../../../data/diagnostics';
import VideoSection from '../../../../components/media/VideoSection.astro';
import { tuitionPageFor } from '../../../../data/tuition-pages';
import { tuitionFaqs } from '../../../../utils/content/tuition';
import { videosForCourse } from '../../../../utils/content/media';
import { videoNodes } from '../../../../utils/schema/video';
import { STUDY_KIND } from '../../../../utils/academic/combination-resources';
import { teachersForSubjectTitle } from '../../../../utils/content/subject-teachers';
import { ONE_TO_ONE_ONLY_PRICING, isOneToOneOnlyCourse, formatFee } from '../../../../data/pricing';

export async function getStaticPaths() {
  return activeOnly().map((c) => ({
    params: { board: c.boardSlug, qualification: c.qualificationSlug, subject: c.subjectSlug },
    props: { combination: c },
  }));
}

const { combination: c } = Astro.props as { combination: Combination };
const path = academicHubPath(c);
const syllabus = syllabusFor(c.boardSlug, c.qualificationSlug, c.subjectSlug);
/** D-298 -- every hub links to its own printable checklist (0 of 160 did). */
const checklistVersion = topicsFor(c.boardSlug, c.qualificationSlug, c.subjectSlug);
const checklistHref = checklistVersion && checklistVersion.status === 'current'
  ? `/checklists/${c.boardSlug}/${c.qualificationSlug}/${c.subjectSlug}/`
  : null;
/**
 * v2.0 AUTHORITY/PRACTICE/TOOLS/GROWTH MEGA PROGRAMME WS6 -- the self-
 * check practice engine (see utils/practice/bank.ts) only has real
 * question data for the flagship codes that actually have published
 * practice-questions resources (0620/9701/9702 today, not 0625/0580 --
 * see docs/decision-log.md D-067). practiceQuestionsForCode() returns
 * an empty array for every other combination's code, which is exactly
 * right: cheap to call unconditionally, and the row below only renders
 * when there's something real to link to.
 */
// Only a flagship code (0620/0625/0580/9701/9702) actually has a
// generated /practice/<CODE>/ page (see getStaticPaths in that route) --
// a non-flagship code that happens to share a practice-questions
// resource with a flagship (e.g. 5070 shares files with 0620) would
// otherwise produce a real count here with no page to link to, a
// broken link caught by audit-internal-links.mjs during verification.
const practiceCount = syllabus && isFlagshipCode(syllabus.code) ? practiceQuestionsForCode(syllabus.code).length : 0;
// D-319: link the free 10-minute diagnostic(s) for this syllabus, when any exist.
const hubDiagnostics = syllabus && practiceCount > 0 ? diagnosticsForCode(syllabus.code) : [];

/**
 * v2.0 AUTHORITY/PRACTICE/TOOLS/GROWTH MEGA PROGRAMME WS2 -- every academic
 * hub carries a real, working correction affordance (not just an abstract
 * policy on /legal/editorial-policy/). Subject/body are pre-filled with this
 * exact page's identity so a report always arrives with enough context to
 * act on -- see docs/decision-log.md D-063.
 */
const correctionMailto = `mailto:${FALLBACK_EMAIL}?subject=${encodeURIComponent(`Correction: ${c.board} ${c.qualification} ${c.subject}${syllabus ? ` (${syllabus.code})` : ''}`)}&body=${encodeURIComponent(`Page: ${site.url}${path}\n\nWhat looks wrong:\n`)}`;

/**
 * v1.x CLOSURE WS5 -- real, sourced assessment structure (papers,
 * duration, marks, weighting) for this combination, when it has been
 * modeled (src/data/academic/assessments.ts). A bounded first batch of 12
 * combinations is modeled as of this release; every other ACTIVE
 * combination honestly renders "not yet modeled" below rather than either
 * inventing figures or silently omitting the section -- see
 * docs/decision-log.md D-050.
 */
const assessments = assessmentsFor(c.boardSlug, c.qualificationSlug, c.subjectSlug);
const ASSESSMENT_TYPE_LABEL: Record<string, string> = {
  'written-exam': 'Written exam',
  'multiple-choice': 'Multiple choice',
  coursework: 'Coursework',
  'non-exam-assessment': 'Non-exam assessment',
  practical: 'Practical',
  'alternative-to-practical': 'Alternative to practical',
  'practical-endorsement': 'Practical endorsement',
  oral: 'Oral',
  speaking: 'Speaking',
  listening: 'Listening',
  reading: 'Reading',
  writing: 'Writing',
  portfolio: 'Portfolio',
  project: 'Project',
  unit: 'Unit',
  endorsement: 'Endorsement',
};
/** v2.0 MEGA PROGRAMME WS12 -- assessmentModel vocabulary, one-line label
 * shown per assessment record when the field is populated (18 pre-v2.0
 * records deliberately have no assessmentModel; see its doc comment in
 * assessments.ts -- those simply omit this line). */
const ASSESSMENT_MODEL_LABEL: Record<string, string> = {
  linear: 'Linear qualification',
  modular: 'Modular qualification',
  staged: 'Staged qualification',
  'unit-based': 'Unit-based qualification',
  'component-based': 'Component-based qualification',
  mixed: 'Mixed assessment model',
};
const TIER_LABEL: Record<string, string> = {
  'not-tiered': '',
  core: 'Core',
  extended: 'Extended',
  foundation: 'Foundation',
  higher: 'Higher',
  'first-language': 'First Language',
  'second-language': 'Second Language',
  'as-only': 'AS',
  'a2-only': 'A2',
  sl: 'SL',
  hl: 'HL',
};

// LEVEL_FOR_QUALIFICATION now lives in utils/academic (shared with
// astro.config.mjs's sitemap indexability step -- see that file).

// The matrix's subjectSlug and the subjects content collection's id can
// differ (e.g. matrix 'english-language' -> hub 'english') — always resolve
// through the canonical registry's hubId rather than assuming they match,
// so this never silently 404s or links to a nonexistent hub.
const hubSlug = subjectBySlug(c.subjectSlug)?.hubId ?? c.subjectSlug;
const subjectEntry = await getEntry('subjects', hubSlug);
/**
 * v2.0 AUTHORITY/PRACTICE/TOOLS/GROWTH MEGA PROGRAMME WS3 -- a real,
 * existing author-collection entry (not fabricated for this workstream;
 * see src/content/authors/marlbridge-academic-team.md, already the
 * documented default byline for material not yet assigned to a named
 * subject teacher -- src/pages/legal/editorial-policy.astro's own
 * "Authorship" section). Gives every hub page a visible, honest
 * provenance line without inventing a specific named author for
 * content that is actually assembled from the awarding body's own
 * published syllabus, not written by one teacher.
 */
const teamAuthor = await getEntry('authors', 'marlbridge-academic-team');
const allResources = await getResources();
// Resources reference the subjects CONTENT id (hubSlug), not the matrix
// subjectSlug — those diverge for e.g. matrix 'english-language' -> content
// id 'english'. Filtering on c.subjectSlug here silently hid every resource
// for any subject whose hubId differs from its matrix slug (Workstream 9
// finding: AQA GCSE English Language resources were invisible on this page
// for exactly this reason, even though they render correctly on the
// English subject hub, which already used hubSlug).
// A resource must also apply to THIS board: either genuinely board-agnostic
// (boards: [], e.g. general study-skills material) or explicitly tagged
// with c.boardSlug. Without this, a board-specific resource (most of them
// carry a boards[] tag — see content.config.ts) would silently surface on
// every other board's leaf page for the same subject/level, misrepresenting
// e.g. AQA-specific syllabus content as relevant to OxfordAQA or Cambridge
// students. Found via v1.0 WS7 audit: an AQA-only Sociology resource
// (boards: ["aqa"]) was rendering on the OxfordAQA A-level Sociology page.
// D-286: the filter lives in utils/academic/combination-resources.ts so the
// revision tools and this hub cannot disagree about a combination's resources.
const resources = resourcesForCombination(c, allResources);

// Navigation round (6 Oct 2026): the course's resources by official topic,
// grouped as study guides / revision notes / practice questions. Replaces
// the three card grids that used to sit below the topic list.
const topicData = courseTopics(c, allResources);
const articles = await relatedArticles({ subject: hubSlug, limit: 3 });

/**
 * Official syllabus topics, straight from the awarding body's document.
 * Marlbridge resource coverage is computed per topic so the page can state
 * plainly which topics we have material for — and which we do not.
 */
const syllabusTopics = topicsFor(c.boardSlug, c.qualificationSlug, c.subjectSlug);
const coverage = (syllabusTopics?.topics ?? []).map((t) => ({
  topic: t,
  resources: resources.filter((r) =>
    r.data.syllabusTopics.some((m) => m.qualification === c.qualificationSlug && m.topic === t.slug),
  ),
}));
const staged = syllabusTopics ? hasStages(syllabusTopics) : false;
/**
 * A staged syllabus is presented as clearly separated stages, never one flat
 * list. Round 42 (E938 (2)): the notes were hard-coded for 9701 ("Topics
 * 1–22" / "Topics 23–37") and printed on every staged hub. They are now built
 * from each record's own topic numbers and stages. A linear specification
 * (AQA A-level: the AS is a separate qualification and every A-level exam
 * is sat at the end of the course) gets no "assessed on the AS papers" note,
 * and topics without a stage are listed rather than silently dropped.
 */
function topicRange(nums: (number | string)[]): string {
  // A handful of specifications print a fractional topic-level number
  // instead of a plain integer (Pearson YAC11: 1.1-1.6, 2.1-2.9; Pearson
  // 4EC1: 1.1, 1.2, 2.1, 2.2 -- see SyllabusTopic.number, E/D-264). Integer
  // range compression ("Topics 1-9") doesn't apply to those, so they're
  // listed in document order instead rather than coerced into a numeric
  // sort that would silently misorder or NaN them.
  if (!nums.every((n) => typeof n === 'number')) {
    return `${nums.length === 1 ? 'Topic' : 'Topics'} ${nums.join(', ')}`;
  }
  const sorted = [...(nums as number[])].sort((a, b) => a - b);
  const parts: string[] = [];
  for (let i = 0; i < sorted.length; i++) {
    let j = i;
    while (j + 1 < sorted.length && sorted[j + 1] === sorted[j] + 1) j++;
    parts.push(j === i ? `${sorted[i]}` : `${sorted[i]}–${sorted[j]}`);
    i = j;
  }
  return `${sorted.length === 1 ? 'Topic' : 'Topics'} ${parts.join(', ')}`;
}
const linearSpec = (assessments.find((a) => a.specStatus === 'current') ?? assessments[0])?.assessmentModel === 'linear';
const stageItems = (stage: 'AS' | 'A' | undefined) => coverage.filter((x) => x.topic.stage === stage);
const groups: { label: string; note: string; items: typeof coverage }[] = staged
  ? [
      linearSpec
        ? { label: 'AS and A-level content', items: stageItems('AS'),
            note: `${topicRange(stageItems('AS').map((x) => x.topic.number))}. Also the subject content of the separate AS qualification. The A-level is linear, so these topics are examined in the A-level papers at the end of the course, together with the A-level-only topics.` }
        : { label: 'AS Level', items: stageItems('AS'),
            note: `${topicRange(stageItems('AS').map((x) => x.topic.number))}. Usually studied in the first year, and assessed at AS.` },
      linearSpec
        ? { label: 'A-level only', items: stageItems('A'),
            note: `${topicRange(stageItems('A').map((x) => x.topic.number))}. Not part of the AS.` }
        : { label: 'A Level', items: stageItems('A'),
            note: `${topicRange(stageItems('A').map((x) => x.topic.number))}. Studied in addition to the AS content for the full A Level.` },
      { label: 'Not assigned to a stage', items: stageItems(undefined),
        note: `${topicRange(stageItems(undefined).map((x) => x.topic.number))}. Marlbridge's topic record does not assign ${stageItems(undefined).length === 1 ? 'this topic' : 'these topics'} to the AS or the A-level-only content; check the specification.` },
    ].filter((g) => g.items.length > 0)
  : [{ label: '', note: '', items: coverage }];
const topicGroups = groups.map((g) => ({ label: g.label, note: g.note, slugs: g.items.map((x) => x.topic.slug) }));

/** The other approved qualifications for this subject — the sibling hubs. */
const siblings = offeringsForSubject(c.subjectSlug).filter((o) => o.qualificationSlug !== c.qualificationSlug);

/**
 * Flagship Dominance Programme WS-A (2026-08-31): IB's canonical
 * qualification names ("IB Diploma Programme", "IB Middle Years
 * Programme") already carry the board's identity, so prefixing them with
 * "IB" a second time produced a doubled-up heading/title/breadcrumb/"at a
 * glance" field on every IB hub page (e.g. "IB IB Diploma Programme
 * Economics"). boardQualPhrase drops that redundant board prefix only for
 * IB -- every other board's qualification name ("A Level", "IGCSE", ...)
 * does not already contain its board's name, so `${c.board} ${c.qualification}`
 * is unchanged for them.
 */
const boardQualPhrase = c.qualification.startsWith('IB ') ? c.qualification : `${c.board} ${c.qualification}`;
const heading = `${boardQualPhrase} ${c.subject}`;
/** B15 -- this course's subject name is overridden per course (COURSE_SUBJECT_NAMES in matrix.ts). */
const courseRenamed = courseSubjectNameOverride(c.boardSlug, c.qualificationSlug, c.subjectSlug) !== undefined;
/**
 * D-299 -- titles name the document searchers ask for. Search Console
 * (2026-08-19 to 2026-09-21) shows hubs ranking around positions 6-11 for
 * "<code> syllabus 2027"-style queries with almost no clicks, and 0 of 160
 * titles said "syllabus" or "specification". Cambridge and IB call the
 * document a syllabus; Pearson, AQA, OCR and OxfordAQA call it a
 * specification. Edition years are shown only when the linked official
 * document itself carries them in its file name (e.g. 662464-2025-2027-
 * syllabus.pdf) -- never guessed. An upcoming replacement code is shown
 * next to the current one (e.g. AQA 7132 / 7138) so both searches match.
 */
const docWord = c.qualificationSlug === 'ib-myp'
  ? 'Subject Guide'
  : c.boardSlug === 'cambridge' || c.boardSlug === 'ib' ? 'Syllabus' : 'Specification';
const editionMatch = syllabus?.officialUrl.match(/(20\d{2})-(20\d{2})-syllabus/);
// D-316 -- single-year editions (e.g. 721463-2027-syllabus.pdf) name their
// one exam year too; previously only YYYY-YYYY ranges were recognised.
const singleYearMatch = editionMatch ? null : syllabus?.officialUrl.match(/-(20\d{2})-syllabus\.pdf$/);
const editionYears = editionMatch ? `${editionMatch[1]}–${editionMatch[2]}` : singleYearMatch ? singleYearMatch[1] : null;
const upcomingCode = assessments.find((a) => a.specStatus === 'future' && a.code !== syllabus?.code)?.code;
const hasRealCode = Boolean(syllabus && /\d/.test(syllabus.code) && c.boardSlug !== 'ib');
const codeLabel = hasRealCode ? `${syllabus!.code}${upcomingCode ? ` / ${upcomingCode}` : ''}` : '';
// D-286 (main): the five hubs with a tuition section say so in the title.
const tuitionPage = offersClasses(c) ? tuitionPageFor(c.boardSlug, c.qualificationSlug, c.subjectSlug) : undefined;
// B15 -- a course whose subject name is overridden (e.g. 9626 "Information
// Technology") keeps the shared search term once, in brackets, in its title.
const titleSubject = c.subjectAlias ? `${heading} (${c.subjectAlias})` : heading;
const title = syllabus
  ? `${titleSubject}${codeLabel ? ` ${codeLabel}` : ''} ${docWord}${editionYears ? ` ${editionYears}` : ''}${tuitionPage ? ' & Online Tuition' : ''}`
  : titleSubject;

/**
 * Differentiated meta description (Aug 2026 SEO remediation, Phase 4/9).
 *
 * The old description was one fixed template string for all 160 hub
 * pages -- board/qualification/subject/code varied, but the rest was
 * identical boilerplate ("overview, topics and study resources... Free
 * to read") regardless of what was actually on the page. That is exactly
 * the "near-identical descriptions" problem search consoles flag, and it
 * wastes the description's one real job: telling a searcher what makes
 * *this* result different from the next one. Real differentiators are
 * available at this point in the template -- syllabus code and, since
 * D-023/D-024, real resource type/count data -- so use them instead.
 */
const RESOURCE_TYPE_LABEL: Record<string, string> = {
  'study-guides': 'study guides',
  'revision-notes': 'revision notes',
  'past-papers': 'past-paper guidance',
  'practice-questions': 'practice questions',
  'exam-preparation': 'exam preparation guides',
  'subject-guides': 'a subject guide',
};
const presentResourceTypes = [...new Set(resources.map((r) => r.data.resourceType))]
  .map((t) => RESOURCE_TYPE_LABEL[t] ?? t);
// Never claim resource availability this combination doesn't have --
// the explicit false branch here is what the "no resources" case reads
// as, rather than silently reusing generic "study resources" language.
const resourceSummary = presentResourceTypes.length > 0
  ? `${resources.length} original resource${resources.length === 1 ? '' : 's'} (${presentResourceTypes.join(', ')})`
  : 'no original Marlbridge resource yet';
/**
 * 8 Oct 2026 -- Search Console (15 Sep-5 Oct) shows hubs at ~1.3% CTR
 * around position 8-10, while the printable checklists for the same courses
 * get ~8.5% at a similar position: searchers click the offer of every topic
 * on one page. Where a current checklist exists, the description leads with
 * it and the real topic count; the resource count follows. Nothing is
 * claimed that the page does not link to.
 */
const checklistLead = checklistHref && checklistVersion
  ? `all ${checklistVersion.topics.length} topics with a free printable checklist, how it is assessed, the official ${c.board} link, and ${resources.length > 0 ? `${resources.length} free study resource${resources.length === 1 ? '' : 's'}` : 'no Marlbridge resource yet'}.`
  : undefined;
const pageDescription = (tuitionPage
  ? `${heading}${codeLabel ? ` (${codeLabel})` : ''} ${docWord.toLowerCase()}${editionYears ? ` ${editionYears}` : ''}: syllabus topics, online tuition with named teachers and published fees, a free trial class, and ${resources.length} free resources.`
  : syllabus && checklistLead
    ? `${heading}${codeLabel ? ` (${codeLabel})` : ''} ${docWord.toLowerCase()}${editionYears ? ` ${editionYears}` : ''}: ${checklistLead}`
  : syllabus
    ? `${heading}${codeLabel ? ` (${codeLabel})` : ''} ${docWord.toLowerCase()}${editionYears ? ` ${editionYears}` : ''}: what it covers, how it is assessed, the official ${c.board} link, and ${resourceSummary} Marlbridge has published for it.`
    : `${heading}: what the qualification covers, and ${resourceSummary} Marlbridge has published for it.`).replace(/\s+/g, ' ');

/**
 * Indexability (Aug 2026 SEO remediation — Phase 1/2).
 *
 * activeOnly() legitimately produces a page for every ACTIVE combination in
 * the academic matrix, but a combination can be approved long before any
 * syllabus topics have been transcribed or any substantial resource
 * written. Those pages render nothing but honest empty states — or, worse,
 * a single thin stub — genuinely useful to a human who lands on one,
 * genuinely worthless as a search result.
 *
 * The decision itself lives in one place, src/utils/seo/indexability.ts
 * (isIndexableAcademicPage), so the exact same rule also governs sitemap
 * inclusion (astro.config.mjs) instead of the two drifting independently.
 * A single 100-word resource used to be enough to mark a page indexable;
 * it no longer is — see that file for the substantial-content threshold
 * and why 400 words was chosen.
 *
 * `noindex, follow` (see components/seo/Meta.astro) still keeps the page
 * served and in the internal link graph, preserving link equity flow to
 * the pages that do have content — this only withholds it from search
 * results until it earns a place there.
 *
 * This is deliberately NOT based on `marlbridgeTeaches` — whether we teach a
 * combination is a separate fact from whether this page has anything on it.
 */
const hasSyllabusTopics = (syllabusTopics?.topics ?? []).length > 0;
const indexability = isIndexableAcademicPage({
  resources: resources.map((r) => ({
    resourceType: r.data.resourceType,
    wordCount: r.body?.trim().split(/\s+/).filter(Boolean).length ?? 0,
  })),
  hasSyllabusTopics,
});
const isThin = !indexability.indexable;

/**
 * v2.0 MEGA PROGRAMME WS15 -- AEO/AIO: FAQ content generated strictly from
 * the already-computed `assessments` array above (the same data the visible
 * Assessment structure table renders), matching the discipline
 * src/pages/levels/[qualification]/index.astro already established for its
 * own FAQ block -- every figure here is read straight from a sourced
 * assessments.ts record, never invented or computed by summing marks across
 * components that may be mutually-exclusive alternatives (alternativeGroup/
 * routeGroup components are listed individually with their own real marks/
 * weighting, not aggregated into a total that could silently double-count a
 * choice). Only emitted when a real assessment record exists -- combinations
 * still NOT_YET_MODELED get no FAQ, matching the honest "not yet modeled"
 * fallback the visible table already uses.
 */
const primaryAssessment = assessments.find((a) => a.specStatus === 'current') ?? assessments[0];
const faqs: { question: string; answer: string }[] = [];
if (primaryAssessment) {
  /**
   * WS6 (2026-09-08): this used to flatten every component into one
   * semicolon list regardless of tier or alternativeGroup -- for a tiered
   * syllabus like Cambridge 0620 that read "assessed through: Paper 1
   * (Core); Paper 3 (Core); Paper 2 (Extended); Paper 4 (Extended); Paper
   * 5; Paper 6", implying every candidate sits all six, when a Core
   * candidate actually sits Paper 1 + Paper 3 + one of Paper 5/6, and an
   * Extended candidate sits Paper 2 + Paper 4 + one of Paper 5/6. Checked
   * live on /boards/cambridge/igcse/chemistry/ before this fix -- the
   * flat listing was there, worded exactly as ambiguously as this.
   *
   * fmtComponent/describeComponents are also used by the tiered branch
   * below, so alternativeGroup handling ("one of X or Y", never listing
   * every alternative as though a candidate sits it) is identical whether
   * or not the syllabus is also tiered -- one algorithm, not two.
   *
   * Deliberately does not attempt `routeGroup` (a component can belong to
   * several route groups at once -- e.g. 0475 English Literature's Paper
   * 3, shared between route-b and route-c -- a genuinely different,
   * many-to-many composition model this pass does not build a describer
   * for). A `routeGroup`-bearing assessment falls through to the flat
   * per-component listing exactly as before this fix; not claimed fixed.
   */
  /**
   * C/D-264 — a component with an `asWeightingPercent` different from its
   * `weightingPercent` (Cambridge 9709's staged AS/A Level route: Paper 2
   * is 40% of the AS Level but 0% of the A Level, since it doesn't count
   * toward the full qualification at all) is shown with both figures named,
   * never as a bare "0%" or "0% of the qualification" that reads as an
   * error. A component with no distinct AS weighting renders exactly as
   * before this fix.
   */
  const weightingProse = (comp: AssessmentComponent): string => {
    if (comp.asWeightingPercent != null && comp.asWeightingPercent !== comp.weightingPercent) {
      return comp.weightingPercent === 0
        ? `${comp.asWeightingPercent}% of the AS Level (not counted toward the A Level)`
        : `${comp.asWeightingPercent}% of the AS Level, ${comp.weightingPercent}% of the A Level`;
    }
    return `${comp.weightingPercent}% of the qualification`;
  };
  const fmtComponent = (comp: (typeof primaryAssessment.components)[number]) => {
    const dur = comp.durationLabel
      ? comp.durationLabel.replace(/^approx\. /, 'approximately ').replace(/m$/, ' minutes')
      : comp.durationMinutes
      ? `${Math.floor(comp.durationMinutes / 60)}h${comp.durationMinutes % 60 ? ` ${comp.durationMinutes % 60}m` : ''}`.trim()
      : 'no fixed duration';
    return `${comp.paperCode} (${comp.title}) — ${dur}, ${comp.marks} marks, ${weightingProse(comp)}`;
  };
  const describeComponents = (comps: typeof primaryAssessment.components): string => {
    const seen = new Set<string>();
    const parts: string[] = [];
    for (const comp of comps) {
      if (seen.has(comp.paperCode)) continue;
      if (comp.alternativeGroup) {
        const group = comps.filter((c) => c.alternativeGroup === comp.alternativeGroup);
        group.forEach((c) => seen.add(c.paperCode));
        parts.push(`one of ${group.map(fmtComponent).join(' or ')}`);
      } else {
        seen.add(comp.paperCode);
        parts.push(fmtComponent(comp));
      }
    }
    return parts.join('; ');
  };
  const hasRouteGroups = primaryAssessment.components.some((comp) => comp.routeGroup && comp.routeGroup.length > 0);
  type NonNotTieredTier = Exclude<NonNullable<(typeof primaryAssessment.components)[number]['tier']>, 'not-tiered'>;
  const tierValues = hasRouteGroups
    ? []
    : [
        ...new Set(
          primaryAssessment.components
            .map((comp) => comp.tier)
            .filter((t): t is NonNotTieredTier => !!t && t !== 'not-tiered'),
        ),
      ];
  const componentList =
    tierValues.length > 1
      ? tierValues
          .map((tier) => {
            const shared = primaryAssessment.components.filter((comp) => !comp.tier || comp.tier === 'not-tiered');
            const tierComps = primaryAssessment.components.filter((comp) => comp.tier === tier);
            return `${TIER_LABEL[tier] ?? tier} candidates take: ${describeComponents([...tierComps, ...shared])}`;
          })
          .join('. ')
      : describeComponents(primaryAssessment.components);
  const modelPhrase = primaryAssessment.assessmentModel ? ` It is a ${primaryAssessment.assessmentModel.replace('-', ' ')} qualification.` : '';
  /**
   * D-132 fix: when no record is `current` (a combination modeled only via
   * a `future` or `legacy-teach-out` record -- 4 combinations as of this
   * fix), `primaryAssessment` above falls back to `assessments[0]`, which
   * is NOT the specification current students follow. Previously this FAQ
   * answer, and the JSON-LD FAQPage entry generated from it, stated that
   * record's structure as if it were simply "how this subject is
   * assessed" with no caveat -- contradicting the correctly-caveated
   * visible banner elsewhere on the same page (see the `specStatus ===
   * 'future'` render below). This caveat keeps the FAQ (both the visible
   * accordion and the structured data search engines/AI answer engines
   * read independently of surrounding page text) honest in that case.
   */
  const primaryStatusCaveat =
    primaryAssessment.specStatus === 'future'
      ? ` ${primaryAssessment.code} is an upcoming specification: its first exams (${primaryAssessment.firstAssessment}) have not been sat yet.${primaryAssessment.firstTeaching ? ` Learners who start the course from ${teachingMonthLabel(primaryAssessment.firstTeaching)} follow it.` : ''}`
      : primaryAssessment.specStatus === 'legacy-teach-out'
        ? ` ${primaryAssessment.code} is being withdrawn${primaryAssessment.relatedCode ? ` in favour of ${primaryAssessment.relatedCode}` : ''}.`
        : primaryAssessment.specStatus === 'withdrawn'
          ? ` ${primaryAssessment.code} has been withdrawn and is no longer assessable.`
          : '';
  faqs.push({
    question: `How is ${c.board} ${c.subject} (${primaryAssessment.code}) assessed?`,
    answer: `${c.board} ${c.subject} (${primaryAssessment.code}) is assessed through: ${componentList}.${modelPhrase} Source: official ${c.board} specification, verified ${primaryAssessment.verifiedOn}.${primaryStatusCaveat}`,
  });
  const future = assessments.find((a) => a.specStatus === 'future');
  const legacy = assessments.find((a) => a.specStatus === 'legacy-teach-out');
  if (future && future !== primaryAssessment) {
    faqs.push({
      question: `Is there a new ${c.board} ${c.subject} specification coming?`,
      answer: `Yes. ${future.code} is an upcoming specification${future.relatedCode ? `, replacing ${future.relatedCode}` : ''}${future.firstTeaching ? `, for first teaching from ${teachingMonthLabel(future.firstTeaching)}` : ''}. First assessment: ${future.firstAssessment}. Learners who start the course ${future.firstTeaching ? `from ${teachingMonthLabel(future.firstTeaching)}` : 'once its teaching begins'} follow ${future.code}; learners already partway through ${primaryAssessment.code} finish that specification${primaryAssessment.finalAssessment ? `, whose final exams are in ${primaryAssessment.finalAssessment}` : ''}.`,
    });
  }
  if (legacy && legacy !== primaryAssessment) {
    faqs.push({
      question: `Is ${legacy.code} being withdrawn?`,
      answer: `Yes. ${legacy.code} is being withdrawn${legacy.relatedCode ? ` in favour of ${legacy.relatedCode}` : ''}.${legacy.finalAssessment ? ` Final assessment opportunity: ${legacy.finalAssessment}.` : ''}`,
    });
  }
}
// D-286: tuition FAQs join the same list, so the page emits one FAQPage
// node that matches everything visible.
const tuitionFaqList = tuitionPage ? tuitionFaqs(tuitionPage, `${heading}${syllabus ? ` (${syllabus.code})` : ''}`) : [];
const faq = faqNode([...faqs, ...tuitionFaqList]);
const courseVideos = await videosForCourse(hubSlug, c.boardSlug, c.qualificationSlug);
// Sample material for the tuition section: one guide, one set of notes, one practice set.
const sampleResources = tuitionPage
  ? (['learn', 'review', 'practice'] as const)
      .map((k) => resources.find((r) => STUDY_KIND[r.data.resourceType] === k))
      .filter((r): r is NonNullable<typeof r> => !!r)
  : [];

const classesOffered = offersClasses(c);
// D-334 -- teachers of this subject who teach this board (owner answers, D-333). Shown in
// the at-a-glance box on course hubs without a full tuition section (TuitionPanel has its own).
const hubTeachers = classesOffered && !tuitionPage ? await teachersForSubjectTitle(subjectEntry?.data.title, 4, [c.boardSlug]) : [];
/* D-326 -- taught hubs without a tuition section had no in-page route to the
   free trial: the glance row said only "Yes" and the closing button went to
