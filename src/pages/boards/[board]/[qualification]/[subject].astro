                  <p class="m-0 mb-2 text-[13px] text-ink-mute">{ASSESSMENT_MODEL_LABEL[a.assessmentModel] ?? a.assessmentModel}</p>
                )}
                {/* v2.0 MEGA PROGRAMME WS16 -- accessibility/mobile: wrapped in an
                    overflow-x-auto scroll container so a long paper title (e.g. AQA
                    Business 7138's "Business and society, business and the external
                    environment, and business strategy") can't force the whole page to
                    scroll horizontally on a narrow viewport -- only the table itself
                    scrolls. Added a visually-hidden <caption> (WCAG 1.3.1 -- a table
                    needs an accessible name, not just a preceding heading a screen
                    reader may not associate with it) and scope="col" on every header
                    cell (WCAG 1.3.1 -- lets a screen reader announce "Duration" etc.
                    when moving into a data cell, not just when reading the header row). */}
                <div class="overflow-x-auto" tabindex="0" role="group" aria-label="Table, scrolls sideways on small screens">
                <table class="w-full border-collapse text-[15px]">
                  <caption class="sr-only">Assessment components for {c.board} {c.subject} {a.code}</caption>
                  <thead>
                    <tr class="border-b border-rule text-left">
                      <th scope="col" class="py-2 pe-3 font-semibold text-navy-800">Component</th>
                      <th scope="col" class="py-2 pe-3 font-semibold text-navy-800">Duration</th>
                      <th scope="col" class="py-2 pe-3 font-semibold text-navy-800">Marks</th>
                      <th scope="col" class="py-2 pe-3 font-semibold text-navy-800">Weighting</th>
                      <th scope="col" class="py-2 font-semibold text-navy-800">Type</th>
                    </tr>
                  </thead>
                  <tbody>
                    {a.components.map((comp) => (
                      <tr class="border-b border-rule/60">
                        <td class="py-2 pe-3 text-ink">
                          {comp.paperCode}: {comp.title}
                          {/* D-153 follow-up (WS5): some component titles already end in their own
                              "(Core)"/"(Extended)" — e.g. "Non-calculator (Core)" — because that is
                              genuinely part of the official component name. Appending the tier badge
                              unconditionally on top of that produced "Non-calculator (Core) (Core)"
                              everywhere a title happened to already carry it. Checked live on several
                              tiered syllabus hubs, 2026-09-08. Only suppress the badge when the title's
                              own trailing "(<Tier>)" already says the same tier this component is
                              tagged with -- a title ending in a genuinely different parenthetical must
                              still get its tier badge. */}
                          {comp.tier && comp.tier !== 'not-tiered' && !comp.title.trim().endsWith(`(${TIER_LABEL[comp.tier] ?? comp.tier})`) && (
                            <span class="text-ink-mute"> ({TIER_LABEL[comp.tier] ?? comp.tier})</span>
                          )}
                        </td>
                        <td class="py-2 pe-3 text-ink-mute">{comp.durationLabel ? comp.durationLabel : comp.durationMinutes ? `${Math.floor(comp.durationMinutes / 60)}h ${comp.durationMinutes % 60 ? `${comp.durationMinutes % 60}m` : ''}`.trim() : '—'}</td>
                        <td class="py-2 pe-3 text-ink-mute">{comp.marks}</td>
                        <td class="py-2 pe-3 text-ink-mute">{comp.asWeightingPercent != null && comp.asWeightingPercent !== comp.weightingPercent
                          ? (comp.weightingPercent === 0 ? `${comp.asWeightingPercent}% (AS only)` : `${comp.asWeightingPercent}% AS / ${comp.weightingPercent}% A Level`)
                          : `${comp.weightingPercent}%`}{comp.alternativeGroup && <span aria-label="Sat as an alternative to another component" title="Sat as an alternative to another component"> *</span>}{comp.asAlternativeGroup && <span aria-label="At AS Level, sat as an alternative to another component" title="At AS Level, sat as an alternative to another component"> †</span>}</td>
                        <td class="py-2 text-ink-mute">{ASSESSMENT_TYPE_LABEL[comp.assessmentType] ?? comp.assessmentType}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                </div>
                {a.components.some((comp) => comp.alternativeGroup) && (
                  <p class="m-0 mt-2 text-[13px] text-ink-mute">* Candidates sit one of the components marked with an asterisk, not all of them.</p>
                )}
                {/* D-265 (round 48, I401 (5)): an AS-only alternative group needs its own
                    footnote, or the AS column reads as though every paper is sat. */}
                {a.components.some((comp) => comp.asAlternativeGroup) && (
                  <p class="m-0 mt-2 text-[13px] text-ink-mute">† At AS Level, candidates sit one of the components marked with a dagger, not all of them.</p>
                )}
                {a.components.some((comp) => comp.routeGroup && comp.routeGroup.length > 0) && (
                  <p class="m-0 mt-2 text-[13px] text-ink-mute">
                    This qualification offers alternative routes built from the components above — candidates complete one full route, not every component listed. See the source notes below for exactly which components make up each route.
                  </p>
                )}
                {a.marksSourceNote && (
                  <p class="m-0 mt-3 rounded-sm border-l-2 border-gold-500 pl-3 text-[13.5px] leading-[1.6] text-ink-mute" data-marks-source-note>
                    <span class="font-medium text-navy-800">Not all of these figures come from {c.board} documents:</span> {a.marksSourceNote}
                  </p>
                )}
                <p class="m-0 mt-3 text-[13px] text-ink-mute">
                  Source: <a href={a.officialSourceUrl} rel="nofollow noopener" class="underline decoration-rule underline-offset-2">official {c.board} specification</a>, verified {a.verifiedOn}.
                  {a.notes && <> {a.notes}</>}
                </p>
              </div>
            ))
          ) : (
            <p class="m-0 text-ink-mute">
              Marlbridge has not yet modeled the paper-by-paper assessment structure (marks, weighting, timing) for this
              specific qualification. {syllabus ? <>Refer to the <a href={syllabus.officialUrl} rel="nofollow noopener" class="underline decoration-teal-500 underline-offset-2">official {c.board} specification</a> for the current assessment scheme.</> : 'Refer to the official awarding-body specification for the current assessment scheme.'}
            </p>
          )}
        </div>
      </div>

      {faqs.length > 0 && (
        <div class="mt-[clamp(48px,6vw,80px)] border-t border-rule pt-[clamp(32px,4vw,56px)]">
          <h2 class="m-0 mb-2 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Assessment FAQs</h2>
          <FAQ items={faqs} />
        </div>
      )}

      {subjectEntry && (
        <div class="mt-[clamp(48px,6vw,80px)] grid items-start gap-8 border-t border-rule pt-[clamp(32px,4vw,56px)] lg:grid-cols-[minmax(280px,0.8fr)_1.6fr] lg:gap-[clamp(32px,5vw,88px)]">
          <h2 class="m-0 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">The subject</h2>
          <div class="max-w-[68ch] text-[17.5px] leading-[1.7]">
            <p class="m-0">{subjectEntry.data.description}</p>
            <p class="m-0 mt-4 text-[15.5px]">
              <a href={routes.subject(hubSlug)} class="underline decoration-teal-500 underline-offset-2">All {subjectEntry.data.title} at Marlbridge</a>
            </p>
          </div>
        </div>
      )}
    </Container>
  </Section>

  {tuitionPage && (
    <TuitionPanel
      c={c}
      page={tuitionPage}
      courseLabel={`${heading}${syllabus ? ` (${syllabus.code})` : ''}`}
      code={syllabus?.code}
      subjectEntry={subjectEntry}
      hubSlug={hubSlug}
      sampleResources={sampleResources}
      faqs={tuitionFaqList}
      practiceHref={practiceCount > 0 ? `/practice/${syllabus!.code}/` : undefined}
      checklistHref={syllabusTopics ? `${routes.checklists}${c.boardSlug}/${c.qualificationSlug}/${c.subjectSlug}/` : undefined}
    />
  )}

  {!tuitionPage && courseVideos.length > 0 && (
    <Section surface="white" spacing="md">
      <Container><VideoSection videos={courseVideos} heading="Lessons" id="hub-videos" /></Container>
    </Section>
  )}

  <Section surface="ivory" labelledby="other-quals" border>
    <Container>
      <h2 id="other-quals" class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">
        {c.subject} at other qualifications
      </h2>
      <p class="m-0 mb-[clamp(24px,3vw,40px)] max-w-[68ch] text-[16.5px] leading-[1.65] text-ink-mute">
        These are separate qualifications with different syllabuses and assessments — not different names for the same course. Check which one your school enters you for.
      </p>
      {siblings.length > 0 ? (
        <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {siblings.map((s) => {
            const sib = syllabusFor(s.boardSlug, s.qualificationSlug, s.subjectSlug);
            return (
              <li class="m-0">
                <a href={academicHubPath(s)} class="flex h-full flex-col gap-2 rounded-sm border border-rule bg-white p-[clamp(22px,2.2vw,30px)] transition-colors duration-150 hover:border-teal-500">
                  <span class="mb-label text-teal-700">{s.board}</span>
                  <span class="text-[18px] font-semibold tracking-[-0.01em] text-navy-800">{s.qualification} {s.subject}</span>
                  {sib && <span class="mt-auto pt-2 font-mono text-[12px] text-ink-mute">Syllabus {sib.code}</span>}
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="m-0 text-ink-mute">No other qualifications are published for this subject yet.</p>
      )}
    </Container>
  </Section>

  {articles.length > 0 && (
    <Section surface="white">
      <Container>
        <RelatedGrid id="hub-articles" title="Related articles">
          {articles.map((a) => <li class="m-0"><ArticleCard entry={a} /></li>)}
        </RelatedGrid>
      </Container>
    </Section>
  )}

  {classesOffered ? (
    <CTA
      heading={`Studying ${boardQualPhrase} ${c.subject}? Tell us where the difficulty is.`}
      buttonLabel="Request a free trial class"
      buttonCta={tuitionPage ? 'tuition-page-trial-final' : 'hub-trial-final'}
      buttonHref={tuitionPage ? `${routes.trial}?course=${encodeURIComponent(`${c.boardSlug}/${c.qualificationSlug}/${c.subjectSlug}`)}&source=tuition-page` : hubTrialHref}
      linkLabel="Studying outside Pakistan? Class times and fees for your country"
      linkHref="/international-tutoring/"
    />
  ) : (
    <CTA
      heading={`Marlbridge is not offering ${boardQualPhrase} ${c.subject} classes at the moment. The free study resources stay open to everyone.`}
      buttonLabel="Browse free resources"
      buttonHref={routes.resources}
    />
  )}
</PageLayout>

<script>
  // Navigation round (6 Oct 2026): visiting a course page makes it the
  // student's current course (scripts/course-context.ts).
  import { setCourse } from '../../../../scripts/course-context';
  const el = document.querySelector<HTMLElement>('[data-course-context]');
  if (el?.dataset.courseContext) {
    try { setCourse(JSON.parse(el.dataset.courseContext)); } catch { /* ignore */ }
  }
</script>
