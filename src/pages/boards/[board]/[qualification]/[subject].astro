// D-335 -- OCR courses and OxfordAQA Islamiyat / Pakistan Studies: one-to-one only.
const oneToOneOnly = classesOffered && isOneToOneOnlyCourse(c.boardSlug, c.subjectSlug);
const hubTrialHref = `${routes.trial}?course=${encodeURIComponent(`${c.boardSlug}/${c.qualificationSlug}/${c.subjectSlug}`)}${oneToOneOnly ? '&format=one-to-one' : ''}&source=hub`;
// A resources-only combination (owner decision 2026-09-21) is not an
// offered course, so it gets no Course structured data.
const jsonLd = [
  ...(classesOffered ? [courseNode({
    path,
    name: syllabus?.officialTitle ?? heading,
    description: `${heading} teaching and study resources from Marlbridge.`,
    authorId: 'marlbridge-academic-team',
  })] : []),
  ...(faq ? [faq] : []),
  ...videoNodes(courseVideos),
];
