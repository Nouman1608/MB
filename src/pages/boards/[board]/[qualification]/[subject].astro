                  </p>
                )}
                {a.specStatus === 'future' && (
                  <p class="m-0 mb-3 text-[15px] text-ink-mute">
                    {a.code} is an upcoming specification{a.relatedCode && <>, replacing {a.relatedCode}</>}
                    {a.firstTeaching && <>, for first teaching from {teachingMonthLabel(a.firstTeaching)}</>}. First assessment: {a.firstAssessment}.
                    {' '}Its first exams have not been sat yet.
                    {' '}{a.firstTeaching ? <>Learners who start the course from {teachingMonthLabel(a.firstTeaching)} follow it</> : <>Learners follow it once its teaching begins</>}{a.relatedCode && <>; learners already partway through {a.relatedCode} finish that specification{assessments.find((o) => o.code === a.relatedCode)?.finalAssessment && <>, whose final exams are in {assessments.find((o) => o.code === a.relatedCode)?.finalAssessment}</>}</>}.
                  </p>
                )}
                {a.specStatus === 'withdrawn' && (
                  <p class="m-0 mb-3 text-[15px] text-ink-mute">
                    {a.code} has been withdrawn and is no longer assessable{a.relatedCode && <>; see {a.relatedCode}</>}. Shown here for historical reference only.
                  </p>
