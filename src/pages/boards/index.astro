---
/**
 * Board directory — /boards/
 *
 * Lists every examination board in the model. Boards with status "offered"
 * link to their own hub; OCR (status "future") is shown for transparency —
 * it is a real board and is fully modelled (see boards.ts, matrix.ts,
 * syllabuses.ts) — but is never linked, matching isPublishable()'s hard
 * gate that no OCR route can exist while board.status is "future".
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import { BOARDS, boardPath, boardsPath, combinationsForBoard } from '../../utils/academic';
import { routes } from '../../utils/urls/routes';

const rows = BOARDS.map((b) => {
  const combos = b.status === 'offered' ? combinationsForBoard(b.slug) : [];
  const qualifications = [...new Set(combos.map((c) => c.qualification))];
  return { board: b, combos, qualifications };
});
---
<PageLayout
  title="Exam boards"
  description="Cambridge, Pearson Edexcel and AQA — the examination boards Marlbridge teaches, with every qualification and subject combination we publish for each."
  path={boardsPath()}
  eyebrow="Boards"
  heading="Exam boards"
  lead="Every board in the Marlbridge academic model, and what we publish for each. A board only links through once it is taught by Marlbridge."
  breadcrumbs={[{ label: 'Home', href: routes.home }, { label: 'Boards', href: boardsPath() }]}
>
  <Section surface="white">
    <Container>
      <ul class="m-0 grid list-none gap-px border border-rule bg-rule p-0 sm:grid-cols-2">
        {rows.map(({ board, combos, qualifications }) => (
          <li class="m-0 bg-white p-[clamp(20px,3vw,32px)]">
            {board.status === 'offered' ? (
              <a href={boardPath(board.slug)} class="group block">
                <h2 class="m-0 font-display text-2xl tracking-[-0.01em] text-navy-800 group-hover:text-gold-600">{board.name}</h2>
                <p class="m-0 mt-2 text-[15px] text-ink-mute">
                  {combos.length} {combos.length === 1 ? 'combination' : 'combinations'} across {qualifications.length} {qualifications.length === 1 ? 'qualification' : 'qualifications'}: {qualifications.join(', ')}.
                </p>
                <span class="mt-4 inline-block border-b border-gold-500 text-[14px] font-medium text-navy-800 group-hover:text-gold-600">View {board.name} →</span>
              </a>
            ) : (
              <div>
                <h2 class="m-0 font-display text-2xl tracking-[-0.01em] text-ink-mute">{board.name}</h2>
                <p class="m-0 mt-2 text-[15px] text-ink-mute">{board.notes ?? 'Not currently offered by Marlbridge.'}</p>
                <span class="mt-4 inline-block rounded-sm border border-rule px-2 py-0.5 font-mono text-[10.5px] uppercase tracking-[0.08em] text-ink-mute">Not currently offered</span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </Container>
  </Section>
</PageLayout>
