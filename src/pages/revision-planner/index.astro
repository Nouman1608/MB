---
/**
 * D-286 -- /revision-planner/: the free revision-plan generator.
 *
 * Everything runs in the student's browser (src/scripts/planner-ui.ts and
 * the pure scheduler in src/scripts/planner-engine.ts). No account, no
 * email, no server: the plan is saved only in this browser's localStorage,
 * is never put in a URL, and is never sent to analytics -- only a count of
 * subjects and weeks is recorded when a plan is made (see
 * docs/growth/measurement-guide.md).
 *
 * Exam dates come only from the student. The page links to the exam
 * calendar for series dates and tells students to use the date on their own
 * statement of entry or timetable; it never guesses a date.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import CTA from '../../components/ui/CTA.astro';
import { QUALIFICATIONS } from '../../data/academic/qualifications';
import { activeOnly } from '../../utils/academic';
import { routes } from '../../utils/urls/routes';

const path = '/revision-planner/';
const present = new Set(activeOnly().map((c) => c.qualificationSlug));
const quals = QUALIFICATIONS.filter((q) => present.has(q.slug));
const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const minuteOptions = [0, 30, 45, 60, 90, 120, 150, 180, 240, 300];
const defaults = [60, 60, 60, 60, 60, 120, 90];
const faqs = [
  { question: 'Is the revision planner free?', answer: 'Yes. It is free, needs no account and no email address, and works on a phone.' },
  { question: 'Where is my plan saved?', answer: 'Only in this browser, on this device. It is not sent to Marlbridge and it is not put in a link. Clearing your browser data deletes it.' },
  { question: 'What if I do not know my exam dates yet?', answer: 'Tick "I don\'t know the date yet". The plan then runs for the number of weeks you choose. Your school or your statement of entry gives the exact date for each paper.' },
];
---
<PageLayout
  title="Free Revision Planner — Weekly Plan for IGCSE, A Level & IB"
  description="Make a free weekly revision plan for IGCSE, O Level, A Level, GCSE or IB. Rate your topics, add exam dates and free time, and get a plan that puts weak topics first."
  path={path}
  eyebrow="Free tool · no sign-up"
  heading="Revision planner"
  lead="Add your subjects, exam dates and free time, rate how confident you feel about each topic, and get a realistic weekly plan. Weak topics and nearer exams come first, and every session links to Marlbridge notes or practice for that topic."
  breadcrumbs={[
    { label: 'Home', href: routes.home },
    { label: 'Revision planner', href: path },
  ]}
>
  <Section surface="white" spacing="md" class="planner-inputs">
    <Container>
      <noscript>
        <p class="m-0 mb-6 rounded-sm border border-rule bg-ivory p-5 text-[15px]">The revision planner needs JavaScript. You can still revise from the <a href="/checklists/" class="underline decoration-gold-500 underline-offset-2">printable syllabus checklists</a>.</p>
      </noscript>

      <form id="planner-form" novalidate class="grid gap-10">
        <fieldset class="m-0 border-0 p-0">
          <legend class="m-0 mb-1 p-0 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">1. Your subjects</legend>
          <p class="m-0 mb-5 max-w-[68ch] text-[15px] text-ink-mute">Add up to six subjects. For each one, enter the exam date if you know it, and rate each topic from 1 (very weak) to 5 (confident).</p>

          <div class="grid gap-4 rounded-sm border border-rule bg-ivory p-[clamp(16px,2vw,24px)] sm:grid-cols-[1fr_1fr_1.4fr_auto] sm:items-end">
            <div class="grid gap-1.5">
              <label for="pl-q" class="text-[13.5px] font-medium">Qualification</label>
              <select id="pl-q" class="min-h-11 w-full rounded-sm border border-rule bg-white px-3 text-[15px]">
                <option value="">Choose…</option>
                {quals.map((q) => <option value={q.slug}>{q.name}</option>)}
              </select>
            </div>
            <div class="grid gap-1.5">
              <label for="pl-b" class="text-[13.5px] font-medium">Exam board</label>
              <select id="pl-b" disabled class="min-h-11 w-full rounded-sm border border-rule bg-white px-3 text-[15px] disabled:bg-ivory disabled:text-ink-mute"><option value="">Choose a qualification first</option></select>
            </div>
            <div class="grid gap-1.5">
              <label for="pl-s" class="text-[13.5px] font-medium">Subject and syllabus code</label>
              <select id="pl-s" disabled class="min-h-11 w-full rounded-sm border border-rule bg-white px-3 text-[15px] disabled:bg-ivory disabled:text-ink-mute"><option value="">Choose a board first</option></select>
            </div>
            <button type="button" id="pl-add" disabled class="min-h-11 rounded-sm bg-navy-800 px-5 text-[15px] font-medium text-ivory transition-colors hover:bg-navy-700 disabled:opacity-50">Add subject</button>
          </div>
          <p id="pl-add-status" role="status" aria-live="polite" class="m-0 mt-2 text-[14px] text-ink-mute"></p>

          <ol id="pl-subjects" class="m-0 mt-5 grid list-none gap-4 p-0"></ol>
          <p id="pl-empty" class="m-0 mt-2 text-[14.5px] text-ink-mute">No subjects added yet.</p>
        </fieldset>

        <fieldset class="m-0 border-0 p-0">
          <legend class="m-0 mb-1 p-0 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">2. Your time</legend>
          <p class="m-0 mb-5 max-w-[68ch] text-[15px] text-ink-mute">How long could you really study on each day? Be honest — a plan you can keep beats a plan that looks impressive.</p>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
            {days.map((d, i) => (
              <div class="grid gap-1.5">
                <label for={`pl-day-${i}`} class="text-[13.5px] font-medium">{d}</label>
                <select id={`pl-day-${i}`} data-day={i} class="min-h-11 w-full rounded-sm border border-rule bg-white px-2 text-[15px]">
                  {minuteOptions.map((m) => <option value={m} selected={m === defaults[i]}>{m === 0 ? 'No study' : m < 60 ? `${m} min` : `${m / 60} h`.replace('.5 h', '½ h')}</option>)}
                </select>
              </div>
            ))}
          </div>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="grid gap-1.5">
              <label for="pl-session" class="text-[13.5px] font-medium">Session length</label>
              <select id="pl-session" class="min-h-11 rounded-sm border border-rule bg-white px-3 text-[15px]">
                <option value="25">25 minutes</option>
                <option value="30">30 minutes</option>
                <option value="45" selected>45 minutes</option>
                <option value="60">60 minutes</option>
              </select>
            </div>
            <div class="grid gap-1.5">
              <label for="pl-break" class="text-[13.5px] font-medium">Break between sessions</label>
              <select id="pl-break" class="min-h-11 rounded-sm border border-rule bg-white px-3 text-[15px]">
                <option value="5">5 minutes</option>
                <option value="10" selected>10 minutes</option>
                <option value="15">15 minutes</option>
              </select>
            </div>
            <div class="grid gap-1.5">
              <label for="pl-start" class="text-[13.5px] font-medium">Start the plan on</label>
              <input id="pl-start" type="date" class="min-h-11 rounded-sm border border-rule bg-white px-3 text-[15px]" />
            </div>
            <div class="grid gap-1.5">
              <label for="pl-weeks" class="text-[13.5px] font-medium">Weeks to plan if no exam date</label>
              <select id="pl-weeks" class="min-h-11 rounded-sm border border-rule bg-white px-3 text-[15px]">
                <option value="4">4 weeks</option>
                <option value="6">6 weeks</option>
                <option value="8" selected>8 weeks</option>
                <option value="12">12 weeks</option>
              </select>
            </div>
          </div>
        </fieldset>

        <div>
          <div id="pl-errors" role="alert" tabindex="-1" class="mb-4 hidden rounded-sm border border-[#E3BDBD] bg-[#FBF2F2] p-4 text-[15px] text-error"></div>
          <button type="submit" id="pl-generate" class="inline-flex min-h-11 items-center justify-center rounded-sm bg-navy-800 px-7 py-3.5 text-[15px] font-medium text-ivory transition-colors hover:bg-navy-700">Make my plan</button>
          <p class="m-0 mt-3 max-w-[68ch] text-[13.5px] text-ink-mute">Your plan is made on this device and saved only in this browser. It is not sent to Marlbridge and is never put in a link.</p>
        </div>
      </form>
    </Container>
  </Section>

  <Section surface="ivory" spacing="md" border id="plan" class="planner-output hidden">
    <Container>
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="pl-plan-heading" tabindex="-1" class="m-0 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Your revision plan</h2>
          <p id="pl-summary" class="m-0 mt-2 text-[15px] text-ink-mute"></p>
        </div>
        <div class="planner-toolbar flex flex-wrap gap-2">
          <button type="button" id="pl-print" class="min-h-11 rounded-sm border border-rule bg-white px-4 text-[14.5px] font-medium hover:border-gold-500">Print or save as PDF</button>
          <button type="button" id="pl-regenerate" class="min-h-11 rounded-sm border border-rule bg-white px-4 text-[14.5px] font-medium hover:border-gold-500">Change inputs</button>
          <button type="button" id="pl-clear" class="min-h-11 rounded-sm border border-rule bg-white px-4 text-[14.5px] font-medium text-error hover:border-error">Delete saved plan</button>
        </div>
      </div>
      <p id="pl-saved" role="status" aria-live="polite" class="planner-toolbar m-0 mb-4 text-[13.5px] text-ink-mute"></p>
      <div id="pl-warnings" class="mb-6 hidden rounded-sm border border-gold-500 bg-white p-5"></div>
      <div id="pl-weeks-out" class="grid gap-6"></div>
      <p class="m-0 mt-6 text-[13.5px] text-ink-mute">This is a study plan, not a prediction of your results. Adjust it as you go: tick sessions off, edit one to suit you, or change your inputs and make a new plan.</p>
    </Container>
  </Section>

  <Section surface="white" spacing="md" border class="planner-inputs">
    <Container>
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <h2 class="m-0 mb-4 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">How the plan is made</h2>
          <ol class="m-0 grid gap-2.5 pl-5 text-[15px] leading-[1.6] text-ink">
            <li>Your free minutes each day are split into sessions of the length you chose, with a break between them.</li>
            <li>In any week with three or more sessions, the last one is kept for catch-up.</li>
            <li>Each topic gets sessions from your rating: <strong>1</strong> — learn, practise, revise, practise; <strong>2</strong> — learn, practise, revise; <strong>3 or not rated</strong> — practise, revise; <strong>4 or 5</strong> — revise once. "I find this difficult" counts as 2 at most and moves the topic up.</li>
            <li>Sessions on the same topic are spread out: at least 2 days after learning it and 3 days after practising it.</li>
            <li>Each session goes to the subject with the most work left for the time left before its exam. Weaker topics come first.</li>
            <li>The same subject isn't given two sessions in a row on one day if another subject has work.</li>
            <li>In the last 14 days before an exam, every other session for that subject is mixed exam-style practice.</li>
            <li>Nothing is planned for a subject on or after its exam date.</li>
            <li>If your time can't fit everything, the plan tells you what didn't fit and roughly how much more time it needs.</li>
          </ol>
        </div>
        <div>
          <h2 class="m-0 mb-4 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Questions</h2>
          <dl class="m-0 grid gap-4">
            {faqs.map((f) => (
              <div>
                <dt class="m-0 font-semibold text-navy-800">{f.question}</dt>
                <dd class="m-0 mt-1 text-[15px] leading-[1.6] text-ink-mute">{f.answer}</dd>
              </div>
            ))}
          </dl>
          <p class="m-0 mt-5 text-[15px] text-ink-mute">Need the series dates? See the <a href="/exam-calendar/" class="underline decoration-gold-500 underline-offset-2">exam calendar</a> — then check each paper's date on your own timetable.</p>
        </div>
      </div>
    </Container>
  </Section>

  <div class="planner-inputs">
    <CTA
      surface="ivory"
      heading="Stuck on the same topics every week? A subject teacher can work through them with you."
      buttonLabel="Request a free trial class"
      buttonHref="/trial/?source=planner"
    />
  </div>
</PageLayout>

<script>
  import '../../scripts/planner-ui';
</script>

<style>
  @media print {
    :global(header), :global(footer), :global([data-consent-banner]), :global([data-whatsapp-button]),
    :global(nav[aria-label="Breadcrumb"]), :global(.planner-inputs), :global(.planner-toolbar),
    :global(.pl-session-actions) { display: none !important; }
    :global(.planner-output) { display: block !important; padding: 0 !important; background: #fff !important; }
    :global(.pl-week) { break-inside: avoid-page; }
    :global(.pl-day) { break-inside: avoid; }
    :global(a) { text-decoration: none !important; color: #000 !important; }
  }
</style>
