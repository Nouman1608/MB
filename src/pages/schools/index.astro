---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import { routes } from '../../utils/urls/routes';
---
<PageLayout
  translationKey="schools"
  title="For Schools"
  description="Marlbridge shares its academic resources with schools and teachers, and is developing partnership work in curriculum support and teacher development."
  path={routes.schools}
  eyebrow="For Schools"
  heading="Working with schools"
  lead="Marlbridge shares its academic resources with schools and teachers. Partnership work in curriculum support and teacher development is in development."
  breadcrumbs={[{ label: 'Home', href: routes.home }, { label: 'For Schools', href: routes.schools }]}
>
  <Section surface="white">
    <Container>
      <div class="max-w-[68ch] text-[17.5px] leading-[1.7]">
        <p class="m-0">Our published resources are free for schools and teachers to use with their classes. No licence, no account, no attribution required — though we appreciate a link.</p>
        <p class="m-0 mt-5">This covers printing copies for a full year group and uploading resources to your school's LMS (Google Classroom, Moodle, or similar) for students to access directly. Please use resources as published rather than editing, relabelling or rebranding them — if you'd like to adapt our material, or use it somewhere this page doesn't cover, just ask.</p>
        <p class="m-0 mt-5">Beyond that, we would rather build what schools actually need than announce a service list we cannot yet deliver. If curriculum support, teacher development or shared assessment material would help your department, tell us specifically what the gap is.</p>
      </div>

      <section aria-labelledby="school-enquiry" class="mt-[clamp(48px,6vw,80px)] border-t border-rule pt-10">
        <h2 id="school-enquiry" class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Talk to us</h2>
        <p class="m-0 mb-8 max-w-[62ch] text-[17px] text-ink-mute">We reply to every school enquiry, including the ones we have to say no to.</p>
        <EnquiryForm kind="school" />
      </section>
    </Container>
  </Section>
</PageLayout>
