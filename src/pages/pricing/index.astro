---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import FAQ from '../../components/ui/FAQ.astro';
import { faqNode } from '../../utils/schema/faq';
import FeeCalculator from '../../components/tools/FeeCalculator.astro';
import { routes } from '../../utils/urls/routes';
import {
  REGION_PRICING, PRICING_TERMS, PRICING_VERIFIED_DATE, formatFee, IB_PRICING, IB_CONVERSIONS, IB_USD_PRICING,
  ONE_TO_ONE_PRICING, ONE_TO_ONE_TERMS, combinedDiscountPercent, discountWorkedExample,
  isIndicative, INDICATIVE_NOTE,
} from '../../data/pricing';

const combinedPercent = combinedDiscountPercent();
// D-330: the three ways tuition is priced, side by side. Pakistan rows are the owner-set base rates.
const pk = REGION_PRICING.find((r) => r.region === 'Pakistan')!;
const pk1 = ONE_TO_ONE_PRICING.find((r) => r.region === 'Pakistan')!;
const compareRows: [string, string, string, string][] = [
  ['Charged', 'Per subject, per month', 'Per class', 'Per class'],
  ['Pakistan fee', `${formatFee(pk.igcse, pk.currency)} ${pk.currency} (IGCSE, GCSE, O Level) or ${formatFee(pk.aLevel, pk.currency)} ${pk.currency} (AS, A Level) per subject per month`, `${formatFee(pk1.igcse, pk1.currency)} ${pk1.currency} (IGCSE, GCSE, O Level) or ${formatFee(pk1.aLevel, pk1.currency)} ${pk1.currency} (AS, A Level) per class`, `${IB_PRICING.perClass.toLocaleString('en-US')} ${IB_PRICING.currency} per class (MYP and Diploma)`],
  ['Class length', PRICING_TERMS.classFormat.group.split(',')[0], '1 hour', '1 hour'],
  ['How often', '3 classes a week, per subject', 'Up to you: as many classes as you book', 'Up to you: as many classes as you book'],
  ['Class size', `Up to ${PRICING_TERMS.maxGroupSize} students`, 'One student', 'One student'],
  ['Discounts', `${PRICING_TERMS.multiSubjectDiscount.percentOff}% for ${PRICING_TERMS.multiSubjectDiscount.minSubjects}+ subjects; ${PRICING_TERMS.siblingDiscount.percentOff}% sibling; the two add together`, 'None', 'None'],
  ['Free trial', 'A real group class', 'A real one-to-one class', 'A real one-to-one class'],
  ['Paying and stopping', `${PRICING_TERMS.billing} ${PRICING_TERMS.cancellationPolicy}`, `${PRICING_TERMS.billing} ${PRICING_TERMS.cancellationPolicy}`, `${PRICING_TERMS.billing} ${PRICING_TERMS.cancellationPolicy}`],
  ['Other countries', 'Set by Marlbridge for the Gulf, UK and Europe; indicative conversions for Malaysia and other countries', 'Set by Marlbridge for Pakistan and US dollars; indicative conversions elsewhere', 'Set for Pakistan and US dollars; indicative conversions for the listed regions'],
];
const example = discountWorkedExample();

const faqs = [
  {
    question: 'How much does Marlbridge tuition cost?',
    answer: `Group classes are charged ${PRICING_TERMS.unit}; one-to-one classes and IB tuition are charged per class. For group classes, GCSE, IGCSE and O Level are charged at the IGCSE rate for your region; International AS, AS and A Level are charged at the A Level rate. See the tables on this page for your region, or enquire if your country is not listed.`,
  },
  {
    question: 'Are there discounts for multiple subjects or siblings?',
    answer: `Yes. A ${PRICING_TERMS.multiSubjectDiscount.percentOff}% discount applies for ${PRICING_TERMS.multiSubjectDiscount.minSubjects} or more subjects taken together, and a ${PRICING_TERMS.siblingDiscount.percentOff}% sibling discount applies for up to ${PRICING_TERMS.siblingDiscount.maxSiblings} siblings enrolled at the same time. These two discounts combine if a family qualifies for both: they are added together (${PRICING_TERMS.multiSubjectDiscount.percentOff}% + ${PRICING_TERMS.siblingDiscount.percentOff}% = ${combinedPercent}% off in total), not applied one after the other. For example, ${example.subjectCount} subjects in ${example.region} at ${formatFee(example.perSubject, example.currency)} ${example.currency}/subject/month comes to ${formatFee(example.beforeDiscount, example.currency)} ${example.currency}/month before any discount; with both discounts applied, that becomes ${formatFee(example.afterDiscount, example.currency)} ${example.currency}/month (${combinedPercent}% off). Both discounts apply to group classes only, not to one-to-one tuition.`,
  },
  {
    question: 'How long are classes, and how often?',
    answer: `Group classes: ${PRICING_TERMS.classFormat.group} One-to-one classes: ${PRICING_TERMS.classFormat.oneToOne}`,
  },
  {
    question: 'Is there a free trial?',
    answer: PRICING_TERMS.freeTrial,
  },
  {
    question: 'How and when do I pay, and is there a registration fee?',
    answer: `${PRICING_TERMS.billing} We accept ${PRICING_TERMS.paymentMethods.join(' and ')}. ${PRICING_TERMS.enrolmentFee}`,
  },
  {
    question: 'What if I need to cancel or pause?',
    answer: PRICING_TERMS.cancellationPolicy,
  },
  {
    question: 'My country is not listed — what do I pay?',
    answer: PRICING_TERMS.unsupportedRegionNote,
  },
  {
    question: 'Will these prices stay the same?',
    answer: `${PRICING_TERMS.notPermanentNote} Last confirmed ${PRICING_VERIFIED_DATE}.`,
  },
  {
    question: 'How much does IB tuition cost?',
    answer: `IB tuition (Middle Years Programme and Diploma Programme) is priced differently from the rest of the site: ${IB_PRICING.perClass.toLocaleString('en-US')} ${IB_PRICING.currency} ${IB_PRICING.unit}, ${IB_PRICING.deliveryMode} This rate is set for ${IB_PRICING.region} (last confirmed ${IB_PRICING.verifiedDate}); indicative conversions are shown for the listed regions, and every other country pays ${IB_USD_PRICING.myp} USD (MYP) or ${IB_USD_PRICING.dp} USD (Diploma Programme) per 1-hour class. ${IB_PRICING.unsupportedRegionNote}`,
  },
  {
    question: 'How much does one-to-one (1:1) tuition cost?',
    answer: `One-to-one classes are priced per class rather than per subject per month. For IGCSE/GCSE/O Level it is ${formatFee(ONE_TO_ONE_PRICING[0].igcse, ONE_TO_ONE_PRICING[0].currency)} ${ONE_TO_ONE_PRICING[0].currency} ${ONE_TO_ONE_TERMS.unit}, and for A Level it is ${formatFee(ONE_TO_ONE_PRICING[0].aLevel, ONE_TO_ONE_PRICING[0].currency)} ${ONE_TO_ONE_PRICING[0].currency} ${ONE_TO_ONE_TERMS.unit}, confirmed for ${ONE_TO_ONE_PRICING[0].region}. See the one-to-one table on this page for other regions. ${ONE_TO_ONE_TERMS.conversionNote}`,
  },
];
const faq = faqNode(faqs);
---
<PageLayout
  translationKey="pricing"
  title="Pricing"
  description="Marlbridge tuition fees by region for IGCSE/GCSE/O Level and A Level: group classes per subject per month, one-to-one and IB classes per class — with group-class discounts and a free trial class."
  path={routes.pricing}
  eyebrow="Pricing"
  heading="Tuition fees, by region."
  lead="Group-class fees are per subject, per month; one-to-one classes and IB tuition are charged per class, in their own tables below. GCSE, International GCSE and Cambridge O Level are charged at the IGCSE rate; International AS, AS and A Level are charged at the A Level rate."
  breadcrumbs={[{ label: 'Home', href: routes.home }, { label: 'Pricing', href: routes.pricing }]}
  jsonLd={faq ? [faq] : []}
>
  <Section surface="white">
    <Container>
      <h2 class="m-0 mb-4 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Group, one-to-one or IB: how they compare</h2>
      <p class="m-0 mb-5 max-w-[62ch] text-[15.5px] leading-relaxed text-ink-mute">A monthly group fee and a per-class one-to-one fee are not directly comparable: one covers {PRICING_TERMS.classFormat.group.split(',')[1]?.trim() ?? 'three classes a week'} for a month, the other is one hour.</p>
      <div class="overflow-x-auto" tabindex="0" role="group" aria-label="Comparison table, scrolls sideways on small screens">
        <table class="w-full min-w-[720px] border-collapse text-[14.5px] leading-snug">
          <caption class="sr-only">How group classes, one-to-one classes and IB tuition are priced and run</caption>
          <thead>
            <tr class="border-b border-rule text-left">
              <td class="py-3 pr-4"></td>
              <th scope="col" class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Group classes</th>
              <th scope="col" class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">One-to-one</th>
              <th scope="col" class="py-3 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">IB (one-to-one)</th>
            </tr>
          </thead>
          <tbody>
            {compareRows.map(([k, g, o, ib]) => (
              <tr class="border-b border-rule align-top">
                <th scope="row" class="py-3 pr-4 text-left font-medium text-ink">{k}</th>
                <td class="py-3 pr-4 text-ink-mute">{g}</td>
                <td class="py-3 pr-4 text-ink-mute">{o}</td>
                <td class="py-3 text-ink-mute">{ib}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 id="fee-calc-heading" class="m-0 mb-4 mt-12 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Work out a fee</h2>
      <FeeCalculator />

      <h2 class="m-0 mb-4 mt-12 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Group classes, by region</h2>
      <div class="overflow-x-auto" tabindex="0" role="group" aria-label="Table, scrolls sideways on small screens">
        <table class="w-full min-w-[560px] border-collapse text-[15px]">
          <caption class="sr-only">Group-class fees per subject per month, by region</caption>
          <thead>
            <tr class="border-b border-rule text-left">
              <th scope="col" class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Region</th>
              <th scope="col" class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">GCSE / IGCSE / O Level</th>
              <th scope="col" class="py-3 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">AS / A Level</th>
            </tr>
          </thead>
          <tbody>
            {REGION_PRICING.map((r) => (
              <tr class="border-b border-rule">
                <th scope="row" class="py-3 pr-4 text-left font-normal text-ink">{r.region}{r.region === 'United Arab Emirates' ? ' (UAE)' : ''}{isIndicative(r) && <span class="ms-2 rounded-sm border border-gold-500 px-1.5 py-0.5 font-mono text-[10.5px] uppercase tracking-[0.08em] text-gold-600">Indicative</span>}</th>
                <td class="py-3 pr-4 text-ink-mute">{formatFee(r.igcse, r.currency)} {r.currency} <span class="text-[13px] text-ink-mute">/subject/month</span></td>
                <td class="py-3 text-ink-mute">{formatFee(r.aLevel, r.currency)} {r.currency} <span class="text-[13px] text-ink-mute">/subject/month</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {REGION_PRICING.some(isIndicative) && (
        <p class="m-0 mt-4 max-w-[62ch] text-[13px] text-ink-mute">{INDICATIVE_NOTE}</p>
      )}
      <p class="m-0 mt-6 max-w-[62ch] text-[15.5px] leading-relaxed text-ink-mute">
        Don't see your country? {PRICING_TERMS.unsupportedRegionNote}
      </p>
      <p class="m-0 mt-3 max-w-[62ch] text-[15.5px] leading-relaxed text-ink-mute">
        Class times, boards taught and fees for families outside Pakistan are set out on the
        {' '}<a href="/international-tutoring/" class="underline decoration-gold-500 underline-offset-2 hover:text-gold-600">international online tutoring page</a>.
      </p>
      <p class="m-0 mt-3 text-[13px] text-ink-mute">Pricing last verified {PRICING_VERIFIED_DATE}. {PRICING_TERMS.notPermanentNote}</p>
    </Container>
  </Section>

  <Section surface="ivory" border>
    <Container>
      <h2 class="m-0 mb-4 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">One-to-one classes</h2>
      <p class="m-0 mb-6 max-w-[62ch] text-[15.5px] leading-relaxed text-ink-mute">
        One-to-one tuition is priced per class rather than per subject per month. The multi-subject and sibling discounts above do not apply to one-to-one classes.
      </p>
      <div class="overflow-x-auto" tabindex="0" role="group" aria-label="Table, scrolls sideways on small screens">
        <table class="w-full min-w-[560px] border-collapse text-[15px]">
          <caption class="sr-only">One-to-one fees per class, by region</caption>
          <thead>
            <tr class="border-b border-rule text-left">
              <th scope="col" class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Region</th>
              <th scope="col" class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">GCSE / IGCSE / O Level</th>
              <th scope="col" class="py-3 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">AS / A Level</th>
            </tr>
          </thead>
          <tbody>
            {ONE_TO_ONE_PRICING.map((r) => (
              <tr class="border-b border-rule">
                <th scope="row" class="py-3 pr-4 text-left font-normal text-ink">{r.region}{r.region === 'United Arab Emirates' ? ' (UAE)' : ''}{isIndicative(r) && <span class="ms-2 rounded-sm border border-gold-500 px-1.5 py-0.5 font-mono text-[10.5px] uppercase tracking-[0.08em] text-gold-600">Indicative</span>}</th>
                <td class="py-3 pr-4 text-ink-mute">{formatFee(r.igcse, r.currency)} {r.currency} <span class="text-[13px] text-ink-mute">{ONE_TO_ONE_TERMS.unit}</span></td>
                <td class="py-3 text-ink-mute">{formatFee(r.aLevel, r.currency)} {r.currency} <span class="text-[13px] text-ink-mute">{ONE_TO_ONE_TERMS.unit}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="m-0 mt-6 text-[13px] text-ink-mute">{ONE_TO_ONE_TERMS.deliveryMode}</p>
      <p class="m-0 mt-3 max-w-[62ch] text-[13px] text-ink-mute">{ONE_TO_ONE_TERMS.conversionNote}</p>
      <p class="m-0 mt-3 text-[13px] text-ink-mute">Last confirmed/converted {ONE_TO_ONE_TERMS.verifiedDate}. {ONE_TO_ONE_TERMS.notPermanentNote}</p>
    </Container>
  </Section>

  <Section surface="white" border>
    <Container>
      <h2 class="m-0 mb-4 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">IB tuition</h2>
      <p class="m-0 mb-6 max-w-[62ch] text-[15.5px] leading-relaxed text-ink-mute">
        IB (Middle Years Programme and Diploma Programme) is priced differently from the rest of the site above -- per class rather than per subject per month, and one-to-one only. The multi-subject and sibling discounts below do not apply to IB tuition.
      </p>
      <div class="mb-2 max-w-[420px] rounded-sm border border-rule bg-white p-6">
        <p class="m-0 mb-2 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">{IB_PRICING.region}</p>
        <p class="m-0 text-[17px] text-ink">{IB_PRICING.perClass.toLocaleString('en-US')} {IB_PRICING.currency} <span class="text-[13px] text-ink-mute">{IB_PRICING.unit}</span></p>
        <p class="m-0 mt-2 text-[13px] text-ink-mute">{IB_PRICING.deliveryMode}</p>
      </div>
      <div class="mb-2 mt-4 max-w-[420px] rounded-sm border border-rule bg-white p-6">
        <p class="m-0 mb-2 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Other countries (US dollars)</p>
        <p class="m-0 text-[17px] text-ink">{IB_USD_PRICING.myp} USD <span class="text-[13px] text-ink-mute">MYP, per 1-hour class</span></p>
        <p class="m-0 mt-1 text-[17px] text-ink">{IB_USD_PRICING.dp} USD <span class="text-[13px] text-ink-mute">Diploma Programme, per 1-hour class</span></p>
        <p class="m-0 mt-2 text-[13px] text-ink-mute">One-to-one only. Set by Marlbridge, not a currency conversion.</p>
      </div>
      <div class="mt-4 overflow-x-auto" tabindex="0" role="group" aria-label="Table, scrolls sideways on small screens">
        <table class="w-full min-w-[360px] max-w-[560px] border-collapse text-[15px]">
          <caption class="sr-only">IB fee per 1-hour one-to-one class, indicative conversions of the Pakistan fee for the listed regions</caption>
          <thead>
            <tr class="border-b border-rule text-left">
              <th scope="col" class="py-2 pr-4 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Region</th>
              <th scope="col" class="py-2 pr-4 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Per 1-hour class</th>
              <th scope="col" class="py-2 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Status</th>
            </tr>
          </thead>
          <tbody>
            {IB_CONVERSIONS.map((r) => (
              <tr class="border-b border-rule">
                <th scope="row" class="py-2 pr-4 text-left font-normal text-ink">{r.region}</th>
                <td class="py-2 pr-4 text-ink-mute">{formatFee(r.perClass, r.currency)} {r.currency}</td>
                <td class="py-2 text-ink-mute">Indicative</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="m-0 mt-3 text-[13px] text-ink-mute">{IB_PRICING.unsupportedRegionNote} Last confirmed {IB_PRICING.verifiedDate}.</p>
    </Container>
  </Section>

  <Section surface="white" border>
    <Container>
      <h2 class="m-0 mb-2 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Discounts and trial</h2>
      <p class="m-0 mb-6 max-w-[62ch] text-[15.5px] leading-relaxed text-ink-mute">The multi-subject and sibling discounts below combine if you qualify for both -- added together, not applied one after the other -- and apply to group classes only.</p>
      <ul class="m-0 grid list-none gap-5 p-0 sm:grid-cols-3">
        <li class="m-0 rounded-sm border border-rule bg-white p-6">
          <p class="m-0 mb-2 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Multi-subject</p>
          <p class="m-0 text-[17px] text-ink">{PRICING_TERMS.multiSubjectDiscount.percentOff}% off for {PRICING_TERMS.multiSubjectDiscount.minSubjects}+ subjects taken together.</p>
        </li>
        <li class="m-0 rounded-sm border border-rule bg-white p-6">
          <p class="m-0 mb-2 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Sibling discount</p>
          <p class="m-0 text-[17px] text-ink">{PRICING_TERMS.siblingDiscount.percentOff}% off for up to {PRICING_TERMS.siblingDiscount.maxSiblings} siblings enrolled together.</p>
        </li>
        <li class="m-0 rounded-sm border border-rule bg-white p-6">
          <p class="m-0 mb-2 font-mono text-[11px] uppercase tracking-[0.1em] text-gold-600">Trial class</p>
          <p class="m-0 text-[17px] text-ink">{PRICING_TERMS.freeTrial}</p>
        </li>
      </ul>
      <p class="m-0 mt-6 max-w-[62ch] text-[15.5px] leading-relaxed text-ink-mute">
        <strong class="font-semibold text-ink">Qualify for both?</strong> The two discounts add together rather than applying one after the other. For example, {example.subjectCount} subjects in {example.region} at {formatFee(example.perSubject, example.currency)} {example.currency}/subject/month is {formatFee(example.beforeDiscount, example.currency)} {example.currency}/month before any discount. With both discounts ({combinedPercent}% combined), that becomes {formatFee(example.afterDiscount, example.currency)} {example.currency}/month.
      </p>
    </Container>
  </Section>

  <Section surface="white" border>
    <Container>
      <h2 class="m-0 mb-6 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Questions about pricing</h2>
      <FAQ items={faqs} />
      <p class="m-0 mt-8 text-[15.5px]">
        Ready to start? <a href={`${routes.trial}?source=pricing`} data-cta="pricing-trial-final" class="underline decoration-gold-500 underline-offset-2">Request a free trial class</a>, <a href={routes.tutoring} class="underline decoration-gold-500 underline-offset-2">meet the teachers</a> or <a href={routes.contact} class="underline decoration-gold-500 underline-offset-2">send an enquiry</a>.
      </p>
    </Container>
  </Section>
</PageLayout>
