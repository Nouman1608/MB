---
/**
 * Grade-threshold explorer -- /grade-thresholds/
 *
 * v2.0 AUTHORITY/PRACTICE/TOOLS/GROWTH MEGA PROGRAMME WS14.
 *
 * See src/data/academic/grade-thresholds.ts for the sourcing and scope
 * decisions. A select dropdown swaps between the specifications'
 * tables client-side (progressive enhancement -- with JS disabled every
 * table simply shows at once, so nothing is hidden or broken).
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import { thresholdsByCode, seriesCovered, seriesPhrase, thresholdProblems, GRADE_SCALES, scaleOf, BOARD_ORDER } from '../../data/academic/grade-thresholds.ts';
import { routes } from '../../utils/urls/routes';
import CTA from '../../components/ui/CTA.astro';
import { getCollection } from 'astro:content';

const path = '/grade-thresholds/';
// Audit 3 item 44: one panel per syllabus, each series newest first, so a new
// series is new records in the data file and no change here.
const problems = thresholdProblems();
if (problems.length > 0) throw new Error(`grade-thresholds.ts: ${problems.join('; ')}`);
const BY_CODE = thresholdsByCode();
const SERIES = seriesPhrase(seriesCovered());
// D-541: the page is board-neutral; each record's table uses its own board's grade scale.
const BOARD_GROUPS = BOARD_ORDER.map((board) => ({ board, groups: BY_CODE.filter((g) => g.board === board) })).filter((b) => b.groups.length > 0);
const BOARDS_PHRASE = BOARD_GROUPS.map((b) => b.board).join(' and ');
const SPEC_COUNT = BY_CODE.length;
const IAL_AS_GRADES = ['A', 'B', 'C', 'D', 'E'] as const;

// Past-papers guides (resourceType "past-papers") hold the earlier series'
// thresholds; list them here so this page links every one of them.
const PAST_PAPER_GUIDES = (await getCollection('resources'))
  .filter((r) => r.data.resourceType === 'past-papers')
  .map((r) => ({ slug: r.id, label: r.data.title.replace(/: Grade Thresholds.*$/, '').replace(/ Past Papers$/, ' past papers') }))
  .sort((a, b) => a.label.localeCompare(b.label));
---
<PageLayout
  title="Grade Threshold Explorer — Exam Board Grade Boundaries"
  description={`Verified ${SERIES} grade thresholds (grade boundaries) for ${BOARDS_PHRASE} IGCSE and AS & A Level specifications -- sourced directly from each exam board's own official grade-threshold documents.`}
  path={path}
  eyebrow="Free tool"
  heading="Grade threshold explorer"
  lead={`The minimum mark needed for each grade in the ${SERIES} series, for ${SPEC_COUNT} specifications from ${BOARDS_PHRASE} -- copied directly from each exam board's own official grade-threshold or grade-boundary documents, not estimated. Where a board publishes several paper-combination routes for one specification, each table lists them, so you can find your own exact combination rather than a single "representative" one. Cambridge AS & A Level Chemistry (9701) and Physics (9702): the staged-assessment routes (AS and A2 papers sat in different series) are not reproduced -- see the note under those tables. Cambridge figures are syllabus grade thresholds out of Cambridge's maximum weighted mark, derived by Cambridge from the weighted component thresholds. Pearson Edexcel International GCSE figures are the overall raw-mark grade boundaries for the whole qualification (grades 9 to 1). Pearson Edexcel International AS and A Level qualifications are modular, so their figures are the raw-mark boundaries for each unit. None of these is a percentage uniform mark.`}
  breadcrumbs={[
    { label: 'Home', href: routes.home },
    { label: 'Grade thresholds', href: path },
  ]}
>
  <Section surface="white">
    <Container>
      <div class="mx-auto max-w-[360px]">
        <label for="mb-gt-select" class="m-0 mb-2 block mb-label text-ink-mute">Choose a specification</label>
        <select id="mb-gt-select" class="w-full rounded-sm border border-rule bg-white px-4 py-3 text-[16px] text-navy-800 outline-none transition-colors duration-150 focus:border-gold-500">
          {BOARD_GROUPS.map((b) => (
            <optgroup label={b.board}>
              {b.groups.map((g) => (
                <option value={g.code}>{g.qualificationLabel} {g.subjectLabel} ({g.code})</option>
              ))}
            </optgroup>
          ))}
        </select>
      </div>

      <p class="mx-auto mt-6 max-w-[520px] rounded-sm border border-dashed border-rule bg-ivory p-4 text-center text-[13.5px] leading-[1.6] text-ink-mute">
        <strong class="text-ink">Historical grade thresholds do not predict future thresholds.</strong> Exam boards
        set each series' thresholds independently based on how that specific paper performed -- use the table
        below to understand a past series, not to estimate a future one.
      </p>

      <div class="mt-10 flex flex-col gap-14">
        {BY_CODE.map((group) => (
          <div class="mb-gt-panel" data-code={group.code}>
            <h2 class="m-0 mb-1 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">{group.board === 'Pearson Edexcel' ? 'Edexcel ' : ''}{group.qualificationLabel} {group.subjectLabel} <span class="font-mono text-[16px] font-normal text-ink-mute">({group.code})</span></h2>
            {group.records.map((g, ri) => { const gradeOrder = GRADE_SCALES[scaleOf(g)]; return (<div class={ri > 0 ? 'mt-10' : ''} data-series={g.series}>
            <p class="m-0 mb-6 text-[13.5px] text-ink-mute">{g.board} · {g.series} series</p>

            {g.units ? (
              <div class="flex flex-col gap-8">
                {(['AS', 'A2'] as const).map((level) => { const units = (g.units ?? []).filter((u) => u.level === level); const cols = level === 'A2' ? GRADE_SCALES['edexcel-ial'] : IAL_AS_GRADES; return units.length > 0 && (
                  <div>
                    <h3 class="m-0 mb-3 text-[15px] font-semibold text-navy-800">International {level === 'AS' ? 'AS' : 'A2'} units</h3>
                    <div class="overflow-x-auto rounded-sm border border-rule">
                      <table class="w-full min-w-[620px] border-collapse text-[13.5px]">
                        <thead>
                          <tr class="border-b border-rule bg-ivory">
                            <th class="px-4 py-3 text-left font-medium text-navy-800">Unit</th>
                            <th class="px-3 py-3 text-right font-medium text-navy-800">Max mark (raw)</th>
                            <th class="px-3 py-3 text-right font-medium text-navy-800">Max UMS</th>
                            {cols.map((grade) => (
                              <th class="px-3 py-3 text-right font-medium text-navy-800">{grade}</th>
                            ))}
                          </tr>
                        </thead>
                        <tbody>
                          {units.map((u, i) => (
                            <tr class={i % 2 === 1 ? 'bg-ivory/50' : ''}>
                              <td class="px-4 py-3 text-ink-mute"><span class="font-mono text-[12.5px]">{u.unit}</span> {u.label}</td>
                              <td class="px-3 py-3 text-right font-medium text-navy-800">{u.maxRaw}</td>
                              <td class="px-3 py-3 text-right text-ink-mute">{u.maxUms}</td>
                              {cols.map((grade) => (
                                <td class="px-3 py-3 text-right text-navy-800">{u.raw[grade] ?? '—'}</td>
                              ))}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                ); })}
              </div>
            ) : (
            <div class="overflow-x-auto rounded-sm border border-rule">
              <table class="w-full min-w-[520px] border-collapse text-[13.5px]">
                <thead>
                  <tr class="border-b border-rule bg-ivory">
                    <th class="px-4 py-3 text-left font-medium text-navy-800">Route</th>
                    <th class="px-3 py-3 text-right font-medium text-navy-800">{g.board === 'Cambridge' ? 'Max weighted mark' : 'Max mark (raw)'}</th>
                    {gradeOrder.map((grade) => (
                      <th class="px-3 py-3 text-right font-medium text-navy-800">{grade}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {g.rows.map((row, i) => (
                    <tr class={i % 2 === 1 ? 'bg-ivory/50' : ''}>
                      <td class="px-4 py-3 text-ink-mute">{row.combination}</td>
                      <td class="px-3 py-3 text-right font-medium text-navy-800">{row.maxMark}</td>
                      {gradeOrder.map((grade) => (
                        <td class="px-3 py-3 text-right text-navy-800">{row.thresholds[grade] ?? '—'}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            )}

            {g.note && <p class="m-0 mt-4 max-w-[70ch] text-[13px] text-ink-mute">{g.note}</p>}

            <p class="m-0 mt-3 text-[13px] text-ink-mute">
              {g.sourceDocument
                ? <>Source: {g.board}, "{g.sourceDocument}", {g.series} series, PDF page {g.sourcePage}; verified {g.verifiedOn}.</>
                : <>Sourced directly from {g.board}'s official grade-threshold document for {g.code}, {g.series}, verified {g.verifiedOn}.</>}
              {' '}<a href={g.officialSourceUrl} class="underline decoration-teal-500 underline-offset-2 hover:text-teal-700" rel="noopener">{g.board === 'Cambridge' ? 'View the original PDF' : "View Pearson's grade-boundaries page"}</a>.
            </p>
            </div>); })}
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section surface="ivory" border>
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Why grade thresholds change every series</h2>
      <p class="m-0 max-w-[70ch] text-[14.5px] leading-[1.65] text-ink-mute">
        Cambridge and Pearson Edexcel set grade thresholds independently for every exam series, based on how that specific paper performed —
        not on a fixed percentage. This is deliberate: it accounts for small variations in how demanding a particular
        paper turned out to be, so a grade means the same standard of achievement across different series even when
        the papers themselves aren't identically difficult. The practical result is that a mark that earned a B in one
        series might earn an A or a C in another — always check the threshold table for the exact series you sat, not
        a different one, and never assume this series' numbers will repeat next time.
      </p>
    </Container>
  </Section>

  <Section surface="ivory" border>
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Earlier series: thresholds and examiner-report notes</h2>
      <p class="m-0 mb-4 max-w-[70ch] text-[14.5px] leading-[1.65] text-ink-mute">
        Our past-papers guides list the grade thresholds for every earlier series we hold (from 2020 onwards for some
        syllabuses), copied from the board's own grade-threshold documents, with a note of what each series' examiner report said.
      </p>
      <ul class="m-0 grid list-none gap-2 p-0 text-[14.5px] sm:grid-cols-2">
        {PAST_PAPER_GUIDES.map((g) => (
          <li><a class="text-navy-800 underline decoration-teal-500 underline-offset-2" href={`/resources/${g.slug}/`}>{g.label}</a></li>
        ))}
      </ul>
    </Container>
  </Section>

  <CTA
    surface="ivory"
    heading="Know the grade you need -- a teacher can help you build a realistic plan to reach it."
    buttonLabel="Find Learning Support"
    buttonHref={routes.tutoring}
  />

</PageLayout>

<script is:inline>
  (function () {
    var select = document.getElementById('mb-gt-select');
    var panels = Array.prototype.slice.call(document.querySelectorAll('.mb-gt-panel'));
    if (!select || panels.length === 0) return;

    function apply() {
      var code = select.value;
      panels.forEach(function (p) {
        p.style.display = p.getAttribute('data-code') === code ? '' : 'none';
      });
    }

    select.addEventListener('change', apply);
    apply();
  })();
</script>
