---
import LocaleLayout from '../../../layouts/LocaleLayout.astro';
import EnquiryForm from '../../../components/forms/EnquiryForm.astro';
import FAQ from '../../../components/ui/FAQ.astro';
import { MARKETING_COPY } from '../../../i18n/pages/marketing';
import { NAV_COPY, type LocaleCode } from '../../../i18n/nav';
import { TRANSLATED_LOCALES } from '../../../i18n/routes';

export function getStaticPaths() {
  return TRANSLATED_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
const copy = MARKETING_COPY.contact[locale];
const nav = NAV_COPY[locale];

/**
 * v1.x CLOSURE WS2 -- same real questions as /contact/'s English FAQ,
 * translated. Answers restate policy already published elsewhere on the
 * site (teaching locations, qualifications taught) rather than inventing
 * new claims; no numeric pricing is repeated here (the English page
 * doesn't either) so there is nothing to keep in sync across languages.
 */
const FAQS: Record<LocaleCode, { question: string; answer: string }[]> = {
  ar: [
    { question: 'كم تكلفة تدريس مارلبريدج؟', answer: 'تُحتسب الدروس الجماعية لكل مادة شهريًا، أما الدروس الفردية وتدريس IB فتُحتسب لكل درس، وتختلف الرسوم حسب المنطقة. راجع صفحة الأسعار، أو أرسل استفسارك مع المادة والمستوى وسنؤكد الرسم الدقيق عبر البريد الإلكتروني.' },
    { question: 'كيف يعمل التسجيل في مارلبريدج؟', answer: 'املأ نموذج الاستفسار بالمادة والمستوى وأين يحتاج المتعلم مساعدة. سيرد مارلبريدج عبر البريد الإلكتروني ليؤكد ما إذا كان بإمكانه المساعدة وكيف.' },
    { question: 'هل تدريس مارلبريدج عبر الإنترنت أم حضوري؟', answer: 'كلاهما. يدرّس مارلبريدج فرديًا وفي مجموعات صغيرة حضوريًا في أكاديميتنا في باكستان، ومباشرة عبر الإنترنت للمتعلمين في أي مكان آخر.' },
    { question: 'أين يدرّس مارلبريدج؟', answer: 'تُقام الدروس الحضورية فقط من أكاديميتنا في باكستان؛ وفي أي مكان آخر، نقدّم التدريس مباشرة عبر الإنترنت. مكتبة المصادر المجانية مكتوبة للمناهج الدولية ومفتوحة لأي شخص في أي مكان.' },
    { question: 'ما المؤهلات التي يدرّسها مارلبريدج؟', answer: 'يدرّس مارلبريدج حاليًا IGCSE وO Level وGCSE وAS Level وA Level وIB (برنامجا السنوات المتوسطة والدبلوم، فرديًا) وIELTS، عبر Cambridge وPearson Edexcel وAQA وOCR وOxfordAQA حسب المادة.' },
  ],
  ur: [
    { question: 'مارل برج کی تعلیم کی لاگت کتنی ہے؟', answer: 'گروپ کلاسوں کی فیس فی مضمون فی ماہ ہے، جبکہ انفرادی کلاسوں اور آئی بی کی تدریس کی فیس فی کلاس لی جاتی ہے۔ شرحیں علاقے کے مطابق مختلف ہوتی ہیں۔ فیس کا صفحہ دیکھیں، یا مضمون اور سطح کے ساتھ اپنا استفسار بھیجیں اور ہم ای میل کے ذریعے عین فیس کی تصدیق کریں گے۔' },
    { question: 'مارل برج میں داخلہ کیسے کام کرتا ہے؟', answer: 'مضمون، سطح اور طالب علم کو کہاں مدد چاہیے کے ساتھ استفسار فارم بھریں۔ مارل برج ای میل کے ذریعے جواب دے گا کہ کیا — اور کیسے — وہ مدد کر سکتا ہے۔' },
    { question: 'کیا مارل برج کی تعلیم آن لائن ہے یا آمنے سامنے؟', answer: 'دونوں۔ مارل برج پاکستان میں اپنی اکیڈمی میں انفرادی اور چھوٹے گروپوں میں آمنے سامنے پڑھاتا ہے، اور باقی ہر جگہ کے طلبہ کو براہِ راست آن لائن پڑھاتا ہے۔' },
    { question: 'مارل برج کہاں پڑھاتا ہے؟', answer: 'کلاس روم میں حاضری کے ساتھ تدریس صرف پاکستان میں ہماری اکیڈمی سے کی جاتی ہے؛ باقی ہر جگہ ہم براہِ راست آن لائن پڑھاتے ہیں۔ مفت وسائل کی لائبریری بین الاقوامی نصاب کے لیے لکھی گئی ہے اور کہیں بھی کسی کے لیے کھلی ہے۔' },
    { question: 'مارل برج کون سی قابلیتیں پڑھاتا ہے؟', answer: 'مارل برج فی الحال IGCSE، او لیول، جی سی ایس ای، اے ایس لیول، اے لیول، آئی بی (مڈل ائیرز اور ڈپلومہ پروگرام، انفرادی) اور آئی ایلٹس پڑھاتا ہے، مضمون کے مطابق Cambridge، Pearson Edexcel، AQA، OCR اور OxfordAQA کے تحت۔' },
  ],
  bn: [
    { question: 'মার্লব্রিজের টিউশনের খরচ কত?', answer: 'গ্রুপ ক্লাসের ফি প্রতি বিষয়ে প্রতি মাসে; একক ক্লাস ও IB টিউশনের ফি প্রতি ক্লাসে নেওয়া হয়। হার অঞ্চল অনুযায়ী পরিবর্তিত হয়। মূল্য পৃষ্ঠাটি দেখুন, বা বিষয় ও স্তরসহ আপনার অনুসন্ধান পাঠান এবং আমরা ইমেইলে সঠিক ফি নিশ্চিত করব।' },
    { question: 'মার্লব্রিজে ভর্তি কীভাবে কাজ করে?', answer: 'বিষয়, স্তর, এবং শিক্ষার্থীর কোথায় সাহায্য দরকার তা দিয়ে অনুসন্ধান ফর্ম পূরণ করুন। মার্লব্রিজ ইমেইলে জবাব দেবে এটি নিশ্চিত করতে যে এটি সাহায্য করতে পারে কিনা — এবং কীভাবে।' },
    { question: 'মার্লব্রিজের টিউশন অনলাইন নাকি সামনাসামনি?', answer: 'উভয়ই। মার্লব্রিজ পাকিস্তানে আমাদের একাডেমিতে সশরীরে একক ও ছোট গ্রুপে পড়ায়, এবং অন্য সব জায়গার শিক্ষার্থীদের সরাসরি অনলাইনে পড়ায়।' },
    { question: 'মার্লব্রিজ কোথায় পড়ায়?', answer: 'সশরীরে ক্লাস কেবল পাকিস্তানে আমাদের একাডেমি থেকে পড়ানো হয়; অন্য সব জায়গায় আমরা সরাসরি অনলাইনে পড়াই। বিনামূল্যের রিসোর্স লাইব্রেরি আন্তর্জাতিক কারিকুলামের জন্য লেখা এবং যে কারো জন্য, যেকোনো স্থানে উন্মুক্ত।' },
    { question: 'মার্লব্রিজ কোন যোগ্যতাগুলো পড়ায়?', answer: 'মার্লব্রিজ বর্তমানে IGCSE, O Level, GCSE, AS Level, A Level, IB (মিডল ইয়ার্স ও ডিপ্লোমা প্রোগ্রাম, একক) এবং IELTS পড়ায়, বিষয় অনুযায়ী Cambridge, Pearson Edexcel, AQA, OCR এবং OxfordAQA-এর অধীনে।' },
  ],
};
const faqs = FAQS[locale];
---
<LocaleLayout locale={locale} translationKey="contact" title={copy.title} description={copy.description} eyebrow={copy.eyebrow} heading={copy.heading} lead={copy.lead}>
  <div class="mx-auto max-w-[72ch] px-[var(--spacing-gutter)] py-[clamp(32px,4vw,56px)]">
    <EnquiryForm kind="student" labels={nav.form} />
  </div>
  <div class="mx-auto max-w-[72ch] px-[var(--spacing-gutter)] pb-[clamp(40px,5vw,72px)]">
    <h2 class="m-0 mb-6 text-[24px] font-semibold text-navy-800">{nav.questionsHeading}</h2>
    <FAQ items={faqs} id="contact-faqs" />
  </div>
</LocaleLayout>
