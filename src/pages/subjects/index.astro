---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import SubjectList from '../../components/cards/SubjectList.astro';
import { getSubjects } from '../../utils/content/collections';
import { resourcesForSubject } from '../../utils/content/related';
import { routes } from '../../utils/urls/routes';

const subjects = await getSubjects();
const countPairs = await Promise.all(subjects.map(async (s) => [s.id, (await resourcesForSubject(s.id)).length] as const));
const counts = Object.fromEntries(countPairs);
---
<PageLayout
  translationKey="subjects"
  title="Subjects"
  description="Mathematics, sciences, computer science, economics, accounting, business, English and languages — each subject hub gathers topics, study guides and practice material."
  path={routes.subjects}
  eyebrow="Subjects"
  heading="Subjects we teach and publish"
  lead="Each subject hub gathers the topics, study guides and practice material for that subject in one place."
  breadcrumbs={[{ label: 'Home', href: routes.home }, { label: 'Subjects', href: routes.subjects }]}
>
  <Section surface="white">
    <Container>
      <SubjectList subjects={subjects} counts={counts} />
    </Container>
  </Section>
</PageLayout>
