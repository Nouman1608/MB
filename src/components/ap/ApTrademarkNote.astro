---
/** College Board attribution, required at the foot of every page that uses its marks. */
import Container from '../layout/Container.astro';
import { AP_TRADEMARK_ATTRIBUTION } from '../../data/ap/config';
---
<div class="border-t border-rule bg-ivory py-6" data-pagefind-ignore="all">
  <Container>
    <p class="m-0 max-w-[90ch] text-[13px] leading-[1.6] text-ink-mute">
      {AP_TRADEMARK_ATTRIBUTION} Marlbridge is an independent tuition provider. It is not an authorized AP course provider, an AP school or an exam centre, and these
      resources are not official College Board materials. Reading them or doing simulations does not meet the laboratory requirement of an AP science course.
    </p>
  </Container>
</div>
