---
/**
 * Navigation round (6 Oct 2026) -- "Find study resources": choose
 * qualification, then exam board, then subject, and go straight to that
 * course's topics and resources.
 *
 * Replaces SyllabusFinder (D-286), which asked the same three questions with
 * dropdowns, fetched /tools-data/catalogue.json, and then offered six
 * competing links. This version:
 *   - shows every choice at once as labelled radio buttons (visible options,
 *     native keyboard behaviour: Tab between groups, arrow keys within one);
 *   - renders the full course directory in the HTML at build time, from the
 *     same catalogueIndex() the revision tools use, so the subject step is a
 *     list of plain links with their syllabus codes and resource counts, and
 *     the page works with JavaScript off (mode "full": the directory is
 *     simply shown; mode "compact": a link to the full directory);
 *   - remembers the chosen course in this browser (scripts/course-context.ts)
 *     and offers it back as "Continue with ...".
 * Nothing a visitor types or chooses is sent anywhere or put in a link.
 */
import { getResources } from '../../utils/content/collections';
import { catalogueIndex } from '../../utils/tools/catalogue';
import { QUALIFICATIONS } from '../../data/academic/qualifications';
import { routes } from '../../utils/urls/routes';

interface Props {
  id?: string;
  /** Analytics label for where this finder sits. */
  source: string;
  /** full: /resources/ (directory visible, filtered by the choices). compact: homepage. */
  mode?: 'full' | 'compact';
  heading?: string;
  /** Heading level for the finder's own heading; the directory uses the next levels down. */
  level?: 2 | 3;
}
const { id = 'course-finder', source, mode = 'full', heading = 'Find study resources for your course', level = 2 } = Astro.props;

const catalogue = catalogueIndex(await getResources());
const quals = QUALIFICATIONS.filter((q) => catalogue.some((e) => e.qs === q.slug));
const tree = quals.map((q) => {
  const entries = catalogue.filter((e) => e.qs === q.slug);
  const boards = [...new Map(entries.map((e) => [e.bs, e.b])).entries()].map(([bs, b]) => ({
    bs,
    b,
    courses: entries.filter((e) => e.bs === bs).sort((x, y) => x.s.localeCompare(y.s)),
  }));
  return { qs: q.slug, q: q.name, boards };
});
const allBoards = [...new Map(catalogue.map((e) => [e.bs, e.b])).entries()].sort((a, b) => a[1].localeCompare(b[1]));
const qualsForBoard = (bs: string) => [...new Set(catalogue.filter((e) => e.bs === bs).map((e) => e.qs))].join(' ');
const H = `h${level}` as 'h2' | 'h3';
const H2 = `h${level + 1}` as 'h3' | 'h4';
const H3 = `h${level + 2}` as 'h4' | 'h5';
const full = mode === 'full';
/** Compact mode renders no qualification headings, so board headings move up a level. */
const BoardH = full ? H3 : H2;
const chip = 'flex min-h-11 cursor-pointer items-center gap-2 rounded-full border-2 border-rule bg-white px-4 text-[15px] font-medium text-ink transition-colors hover:border-teal-500 has-[:checked]:border-teal-700 has-[:checked]:bg-teal-50 has-[:checked]:font-semibold has-[:checked]:text-teal-800 has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-teal-700';
const courseLabel = (e: (typeof catalogue)[number]) => `${e.bs === 'ib' ? e.q : `${e.b} ${e.q}`} ${e.s}${e.code && e.bs !== 'ib' ? ` (${e.code})` : ''}`;
---
<div id={id} data-course-finder data-source={source} data-mode={mode} class="scroll-mt-24">
  <div class={full ? '' : 'rounded-md border border-rule bg-white p-[clamp(20px,2.6vw,32px)]'}>
    <H class={full ? 'm-0 text-[length:var(--text-h2)] font-bold leading-[1.08] tracking-[-0.025em] text-navy-800' : 'm-0 text-[24px] font-bold tracking-[-0.015em] text-navy-800'}>{heading}</H>
    <p class="m-0 mt-2 max-w-[62ch] text-[15.5px] leading-[1.6] text-ink-mute">
      Choose your qualification, then your exam board, then your subject. You'll see that course's topics, each with its study guides, revision notes and practice questions. Free, no sign-up.
    </p>

    <div data-finder-continue hidden class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-md border-2 border-gold-500 bg-[#FFF8E6] px-4 py-3">
      <span class="text-[14.5px] text-ink">Your course:</span>
      <a data-finder-continue-link href={routes.resources} class="text-[16px] font-semibold text-navy-800 underline decoration-teal-500 underline-offset-2 hover:text-teal-700"></a>
      <button type="button" data-finder-change class="min-h-11 text-[14.5px] text-ink-mute underline decoration-rule underline-offset-2 hover:text-teal-700">Change course</button>
    </div>

    <form data-finder-form hidden class="mt-6 grid gap-6" aria-label="Choose your course">
      <fieldset class="m-0 border-0 p-0">
        <legend class="mb-2.5 p-0 text-[15px] font-semibold text-navy-800">1. Qualification</legend>
        <div class="flex flex-wrap gap-2">
          {quals.map((q) => (
            <label class={chip}><input type="radio" name={`${id}-q`} value={q.slug} class="h-4 w-4 accent-[#0C6964]" />{q.name}</label>
          ))}
        </div>
      </fieldset>
      <fieldset class="m-0 border-0 p-0" data-finder-boards>
        <legend class="mb-2.5 p-0 text-[15px] font-semibold text-navy-800">2. Exam board</legend>
        <p data-finder-boards-hint class="m-0 text-[14.5px] text-ink-mute">Choose a qualification first.</p>
        <div class="flex flex-wrap gap-2">
          {allBoards.map(([bs, b]) => (
            <label class={chip} data-board-chip data-quals={qualsForBoard(bs)} hidden><input type="radio" name={`${id}-b`} value={bs} class="h-4 w-4 accent-[#0C6964]" />{b}</label>
          ))}
        </div>
      </fieldset>
      <div data-finder-subject-step hidden>
        <p class="m-0 mb-2.5 text-[15px] font-semibold text-navy-800" id={`${id}-subject-label`}>3. Subject</p>
        <div data-finder-filter-wrap hidden class="mb-3 max-w-[360px]">
          <label for={`${id}-filter`} class="mb-1 block text-[13.5px] text-ink-mute">Filter subjects</label>
          <input id={`${id}-filter`} type="search" autocomplete="off" data-finder-filter class="min-h-11 w-full rounded-sm border border-rule bg-white px-3 text-[15px] text-ink" placeholder="e.g. chemistry or 0620" />
        </div>
      </div>
    </form>
    <p data-finder-status role="status" aria-live="polite" class="m-0 mt-3 min-h-[1.25em] text-[14px] text-ink-mute"></p>
    {full && (
      <p data-finder-all-wrap hidden class="m-0 mt-2">
        <button type="button" data-finder-showall class="inline-flex min-h-11 items-center text-[15px] font-medium text-navy-800 underline decoration-teal-500 underline-offset-2 hover:text-teal-700">Or show every course ({catalogue.length})</button>
      </p>
    )}

    {!full && (
      <noscript>
        <p class="m-0 mt-4 text-[15px]"><a href={routes.resources} class="font-medium text-navy-800 underline decoration-teal-500 underline-offset-2">Browse every course by qualification and exam board</a></p>
      </noscript>
    )}

    {/* The directory: qualification > exam board > subject. Shown in full
        mode (and filtered by the choices above); in compact mode only the
        chosen board's subjects are revealed. */}
    <div data-finder-directory role="group" aria-labelledby={`${id}-subject-label`} data-pagefind-ignore={full ? undefined : 'all'} hidden={!full} class={full ? 'mt-8' : 'mt-2'}>
      {tree.map((q) => (
        <section data-q-block={q.qs} id={full ? q.qs : undefined} aria-label={full ? undefined : q.q} class={full ? 'mt-10 scroll-mt-24 first:mt-0' : ''}>
          {full && <H2 data-q-heading class="m-0 mb-4 border-b-2 border-navy-800 pb-2.5 text-[22px] font-semibold tracking-[-0.01em] text-navy-800">{q.q}</H2>}
          {q.boards.map((b) => (
            <div data-b-block={b.bs} id={full ? `${q.qs}-${b.bs}` : undefined} class="mt-5 scroll-mt-24 first:mt-0">
              {b.bs !== 'ib' && (
                <BoardH class="m-0 mb-2 mb-label text-teal-700">{`${b.b} ${q.q}`}</BoardH>
              )}
              <ul class={`m-0 grid list-none gap-2 p-0 sm:grid-cols-2 ${full ? 'lg:grid-cols-3' : ''}`}>
                {b.courses.map((e) => (
                  <li class="m-0" data-course-item data-search={`${e.s} ${e.code ?? ''}`.toLowerCase()}>
                    <a href={e.hub} data-course-link={e.id} data-course-label={courseLabel(e)} data-course-code={e.bs !== 'ib' ? e.code : undefined}
                      class="flex h-full min-h-11 flex-col gap-0.5 rounded-md border border-rule bg-white px-4 py-3 transition-colors hover:border-teal-700 hover:bg-teal-50 hover:text-navy-800 active:bg-teal-100">
                      <span class="font-display text-[17px] font-semibold leading-tight text-navy-800">{e.s}</span>
                      <span class="font-mono text-[11.5px] text-ink-mute">{e.code && e.bs !== 'ib' && <>{e.code} · </>}{e.n > 0 ? `${e.n} ${e.n === 1 ? 'resource' : 'resources'}` : 'topics only'}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))}
      <p data-finder-filter-empty hidden class="m-0 mt-3 text-[15px] text-ink-mute">No subject matches that filter. <button type="button" data-finder-filter-clear class="underline decoration-teal-500 underline-offset-2">Show all subjects</button></p>
    </div>
  </div>
</div>

<script>
  import { getCourse, setCourse, clearCourse } from '../../scripts/course-context';
  import { track } from '../../scripts/catalogue-client';

  document.querySelectorAll<HTMLElement>('[data-course-finder]').forEach((root) => {
    const full = root.dataset.mode === 'full';
    const source = root.dataset.source ?? 'unknown';
    const form = root.querySelector<HTMLFormElement>('[data-finder-form]')!;
    const status = root.querySelector<HTMLElement>('[data-finder-status]')!;
    const dir = root.querySelector<HTMLElement>('[data-finder-directory]')!;
    const qRadios = [...form.querySelectorAll<HTMLInputElement>('input[type=radio][name$="-q"]')];
    const bChips = [...form.querySelectorAll<HTMLElement>('[data-board-chip]')];
    const bRadios = bChips.map((c) => c.querySelector<HTMLInputElement>('input')!);
    const boardsHint = form.querySelector<HTMLElement>('[data-finder-boards-hint]')!;
    const subjectStep = form.querySelector<HTMLElement>('[data-finder-subject-step]')!;
    const filterWrap = form.querySelector<HTMLElement>('[data-finder-filter-wrap]')!;
    const filter = form.querySelector<HTMLInputElement>('[data-finder-filter]')!;
    const filterEmpty = root.querySelector<HTMLElement>('[data-finder-filter-empty]')!;
    const qBlocks = [...dir.querySelectorAll<HTMLElement>('[data-q-block]')];
    const cont = root.querySelector<HTMLElement>('[data-finder-continue]')!;
    const contLink = root.querySelector<HTMLAnchorElement>('[data-finder-continue-link]')!;

    form.hidden = false;
    const allWrap = root.querySelector<HTMLElement>('[data-finder-all-wrap]');
    let showAll = false;
    root.querySelector('[data-finder-showall]')?.addEventListener('click', () => { showAll = true; view(); status.textContent = 'Showing every course, by qualification and exam board.'; });
    form.addEventListener('submit', (e) => e.preventDefault());

    const chosen = (rs: HTMLInputElement[]) => rs.find((r) => r.checked)?.value ?? '';
    const labelOf = (rs: HTMLInputElement[], v: string) => rs.find((r) => r.value === v)?.parentElement?.textContent?.trim() ?? v;

    const view = (announce = true) => {
      const q = chosen(qRadios);
      // Boards on offer for this qualification only.
      let visibleBoards = 0;
      for (const chip of bChips) {
        const on = !!q && (chip.dataset.quals ?? '').split(' ').includes(q);
        chip.hidden = !on;
        if (!on) chip.querySelector('input')!.checked = false;
        if (on) visibleBoards++;
      }
      if (q && visibleBoards === 1) bChips.find((c) => !c.hidden)!.querySelector('input')!.checked = true;
      boardsHint.hidden = !!q;
      const b = chosen(bRadios);
      // Full mode: the whole directory is in the HTML (and shown without
      // JavaScript); with JavaScript it opens once a qualification is chosen,
      // or on "show every course", so the page does not start 20,000px long.
      const showDir = full ? (!!q || showAll) : (!!q && !!b);
      dir.hidden = !showDir;
      if (allWrap) allWrap.hidden = !!q || showAll;
      subjectStep.hidden = !(q && b);
      let shownCourses = 0;
      for (const qb of qBlocks) {
        const qOn = !q || qb.dataset.qBlock === q;
        qb.hidden = !qOn;
        // Once a qualification is chosen, the radio already says which; drop the repeated heading.
        const qh = qb.querySelector<HTMLElement>('[data-q-heading]');
        if (qh) qh.hidden = !!q;
        for (const bb of qb.querySelectorAll<HTMLElement>('[data-b-block]')) {
          const on = qOn && (!b || bb.dataset.bBlock === b);
          bb.hidden = !on;
          if (on) shownCourses += bb.querySelectorAll('[data-course-item]').length;
        }
      }
      filterWrap.hidden = !(q && b && shownCourses > 8);
      if (filterWrap.hidden && filter.value) filter.value = '';
      applyFilter();
      if (!announce) return;
      const qLabel = labelOf(qRadios, q);
      const course = visibleBoards === 1 && qLabel.startsWith('IB ') ? qLabel : `${labelOf(bRadios, b)} ${qLabel}`;
      if (q && b) status.textContent = `${shownCourses} ${course} ${shownCourses === 1 ? 'subject' : 'subjects'}. Choose yours below.`;
      else if (q) status.textContent = `Now choose the exam board for ${labelOf(qRadios, q)}.`;
      else status.textContent = '';
    };

    const applyFilter = (announce = false) => {
      const t = filter.value.trim().toLowerCase();
      let n = 0;
      for (const li of dir.querySelectorAll<HTMLElement>('[data-course-item]')) {
        const block = li.closest<HTMLElement>('[data-b-block]')!;
        if (block.hidden) continue;
        const on = !t || (li.dataset.search ?? '').includes(t);
        li.hidden = !on;
        if (on) n++;
      }
      filterEmpty.hidden = !t || n > 0;
      if (announce && t) status.textContent = n ? `${n} ${n === 1 ? 'subject matches' : 'subjects match'} “${filter.value.trim()}”.` : `No subject matches “${filter.value.trim()}”.`;
    };

    qRadios.forEach((r) => r.addEventListener('change', () => { bRadios.forEach((x) => (x.checked = false)); view(); }));
    bRadios.forEach((r) => r.addEventListener('change', () => view()));
    filter.addEventListener('input', () => applyFilter(true));
    root.querySelector('[data-finder-filter-clear]')?.addEventListener('click', () => { filter.value = ''; applyFilter(); filter.focus(); });

    // Following a course link makes it the current course and records the choice.
    dir.addEventListener('click', (ev) => {
      const a = (ev.target as HTMLElement).closest<HTMLAnchorElement>('a[data-course-link]');
      if (!a) return;
      const id = a.dataset.courseLink!;
      setCourse({ id, label: a.dataset.courseLabel ?? id, hub: a.getAttribute('href') ?? '', code: a.dataset.courseCode || undefined });
      const [bs, qs] = id.split('/');
      track('syllabus_finder_select', { source, qualification: qs, board: bs, course_code: a.dataset.courseCode || 'none' });
    });

    const preselect = (qs: string, bs?: string) => {
      const qr = qRadios.find((r) => r.value === qs);
      if (!qr) return false;
      qr.checked = true;
      view(false);
      if (bs) { const br = bRadios.find((r) => r.value === bs && !r.closest<HTMLElement>('[data-board-chip]')!.hidden); if (br) br.checked = true; }
      view(false);
      return true;
    };

    // A remembered course: offer it back, and open the finder at its board.
    const stored = getCourse();
    const storedLink = stored ? dir.querySelector<HTMLAnchorElement>(`a[data-course-link="${CSS.escape(stored.id)}"]`) : null;
    if (stored && storedLink) {
      contLink.textContent = storedLink.dataset.courseLabel ?? stored.label;
      contLink.href = storedLink.getAttribute('href')!;
      cont.hidden = false;
    } else if (stored) {
      clearCourse(); // no longer published: forget it
    }
    root.querySelector('[data-finder-change]')?.addEventListener('click', () => {
      clearCourse();
      cont.hidden = true;
      qRadios.forEach((r) => (r.checked = false));
      bRadios.forEach((r) => (r.checked = false));
      showAll = false;
      view(false);
      status.textContent = 'Choose your qualification.';
      qRadios[0]?.focus();
    });

    // /resources/#igcse or /resources/#igcse-cambridge (breadcrumbs, homepage links) opens at that step.
    const hash = full ? decodeURIComponent(location.hash.slice(1)) : '';
    const fromHash = hash && qRadios.some((r) => hash === r.value || hash.startsWith(`${r.value}-`));
    if (fromHash) {
      const qs = qRadios.map((r) => r.value).filter((v) => hash === v || hash.startsWith(`${v}-`)).sort((a, b) => b.length - a.length)[0];
      preselect(qs, hash.length > qs.length ? hash.slice(qs.length + 1) : undefined);
    } else if (full && stored && storedLink) {
      const [bs, qs] = stored.id.split('/');
      preselect(qs, bs);
    } else {
      view(false);
    }
  });
</script>
