---
/**
 * D-286 -- "Next steps" at the end of a resource page: what to do after
 * reading, using only pages that exist for this resource's own course.
 *
 * The course is resolved from the resource's own boards / qualifications /
 * subject against the ACTIVE matrix, through resourcesForCombination (the
 * same rule the hub uses), so a link is never offered for a course this
 * resource does not belong to. A resource that maps to no single course
 * (e.g. board-agnostic study skills) gets only the generic planner link.
 *
 * Same-topic links come from the resource's own syllabusTopics mapping.
 * B8 (2026-09-27): computed by src/utils/content/next-steps.ts.
 */
import type { CollectionEntry } from 'astro:content';
import { resourceNextSteps, type ResourceNextStepsPlan } from '../../utils/content/resource-next-steps';
import SubscribeBox from './SubscribeBox.astro';

interface Props {
  resource: CollectionEntry<'resources'>;
  /** B8 -- the plan the page already computed for its "On this topic" line; computed here when absent. */
  plan?: ResourceNextStepsPlan;
  /**
   * Navigation round (6 Oct 2026) -- when the resource serves more than one
   * course, the steps for each course. The first is shown; the page's course
   * script shows the one matching the student's chosen course instead.
   */
  options?: { id: string; steps: ResourceNextStepsPlan['steps'] }[];
}
const { resource, plan: given, options } = Astro.props;
// B8 (2026-09-27): the step rules now live in src/utils/content/next-steps.ts
// (resolved by resource-next-steps.ts), shared with the "On this topic" line.
const { course, steps } = given ?? await resourceNextSteps(resource);
---
<div class="mt-12 border-t border-rule pt-8">
<nav aria-labelledby="next-steps-heading" data-next-steps>
  <h2 id="next-steps-heading" class="m-0 mb-4 text-[20px] font-semibold tracking-[-0.01em] text-navy-800">Next steps</h2>
  {(options && options.length > 0 ? options : [{ id: '', steps }]).map((o, i) => (
    <ul class="m-0 grid list-none gap-3 p-0 sm:grid-cols-2" data-course-option={o.id || undefined} hidden={i > 0}>
      {o.steps.map((s) => (
        <li class="m-0">
          <a href={s.href} data-next-step={s.kind} class="flex h-full flex-col gap-0.5 rounded-sm border border-rule bg-white px-4 py-3 transition-colors hover:border-gold-500">
            <span class="text-[15px] font-semibold text-navy-800">{s.label}</span>
            <span class="text-[13.5px] text-ink-mute">{s.detail}</span>
          </a>
        </li>
      ))}
    </ul>
  ))}
</nav>
  <div class="mt-8">
    <SubscribeBox source="resource" preset={course ? { qualification: course.qualificationSlug, courseId: `${course.boardSlug}/${course.qualificationSlug}/${course.subjectSlug}` } : undefined} />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-next-step]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        (window as unknown as { mbTrack?: (n: string, p: Record<string, unknown>) => void }).mbTrack?.('recommended_resource_click', { source: 'resource_next_steps', link_kind: a.dataset.nextStep ?? 'unknown' });
      } catch { /* never block navigation */ }
    });
  });
</script>
