---
interface Props { width?: 'default' | 'prose'; class?: string }
const { width = 'default', class: className = '' } = Astro.props;
const w = width === 'prose' ? 'max-w-[68ch]' : 'max-w-[var(--container-site)]';
---
<div class={`mx-auto w-full px-[var(--spacing-gutter)] ${w} ${className}`}><slot /></div>
