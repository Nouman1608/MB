---
import Logo from '../brand/Logo.astro';
import { footerNav, locales } from '../../data/navigation';
import { site } from '../../data/site';

const columns = [
  { heading: 'Explore', items: footerNav.explore },
  { heading: 'Resources', items: footerNav.resources },
  { heading: 'Marlbridge', items: footerNav.company },
];
// D-454 -- `footer: false` keeps a profile in sameAs but out of this list.
const footerSocial = site.social.filter((s) => s.footer !== false);
---
<footer class="bg-navy-900 text-on-navy">
  <div class="mx-auto max-w-[var(--container-site)] px-[var(--spacing-gutter)] pb-8 pt-[clamp(56px,7vw,88px)]">
    {/* D-479 -- two link columns on phones (was one): the footer is on every
         page and was about 2,040 px tall at 390 px wide; side by side it is
         about 1,420 px. Nothing is hidden; the logo block spans both columns. */}
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 border-b border-navy-rule pb-[clamp(40px,5vw,64px)] sm:grid-cols-3 lg:grid-cols-[1.4fr_1fr_1fr_1fr_0.8fr]">
      <div class="col-span-2 flex max-w-[34ch] flex-col gap-4 sm:col-span-1">
        <Logo height={28} />
        <p class="m-0 font-display text-[19px] leading-snug text-ivory font-semibold">{site.tagline}</p>
      </div>

      {columns.map((col) => (
        <div>
          <h2 class="mb-4 mb-label text-gold-500">{col.heading}</h2>
          <ul class="m-0 flex list-none flex-col gap-0.5 p-0">
            {col.items.map((item) => (
              <li><a href={item.href} class="block py-2 text-[15px] text-on-navy hover:text-white">{item.label}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h2 class="mb-4 mb-label text-gold-500">Language</h2>
        <ul class="m-0 flex list-none flex-col gap-0.5 p-0">
          {locales.map((l) => (
            <li>
              {l.code === 'en'
                ? <span aria-current="true" class="block py-2 text-[15px] text-white">{l.label}</span>
                : l.enabled
                  ? <a href={l.href} class="block py-2 text-[15px] text-on-navy hover:text-white">{l.label}</a>
                  : <span class="block py-2 text-[15px] text-on-navy-mute">{l.label} — not yet available</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>

    {footerSocial.length > 0 && (
      <nav aria-label="Marlbridge on social media and the web" class="flex flex-wrap items-center gap-x-6 gap-y-1 border-b border-navy-rule py-5">
        <h2 class="m-0 mb-label text-gold-500">Follow Marlbridge</h2>
        <ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-1 p-0">
          {footerSocial.map((s) => (
            <li><a href={s.href} rel="me noopener" target="_blank" class="block py-2 text-[15px] text-on-navy hover:text-white">{s.label}<span class="sr-only"> (opens in a new tab)</span></a></li>
          ))}
        </ul>
      </nav>
    )}

    <div class="flex flex-wrap items-center justify-between gap-4 pt-6">
      <p class="m-0 text-[13.5px] text-on-navy-mute">© 2026 Marlbridge. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-4">
        {/* D-081, retained after Zaraz removal in D-091 -- reopens this
            site's own consent banner so a visitor who already chose can
            change their mind. Handled by the delegated listener in
            ConsentAnalytics.astro.
            D-461: 11px of padding above and below, taken back by the same
            negative margin, makes the touch height 44px (it was 22px)
            without moving anything. */}
        <button
          type="button"
          data-open-cookie-settings
          class="mx-0 -my-[11px] cursor-pointer border-0 bg-transparent px-0 py-[11px] text-[13.5px] text-on-navy-mute underline decoration-teal-500 underline-offset-2 hover:text-white"
        >Cookie Settings</button>
        <p class="m-0 text-[13.5px] text-on-navy-mute">{site.founding}</p>
      </div>
    </div>
  </div>
</footer>
