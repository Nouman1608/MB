---
import Logo from '../brand/Logo.astro';
import { primaryNav, isCurrentSection } from '../../data/navigation';
import MobileMenu from './MobileMenu.astro';

// Navigation round (6 Oct 2026) -- mark the section the page belongs to.
const isCurrent = (href: string) => isCurrentSection(href, Astro.url.pathname);

// D-442: below the large-screen breakpoint the header showed only the logo and
// the menu icon, so a phone visitor had no trial button on screen once the hero
// scrolled away, and on small phones the cookie banner covered the hero's.
// A compact trial button now sits in the sticky header on phones and tablets
// (never on /trial/ itself, where it would link to the page it is on).
const onTrialPage = Astro.url.pathname.startsWith('/trial');
---
<header class="sticky top-0 z-50 border-b border-navy-rule bg-navy-800">
  <div class="mx-auto flex h-16 max-w-[var(--container-site)] items-center justify-between gap-3 px-[var(--spacing-gutter)] lg:h-20 lg:gap-8">
    <a href="/" aria-label="Marlbridge — home" class="flex shrink-0 items-center">
      <Logo height={28} />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-5 lg:flex xl:gap-[30px]">
      {primaryNav.map((item, i) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'true' : undefined}
          class={`whitespace-nowrap border-b-2 py-1.5 text-[15px] hover:border-teal-300 hover:text-white ${isCurrent(item.href) ? 'border-teal-300 text-white' : 'border-transparent text-on-navy'} ${i === 0 ? 'font-semibold' : ''}`}
        >{item.label}</a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-3.5">
      {/* Conversion & trust round (2026-09-07, D-150) -- the ivory "Explore
          Programs" button was removed at the owner's discretion. It pointed
          at /programs/, which is already the first item in primaryNav two
          inches to the left, so it added a second route to the same page
          while competing visually with the trial CTA beside it. The header
          now carries exactly one action, which is the one the site exists to
          produce. Nothing became unreachable: Programs remains in both the
          desktop nav and the mobile menu. */}
      {/* v1.x CLOSURE follow-up -- header CTA, requested to match
          the trial-class button on learnersacademy.com.pk. Colour and
          shape follow Marlbridge's own conventions rather than copying
          that site's rounded-pill/navy treatment: rounded-sm (matching
          every other button on this site) in the gold accent colour
          (--color-gold-500), which reads as the "highlighted" action
          against the navy header without competing visually with the
          existing ivory "Explore Programs" button. */}
      {/* D-342 -- "Portal Login" opens the school management portal
          (learnerspreschool.cloud). One link for admins, teachers and
          students: the portal routes by role after sign-in. Outlined so
          it does not compete with the gold trial CTA, which stays the
          single highlighted action. */}
      <a href="https://portal.marlbridge.com/login" class="hidden rounded-sm border-2 border-navy-rule px-5 py-2.5 text-sm font-semibold text-white hover:border-teal-300 hover:text-white lg:inline-flex">Portal Login</a>
      {/* D-443: ?source=header and data-cta so leads and clicks from the header are counted apart from the trial page itself. */}
      <a href="/trial/?source=header" data-cta="header-trial" class="hidden rounded-sm bg-gold-500 px-5 py-3 text-sm font-bold text-navy-800 hover:bg-gold-400 hover:text-navy-800 active:bg-[#C99A1F] lg:inline-flex">Free Trial Class</a>
      {!onTrialPage && (
        <a href="/trial/?source=header" data-cta="header-trial-mobile" class="inline-flex h-11 items-center rounded-sm bg-gold-500 px-3.5 text-[14px] font-bold text-navy-800 hover:bg-gold-400 hover:text-navy-800 active:bg-[#C99A1F] lg:hidden">Free trial</a>
      )}
      <button
        type="button"
        id="menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-11 w-11 flex-col items-center justify-center gap-[5px] rounded-sm border border-navy-rule lg:hidden"
      >
        <span class="block h-[1.5px] w-[18px] bg-ivory"></span>
        <span class="block h-[1.5px] w-[18px] bg-ivory"></span>
      </button>
    </div>
  </div>
  <MobileMenu />
</header>
