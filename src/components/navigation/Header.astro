---
import Logo from '../brand/Logo.astro';
import { primaryNav } from '../../data/navigation';
import MobileMenu from './MobileMenu.astro';
---
<header class="sticky top-0 z-50 border-b border-navy-rule bg-navy-800">
  <div class="mx-auto flex h-16 max-w-[var(--container-site)] items-center justify-between gap-8 px-[var(--spacing-gutter)] lg:h-20">
    <a href="/" aria-label="Marlbridge — home" class="flex shrink-0 items-center">
      <Logo height={28} />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-[34px] lg:flex">
      {primaryNav.map((item) => (
        <a
          href={item.href}
          class="border-b border-transparent py-1.5 text-[15px] text-ivory hover:border-gold-500 hover:text-white"
        >{item.label}</a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-3.5">
      <a href="/programs/" class="hidden rounded-sm bg-ivory px-5 py-3 text-sm font-medium text-navy-800 hover:bg-white lg:inline-flex">Explore Programs</a>
      <button
        type="button"
        id="menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-11 w-11 flex-col items-center justify-center gap-[5px] rounded-sm border border-navy-rule lg:hidden"
      >
        <span class="block h-[1.5px] w-[18px] bg-ivory"></span>
        <span class="block h-[1.5px] w-[18px] bg-ivory"></span>
      </button>
    </div>
  </div>
  <MobileMenu />
</header>
