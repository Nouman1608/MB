---
import { site } from '../../data/site';
import { absoluteUrl, pageTitle, metaDescription, type SeoProps } from '../../utils/seo/meta';
import { siteGraph, webPageNode } from '../../utils/schema/organization';
import { breadcrumbNode } from '../../utils/schema/breadcrumb';
import { locales } from '../../data/navigation';
import { localePath, TRANSLATED_LOCALES } from '../../i18n/routes';

type Props = SeoProps & { isHome?: boolean };
const {
  title, description, path, type = 'website', image = site.ogImage,
  publishedDate, updatedDate, noindex = false, breadcrumbs = [],
  jsonLd = [], isHome = false, translationKey,
} = Astro.props;

const canonical = absoluteUrl(path);
const fullTitle = pageTitle(title, isHome);
// Sections 37-39 -- snippet is the fixed-width-safe version, used only for
// the tags platforms display as a truncated snippet (see metaDescription's
// own doc comment). The full, untruncated `description` still goes into
// the JSON-LD webPageNode below -- structured data isn't a display snippet.
const snippet = metaDescription(description);
const crumbs = breadcrumbNode(breadcrumbs);
const graph = [
  ...siteGraph(),
  webPageNode(path, fullTitle, description),
  ...(crumbs ? [crumbs] : []),
  ...jsonLd,
];
---
<title>{fullTitle}</title>
<meta name="description" content={snippet} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
{/* v1.x CLOSURE WS2 -- any English page with a real ar/ur/bn translated
    counterpart declares translationKey (see src/i18n/routes.ts), which
    drives correct, page-specific, reciprocal hreflang here -- not just on
    the homepage. x-default and the "en" self-reference both point at this
    page's own canonical URL. */}
{translationKey && TRANSLATED_LOCALES.map((code) => (
  <link rel="alternate" hreflang={code} href={absoluteUrl(localePath(code, translationKey))} />
))}
{translationKey && <link rel="alternate" hreflang="en" href={canonical} />}
{translationKey && <link rel="alternate" hreflang="x-default" href={canonical} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={snippet} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteUrl(image)} />
{publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={snippet} />
<meta name="twitter:image" content={absoluteUrl(image)} />

<script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
