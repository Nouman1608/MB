---
/**
 * D-397 / D-398 -- the three study modes for one topic (or for the course as
 * a whole): study guides (blue), revision notes (teal), practice questions
 * (amber), always in that order, three across where there is room and
 * stacked on phones.
 *
 * Each mode is one white card with an icon tile and a label, so the type is
 * never shown by colour alone. Each resource is one link holding its short
 * title (utils/academic/short-title.ts; the full title is in the link's
 * title attribute and on the resource page) and its action ("Read guide",
 * "Revise topic", "Try questions"): one keyboard stop per resource, nothing
 * nested. When a card holds a single resource the link is stretched over the
 * whole card, so the entire card is the click target. An empty mode keeps
 * its place as a dashed card that says what is missing.
 *
 * data-kind-group / data-res / data-kind-none are read by the course search
 * script in CourseTopicResources.astro.
 */
import ModeIcon from './ModeIcon.astro';
import { MODE, ACTION } from './ResourceMode';
import { KIND_ORDER, type KindGroups } from '../../utils/academic/course-topics';
import { shortTitle, type ShortTitleContext } from '../../utils/academic/short-title';
import { routes } from '../../utils/urls/routes';

interface Props {
  groups: KindGroups;
  context: ShortTitleContext;
  /** e.g. "this topic" or "this course" */
  scope: string;
  /** Heading level for the card labels (default h4, under a topic h3). */
  headingLevel?: 3 | 4;
}
const { groups, context, scope, headingLevel = 4 } = Astro.props;
const H = `h${headingLevel}` as 'h3' | 'h4';

const TYPE_TAG: Record<string, string> = {
  'subject-guides': 'Course guide',
  'learning-articles': 'Article',
  'past-papers': 'Past papers guide',
  'exam-preparation': 'Exam preparation',
};
const EMPTY: Record<string, string> = {
  learn: `No study guide for ${scope} yet`,
  review: `No revision notes for ${scope} yet`,
  practice: `No practice questions for ${scope} yet`,
};
const searchText = (...parts: (string | undefined)[]) => parts.filter(Boolean).join(' ').toLowerCase();
---
<div class="mt-6 grid gap-4 md:grid-cols-3">
  {KIND_ORDER.map((k) => {
    const m = MODE[k];
    const items = groups[k];
    const single = items.length === 1;
    return (
      <div data-kind-group={k} class={`relative flex flex-col rounded-[14px] border transition-colors duration-150 ${items.length ? `bg-white ${m.border} ${m.hasHover}` : 'border-dashed border-surface-line bg-white/55'}`}>
        <H class={`m-0 flex items-center gap-3 rounded-t-[13px] px-4 py-3 font-sans text-[16px] font-semibold leading-tight ${items.length ? `${m.tint} text-navy-800` : 'text-ink-mute'}`}>
          <span class={`grid size-9 shrink-0 place-items-center rounded-[9px] ${items.length ? `bg-white ${m.text}` : 'bg-surface'}`}><ModeIcon kind={k} size={20} /></span>
          <span>{single ? m.singular : m.label}</span>
          {items.length > 1 && <span class="ms-auto rounded-full bg-white px-2.5 py-0.5 mb-meta text-ink-mute" aria-label={`${items.length} resources`}>{items.length}</span>}
        </H>
        {items.length > 0 ? (
          <ul class="m-0 flex list-none flex-col gap-1 p-0 px-1.5 pb-2.5 pt-2">
            {items.map((r) => (
              <li class="m-0" data-res data-search={searchText(r.title, r.description, m.label, TYPE_TAG[r.resourceType])}>
                <a href={routes.resource(r.id)} data-course-resource={k} title={r.title}
                  class={`group/res block rounded-[10px] px-2.5 py-3 transition-colors duration-150 hover:text-navy-800 ${single ? "after:absolute after:inset-0 after:rounded-[14px] after:content-['']" : 'hover:bg-surface'}`}>
                  <span class="line-clamp-3 font-display text-[clamp(1.0625rem,1rem+0.3vw,1.1875rem)] font-semibold leading-[1.28] tracking-[-0.01em] text-navy-800">{shortTitle(r.title, context)}</span>
                  {TYPE_TAG[r.resourceType] && <span class="mt-1 block text-[14px] text-ink-mute">{TYPE_TAG[r.resourceType]}</span>}
                  <span class={`mt-2.5 inline-block text-[16px] font-semibold underline decoration-2 underline-offset-[5px] transition-colors ${m.text} ${m.underline} group-hover/res:decoration-current`}>{ACTION[r.resourceType] ?? 'Open'}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="m-0 px-4 pb-5 pt-1 text-[15.5px] leading-snug text-ink-mute" data-kind-none>{EMPTY[k]}.</p>
        )}
      </div>
    );
  })}
</div>
