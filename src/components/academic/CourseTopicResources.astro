---
/**
 * Navigation round (6 Oct 2026) -- "Topics and resources", the first thing on
 * a course page.
 *
 * Every official syllabus topic, in syllabus order, with the course's own
 * study guides, revision notes and practice questions grouped side by side
 * under it, and a search box that only ever searches this course. It replaces
 * the old "Syllabus topics" list (titles only) and the three card grids below
 * it ("Study resources", "Revision material", "Exam preparation"), which
 * listed every revision note twice and put the material a student came for
 * 5,000-8,000px down the page.
 *
 * The resources come from courseTopics() (utils/academic/course-topics.ts),
 * which uses the same resourcesForCombination() rule as the revision tools,
 * so nothing from another course can appear here. The search filters what is
 * already on this page: it cannot return another course's material.
 * Without JavaScript the whole list is shown and the search box stays hidden.
 */
import { KIND_ORDER, topicAnchor, type CourseTopics, type KindGroups } from '../../utils/academic/course-topics';
import type { SyllabusVersion } from '../../data/academic/syllabus-topics';
import { nameRtlLang, recordRtlLang } from '../../utils/academic/rtl-names';
import { routes } from '../../utils/urls/routes';
import ModeColumns from './ModeColumns.astro';
import ModeIcon from './ModeIcon.astro';
import { MODE } from './ResourceMode';
import type { ShortTitleContext } from '../../utils/academic/short-title';

interface Group { label: string; note: string; slugs: string[] }
interface Tool { href: string; label: string; detail: string; cta: string }
interface Props {
  data: CourseTopics;
  record: SyllabusVersion | undefined;
  /** e.g. "Cambridge IGCSE Chemistry (0620)" */
  courseLabel: string;
  /** Short label for the search box, e.g. "0620" or "IB Economics". */
  searchLabel: string;
  /** Stage groups (AS / A Level) from the hub; one unlabelled group otherwise. */
  groups: Group[];
  /** Board-specific intro paragraph(s), rendered above the list. */
  tools: Tool[];
  /** Board name, for the source line. */
  board: string;
  officialTitle: string;
  isMyp: boolean;
  /** D-397: names the course on screen, so resource titles can drop them. */
  context: ShortTitleContext;
}
const { data, record, courseLabel, searchLabel, groups, tools, board, officialTitle, isMyp, context } = Astro.props;
const rtl = recordRtlLang(record?.topics ?? []);
const bySlug = new Map(data.topics.map((t) => [t.topic.slug, t]));
const covered = data.topics.filter((t) => t.count > 0).length;

const searchText = (...parts: (string | undefined)[]) => parts.filter(Boolean).join(' ').toLowerCase();
const hasAny = (g: KindGroups) => KIND_ORDER.some((k) => g[k].length > 0);
// Review fix: search examples come from this course's own topic list, not
// one subject's vocabulary.
const exampleTerms = [...new Set((record?.topics ?? []).flatMap((t) => [t.name, ...t.subtopics.map((st) => st.name)])
  .filter((n) => n.length >= 4 && n.length <= 22 && !/[;:()]/.test(n))
  .map((n) => n.toLowerCase()))].slice(0, 3);
const placeholder = exampleTerms.length ? `e.g. ${exampleTerms.join(', ')}` : 'a topic name or keyword';
---
<section id="topics" aria-labelledby="topics-heading" data-course-topics class="scroll-mt-24">
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
    <h2 id="topics-heading" class="m-0 text-[length:var(--text-h2)] font-bold leading-[1.08] tracking-[-0.025em] text-navy-800">Topics and resources</h2>
    <p class="m-0 mb-meta text-ink-mute">
      {data.total} free {data.total === 1 ? 'resource' : 'resources'}{record && <>, {covered} of {record.topics.length} topics covered</>}
    </p>
  </div>
  <p class="m-0 mt-3 max-w-[70ch] text-[16px] leading-[1.6] text-ink-mute">
    {record
      ? <>Each topic below is {isMyp ? <>a heading from Marlbridge's summary of the IB's <a href={record.sourceUrl} rel="nofollow noopener" class="underline decoration-teal-500 underline-offset-2">subject brief</a></> : <>from the <a href={record.sourceUrl} rel="nofollow noopener" class="underline decoration-teal-500 underline-offset-2">official {board} document</a> for {officialTitle}</>}, with its study guides, revision notes and practice questions together. Everything here is for <strong class="font-semibold text-navy-800">{courseLabel}</strong> only.</>
      : <>The free study guides, revision notes and practice questions for <strong class="font-semibold text-navy-800">{courseLabel}</strong>. Topic-by-topic listing appears once the syllabus topics are confirmed against the awarding body's document.</>}
  </p>
  <ul class="m-0 mt-4 flex list-none flex-wrap gap-x-5 gap-y-2 p-0 text-[14.5px]" aria-label="How resources are grouped">
    {(['learn', 'review', 'practice'] as const).map((k) => (
      <li class={`m-0 flex items-center gap-1.5 font-semibold ${MODE[k].text}`}><ModeIcon kind={k} size={18} /><span>{MODE[k].mode}<span class="font-normal text-ink-mute"> with {MODE[k].label.toLowerCase()}</span></span></li>
    ))}
  </ul>
  {record?.subtopicsCaveat && (
    <p class="m-0 mt-3 max-w-[70ch] rounded-sm border-l-2 border-gold-500 pl-3 text-[15px] leading-[1.6] text-ink-mute" data-subtopics-caveat>{record.subtopicsCaveat}</p>
  )}

  {tools.length > 0 && (
    <ul class="m-0 mt-6 flex list-none flex-wrap gap-3 p-0" aria-label="Free tools for this course">
      {tools.map((t) => (
        <li class="m-0">
          <a href={t.href} data-cta={t.cta} class="flex min-h-11 flex-col justify-center rounded-sm border border-teal-100 bg-teal-50 px-4 py-2 transition-colors hover:border-teal-700 active:bg-teal-100">
            <span class="text-[14.5px] font-semibold text-teal-800">{t.label}</span>
            <span class="text-[12.5px] text-ink-mute">{t.detail}</span>
          </a>
        </li>
      ))}
    </ul>
  )}

  {data.total > 0 && (
    <div data-course-search hidden class="mt-6 max-w-[560px]">
      <label for="course-search-input" class="mb-1.5 block text-[14px] font-medium text-ink">Search {searchLabel} resources</label>
      <div class="flex gap-2">
        <input
          id="course-search-input"
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder={placeholder}
          aria-describedby="course-search-status"
          class="min-h-11 w-full rounded-sm border-2 border-rule bg-white px-3 text-[15.5px] text-ink placeholder:text-ink-mute hover:border-teal-500 focus:border-teal-700"
        />
        <button type="button" data-course-search-clear hidden class="min-h-11 shrink-0 rounded-sm border border-rule bg-white px-4 text-[14px] font-medium text-navy-800 hover:border-teal-500">Clear</button>
      </div>
      <p id="course-search-status" role="status" aria-live="polite" class="m-0 mt-2 min-h-[1.5em] text-[14px] text-ink-mute">Searches topic names and resource titles for this course only.</p>
    </div>
  )}

  <div data-course-search-empty hidden class="mt-6 max-w-[60ch] rounded-md border border-rule bg-ivory p-[clamp(20px,2.6vw,32px)]">
    <p class="m-0 text-[18px] font-semibold text-navy-800">No {searchLabel} resources match “<span data-course-search-term></span>”.</p>
    <ul class="m-0 mt-3 list-disc ps-5 text-[15px] leading-[1.6] text-ink-mute">
      <li>Try one shorter word, or check the spelling.</li>
      <li>Try the wording the syllabus uses for the topic, as listed below once you clear the search.</li>
      <li>Some topics have no Marlbridge resource yet; they are still listed.</li>
    </ul>
    <p class="m-0 mt-4 text-[15px]">
      <button type="button" data-course-search-reset class="border-b-2 border-teal-500 pb-0.5 font-semibold text-navy-800 hover:text-teal-700">Show all topics</button>
      <span class="text-ink-mute"> · </span>
      <a data-course-search-site href="/search/" class="border-b border-rule pb-0.5 text-ink-mute hover:text-teal-700">Search the whole site instead</a>
    </p>
  </div>

  {record ? (
    <div class="mt-8" data-topic-list>
      {groups.map((g) => (
        <section class={g.label ? 'mt-[clamp(32px,4vw,48px)] first:mt-0' : ''} aria-label={g.label || undefined} data-topic-group>
          {g.label && (
            <div class="mb-4 rounded-[18px] bg-navy-800 px-[clamp(18px,3vw,36px)] py-5 text-white">
              <h3 class="m-0 text-[21px] font-bold tracking-[-0.015em] text-white">{g.label}</h3>
              <p class="m-0 mt-1 text-[15px] text-on-navy">{g.note}</p>
            </div>
          )}
          <ol class="m-0 grid list-none gap-[clamp(16px,2vw,24px)] p-0">
            {g.slugs.map((slug) => {
              const entry = bySlug.get(slug)!;
              const t = entry.topic;
              const lang = nameRtlLang(t.name, rtl);
              const tileLabel = t.stage ? (t.stage === 'A' ? 'A Level' : 'AS') : 'Topic';
              return (
                <li id={topicAnchor(t.slug)} class="m-0 scroll-mt-24 rounded-[18px] border border-surface-line bg-surface p-[clamp(18px,3vw,36px)]" data-topic data-search={searchText(String(t.number), t.name, ...t.subtopics.map((s) => s.name))}>
                  <div class="grid grid-cols-[auto_minmax(0,1fr)] items-start gap-x-[clamp(14px,2vw,22px)] gap-y-2.5">
                    <span class="row-span-2 flex min-w-[52px] flex-col items-center justify-center self-start rounded-[12px] bg-teal-700 px-2 py-1.5 text-white sm:min-w-[60px] sm:py-2">
                      <span class="text-[12px] font-semibold leading-tight text-teal-50">{tileLabel}{t.stage && <span class="sr-only"> topic</span>}</span>
                      <span class="font-display text-[22px] font-bold leading-none sm:text-[26px]">{t.number}</span>
                    </span>
                    <div class="flex min-w-0 flex-wrap items-start justify-between gap-x-5 gap-y-2 sm:min-h-[60px]">
                      <h3 class="m-0 min-w-0 max-w-[30ch] self-center text-[clamp(1.5rem,1.1rem+1.2vw,2rem)] font-bold leading-[1.1] tracking-[-0.022em] text-navy-800 [overflow-wrap:anywhere]">{lang ? <bdi dir="rtl" lang={lang}>{t.name}</bdi> : t.name}</h3>
                      <span class="shrink-0 rounded-full border border-surface-line bg-white px-3 py-1 text-[14px] font-medium text-ink-mute sm:mt-1">{entry.count > 0 ? `${entry.count} ${entry.count === 1 ? 'resource' : 'resources'}` : 'No resources yet'}</span>
                    </div>
                    {t.subtopics.length > 0 && (
                      <p class="col-span-2 m-0 max-w-[72ch] text-[16px] leading-[1.6] text-ink-mute sm:col-span-1 sm:col-start-2">
                        <span class="font-semibold text-ink">Covers </span>
                        {t.subtopics.map((st, i) => {
                          const sl = nameRtlLang(st.name, rtl);
                          return <>{i > 0 && ', '}{sl ? <bdi dir="rtl" lang={sl}>{st.name}</bdi> : st.name}</>;
                        })}
                      </p>
                    )}
                  </div>
                  {entry.count > 0
                    ? <ModeColumns groups={entry.groups} context={context} scope="this topic" />
                    : <p class="m-0 mt-5 rounded-[14px] border border-dashed border-surface-line bg-white/55 px-5 py-4 text-[16px] leading-[1.55] text-ink-mute">No Marlbridge resource for this topic yet. It is still part of the syllabus, so use the official document and past papers for it.</p>}
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </div>
  ) : null}

  {hasAny(data.wholeCourse) && (
    <section aria-labelledby="whole-course-heading" class="mt-[clamp(32px,4vw,48px)]" data-topic-group>
      <div data-topic data-search="whole course general all topics" class="rounded-[18px] border-2 border-surface-line bg-white p-[clamp(18px,3vw,36px)]">
        <h3 id="whole-course-heading" class="m-0 text-[clamp(1.5rem,1.1rem+1.2vw,2rem)] font-bold leading-[1.1] tracking-[-0.022em] text-navy-800">{record ? 'Covering more than one topic' : 'All resources for this course'}</h3>
        {record && <p class="m-0 mt-2.5 text-[16px] text-ink-mute">Course guides, exam preparation and pages that span several topics.</p>}
        <ModeColumns groups={data.wholeCourse} context={context} scope="this course" />
      </div>
    </section>
  )}

  {data.total === 0 && (
    <div class="mt-8 max-w-[60ch] rounded-md border border-rule bg-ivory p-[clamp(20px,2.6vw,32px)]">
      <p class="m-0 text-[18px] font-semibold text-navy-800">No Marlbridge resources for this course yet</p>
      <p class="m-0 mt-2 text-[15.5px] leading-[1.6] text-ink-mute">The topics are listed {record ? 'above' : 'here once confirmed'} so you can plan with the official syllabus. Past papers are available from {board} directly.</p>
      <p class="m-0 mt-3 text-[15px]"><a href={routes.resources} class="border-b-2 border-teal-500 pb-0.5 font-semibold text-navy-800 hover:text-teal-700">Change course</a></p>
    </div>
  )}

  {record && (
    <p class="m-0 mt-6 text-[14px] text-ink-mute">
      Source: {record.source} — {/^\d/.test(record.syllabusSeries) ? `${record.syllabusSeries} series` : record.syllabusSeries}. Verified {record.verifiedDate}.
      {record.subtopicsComplete ? ' Every subtopic the document lists is shown.' : ' Subtopics are shown where Marlbridge has entered them; a topic may have more in the official document.'}
      {record.tiered ? ' This syllabus is tiered: see “About this course” below for the tier structure.' : ''}
      {' '}A topic listed here is part of the syllabus; it does not mean Marlbridge has published material for it. Always check the current syllabus for your examination year.
    </p>
  )}
</section>

<script>
  /**
   * Course-scoped search: filters the topics and resources already on this
   * page. A topic whose name (or subtopic) matches keeps all its resources;
   * otherwise only matching resources are kept, and topics left with none
   * are hidden. Nothing is fetched and nothing is sent anywhere.
   */
  const root = document.querySelector<HTMLElement>('[data-course-topics]');
  const box = root?.querySelector<HTMLElement>('[data-course-search]');
  const input = root?.querySelector<HTMLInputElement>('#course-search-input');
  if (root && box && input) {
    box.hidden = false;
    const status = root.querySelector<HTMLElement>('#course-search-status')!;
    const empty = root.querySelector<HTMLElement>('[data-course-search-empty]')!;
    const term = root.querySelector<HTMLElement>('[data-course-search-term]')!;
    const site = root.querySelector<HTMLAnchorElement>('[data-course-search-site]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-course-search-clear]')!;
    const defaultStatus = status.textContent ?? '';
    const topics = [...root.querySelectorAll<HTMLElement>('[data-topic]')];
    const groups = [...root.querySelectorAll<HTMLElement>('[data-topic-group]')];
    const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '');
    const words = (q: string) => norm(q).split(/[^\p{L}\p{N}]+/u).filter((w) => w.length > 0);
    const matches = (text: string, ws: string[]) => { const t = norm(text); return ws.every((w) => t.includes(w)); };
    let timer: number | undefined;

    const apply = () => {
      const q = input.value.trim();
      const ws = words(q);
      clear.hidden = q.length === 0;
      let nRes = 0;
      let nTopics = 0;
      for (const t of topics) {
        const items = [...t.querySelectorAll<HTMLElement>('[data-res]')];
        const topicHit = ws.length === 0 || matches(t.dataset.search ?? '', ws);
        let shown = 0;
        for (const it of items) {
          const on = topicHit || matches(it.dataset.search ?? '', ws);
          it.hidden = !on;
          if (on) shown++;
        }
        for (const g of t.querySelectorAll<HTMLElement>('[data-kind-group]')) {
          const any = [...g.querySelectorAll<HTMLElement>('[data-res]')].some((x) => !x.hidden);
          const none = g.querySelector<HTMLElement>('[data-kind-none]');
          g.hidden = ws.length > 0 && !any && !(topicHit && none);
        }
        const visible = ws.length === 0 || topicHit || shown > 0;
        t.hidden = !visible;
        if (visible && ws.length > 0) { nTopics++; nRes += shown; }
      }
      for (const g of groups) g.hidden = ws.length > 0 && ![...g.querySelectorAll<HTMLElement>('[data-topic]')].some((t) => !t.hidden);
      if (ws.length === 0) {
        status.textContent = defaultStatus;
        empty.hidden = true;
      } else if (nTopics === 0) {
        status.textContent = `No matches for “${q}”.`;
        term.textContent = q;
        site.href = `/search/?q=${encodeURIComponent(q.slice(0, 200))}`;
        empty.hidden = false;
      } else {
        status.textContent = `${nRes} ${nRes === 1 ? 'resource' : 'resources'} in ${nTopics} ${nTopics === 1 ? 'topic' : 'topics'} match “${q}”.`;
        empty.hidden = true;
      }
    };
    input.addEventListener('input', () => { window.clearTimeout(timer); timer = window.setTimeout(apply, 120); });
    input.addEventListener('keydown', (e) => { if (e.key === 'Escape' && input.value) { input.value = ''; apply(); } });
    const reset = () => { input.value = ''; apply(); input.focus(); };
    clear.addEventListener('click', reset);
    root.querySelector('[data-course-search-reset]')?.addEventListener('click', reset);
  }
</script>
