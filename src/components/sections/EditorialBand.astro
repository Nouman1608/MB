---
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
---
<section aria-label="Learning at Marlbridge" class="bg-white">
  <figure class="m-0">
    <ImagePlaceholder
      ratio="21 / 9"
      label="Photograph · 21:9 full width"
      describedAs="a wide photograph of a Marlbridge classroom"
      class="max-h-[460px] border-x-0 border-t-0"
    />
    <figcaption class="mx-auto flex max-w-[var(--container-site)] flex-wrap items-baseline justify-between gap-x-8 gap-y-3 px-[var(--spacing-gutter)] pt-5">
      <span class="max-w-[44ch] font-display text-[clamp(1.125rem,1rem+0.6vw,1.5rem)] leading-snug text-navy-800">
        Teaching, examined carefully — the same standard whether a learner sits in a classroom or logs in from another country.
      </span>
      <span class="text-[13px] text-ink-mute">Reserved for real photography.</span>
    </figcaption>
  </figure>
</section>
