---
/**
 * Conversion & Trust round (2026-09-06, D-149).
 *
 * Marlbridge's strongest verifiable asset is that every teacher is a real,
 * named person with a real photograph and a citable source -- and until now
 * that asset appeared only on /tutoring/, one click off the conversion path.
 *
 * Only `entityType === 'person'` entries are shown; the institutional
 * "Marlbridge Academic Team" byline is not a teacher. Profiles still in
 * `publicationState: 'draft'` are excluded by getAuthors(). Teachers with
 * at least one `subjectsTaught` entry are preferred, since a name without a
 * subject does not help anyone choose. Nothing is invented: the subject
 * label and the years-of-experience figure are read from the profile's own
 * frontmatter, which is itself sourced and dated.
 */
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getAuthors } from '../../utils/content/collections';
import { sortPinnedFirst } from '../../data/featured-teachers';
import { routes } from '../../utils/urls/routes';

const people = (await getAuthors()).filter((a) => a.data.entityType === 'person' && a.data.subjectsTaught.length > 0);
// Pinned leads first (D-151). Every eligible teacher is listed; the pin
// controls the order, not who is visible.
// D-438: on phones only the first MOBILE_VISIBLE are shown, with a link to
// the full list. Every teacher is still in the page; the rest are hidden by
// CSS below the sm breakpoint, so the pin order (D-151) decides who leads.
const MOBILE_VISIBLE = 6;
const featured = sortPinnedFirst(people, (a, b) => {
  const named = Number(b.data.subjectsTaught.length > 0) - Number(a.data.subjectsTaught.length > 0);
  if (named !== 0) return named;
  return (b.data.yearsExperience ?? 0) - (a.data.yearsExperience ?? 0);
});
---
{featured.length > 0 && (
  <Section surface="ivory" labelledby="teachers-heading" border>
    <Container>
      <div class="mb-[clamp(32px,4.5vw,52px)] flex flex-wrap items-end justify-between gap-6">
        <div>
          <SectionHeading id="teachers-heading" eyebrow="The teachers" scale="lg" font="display">Taught by named subject specialists.</SectionHeading>
          <p class="m-0 mt-4 max-w-[58ch] text-[17px] text-ink-mute">
            Not a tutor pool. Every class is taught by a specific teacher you can read about before you book &mdash; each profile lists the subjects they teach and, where a public source exists, where those details were verified from.
          </p>
        </div>
      </div>

      <ul class="m-0 grid list-none gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((t, i) => (
          <li class:list={['m-0', i >= MOBILE_VISIBLE && 'max-sm:hidden']}>
            <a href={routes.author(t.id)} class="flex h-full items-start gap-4 rounded-sm border border-rule bg-white p-5 transition-colors duration-150 hover:border-teal-500">
              {t.data.image ? (
                <img src={t.data.image} alt="" width="64" height="64" class="h-16 w-16 shrink-0 rounded-full object-cover" loading="lazy" decoding="async" />
              ) : (
                <span aria-hidden="true" class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full border border-rule bg-ivory mb-label text-ink-mute">Photo</span>
              )}
              <span class="min-w-0">
                <span class="block text-[16.5px] font-semibold leading-snug text-navy-800">{t.data.name}</span>
                <span class="mt-0.5 block text-[14.5px] text-ink-mute">{t.data.role}</span>
                {t.data.yearsExperience !== undefined && (
                  <span class="mt-2 block mb-label text-teal-700">{t.data.yearsExperience} years teaching</span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
      {featured.length > MOBILE_VISIBLE && (
        <p class="m-0 mt-6 sm:hidden">
          <a href={`${routes.tutoring}#tutoring-teachers`} class="inline-flex min-h-11 items-center font-medium text-navy-800 underline decoration-teal-500 underline-offset-4">See all {featured.length} teachers</a>
        </p>
      )}
    </Container>
  </Section>
)}
