---
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
import PathwayFigure from '../hero/PathwayFigure.astro';
import { site } from '../../data/site';
import { routes } from '../../utils/urls/routes';
---
<section aria-labelledby="hero-heading" class="relative overflow-hidden bg-navy-800 text-ivory">
  <PathwayFigure />
  <Container class="relative pb-[clamp(88px,14vh,168px)] pt-[clamp(72px,12vh,148px)]">
    <p class="m-0 mb-[clamp(24px,4vh,40px)] text-xs font-medium uppercase tracking-[0.2em] text-gold-500">Global Education</p>
    <h1 id="hero-heading" class="m-0 max-w-[24ch] font-display text-[length:var(--text-hero)] font-normal leading-[1.04] tracking-[-0.02em] text-white">
      Bridging Knowledge and Opportunity — everywhere a learner studies.
    </h1>
    <p class="mt-[clamp(28px,4vh,40px)] max-w-[46ch] text-[length:var(--text-lead)] leading-[1.55] text-on-navy">{site.defaultDescription}</p>
    <div class="mt-[clamp(36px,5vh,52px)] flex flex-wrap gap-3.5">
      <Button href={routes.programs} variant="onDark" size="lg">Explore Programs</Button>
      <Button href={routes.resources} variant="onDarkGhost" size="lg">Explore Resources</Button>
    </div>
  </Container>
</section>
