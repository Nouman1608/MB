---
import Container from '../layout/Container.astro';
---
<section aria-labelledby="schools-heading" class="border-t border-rule bg-ivory py-[clamp(36px,4.5vw,56px)]">
  <Container>
    <div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-4">
      <h2 id="schools-heading" class="m-0 shrink-0 text-xs font-medium uppercase tracking-[0.2em] text-gold-600">For Schools</h2>
      <p class="m-0 max-w-[66ch] flex-1 basis-[30ch] text-[16.5px] leading-[1.6] text-ink-mute">
        Marlbridge shares its academic resources with schools and teachers. Partnership work in curriculum support and teacher development is in development — tell us what your school needs.
      </p>
      <a href="/schools/" class="shrink-0 border-b border-gold-500 pb-1 text-[15px] font-medium text-navy-800 hover:text-gold-600">Talk to us</a>
    </div>
  </Container>
</section>
