---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
import { routes } from '../../utils/urls/routes';
---
<Section surface="navy" labelledby="cta-heading">
  <Container class="flex flex-col items-center gap-6 text-center">
    <h2 id="cta-heading" class="m-0 max-w-[26ch] font-display text-[length:var(--text-h1)] font-normal leading-[1.1] tracking-[-0.02em] text-white">
      Start with the subject you need to master.
    </h2>
    <p class="m-0 max-w-[52ch] text-[17.5px] leading-[1.6] text-on-navy">
      Explore the programs we teach, or read the resources — both are the same work, published two ways.
    </p>
    <div class="mt-1.5 flex flex-wrap justify-center gap-3.5">
      <Button href={routes.programs} variant="onDark" size="lg">Explore Programs</Button>
      <Button href={routes.contact} variant="onDarkGhost" size="lg">Contact</Button>
    </div>
  </Container>
</Section>
