---
/**
 * D-286 -- "Start revising for free", directly under the homepage hero.
 *
 * Navigation round (6 Oct 2026): led by "Find study resources" -- the same
 * CourseFinder as /resources/ (qualification -> exam board -> subject), so
 * the homepage and the library start the same journey. The old third card
 * ("Find notes for my syllabus") only scrolled to the finder and is gone;
 * the two tools that are not resource lists stay beside it. The subject
 * list that used to sit lower on the homepage (SubjectsSection) and the
 * type-first resources band (ResourcesSection) are replaced by one line of
 * subject links here, for students who know their subject but not yet their
 * exam board.
 *
 * The diagnostic count is read from src/data/diagnostics.ts, so the sentence
 * cannot claim a subject that has no diagnostic. The flashcard card (D-445) reads
 * its numbers from src/data/flashcards the same way. The tuition trial stays one
 * click away; the hero above already leads with it.
 */
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import CourseFinder from '../tools/CourseFinder.astro';
import { DIAGNOSTIC_SETS } from '../../data/diagnostics';
import { FLASHCARD_DECKS } from '../../data/flashcards';
import { getSubjects } from '../../utils/content/collections';
import { resourcesForSubject } from '../../utils/content/related';
import { routes } from '../../utils/urls/routes';

const diagCount = DIAGNOSTIC_SETS.length;
const diagSyllabuses = new Set(DIAGNOSTIC_SETS.map((d) => d.code)).size;
// The flashcard numbers come from the deck registry, like the diagnostic count above.
const cardCount = FLASHCARD_DECKS.reduce((n, d) => n + d.cards.length, 0);
const subjects = await getSubjects();
const withResources = (await Promise.all(subjects.map(async (s) => ((await resourcesForSubject(s.id)).length > 0 ? s : null)))).filter((s): s is NonNullable<typeof s> => !!s);

const actions = [
  {
    href: '/diagnostics/',
    title: 'Test my knowledge',
    body: `${diagCount} free 10-minute diagnostics across ${diagSyllabuses} IGCSE, O Level and A Level syllabuses, with worked answers and your weakest topics first.`,
    kind: 'test',
  },
  {
    href: '/revision-planner/',
    title: 'Make my revision plan',
    body: 'Enter your subjects, exam dates and free time. Get a weekly plan that puts weak topics first.',
    kind: 'plan',
  },
  {
    href: '/flashcards/',
    title: 'Revise with flashcards',
    body: `${cardCount.toLocaleString('en-GB')} cards for ${FLASHCARD_DECKS.length} courses, by topic and subtopic. Turn a card, say whether you knew it, and the ones you missed come back.`,
    kind: 'cards',
  },
];
---
<Section surface="white" spacing="md" labelledby="free-tools-heading">
  <Container>
    <div class="mb-8 max-w-[60ch]">
      <p class="m-0 mb-3 mb-eyebrow text-teal-700">Free, no sign-up</p>
      <h2 id="free-tools-heading" class="m-0 font-display text-[clamp(1.75rem,1.35rem+1.5vw,2.5rem)] font-bold leading-[1.08] tracking-[-0.025em] text-navy-800">Find study resources</h2>
    </div>
    <div class="grid items-start gap-6 lg:grid-cols-[1.7fr_1fr]">
      <CourseFinder id="home-course-finder" source="home" mode="compact" heading="Choose your course" level={3} />
      <ul class="m-0 grid list-none gap-4 p-0">
        {actions.map((a) => (
          <li class="m-0">
            <a href={a.href} data-free-tool={a.kind} class="flex h-full flex-col gap-2 rounded-sm border border-rule bg-ivory p-[clamp(20px,2.2vw,28px)] transition-colors duration-150 hover:border-teal-500">
              <span class="text-[19px] font-semibold tracking-[-0.01em] text-navy-800">{a.title} <span aria-hidden="true" class="text-teal-700">→</span></span>
              <span class="text-[15px] leading-[1.6] text-ink-mute">{a.body}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <nav aria-labelledby="home-subjects-label" class="mt-8 border-t border-rule pt-6">
      <p id="home-subjects-label" class="m-0 mb-3 text-[15px] text-ink">Know your subject but not your exam board? Start with the subject:</p>
      <ul class="m-0 flex list-none flex-wrap gap-x-4 gap-y-2 p-0 text-[15px]">
        {/* D-438: the first 8 subjects on phones; the rest stay in the page for wider screens. */}
        {withResources.map((s, i) => (
          <li class:list={['m-0', i >= 8 && 'max-sm:hidden']}><a href={routes.subject(s.id)} class="inline-flex min-h-11 items-center text-navy-800 underline decoration-teal-500 underline-offset-2 hover:text-teal-700 sm:min-h-0">{s.data.title}</a></li>
        ))}
      </ul>
      <p class="m-0 mt-4 flex flex-wrap gap-x-6 gap-y-2 text-[15px]">
        {withResources.length > 8 && <a href={routes.subjects} class="inline-flex min-h-11 items-center font-medium text-navy-800 underline decoration-teal-500 underline-offset-2 hover:text-teal-700 sm:hidden">All {withResources.length} subjects</a>}
        <a href={routes.resources} class="inline-flex min-h-11 items-center font-medium text-navy-800 underline decoration-teal-500 underline-offset-2 hover:text-teal-700 sm:min-h-0">All study resources</a>
      </p>
    </nav>
  </Container>
</Section>
