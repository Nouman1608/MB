---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
---
<Section surface="navyDeep" labelledby="global-heading">
  <Container class="relative">
    <div class="max-w-[56ch]">
      <p class="m-0 mb-6 text-xs font-medium uppercase tracking-[0.2em] text-gold-500">Global Vision</p>
      <h2 id="global-heading" class="m-0 mb-6 font-display text-[length:var(--text-h1)] font-normal leading-[1.1] tracking-[-0.02em] text-white">Education Without Borders</h2>
      <p class="m-0 mb-5 text-[length:var(--text-lead)] leading-[1.6] text-on-navy">
        Marlbridge is building a connected learning experience for learners, families and educators across borders.
      </p>
      <p class="m-0 mb-9 text-[16.5px] leading-[1.65] text-on-navy-mute">
        Our teaching operates in Pakistan today. The resource library is written for the international curricula studied across the Middle East, South Asia, the United Kingdom and beyond, and is open to anyone, anywhere.
      </p>
      <a href="/about/" class="inline-flex border-b border-gold-500 pb-1 text-[15px] font-medium text-ivory hover:text-white">Read about our vision</a>
    </div>
  </Container>
</Section>
