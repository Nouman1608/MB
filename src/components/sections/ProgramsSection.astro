---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import { getPrograms, availabilityLabel, availabilityTone } from '../../utils/content/collections';
import { routes } from '../../utils/urls/routes';

const programs = await getPrograms();
const hasUnavailable = programs.some((p) => p.data.status !== 'available');
---
<Section surface="white" labelledby="programs-heading">
  <Container>
    <div class="mb-[clamp(36px,5vw,56px)] flex flex-wrap items-end justify-between gap-6">
      <div>
        <SectionHeading id="programs-heading" eyebrow="Programs" scale="lg">Explore Our Programs</SectionHeading>
        <p class="m-0 mt-4 max-w-[56ch] text-[17px] text-ink-mute">
          Qualification-focused programs and academic support, with study resources available for every subject we cover.
        </p>
      </div>
      <Button href={routes.programs} variant="quiet">All programs</Button>
    </div>

    <ul class="m-0 grid list-none gap-px border border-rule bg-rule p-0 sm:grid-cols-2 lg:grid-cols-4">
      {programs.map((program) => (
        <li class="m-0 bg-white">
          <a
            href={routes.program(program.id)}
            class="flex h-full flex-col gap-3 bg-white p-[clamp(26px,2.6vw,38px)] transition-colors duration-150 hover:bg-ivory"
          >
            <span class="flex items-start justify-between gap-3">
              <h3 class="m-0 text-[clamp(1.25rem,1.1rem+0.5vw,1.5rem)] font-semibold leading-[1.15] tracking-[-0.02em] text-navy-800">{program.data.title}</h3>
              <Badge label={availabilityLabel[program.data.status]} tone={availabilityTone[program.data.status]} />
            </span>
            <p class="m-0 text-[15.5px] leading-relaxed text-ink-mute">{program.data.shortDescription}</p>
            <span aria-hidden="true" class="mt-auto pt-3 font-mono text-[11px] uppercase tracking-[0.12em] text-gold-600">View program</span>
          </a>
        </li>
      ))}
    </ul>

    {hasUnavailable && (
      <p class="mt-5 text-sm text-ink-mute">
        Only programs marked <em>Teaching now</em> are currently taught by Marlbridge. Study resources are available where indicated.
      </p>
    )}
  </Container>
</Section>
