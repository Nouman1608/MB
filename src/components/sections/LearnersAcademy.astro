---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
import Logo from '../brand/Logo.astro';
---
<Section surface="white" labelledby="academy-heading">
  <Container>
    <div class="grid items-center gap-8 lg:grid-cols-[1.1fr_1fr] lg:gap-[clamp(32px,5vw,72px)]">
      <div>
        <p class="m-0 mb-6 text-xs font-medium uppercase tracking-[0.2em] text-gold-600">Where Marlbridge Began</p>
        <h2 id="academy-heading" class="m-0 mb-6 font-display text-[clamp(1.875rem,1.4rem+1.9vw,2.875rem)] font-normal leading-[1.12] tracking-[-0.02em] text-navy-800">
          Learners Academy is the founding academy behind Marlbridge.
        </h2>
        <p class="m-0 mb-5 max-w-[52ch] text-[18px] leading-[1.7]">
          Marlbridge grew out of classroom teaching, not a business plan. Learners Academy remains the founding academy, and its teaching continues under the Marlbridge name as the wider platform develops.
        </p>
        <div class="mb-7 flex max-w-[46ch] items-center gap-4 border-t border-rule pt-5">
          <Logo variant="mark" height={40} class="shrink-0" />
          <p class="m-0 text-[15.5px] leading-snug text-ink-mute">
            <span class="block font-semibold text-navy-800">Learners Academy</span>
            A Marlbridge education institution
          </p>
        </div>
        <Button href="/about/" variant="quiet">Our story</Button>
      </div>
      <figure class="m-0">
        <ImagePlaceholder
          ratio="4 / 5"
          label="Photograph · 4:5 portrait"
          describedAs="a photograph of teaching at Learners Academy"
        />
        <figcaption class="mt-3 text-[13px] leading-normal text-ink-mute">
          Reserved for a real photograph of teaching at Learners Academy. The frame is fixed at 4:5, so the image drops in without changing the layout.
        </figcaption>
      </figure>
    </div>
  </Container>
</Section>
