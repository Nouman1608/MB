---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { pillars } from '../../data/homepage';
---
<Section surface="ivory" labelledby="pillars-heading" class="border-b border-rule">
  <Container>
    <SectionHeading id="pillars-heading" eyebrow="Our Approach" font="display" class="max-w-[34ch]">
      Learning designed for a changing world.
    </SectionHeading>

    <ul class="m-0 mt-[clamp(40px,5vw,72px)] grid list-none gap-0 p-0 sm:grid-cols-2 sm:gap-x-[clamp(32px,5vw,80px)]">
      {pillars.map((pillar, i) => (
        <li class="m-0 border-t border-rule py-[clamp(24px,3vw,36px)] first:border-gold-500 sm:[&:nth-child(2)]:border-gold-500">
          <div class="flex items-baseline gap-5">
            <span aria-hidden="true" class="font-mono text-[12px] text-gold-600">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="m-0 text-[clamp(1.375rem,1.15rem+0.9vw,1.875rem)] font-semibold leading-[1.15] tracking-[-0.02em] text-navy-800">{pillar.title}</h3>
              <p class="m-0 mt-3 max-w-[42ch] text-[16.5px] leading-[1.6] text-ink-mute">{pillar.description}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </Container>
</Section>
