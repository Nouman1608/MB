---
/**
 * D-303 -- one country market page (UAE, Qatar, Malaysia). Structure is
 * shared; the substance is per-country (src/data/markets.ts): local time
 * arithmetic, local-currency fees with their confirmed/indicative status,
 * the boards and syllabus pages searchers in that country actually look
 * for (Search Console evidence), the local curricula NOT taught, and
 * country-specific FAQs. No local branch, teacher, partner or result is
 * claimed anywhere on these pages.
 *
 * D-460 (15 Nov 2026) -- Saudi Arabia, Kuwait, Bahrain, Oman and Europe use
 * this page too. A market with no `searchedHubs` has no search evidence: the
 * searched-pages block is left out and its boards are introduced as the
 * boards taught, not as the most relevant ones. A market that lists OCR shows
 * the one-to-one-only fee (D-335), as /uk/ does. A market with `timeZones`
 * (Europe) gets one row per zone instead of the single-offset table.
 *
 * D7 (owner, audit round 3, 25 Nov 2026) -- PRICING_TERMS.teacherAvailability
 * ("Teachers are available 24 hours a day, 7 days a week ...") is no longer
 * used here: the class-times paragraph uses groupClassTimes, and the trial
 * section states the real reply hours (enquiryResponse.summary, D-346).
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import CTA from '../ui/CTA.astro';
import FAQ from '../ui/FAQ.astro';
import { routes } from '../../utils/urls/routes';
import { boardBySlug } from '../../data/academic/boards';
import { taughtOnly, boardPath } from '../../utils/academic';
import { faqNode } from '../../utils/schema/faq';
import { TRIAL_STEPS } from '../../data/tuition';
import {
  REGION_PRICING, ONE_TO_ONE_PRICING, PRICING_TERMS, PRICING_VERIFIED_DATE, ONE_TO_ONE_TERMS,
  IB_PRICING, IB_USD_PRICING, formatFee, isIndicative, INDICATIVE_NOTE, ibConversionFor, statusLabel, PRICE_STATUS_LABEL,
  isOneToOneOnlyCourse, oneToOneOnlyConversionFor, ONE_TO_ONE_ONLY_NOTE,
} from '../../data/pricing';
import { site } from '../../data/site';
import { timeRows, clock, LAHORE_UTC_OFFSET, hubIsTaught, RESOURCES_ONLY_SUFFIX, tutorCoursesFor, type Market } from '../../data/markets';
import TutorBySubject from './TutorBySubject.astro';
import CountryGuides from './CountryGuides.astro';

import { fxRateDate } from '../../data/fx-policy';

interface Props { market: Market }
const { market: m } = Astro.props;

const group = REGION_PRICING.find((r) => r.region === m.pricingRegion);
const oneToOne = ONE_TO_ONE_PRICING.find((r) => r.region === m.pricingRegion);
// D-311 -- IB: Rs 6,000 per 1-hour class in Pakistan; other currencies are indicative conversions.
const ib = ibConversionFor(m.pricingRegion);
// D-415 -- countries without a set fee (Singapore) pay the owner-set US dollar IB prices (D-313).
const ibUsd = m.pricingRegion === IB_USD_PRICING.region;
const rows = timeRows(m.utcOffsetHours);
const lahoreDifference = (utcOffsetHours: number) => {
  const diff = LAHORE_UTC_OFFSET - utcOffsetHours;
  return diff === 0 ? 'the same time as Lahore' : diff > 0 ? `${diff} hour${diff === 1 ? '' : 's'} behind Lahore` : `${-diff} hour${diff === -1 ? '' : 's'} ahead of Lahore`;
};
// D-460 -- a region with several time zones (Europe) states its own range and gets one row per zone.
const diffText = m.timeSummary ?? lahoreDifference(m.utcOffsetHours);
const zoneRows = (m.timeZones ?? []).map((z) => ({
  where: z.where,
  zone: `UTC+${z.utcOffsetHours} (${z.zone})`,
  difference: lahoreDifference(z.utcOffsetHours),
  lahore: clock(17 + LAHORE_UTC_OFFSET - z.utcOffsetHours),
}));
// D-460 -- no searched hubs means no search evidence for this market.
const hasSearchEvidence = m.searchedHubs.length > 0;
// D-460 -- a market that lists OCR shows the one-to-one-only fee (D-335), as /uk/ does.
const oneToOneOnly = m.focusBoards.includes('ocr') ? oneToOneOnlyConversionFor(m.pricingRegion) : undefined;

const taught = taughtOnly();
const boardRows = m.focusBoards
  .map((slug) => {
    const b = boardBySlug(slug);
    if (!b || b.status !== 'offered') return null;
    const combos = taught.filter((c) => c.boardSlug === slug);
    const quals = [...new Set(combos.map((c) => c.qualification))];
    // D-460 -- IB, and any board whose every taught course is one-to-one only (OCR, D-335).
    const oneToOne = slug === 'ib' || (combos.length > 0 && combos.every((c) => isOneToOneOnlyCourse(c.boardSlug, c.subjectSlug)));
    return { slug, name: b.name, count: combos.length, quals, oneToOne };
  })
  .filter((r): r is NonNullable<typeof r> => Boolean(r && r.count > 0));

const faqs = [
  ...m.faqs,
  {
    question: `What if my child studies a curriculum you do not list for ${m.name}?`,
    answer: `${m.notOffered} If you are unsure whether your school's exams are covered, send an enquiry and we will tell you plainly.`,
  },
];
const faq = faqNode(faqs);

/**
 * 8 Oct 2026 -- buyer-intent titles. Search Console (6 Sep-5 Oct) recorded
 * no impressions for these pages; the old title ("Online IGCSE, A Level & IB
 * Tuition in the UAE -- Fees & Times") named no city or subject. The title
 * now says who the tutors are for and where; "online" and "for students in"
 * keep it honest, since no local branch or teacher exists.
 */
const place = m.name === 'United Arab Emirates' ? 'the UAE' : m.name;
const cityList = m.cities.length > 1 ? `${m.cities.slice(0, -1).join(', ')} and ${m.cities[m.cities.length - 1]}` : m.cities[0];
const pageTitle = m.pageTitle ?? (m.cities.length > 0
  ? `Online IGCSE & A Level Tutors for ${m.cities.slice(0, 2).join(' & ')}${m.cities.length === 1 ? `, ${m.name}` : ''}`
  : `Online IGCSE & A Level Tutors in ${place}`);
const pageDescription = m.pageDescription ?? `Live online IGCSE, A Level and IB tutors for students in ${cityList ?? place}: ${boardRows.map((r) => r.name).slice(0, 3).join(', ')}, fees in ${group?.currency ?? 'local currency'}, class times in local time, first class free.`;
const tutorCourses = tutorCoursesFor(m.focusBoards, 12)
  .filter((t) => !(m.tutorListExcludes ?? []).includes(t.key.split('/')[1]));

const summary = `Marlbridge teaches ${m.name}-based students live online, one-to-one or in small groups of up to ${PRICING_TERMS.maxGroupSize}, from its academy in Lahore, Pakistan. ${m.name} is ${diffText}. ${PRICING_TERMS.freeTrial}`;
---
<PageLayout
  title={pageTitle}
  description={pageDescription}
  path={m.path}
  eyebrow={m.name}
  heading={`Marlbridge for students in ${m.name === 'United Arab Emirates' ? 'the UAE' : m.name}`}
  lead={summary}
  breadcrumbs={[
    { label: 'Home', href: routes.home },
    { label: 'International tutoring', href: '/international-tutoring/' },
    { label: m.name, href: m.path },
  ]}
  jsonLd={faq ? [faq] : []}
>
  <Section surface="white">
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">What we teach for students in {m.name === 'United Arab Emirates' ? 'the UAE' : m.name}</h2>
      <p class="m-0 mb-6 max-w-[70ch] text-[15.5px] leading-[1.65] text-ink-mute">
        {hasSearchEvidence
          ? `These are the boards most relevant to ${m.name === 'United Arab Emirates' ? 'UAE' : m.name} families, with the number of subjects Marlbridge currently teaches for each.`
          : 'These are the boards Marlbridge teaches, with the number of subjects it currently teaches for each.'}
        The counts come from the same data that builds every board page, so they only include subjects with classes; subjects with free resources only are not counted.
      </p>
      <div class="overflow-x-auto" tabindex="0" role="group" aria-label="Table, scrolls sideways on small screens">
        <table class="w-full min-w-[520px] border-collapse text-[15px]">
          <caption class="sr-only">Boards and qualifications taught for students in {m.name}</caption>
          <thead>
            <tr class="border-b border-rule text-left">
              <th scope="col" class="py-3 pr-4 mb-label text-teal-700">Board</th>
              <th scope="col" class="py-3 pr-4 mb-label text-teal-700">Qualifications</th>
              <th scope="col" class="py-3 mb-label text-teal-700">Subject combinations taught</th>
            </tr>
          </thead>
          <tbody>
            {boardRows.map((r) => (
              <tr class="border-b border-rule">
                <th scope="row" class="py-3 pr-4 text-left font-normal"><a href={boardPath(r.slug)} class="font-semibold text-navy-800 underline decoration-teal-500 underline-offset-2 hover:text-teal-700">{r.name}</a></th>
                <td class="py-3 pr-4 text-ink-mute">{r.quals.join(', ')}</td>
                <td class="py-3 text-ink-mute">{r.count}{r.oneToOne ? ' (one-to-one only)' : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {hasSearchEvidence && (
        <>
          <h3 class="m-0 mt-10 mb-3 text-[20px] font-semibold text-navy-800">Syllabus pages searchers in {m.name === 'United Arab Emirates' ? 'the UAE' : m.name} look for most</h3>
          <p class="m-0 mb-4 max-w-[70ch] text-[14.5px] leading-[1.65] text-ink-mute">
            {m.searchedHubsNote ?? `From Marlbridge's own Google Search Console data for searches made in ${m.name === 'United Arab Emirates' ? 'the UAE' : m.name} (last three months, checked 23 September 2026). Each page gives the official syllabus or specification, how it is assessed, and free study material.`}
          </p>
          <ul class="m-0 grid list-none gap-3 p-0 sm:grid-cols-2">
            {m.searchedHubs.map((h) => (
              <li class="m-0"><a href={h.path} class="block rounded-sm border border-rule bg-ivory p-4 text-[15px] font-semibold text-navy-800 hover:border-teal-500">{h.label}{hubIsTaught(h.path) ? '' : <span class="font-normal text-ink-mute">{RESOURCES_ONLY_SUFFIX}</span>}</a></li>
            ))}
          </ul>
        </>
      )}
    </Container>
  </Section>

  <TutorBySubject
    heading={`Online tutors by subject for students in ${place}`}
    intro={`Courses taught live online for families ${cityList ? `in ${cityList} and across ${place === 'the UAE' ? 'the country' : place}` : `across ${place}`}. Each course page has the syllabus, the topics and the teachers; the free trial books a first class with the course already filled in.`}
    courses={tutorCourses}
  />

  <CountryGuides country={m.slug} audience={`families in ${place}`} />

  <Section surface="ivory" border>
    <Container>
      {zoneRows.length > 0 ? (
        <>
          <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Class times: {place} and Lahore time</h2>
          <p class="m-0 mb-6 max-w-[70ch] text-[15.5px] leading-[1.65] text-ink-mute">
            Every class is taught live from Lahore (UTC+5), which keeps the same time all year. {place} is {diffText}: {m.timeZoneLabel}.
            The table shows where a 5:00 pm class falls in Lahore in each time zone. {PRICING_TERMS.groupClassTimes} The actual time is agreed with you before the first class.
          </p>
          <div class="overflow-x-auto" tabindex="0" role="group" aria-label="Table, scrolls sideways on small screens">
            <table class="w-full min-w-[640px] border-collapse text-[15px]">
              <caption class="sr-only">A 5:00 pm class in each {place} time zone converted to Lahore time</caption>
              <thead>
                <tr class="border-b border-rule text-left">
                  <th scope="col" class="py-2 pr-4 mb-label text-teal-700">Where and when</th>
                  <th scope="col" class="py-2 pr-4 mb-label text-teal-700">Time zone</th>
                  <th scope="col" class="py-2 pr-4 mb-label text-teal-700">Difference</th>
                  <th scope="col" class="py-2 mb-label text-teal-700">5:00 pm local is, in Lahore</th>
                </tr>
              </thead>
              <tbody>
                {zoneRows.map((z) => (
                  <tr class="border-b border-rule">
                    <th scope="row" class="py-2 pr-4 text-left font-normal text-ink">{z.where}</th>
                    <td class="py-2 pr-4 text-ink-mute">{z.zone}</td>
                    <td class="py-2 pr-4 text-ink-mute">{z.difference}</td>
                    <td class="py-2 text-ink-mute">{z.lahore}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ) : (
        <>
          <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Class times: {m.name === 'United Arab Emirates' ? 'UAE' : m.name} time and Lahore time</h2>
          <p class="m-0 mb-6 max-w-[70ch] text-[15.5px] leading-[1.65] text-ink-mute">
            Every class is taught live from Lahore (UTC+5). {m.name === 'United Arab Emirates' ? 'The UAE' : m.name} is on {m.timeZoneLabel}, {diffText}.
            The table shows where common after-school times fall in Lahore. {PRICING_TERMS.groupClassTimes} The actual time is agreed with you before the first class.
          </p>
          <div class="overflow-x-auto" tabindex="0" role="group" aria-label="Table, scrolls sideways on small screens">
            <table class="w-full min-w-[360px] max-w-[520px] border-collapse text-[15px]">
              <caption class="sr-only">{m.name} after-school times converted to Lahore time</caption>
              <thead>
                <tr class="border-b border-rule text-left">
                  <th scope="col" class="py-2 pr-4 mb-label text-teal-700">{m.name === 'United Arab Emirates' ? 'UAE' : m.name} time</th>
                  <th scope="col" class="py-2 mb-label text-teal-700">Lahore time</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr class="border-b border-rule">
                    <th scope="row" class="py-2 pr-4 text-left font-normal text-ink">{r.local}</th>
                    <td class="py-2 text-ink-mute">{r.lahore}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}
    </Container>
  </Section>

  <Section surface="white" border>
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Fees for {m.name === 'United Arab Emirates' ? 'the UAE' : m.name}</h2>
      <p class="m-0 mb-6 max-w-[70ch] text-[15.5px] leading-[1.65] text-ink-mute">
        Group classes are charged per subject per month ({PRICING_TERMS.classFormat.group.replace(/\.$/, '')}); one-to-one classes are charged per class ({PRICING_TERMS.classFormat.oneToOne.replace(/\.$/, '')}).
        Full terms, discounts and other regions are on the <a href={routes.pricing} class="underline decoration-teal-500 underline-offset-2 hover:text-teal-700">pricing page</a>.
      </p>
      {group && oneToOne ? (
        <div class="overflow-x-auto" tabindex="0" role="group" aria-label="Table, scrolls sideways on small screens">
          <table class="w-full min-w-[520px] border-collapse text-[15px]">
            <caption class="sr-only">Tuition fees for {m.name} in {group.currency}</caption>
            <thead>
              <tr class="border-b border-rule text-left">
                <th scope="col" class="py-3 pr-4 mb-label text-teal-700">Format</th>
                <th scope="col" class="py-3 pr-4 mb-label text-teal-700">GCSE / IGCSE / O Level</th>
                <th scope="col" class="py-3 pr-4 mb-label text-teal-700">AS / A Level</th>
                <th scope="col" class="py-3 mb-label text-teal-700">Status</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-rule">
                <th scope="row" class="py-3 pr-4 text-left font-normal text-ink">Group class, per subject per month</th>
                <td class="py-3 pr-4 text-ink-mute">{formatFee(group.igcse, group.currency)} {group.currency}</td>
                <td class="py-3 pr-4 text-ink-mute">{formatFee(group.aLevel, group.currency)} {group.currency}</td>
                <td class="py-3 text-ink-mute">{statusLabel(group)}</td>
              </tr>
              <tr class="border-b border-rule">
                <th scope="row" class="py-3 pr-4 text-left font-normal text-ink">One-to-one, per class</th>
                <td class="py-3 pr-4 text-ink-mute">{formatFee(oneToOne.igcse, oneToOne.currency)} {oneToOne.currency}</td>
                <td class="py-3 pr-4 text-ink-mute">{formatFee(oneToOne.aLevel, oneToOne.currency)} {oneToOne.currency}</td>
                <td class="py-3 text-ink-mute">{statusLabel(oneToOne)}</td>
              </tr>
              <tr class="border-b border-rule">
                <th scope="row" class="py-3 pr-4 text-left font-normal text-ink">IB, one-to-one, per 1-hour class</th>
                <td class="py-3 pr-4 text-ink-mute" colspan="2">{ibUsd ? `MYP ${IB_USD_PRICING.myp} ${IB_USD_PRICING.currency}, Diploma ${IB_USD_PRICING.dp} ${IB_USD_PRICING.currency}` : ib ? `${formatFee(ib.perClass, ib.currency)} ${ib.currency}` : 'Confirmed in writing when you enquire'}</td>
                <td class="py-3 text-ink-mute">{ibUsd ? PRICE_STATUS_LABEL[IB_USD_PRICING.status] : ib ? statusLabel(ib) : 'On enquiry'}</td>
              </tr>
              {oneToOneOnly && (
                <tr class="border-b border-rule">
                  <th scope="row" class="py-3 pr-4 text-left font-normal text-ink">OCR courses, and OxfordAQA Islamiyat and Pakistan Studies, one-to-one only, per class</th>
                  <td class="py-3 pr-4 text-ink-mute" colspan="2">{formatFee(oneToOneOnly.perClass, oneToOneOnly.currency)} {oneToOneOnly.currency}</td>
                  <td class="py-3 text-ink-mute">{statusLabel(oneToOneOnly)}</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="m-0 text-[15.5px] text-ink-mute">{PRICING_TERMS.unsupportedRegionNote}</p>
      )}
      <p class="m-0 mt-4 max-w-[70ch] text-[13px] text-ink-mute">
        {oneToOneOnly ? `${ONE_TO_ONE_ONLY_NOTE} ` : ''}{ibUsd ? `${m.name} has no separate price; these are the US dollar prices for countries without their own fee. "${PRICE_STATUS_LABEL.confirmed}" fees are fixed in US dollars and are not currency conversions. ` : group && oneToOne && (!isIndicative(group) || !isIndicative(oneToOne)) ? `"${PRICE_STATUS_LABEL.confirmed}" fees are fixed for ${m.name} and are not currency conversions. ` : ''}{INDICATIVE_NOTE} {ibUsd ? `IB is priced in US dollars ${IB_USD_PRICING.unit} (set ${IB_USD_PRICING.verifiedDate}).` : `The IB fee is set in Pakistan at ${IB_PRICING.perClass.toLocaleString('en-US')} ${IB_PRICING.currency} ${IB_PRICING.unit}; the figure above is its conversion (IB rates converted ${IB_PRICING.verifiedDate}).`} {PRICING_TERMS.notPermanentNote} Group fees last confirmed {PRICING_VERIFIED_DATE}; one-to-one figures last confirmed or converted {ONE_TO_ONE_TERMS.verifiedDate}{m.slug === 'malaysia' ? `; Malaysia figures converted at the ${fxRateDate('MYR')} rate` : m.slug === 'singapore' ? `; Singapore figures converted at the ${fxRateDate('SGD')} rate` : ''}.
      </p>
    </Container>
  </Section>

  <Section surface="ivory" border>
    <Container>
      <h2 class="m-0 mb-6 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">How the free trial works</h2>
      <ol class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {TRIAL_STEPS.map((step, i) => (
          <li class="m-0 rounded-sm border border-rule bg-white p-5">
            <p class="m-0 mb-label text-teal-700">Step {i + 1}</p>
            <p class="m-0 mt-1 text-[16px] font-semibold text-navy-800">{step.title}</p>
            <p class="m-0 mt-2 text-[14.5px] leading-[1.6] text-ink-mute">{step.body}</p>
          </li>
        ))}
      </ol>
      {/* D7 (owner, audit round 3) -- the real reply hours, in place of the old "24 hours a day, 7 days a week" sentence. */}
      <p class="m-0 mt-6 max-w-[70ch] text-[15.5px] leading-[1.65] text-ink-mute">{PRICING_TERMS.enquiryResponse.summary}</p>
    </Container>
  </Section>

  {m.localFacts && (
    <Section surface="ivory" border>
      <Container>
        <h2 class="m-0 mb-6 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">{m.localFacts.heading}</h2>
        {m.localFacts.groups.map((g) => (
          <>
            <h3 class="m-0 mb-3 mt-6 text-[20px] font-semibold text-navy-800">{g.heading}</h3>
            {g.paragraphs.map((t) => (
              <p class="m-0 mb-3 max-w-[70ch] text-[15.5px] leading-[1.65] text-ink-mute">{t}</p>
            ))}
          </>
        ))}
        <p class="m-0 mt-6 max-w-[70ch] text-[13px] leading-[1.6] text-ink-mute">
          Sources, read {m.localFacts.readOn}:{' '}
          {m.localFacts.sources.map((s, i) => (
            <>{i > 0 ? '; ' : ''}<a href={s.url} rel="nofollow noopener" class="underline decoration-rule underline-offset-2 hover:text-teal-700">{s.label}</a></>
          ))}.
        </p>
      </Container>
    </Section>
  )}

  <Section surface="white" border>
    <Container>
      <h2 class="m-0 mb-3 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">What we do not teach</h2>
      <p class="m-0 max-w-[70ch] text-[15.5px] leading-[1.65] text-ink-mute">{m.notOffered}</p>
      {(m.notOfferedExtra ?? []).map((t) => (
        <p class="m-0 mt-4 max-w-[70ch] text-[15.5px] leading-[1.65] text-ink-mute">{t}</p>
      ))}
      <p class="m-0 mt-4 max-w-[70ch] text-[15.5px] leading-[1.65] text-ink-mute">
        Marlbridge is the international branch of Learners Academy. Its only in-person teaching location is {site.about.address}.
      </p>
    </Container>
  </Section>

  <Section surface="ivory" border>
    <Container>
      <h2 class="m-0 mb-6 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">Questions from families in {m.name === 'United Arab Emirates' ? 'the UAE' : m.name}</h2>
      <div class="max-w-[80ch]"><FAQ items={faqs} /></div>
    </Container>
  </Section>

  <CTA
    heading={`Request a free trial class from ${m.name === 'United Arab Emirates' ? 'the UAE' : m.name}. Tell us the board, subject and the times that suit you, and we will confirm a teacher and a time by email.`}
    buttonLabel="Request a free trial"
    buttonHref={`${routes.trial}?source=region`}
  />
</PageLayout>
