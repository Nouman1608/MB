---
import FormField from './FormField.astro';
import Input from './Input.astro';
import Select from './Select.astro';
import Textarea from './Textarea.astro';
import { FALLBACK_EMAIL, type EnquiryKind } from '../../utils/forms/submit';
import { site } from '../../data/site';
import type { EnquiryFormLabels } from '../../i18n/nav';

// v1.x CLOSURE Release WS1 (2026-08-26) -- every non-school enquiry kind
// (student, tutoring, trial) now shares exactly one field set: Name,
// Email, Phone, Country, Message. This REVERSES the QIGT trust
// workstream's earlier trial-specific qualification/board/subject/
// availability fields (Aug 2026) -- the approved business decision for
// this release is explicit that enquiry forms carry only those five
// fields, with programme, board, subject, level and availability left for
// the student to write in the message itself (see the hint below). The
// school-partnership form keeps its own fields (school, role) since those
// identify the organisation making the enquiry, not enrolment metadata.
interface Props { kind: EnquiryKind; labels?: EnquiryFormLabels }
const { kind, labels } = Astro.props;

/**
 * v1.x CLOSURE WS2 -- English defaults, used verbatim by every existing
 * English caller (contact, trial, tutoring, schools) so this change is
 * behaviour-preserving for the ~500 English pages that already use this
 * component without a `labels` prop. Translated locale pages pass a
 * `labels` object from src/i18n/nav.ts (NAV_COPY[locale].form) instead.
 */
const EN_LABELS: EnquiryFormLabels = {
  name: 'Full name', email: 'Email', phone: 'Phone', country: 'Country', message: 'Message',
  optional: '(optional)', school: 'School', role: 'Your role',
  roleOptions: ['Head of school', 'Head of department', 'Teacher', 'Coordinator', 'Other'],
  rolePlaceholder: 'Please choose',
  messageHintStudent: 'What does the learner need help with? Please include the programme (e.g. IGCSE, A Level), the exam board if known, the subject and the level.',
  messageHintTrial: "Tell us what you'd like the trial class to cover: your programme or qualification (e.g. IGCSE, A Level), the exam board if known, the subject, the level, your preferred days/times and timezone, and what support you need.",
  messageHintTutoring: 'What does the learner need help with? Please include the programme (e.g. IGCSE, A Level), the exam board if known, the subject and the level.',
  messageHintSchool: 'What does your school need?',
  trialNote: 'This sends a request, not a confirmed booking — Marlbridge will reply by email to arrange the trial class once it can confirm a teacher and time.',
  privacyPrefix: "By submitting this form you agree to Marlbridge's ",
  privacyLinkText: 'Privacy Policy',
  privacySuffix: ' — your information is used only to respond to your enquiry.',
  submit: 'Send enquiry',
  preferEmail: 'Prefer email? Write to',
  sending: 'Sending…',
  successMessage: 'Thank you — your enquiry has been sent. We will reply by email.',
  genericError: 'Your enquiry could not be sent.',
  networkError: 'We could not reach the server. Please check your connection, or email us.',
  requiredError: 'This field is required.',
  emailError: 'Please enter a valid email address.',
  genericFieldError: 'Please check this field.',
};
const t = labels ?? EN_LABELS;

const mailto = 'mailto:' + FALLBACK_EMAIL;
const turnstileSiteKey = site.turnstile.siteKey;

const MESSAGE_HINT: Record<EnquiryKind, string> = {
  school: t.messageHintSchool,
  trial: t.messageHintTrial,
  student: t.messageHintStudent,
  tutoring: t.messageHintTutoring,
};

/**
 * Client-side validation/status strings can't read Astro frontmatter
 * variables directly (the <script> below is a separate module script), so
 * they travel via this data attribute instead, read with JSON.parse. An
 * English page renders no `labels` prop, so `t` is EN_LABELS and this
 * attribute's content is identical to the previous hardcoded English
 * strings -- no behaviour change for existing callers.
 */
const clientStrings = JSON.stringify({
  sending: t.sending, success: t.successMessage, genericError: t.genericError, networkError: t.networkError,
  requiredError: t.requiredError, emailError: t.emailError, genericFieldError: t.genericFieldError,
});
---
{/*
  v1.2 WS3 — action now points at the real /api/enquiry Cloudflare Pages
  Function (functions/api/enquiry.ts), not a mailto: action. A `mailto:`
  form action does not reliably deliver form-encoded field data in most
  browsers, so it was effectively as broken as the "not connected" JS
  error path it was meant to back up. With JS enabled the submit handler
  below intercepts and posts via fetch; with JS disabled the browser still
  natively POSTs to /api/enquiry, which is a real, working endpoint.
*/}
<form data-enquiry-form data-kind={kind} data-i18n={clientStrings} method="post" action="/api/enquiry" novalidate class="grid max-w-[68ch] gap-5 sm:grid-cols-2">
  {/* Honeypot — real users never see or fill this in; a filled value is
      treated as automated spam by functions/api/enquiry.ts. Hidden from
      sighted and assistive-tech users alike (aria-hidden + tabindex -1 +
      visually-hidden position, not display:none, so basic bots that skip
      display:none fields don't skip this one too). */}
  <div aria-hidden="true" class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden">
    <label for="website">Website</label>
    <input type="text" id="website" name="website" tabindex={-1} autocomplete="off" />
  </div>

  <FormField name="name" label={t.name} required><Input name="name" autocomplete="name" required /></FormField>

  {kind === 'school' && <FormField name="school" label={t.school} required><Input name="school" autocomplete="organization" required /></FormField>}
  {kind === 'school' && <FormField name="role" label={t.role} required><Select name="role" options={t.roleOptions} placeholder={t.rolePlaceholder} required /></FormField>}

  <FormField name="email" label={t.email} required><Input name="email" type="email" autocomplete="email" inputmode="email" required /></FormField>
  <FormField name="phone" label={t.phone} optionalLabel={t.optional}><Input name="phone" type="tel" autocomplete="tel" inputmode="tel" /></FormField>
  <FormField name="country" label={t.country} required>
    <Input name="country" autocomplete="country-name" required />
  </FormField>

  <FormField
    name="message"
    label={t.message}
    required
    hint={MESSAGE_HINT[kind]}
    class="sm:col-span-2"
  >
    <Textarea name="message" required />
  </FormField>

  {kind === 'trial' && (
    <p class="m-0 sm:col-span-2 text-[13.5px] text-ink-mute">
      {t.trialNote}
    </p>
  )}

  {/* v1.x WS2 -- Cloudflare Turnstile widget. Renders only when a site
      key is configured (site.turnstile.siteKey, a public identifier, not
      a secret -- see docs/decision-log.md D-002). The widget writes its
      token into a hidden input named cf-turnstile-response, which
      functions/api/enquiry.ts already reads and verifies server-side
      against TURNSTILE_SECRET_KEY. */}
  {turnstileSiteKey && (
    <div class="sm:col-span-2">
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
    </div>
  )}

  {/* v1.x CLOSURE follow-up (Register #4 / Risk R10) -- a privacy notice
      at the point of data collection, matching what src/pages/legal/
      privacy.astro already discloses ("we use the information you submit
      only to respond to your enquiry"). A plain-text notice with a link
      is used rather than a mandatory tick-box: this form collects data
      under legitimate-interest/contract processing to answer a genuine
      enquiry, not for marketing, so there is nothing here that needs an
      opt-in checkbox -- the existing cookie-consent banner already
      handles the one thing on this site that DOES need an opt-in
      (GA4 analytics). Adding a checkbox on top would add friction to a
      lead-generation form without a corresponding legal requirement. */}
  <p class="m-0 sm:col-span-2 text-[13.5px] text-ink-mute">
    {t.privacyPrefix}<a href="/legal/privacy/" class="underline decoration-gold-500 underline-offset-2">{t.privacyLinkText}</a>{t.privacySuffix}
  </p>

  <div class="sm:col-span-2">
    <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-sm bg-navy-800 px-7 py-3.5 text-[15px] font-medium text-ivory transition-colors hover:bg-navy-700 disabled:opacity-60">{t.submit}</button>
    <p class="m-0 mt-3 text-[13.5px] text-ink-mute">
      {t.preferEmail} <a href={mailto} class="underline decoration-gold-500 underline-offset-2">{FALLBACK_EMAIL}</a>.
    </p>
  </div>

  <div data-form-status role="status" aria-live="polite" class="sm:col-span-2"></div>
</form>

{turnstileSiteKey && <script is:inline async src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>}

<script>
  import { submitEnquiry, type EnquiryKind } from '../../utils/forms/submit';

  interface ClientStrings {
    sending: string; success: string; genericError: string; networkError: string;
    requiredError: string; emailError: string; genericFieldError: string;
  }

  document.querySelectorAll<HTMLFormElement>('[data-enquiry-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const strings: ClientStrings = JSON.parse(form.dataset.i18n ?? '{}');

    const setError = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement, message: string | null) => {
      const el = form.querySelector<HTMLElement>('[data-error-for="' + field.name + '"]');
      if (!el) return;
      el.textContent = message ?? '';
      el.hidden = !message;
      field.setAttribute('aria-invalid', message ? 'true' : 'false');
    };

    const validate = () => {
      let firstInvalid: HTMLElement | null = null;
      form.querySelectorAll<HTMLInputElement>('input, select, textarea').forEach((field) => {
        if (!field.name) return;
        const message = field.validity.valid
          ? null
          : field.validity.valueMissing
            ? strings.requiredError
            : field.type === 'email'
              ? strings.emailError
              : strings.genericFieldError;
        setError(field, message);
        if (message && !firstInvalid) firstInvalid = field;
      });
      if (firstInvalid) (firstInvalid as HTMLElement).focus();
      return !firstInvalid;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!validate() || !status) return;
      button?.setAttribute('disabled', 'true');
      status.textContent = strings.sending;
      status.className = 'sm:col-span-2 mt-2 text-[15px] text-ink-mute';

      const result = await submitEnquiry((form.dataset.kind as EnquiryKind) ?? 'student', new FormData(form));
      button?.removeAttribute('disabled');

      if (result.ok) {
        status.textContent = strings.success;
        status.className = 'sm:col-span-2 mt-2 rounded-sm border border-[#B9D3C6] bg-[#F1F7F4] p-4 text-[15px] text-success';
        // GA4 key event -- see docs/decision-log.md D-003 (consent-gated gtag defined in
        // ConsentAnalytics.astro). Only fires downstream once the visitor has granted
        // analytics consent; gtag queues safely if window.gtag is undefined.
        (window as any).gtag?.('event', 'generate_lead', {
          enquiry_kind: (form.dataset.kind as EnquiryKind) ?? 'student',
        });
        form.reset();
      } else {
        status.textContent = result.message ?? strings.genericError;
        status.className = 'sm:col-span-2 mt-2 rounded-sm border border-[#E3BDBD] bg-[#FBF2F2] p-4 text-[15px] text-error';
      }
    });
  });
</script>
