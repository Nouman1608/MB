---
type InputType = 'text' | 'email' | 'tel' | 'url' | 'search' | 'number';
type Autocomplete = HTMLInputElement['autocomplete'];
type InputMode = 'text' | 'email' | 'tel' | 'url' | 'search' | 'numeric' | 'decimal' | 'none';

interface Props {
  name: string;
  type?: InputType;
  required?: boolean;
  autocomplete?: Autocomplete;
  inputmode?: InputMode;
  placeholder?: string;
}
const { name, type = 'text', required = false, autocomplete, inputmode, placeholder } = Astro.props;
---
<input
  id={name} name={name} type={type} required={required}
  autocomplete={autocomplete} inputmode={inputmode} placeholder={placeholder}
  aria-describedby={`${name}-hint ${name}-error`}
  class="min-h-11 w-full rounded-sm border border-rule bg-white px-3.5 py-2.5 text-[16px] text-ink focus:border-navy-800"
/>
