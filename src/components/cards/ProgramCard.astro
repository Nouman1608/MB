---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import Badge from '../ui/Badge.astro';
import { availabilityLabel, availabilityTone } from '../../utils/content/collections';
import { routes } from '../../utils/urls/routes';

interface Props { entry: CollectionEntry<'programs'> }
const { entry } = Astro.props;
---
<Card href={routes.program(entry.id)} title={entry.data.title} description={entry.data.shortDescription} variant="grid">
  <Badge slot="badge" label={availabilityLabel[entry.data.marlbridgeTeaches]} tone={availabilityTone[entry.data.marlbridgeTeaches]} />
</Card>
