---
/** Native details/summary — zero JavaScript. */
interface Props { items: readonly { question: string; answer: string }[]; id?: string }
const { items, id = 'faqs' } = Astro.props;
---
{items.length > 0 && (
  <div id={id} class="border-t border-rule">
    {items.map((item) => (
      <details class="group border-b border-rule">
        <summary class="flex cursor-pointer list-none items-baseline justify-between gap-4 py-5 text-[17.5px] font-semibold text-navy-800 marker:hidden">
          {item.question}
          <span aria-hidden="true" class="shrink-0 font-mono text-lg text-gold-600 group-open:hidden">+</span>
          <span aria-hidden="true" class="hidden shrink-0 font-mono text-lg text-gold-600 group-open:inline">−</span>
        </summary>
        <p class="m-0 max-w-[68ch] pb-6 text-[16.5px] leading-[1.7] text-ink-mute">{item.answer}</p>
      </details>
    ))}
  </div>
)}
