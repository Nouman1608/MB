---
interface Props {
  variant?: 'primary' | 'secondary' | 'onDark' | 'onDarkGhost' | 'quiet' | 'highlight';
  size?: 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  /**
   * Any additional attribute (data-cta, aria-*, rel, target, ...) is
   * forwarded verbatim to the rendered <a>/<button>. Without this,
   * Astro drops unknown props silently -- which is exactly how
   * data-cta went missing and left the hero/final trial CTAs
   * untracked. See the commit that added this for the evidence.
   */
  [key: string]: unknown;
}
const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;

// D-397: teal is the action colour on light surfaces; on navy the solid
// button is white and the ghost button gains a teal outline on hover.
// Pressed state darkens one step; focus uses the global ring.
const base =
  'inline-flex items-center justify-center gap-2 rounded-sm font-semibold min-h-11 transition-colors duration-150';
const sizes = { md: 'px-6 py-3 text-[15px]', lg: 'px-8 py-[16px] text-[16.5px]' };
const variants = {
  primary: 'bg-teal-700 text-white hover:bg-teal-800 hover:text-white active:bg-navy-800',
  secondary: 'border-2 border-teal-700 text-teal-700 hover:bg-teal-50 hover:text-teal-800 active:bg-teal-100',
  onDark: 'bg-white text-navy-800 hover:bg-teal-50 hover:text-navy-800 active:bg-teal-100',
  // Gold is kept for the free trial, the one highlighted action on a page.
  highlight: 'bg-gold-500 text-navy-800 hover:bg-gold-400 hover:text-navy-800 active:bg-[#C99A1F]',
  onDarkGhost: 'border-2 border-navy-line text-white hover:border-teal-300 hover:text-white active:bg-navy-700',
  quiet: 'border-b-2 border-teal-500 pb-0.5 text-navy-800 hover:text-teal-700 min-h-0 px-0 py-0 !rounded-none',
};
const cls = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
const Tag = href ? 'a' : 'button';
---
<Tag class={cls} href={href} type={href ? undefined : type} {...rest}><slot /></Tag>
