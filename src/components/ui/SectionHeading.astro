---
interface Props {
  id: string;
  eyebrow: string;
  font?: 'sans' | 'display';
  scale?: 'md' | 'lg';
  tone?: 'dark' | 'light';
  class?: string;
}
const { id, eyebrow, font = 'sans', scale = 'md', tone = 'dark', class: className = '' } = Astro.props;
const eyebrowColor = tone === 'light' ? 'text-teal-300' : 'text-teal-700';
const headingColor = tone === 'light' ? 'text-white' : 'text-navy-800';
const type = font === 'display'
  ? `font-display font-bold tracking-[-0.025em] leading-[1.06] ${scale === 'lg' ? 'text-[length:var(--text-h1)]' : 'text-[length:var(--text-serif-h2)]'}`
  : 'text-[length:var(--text-h2)] font-bold leading-[1.1] tracking-[-0.02em]';
---
<div class={className}>
  <p class={`m-0 mb-3 mb-eyebrow ${eyebrowColor}`}>{eyebrow}</p>
  <h2 id={id} class={`m-0 ${type} ${headingColor}`}><slot /></h2>
</div>
