---
interface Props { label: string; tone?: 'neutral' | 'gold' | 'success' }
const { label, tone = 'neutral' } = Astro.props;
const tones = {
  neutral: 'text-ink-mute border-rule bg-ivory',
  gold: 'text-practise-700 border-practise-200 bg-practise-50',
  success: 'text-success border-[#B9D3C6] bg-[#F1F7F4]',
};
---
<span class={`shrink-0 whitespace-nowrap rounded-full border px-2.5 py-0.5 mb-label ${tones[tone]}`}>{label}</span>
