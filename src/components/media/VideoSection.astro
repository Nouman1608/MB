---
/**
 * D-286 -- a titled group of teaching videos. Renders NOTHING when the list
 * is empty: no heading, no "coming soon", so pages carry no empty video
 * promise while no real lesson has been recorded.
 */
import type { CollectionEntry } from 'astro:content';
import TeachingVideo from './TeachingVideo.astro';

interface Props { videos: CollectionEntry<'videos'>[]; heading: string; id?: string }
const { videos, heading, id = 'teaching-videos' } = Astro.props;
---
{videos.length > 0 && (
  <section aria-labelledby={id} class="mt-10">
    <h2 id={id} class="m-0 mb-4 text-[length:var(--text-h2)] font-semibold leading-[1.16] tracking-[-0.015em] text-navy-800">{heading}</h2>
    <div class="grid gap-5 md:grid-cols-2">
      {videos.map((v) => <TeachingVideo video={v} />)}
    </div>
  </section>
)}
