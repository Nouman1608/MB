# Cloudflare Pages custom response headers.
#
# By default every asset on this deployment is served with
# `Cache-Control: public, max-age=0, must-revalidate` — correct for HTML
# (content changes on every deploy and must stay fresh) but wasteful for
# content-hashed build output and brand assets that almost never change.
# This file opts those paths into long-lived caching without touching HTML.
#
# /_astro/* filenames are content-hashed by Astro's build (e.g.
# index.BdmlJTjy.css) — a file at a given URL can never change without the
# hash changing too, so it is safe to cache for a year and mark immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Brand images are not content-hashed, so a shorter, non-immutable window is
# used instead — long enough to meaningfully reduce repeat-visit requests,
# short enough that a future asset replacement propagates within a week.
/images/*
  Cache-Control: public, max-age=604800

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

# Font binaries in /fonts/* are not content-hashed, but in practice never
# change without a deliberate font-family swap (unlike /images/*, which
# can be replaced more casually) -- these are the same handful of woff2
# files referenced by every page's @font-face rules. A long, non-immutable
# cache window meaningfully cuts repeat-visit font requests while still
# expiring within a reasonable window if a font is ever swapped.
/fonts/*
  Cache-Control: public, max-age=2592000

# Practice-question JSON payloads (Flagship Dominance/Trust Programme,
# D-104 follow-up -- see docs/decision-log.md). /practice-data/{code}.json
# itself is not content-hashed, but every fetch of it carries a content
# hash as a query string (?v=<hash>, computed by dataHashFor in
# src/utils/practice/client-questions.ts and embedded server-side in
# src/pages/practice/[code]/index.astro) -- a real content change produces
# a new URL at the next build, so a long, immutable cache here is safe: an
# old cached response can never be served under a new content's URL. This
# file, not the Cache-Control header set inside
# src/pages/practice-data/[code].json.ts's own Response, is what actually
# governs the header Cloudflare serves -- that in-code header is kept for
# local `astro preview` parity and as a documented intent, not because it
# reaches production on its own (matching the default-headers behaviour
# this file's own top comment already describes for every other path).
/practice-data/*
  Cache-Control: public, max-age=31536000, immutable
